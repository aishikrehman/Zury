PORT=5000
NODE_ENV=development

# MariaDB. npm run db:setup-local creates the user and database and fills this in.
# On Toolforge set ZURY_DB=toolsdb instead: the tool's ToolsDB account is used.
DATABASE_URL="mysql://zury:password@127.0.0.1:3306/zury"

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_secure_random_value

WIKIMEDIA_CONSUMER_KEY=your_consumer_key
WIKIMEDIA_CONSUMER_SECRET=your_consumer_secret

WIKIMEDIA_CALLBACK_URL=http://127.0.0.1:5000/

# Where backups go (default: backups/ in the project).
# ZURY_BACKUP_DIR=/data/project/zury/backups
