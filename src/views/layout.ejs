<!DOCTYPE html>
<html lang="en" data-bs-navbar-position="vertical">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'Zury' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/zury-logo.svg">
  <link rel="stylesheet" href="/css/tabler.css">
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <%- include('partials/sidebar') %>

    <div class="page-wrapper">
      <%- include('partials/topbar') %>
      <% if (demoMode) { %>
        <div class="alert alert-warning alert-important rounded-0 mb-0 py-2 small d-flex justify-content-between">
          <span><i class="ti ti-flask me-1"></i><strong>Demo mode.</strong> Everything here is sample data.</span>
          <a href="/demo" class="alert-link">Switch demo user</a>
        </div>
      <% } %>
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="container-xl pt-3">
          <div class="alert alert-<%= flash.type === 'danger' ? 'danger' : 'success' %> mb-0" role="<%= flash.type === 'danger' ? 'alert' : 'status' %>">
            <i class="ti ti-<%= flash.type === 'danger' ? 'alert-circle' : 'circle-check' %> me-1"></i><%= flash.message %>
          </div>
        </div>
      <% } %>

      <%- body %>

      <%- include('partials/footer') %>
    </div>
  </div>
  <script src="/vendor/tabler/js/tabler.min.js"></script>
</body>
</html>
