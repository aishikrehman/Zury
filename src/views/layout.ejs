<%
  const isActive = (prefix, exact = false) => (exact ? currentPath === prefix : currentPath === prefix || currentPath.startsWith(prefix + '/'));
  // The navigation bar under the header.
  // Personal pages (profile, preferences) are in the account menu.
  const navItems = [
    currentUser
      ? { href: '/dashboard', icon: 'layout-dashboard', label: t('Dashboard'), active: isActive('/dashboard') }
      : { href: '/', icon: 'home', label: t('Home'), active: isActive('/', true) },
    {
      icon: 'calendar-event', label: t('Events'), active: isActive('/events') && !isActive('/events/create'),
      children: [
        { href: '/events', icon: 'list', label: t('All events'), active: currentPath === '/events' },
        { href: '/events/active', icon: 'player-play', label: t('Active'), active: isActive('/events/active') },
        { href: '/events/upcoming', icon: 'clock', label: t('Upcoming'), active: isActive('/events/upcoming') },
        { href: '/events/completed', icon: 'flag', label: t('Completed'), active: isActive('/events/completed') },
      ],
    },
  ];
  if (currentUser && typeof onJury !== 'undefined' && onJury) {
    navItems.push({ href: '/review', icon: 'gavel', label: t('Review'), active: isActive('/review') });
  }
  if (can('createEvent')) {
    navItems.push({
      icon: 'calendar-cog', label: t('Event management'), active: isActive('/events/create') || isActive('/events/import') || isActive('/series'),
      children: [
        { href: '/events/create', icon: 'calendar-plus', label: t('Create event'), active: isActive('/events/create') },
        ...(can('accessAdmin') ? [
          { href: '/events/import', icon: 'download', label: t('Import from Fountain'), active: isActive('/events/import') },
          { href: '/series', icon: 'stack-2', label: t('Series and editions'), active: isActive('/series') },
        ] : []),
      ],
    });
  }
  if (can('accessAdmin')) {
    navItems.push({ href: '/admin', icon: 'shield-lock', label: t('Administration'), active: isActive('/admin') });
  }
  const htmlClasses = uiClasses;
%>
<!DOCTYPE html>
<html lang="<%= lang.code %>" dir="<%= lang.dir %>"<% if (htmlClasses) { %> class="<%= htmlClasses %>"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title><%= typeof title !== 'undefined' ? String(title).split(' — ').map((part) => t(part)).join(' — ') : 'Zury' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/zury-logo.svg">
<%- include('partials/seo') %>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
</head>
<body>
  <a href="#content" class="visually-hidden-focusable skip-link"><%= t("Skip to main content") %></a>
  <%- include('partials/header', { navItems }) %>

  <main id="content" class="z-main">
    <% if (typeof flash !== 'undefined' && flash) { const kind = flash.type === 'danger' ? 'error' : flash.type === 'warning' ? 'warn' : 'success'; %>
      <div class="z-toast flash-<%= kind %>" role="<%= kind === 'error' ? 'alert' : 'status' %>"<%- kind === 'success' ? ' data-autohide' : '' %>>
        <i class="ti ti-<%= kind === 'error' ? 'alert-circle' : kind === 'warn' ? 'alert-triangle' : 'circle-check' %>"></i><span><%= t(flash.message) %></span>
        <button type="button" class="z-toast-close" aria-label="<%= t('Close') %>" data-toast-close><i class="ti ti-x"></i></button>
      </div>
    <% } %>

    <%- body %>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/a11y') %>
  <script type="application/json" id="zury-i18n"><%- clientStrings %></script>
  <script src="/js/i18n.js?v=<%= assetV %>"></script>
  <script src="/vendor/tabler/js/tabler.min.js" defer></script>
  <script src="/js/ui.js?v=<%= assetV %>" defer></script>
  <script src="/js/load.js?v=<%= assetV %>" data-v="<%= assetV %>" defer></script>
</body>
</html>
