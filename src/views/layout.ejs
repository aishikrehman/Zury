<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Zury' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <% if (demoMode) { %>
    <div class="bg-warning-subtle border-bottom border-warning small py-1">
      <div class="container d-flex justify-content-between align-items-center">
        <span><strong>Demo mode.</strong> Everything here is sample data.</span>
        <a href="/demo">Switch demo user</a>
      </div>
    </div>
  <% } %>
  <%- include('partials/nav') %>

  <main class="flex-grow-1">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="container pt-4">
        <div class="alert alert-<%= flash.type === 'danger' ? 'danger' : 'success' %> mb-0" role="<%= flash.type === 'danger' ? 'alert' : 'status' %>"><%= flash.message %></div>
      </div>
    <% } %>
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
