<%
  const layout = LAYOUTS[layoutKey] || LAYOUTS.horizontal;
  const isActive = (prefix, exact = false) => (exact ? currentPath === prefix : currentPath === prefix || currentPath.startsWith(prefix + '/'));
  const navItems = [
    { section: 'Overview' },
    { href: '/', icon: 'home', label: 'Home', active: isActive('/', true) },
    { href: '/events', icon: 'calendar-event', label: 'Events', active: (isActive('/events') && !isActive('/events/create')) || isActive('/contest') },
  ];
  if (currentUser) {
    navItems.push({ href: '/dashboard', icon: 'layout-dashboard', label: 'Dashboard', active: isActive('/dashboard') });
    navItems.push({ href: '/submissions', icon: 'files', label: 'My submissions', active: isActive('/submissions') });
  }
  if (can('createEvent')) navItems.push({ href: '/events/create', icon: 'circle-plus', label: 'Create event', active: isActive('/events/create') });
  if (can('accessAdmin')) {
    navItems.push({ section: 'Administration' });
    navItems.push({
      icon: 'shield-lock', label: 'Administration', active: isActive('/admin'),
      children: [
        { href: '/admin', label: 'Overview', active: isActive('/admin', true) },
        { href: '/admin/users', label: 'Users', active: isActive('/admin/users') },
        { href: '/admin/permissions', label: 'Permissions', active: isActive('/admin/permissions') },
        ...(can('viewAuditLog') ? [{ href: '/admin/logs', label: 'Audit log', active: isActive('/admin/logs') }] : []),
      ],
    });
  }
  navItems.push({ section: 'Zury' });
  if (demoMode) navItems.push({ href: '/demo', icon: 'users-group', label: 'Demo users', active: isActive('/demo') });
  navItems.push({ href: '/about', icon: 'info-circle', label: 'About', active: isActive('/about') });
%>
<!DOCTYPE html>
<html lang="en" <%- layoutHtmlAttributes(layout) %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'Zury' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/zury-logo.svg">
  <% if (layout.rtl) { %>
    <link rel="stylesheet" href="/vendor/tabler/css/tabler.rtl.min.css">
  <% } else { %>
    <link rel="stylesheet" href="/css/tabler.css">
  <% } %>
  <link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#content" class="visually-hidden-focusable skip-link">Skip to main content</a>
  <div class="page">
    <%- include('partials/sidebar', { layout, navItems }) %>
    <%- include('partials/header', { layout, navItems }) %>

    <div class="page-wrapper">
      <main id="content" class="d-flex flex-column flex-fill">
        <% if (demoMode || (typeof flash !== 'undefined' && flash)) { %>
          <div class="container-xl pt-3">
            <% if (demoMode) { %>
              <div class="alert alert-warning py-2 mb-2 d-flex align-items-center" role="note">
                <i class="ti ti-flask me-2"></i><span><strong>Demo mode.</strong> Everything here is sample data.</span>
                <a href="/demo" class="alert-link ms-auto">Switch demo user</a>
              </div>
            <% } %>
            <% if (typeof flash !== 'undefined' && flash) { %>
              <div class="alert alert-<%= flash.type === 'danger' ? 'danger' : 'success' %> mb-0" role="<%= flash.type === 'danger' ? 'alert' : 'status' %>">
                <i class="ti ti-<%= flash.type === 'danger' ? 'alert-circle' : 'circle-check' %> me-1"></i><%= flash.message %>
              </div>
            <% } %>
          </div>
        <% } %>

        <%- body %>
      </main>

      <%- include('partials/footer') %>
    </div>
  </div>
  <%- include('partials/customize', { layout }) %>
  <script src="/vendor/tabler/js/tabler.min.js"></script>
  <script src="/js/charts.js" defer></script>
</body>
</html>
