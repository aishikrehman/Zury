<%
  const isActive = (prefix, exact = false) => (exact ? currentPath === prefix : currentPath === prefix || currentPath.startsWith(prefix + '/'));
  // The navigation bar under the header, as in Tabler's horizontal layout.
  // Personal pages (profile, preferences) are in the account menu.
  const navItems = [
    currentUser
      ? { href: '/dashboard', icon: 'layout-dashboard', label: t('Dashboard'), active: isActive('/dashboard') }
      : { href: '/', icon: 'home', label: t('Home'), active: isActive('/', true) },
    {
      icon: 'calendar-event', label: t('Events'), active: isActive('/events') && !isActive('/events/create'),
      children: [
        { href: '/events', icon: 'list', label: t('All events'), active: currentPath === '/events' },
        { href: '/events/active', icon: 'player-play', label: t('Active'), active: isActive('/events/active') },
        { href: '/events/upcoming', icon: 'clock', label: t('Upcoming'), active: isActive('/events/upcoming') },
        { href: '/events/completed', icon: 'flag', label: t('Completed'), active: isActive('/events/completed') },
      ],
    },
  ];
  if (currentUser) {
    navItems.push({ href: '/review', icon: 'gavel', label: t('Review'), active: isActive('/review') });
  }
  if (can('createEvent')) {
    navItems.push({
      icon: 'circle-plus', label: t('Create'), active: isActive('/events/create') || isActive('/series'),
      children: [
        { href: '/events/create', icon: 'calendar-plus', label: t('Create event'), active: isActive('/events/create') },
        { href: '/series/new', icon: 'stack-2', label: t('New series'), active: isActive('/series/new') },
        { href: '/series', icon: 'settings', label: t('Manage series and editions'), active: currentPath === '/series' },
      ],
    });
  }
  if (can('accessAdmin')) {
    navItems.push({
      icon: 'shield-lock', label: t('Administration'), active: isActive('/admin'),
      children: [
        { href: '/admin', icon: 'chart-dots', label: t('Overview'), active: isActive('/admin', true) },
        { href: '/admin/users', icon: 'users', label: t('Users'), active: isActive('/admin/users') },
        { href: '/admin/permissions', icon: 'key', label: t('Permissions'), active: isActive('/admin/permissions') },
        ...(can('viewAuditLog') ? [{ href: '/admin/logs', icon: 'history', label: t('Audit log'), active: isActive('/admin/logs') }] : []),
        ...(can('maintainSite') ? [{ href: '/admin/maintenance', icon: 'database', label: t('Maintenance'), active: isActive('/admin/maintenance') }] : []),
      ],
    });
  }
  const htmlClasses = [ui.wide && 'zury-wide', ui.textLarge && 'zury-text-lg'].filter(Boolean).join(' ');
%>
<!DOCTYPE html>
<html lang="<%= lang.code %>" dir="<%= lang.dir %>"<% if (htmlClasses) { %> class="<%= htmlClasses %>"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title><%= typeof title !== 'undefined' ? String(title).split(' — ').map((part) => t(part)).join(' — ') : 'Zury' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/zury-logo.svg">
<%- include('partials/seo') %>
  <link rel="stylesheet" href="/css/tabler.css">
  <link rel="stylesheet" href="/vendor/tom-select/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="/icons/tabler-icons.css">
  <link rel="stylesheet" href="/vendor/inter/index.css">
  <link rel="stylesheet" href="/vendor/noto-bengali/wght.css">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <a href="#content" class="visually-hidden-focusable skip-link"><%= t("Skip to main content") %></a>
  <%- include('partials/header', { navItems }) %>

  <main id="content" class="z-main">
    <% if (demoMode || (typeof flash !== 'undefined' && flash)) { %>
      <div class="container-xl pt-3">
        <% if (demoMode) { %>
          <div class="flash flash-warn mb-2" role="note">
            <i class="ti ti-flask"></i><span><strong><%= t("Demo mode.") %></strong> <%= t("Everything here is sample data.") %></span>
            <a href="/demo" class="ms-auto"><%= t("Switch demo user") %></a>
          </div>
        <% } %>
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="flash flash-<%= flash.type === 'danger' ? 'error' : flash.type === 'warning' ? 'warn' : 'success' %>" role="<%= flash.type === 'danger' ? 'alert' : 'status' %>">
            <i class="ti ti-<%= flash.type === 'danger' ? 'alert-circle' : flash.type === 'warning' ? 'alert-triangle' : 'circle-check' %>"></i><span><%= t(flash.message) %></span>
          </div>
        <% } %>
      </div>
    <% } %>

    <%- body %>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/a11y') %>
  <script type="application/json" id="zury-i18n"><%- clientStrings %></script>
  <script src="/js/i18n.js"></script>
  <script src="/vendor/tabler/js/tabler.min.js"></script>
  <script src="/vendor/tom-select/js/tom-select.complete.min.js" defer></script>
  <script src="/js/pickers.js" defer></script>
  <script src="/js/charts.js" defer></script>
  <script src="/js/ui.js" defer></script>
  <script src="/js/wizard.js" defer></script>
  <script src="/js/eventForm.js" defer></script>
  <script src="/js/review.js" defer></script>
</body>
</html>
