<%
  // part: "summary" (numbers and charts, on the overview), "breakdown" (top people,
  // wikis, types, with the results) or everything.
  const statsPart = locals.part || '';
  const s = stats;
  const statusKeys = Object.keys(SUBMISSION_STATUSES).filter((k) => s.status[k]);
  const participants = s.roles.participant || 0;
  const typeIcons = { file: 'photo', article: 'file-text', item: 'database', lexeme: 'language', property: 'tag', page: 'file' };
  const maxTop = Math.max(1, ...s.topParticipants.map((p) => p.count));
  const sum7 = s.last7.reduce((a, b) => a + b, 0);
%>
<section id="statistics" aria-label="<%= t('Statistics') %>">
  <% const tilesOnly = statsPart === 'tiles' && !locals.wide; %>
  <% if (['', 'summary', 'tiles'].includes(statsPart)) { %>
  <div class="row row-deck row-cards mb-3">
    <div class="col-sm-6 col-xl">
      <div class="card">
        <div class="card-body">
          <div class="d-flex align-items-center"><div class="subheader"><%= t("Submissions") %></div><div class="ms-auto text-secondary small"><%= t("all time") %></div></div>
          <div class="d-flex align-items-baseline">
            <div class="h1 mb-0 me-2"><%= s.active %></div>
            <div class="me-auto"><span class="text-<%= sum7 ? 'green' : 'secondary' %> d-inline-flex align-items-center lh-1"><%= t('{n} this week', { n: sum7 }) %> <i class="ti ti-trending-up ms-1"></i></span></div>
          </div>
        </div>
        <% if (settings.wordCountEnabled) { %>
          <% const w3 = s.wordStats || { accepted: { words: s.approvedWords }, pending: { words: 0 }, rejected: { words: 0 } }; %>
          <div class="card-body pt-0 pb-2 small">
            <div class="d-flex mb-1"><span><i class="ti ti-align-justified me-1"></i><%= t('{n} words', { n: formatNumber(s.words) }) %></span></div>
            <div class="d-flex flex-wrap gap-2"><span class="text-green"><%= t('{n} words accepted', { n: formatNumber(w3.accepted.words || 0) }) %></span><span class="text-yellow"><%= t('{n} words pending', { n: formatNumber(Math.max(0, w3.pending.words || 0)) }) %></span><span class="text-red"><%= t('{n} words not accepted', { n: formatNumber(w3.rejected.words || 0) }) %></span></div>
          </div>
        <% } %>
        <%- include('./chart', { spec: { type: 'area', sparkline: true, height: 40, series: [{ name: t('Submissions'), data: s.series.values }], labels: s.series.labels, colors: ['primary'] }, label: t('Daily submissions') }) %>
      </div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="card">
        <div class="card-body">
          <div class="subheader"><%= t("Participants") %></div>
          <div class="h1 mb-3"><%= participants %></div>
          <div class="d-flex mb-1"><div><%= t("With an accepted entry") %></div><div class="ms-auto text-green fw-medium"><%= formatNumber(s.peopleAccepted || 0) %></div></div>
          <div class="d-flex mb-1"><div><%= t("Reviewers") %></div><div class="ms-auto text-secondary"><%= formatNumber(s.reviewersActive || 0) %> / <%= formatNumber(s.roles.jury || 0) %> <small><%= t('active') %></small></div></div>
          <div class="d-flex mb-1"><div><%= t("Reviews given") %></div><div class="ms-auto text-secondary"><%= formatNumber(s.reviewsGiven || 0) %></div></div>
          <div class="d-flex"><div><%= t("Organizers") %></div><div class="ms-auto text-secondary"><%= formatNumber(s.roles.organizer || 0) %></div></div>
        </div>
      </div>
    </div>
    <% if (contest.type !== 'writing') { %>
    <div class="col-sm-6 col-xl">
      <div class="card">
        <div class="card-body">
          <div class="subheader"><%= t("Valid entries") %></div>
          <div class="h1 mb-3"><%= s.validRate %>%</div>
          <div class="d-flex mb-2"><div><%= t("Passed automatic checks") %></div><div class="ms-auto"><span class="text-green d-inline-flex align-items-center lh-1"><%= s.active - (s.status.invalid || 0) %> / <%= s.active %></span></div></div>
          <div class="progress progress-sm"><div class="progress-bar bg-green" style="width: <%= s.validRate %>%" role="progressbar" aria-valuenow="<%= s.validRate %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= s.validRate %>% valid"></div></div>
        </div>
      </div>
    </div>
    <% } %>
    <div class="col-sm-6 col-xl">
      <div class="card">
        <div class="card-body">
          <div class="subheader"><%= t("Review progress") %></div>
          <div class="h1 mb-3"><%= s.reviewProgress %>%</div>
          <div class="d-flex mb-2"><div><%= t("Decided") %></div><div class="ms-auto"><span class="text-secondary"><%= t('{a} of {b}', { a: s.decided, b: s.active }) %></span></div></div>
          <div class="progress progress-sm"><div class="progress-bar bg-primary" style="width: <%= s.reviewProgress %>%" role="progressbar" aria-valuenow="<%= s.reviewProgress %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= s.reviewProgress %>% decided"></div></div>
        </div>
      </div>
    </div>
    <% if (statsPart === 'tiles' && s.total) { %>
    <div class="col-sm-6 col-xl">
      <div class="card">
        <div class="card-body">
          <div class="subheader mb-1"><%= t("By status") %></div>
          <% const sGroups = []; statusKeys.forEach((k) => { const st2 = SUBMISSION_STATUSES[k]; const g = sGroups.find((x) => x.label === st2.label); if (g) g.n += s.status[k]; else sGroups.push({ label: st2.label, color: st2.color, n: s.status[k] }); }); const sTot = sGroups.reduce((n, g) => n + g.n, 0) || 1; %>
          <div class="z-stack"><% sGroups.forEach((g) => { %><i class="bg-<%= g.color %>" style="width: <%= (g.n / sTot) * 100 %>%" title="<%= t(g.label) %>: <%= formatNumber(g.n) %>"></i><% }) %></div>
          <div class="z-stack-legend"><% sGroups.forEach((g) => { %><div><span class="z-sw bg-<%= g.color %>"></span><span class="flex-fill"><%= t(g.label) %></span><b><%= formatNumber(g.n) %></b></div><% }) %></div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>
  <% if (['', 'summary', 'charts'].includes(statsPart) && !(statsPart === 'charts' && !s.total)) { %>
  <div class="row row-cards mb-3">
    <div class="<%= statsPart === 'charts' || statsPart === 'tiles' ? 'col-12' : 'col-lg-8' %>">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><%= t("Submissions per day") %></h3><div class="card-actions text-secondary small"><%= contest.timezone %></div></div>
        <div class="card-body">
          <% if (!s.total) { %>
            <%- include('./emptyArt', { title: t('No submissions yet'), text: t('The chart fills in as entries arrive.') }) %>
          <% } else { %>
            <% const withWords = settings.wordCountEnabled && s.wordSeries && s.wordSeries.values.some((n) => n > 0); %>
            <%- include('./chart', { spec: withWords ? { type: 'area', height: 280, dualAxis: true, series: [{ name: t('Submissions'), data: s.series.values }, { name: t('Words'), data: s.wordSeries.values }], labels: s.series.labels, colors: ['primary', 'orange'] } : { type: 'area', height: 260, series: [{ name: t('Submissions'), data: s.series.values }], labels: s.series.labels, colors: ['primary'] }, label: t('Submissions per day') }) %>
            <% const vals = s.series.values || []; const labs = s.series.labels || []; const maxN = Math.max(0, ...vals); const maxAt = vals.indexOf(maxN); const activeDays = vals.filter((n) => n > 0).length; const lastWeek = vals.slice(-14, -7).reduce((a, b) => a + b, 0); const thisWeek = vals.slice(-7).reduce((a, b) => a + b, 0); %>
            <div class="z-insights">
              <div><span><%= t('Busiest day') %></span><b><%= maxN ? formatNumber(maxN) : '—' %></b><small><%= maxN && labs[maxAt] ? formatDate(new Date(labs[maxAt])) : '' %></small></div>
              <div><span><%= t('Average per day') %></span><b><%= vals.length ? formatNumber(Math.round((vals.reduce((a, b) => a + b, 0) / vals.length) * 10) / 10) : '—' %></b><small><%= tn('{n} day', '{n} days', vals.length) %></small></div>
              <div><span><%= t('Days with entries') %></span><b><%= formatNumber(activeDays) %></b><small><%= vals.length ? formatNumber(Math.round((activeDays / vals.length) * 100)) + '%' : '' %></small></div>
              <div><span><%= t('This week') %></span><b><%= formatNumber(thisWeek) %></b><small class="<%= thisWeek >= lastWeek ? 'text-green' : 'text-red' %>"><%= lastWeek ? (thisWeek >= lastWeek ? '▲ ' : '▼ ') + formatNumber(Math.abs(Math.round(((thisWeek - lastWeek) / lastWeek) * 100))) + '%' : t('No entries last week') %></small></div>
            </div>
          <% } %>
        </div>
      </div>
      <% const tp = (s.topParticipants || []).slice(0, 10); if (tp.length > 1) { %>
      <div class="card mt-3">
        <div class="card-header"><h3 class="card-title"><%= t('By participant') %></h3><div class="card-actions text-secondary small"><%= t('Top {n}', { n: formatNumber(tp.length) }) %></div></div>
        <div class="card-body">
          <%- include('./chart', { spec: { type: 'bar', height: Math.max(200, tp.length * 34), horizontal: true, stacked: true, legend: true, series: [{ name: t('Accepted'), data: tp.map((p) => p.approved) }, { name: t('Pending'), data: tp.map((p) => Math.max(0, p.count - p.approved - p.rejected)) }, { name: t('Not accepted'), data: tp.map((p) => p.rejected) }], labels: tp.map((p) => p.username), colors: ['green', 'yellow', 'red'] }, label: t('By participant') }) %>
        </div>
      </div>
      <% } %>
    </div>
    <% if (statsPart !== 'charts') { %>
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><%= t("By status") %></h3></div>
        <div class="card-body">
          <% if (!s.total) { %>
            <p class="text-secondary mb-0"><%= t("No entries yet.") %></p>
          <% } else { %>
            <%- include('./chart', { spec: { type: 'donut', height: 260, series: statusKeys.map((k) => s.status[k]), labels: statusKeys.map((k) => SUBMISSION_STATUSES[k].label), colors: statusKeys.map((k) => SUBMISSION_STATUSES[k].color), totalLabel: t('Entries') }, label: t('Submissions by status') }) %>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <% } %>
  <% if (!['summary', 'tiles', 'charts'].includes(statsPart)) { %>
    <% const wikis = Object.entries(s.byWiki).sort((a, b) => b[1] - a[1]); const types = Object.entries(s.byType); %>
    <% if (wikis.length > 1 || types.length > 1) { %>
      <div class="row row-cards">
        <% if (wikis.length > 1) { %>
          <div class="col-lg-<%= types.length > 1 ? 7 : 12 %>">
            <div class="card">
              <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t('By wiki') %></h3></div>
              <div class="card-body"><%- include('./chart', { spec: { type: 'bar', height: 240, distributed: true, series: [{ name: t('Entries'), data: wikis.map((w) => w[1]) }], labels: wikis.map((w) => wikiLocal(w[0])), colors: ['primary', 'green', 'orange', 'purple', 'azure', 'pink'] }, label: t('Entries by wiki') }) %></div>
            </div>
          </div>
        <% } %>
        <% if (types.length > 1) { %>
          <div class="col-lg-<%= wikis.length > 1 ? 5 : 12 %>">
            <div class="card">
              <div class="card-header"><h3 class="card-title"><i class="ti ti-category me-2"></i><%= t('By type') %></h3></div>
              <div class="card-body">
                <% types.forEach(([type, n]) => { const pct = Math.round((n / Math.max(1, s.active)) * 100); %>
                  <div class="d-flex mb-1"><span class="text-capitalize"><i class="ti ti-<%= typeIcons[type] || 'file' %> me-1"></i><%= type %></span><span class="ms-auto text-secondary"><%= n %> · <%= pct %>%</span></div>
                  <div class="progress progress-sm mb-3"><div class="progress-bar" style="width: <%= pct %>%"></div></div>
                <% }) %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  <% } %>
  <% if (s.wordStats && statsPart === 'breakdown') { const w = s.wordStats; const tile = (label, x, color) => ({ label, x, color }); %>
    <div class="card mt-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-align-justified me-1"></i><%= t('Word statistics') %></h3></div>
      <div class="card-body">
        <div class="row g-2 mb-3">
          <% [tile('All entries', w.all, ''), tile('Accepted', w.accepted, 'green'), tile('Pending', w.pending, 'yellow'), tile('Not accepted', w.rejected, 'red')].forEach((x) => { %>
            <div class="col-6 col-lg-3"><div class="border rounded p-2">
              <div class="subheader"><%= t(x.label) %></div>
              <div class="h2 mb-0<%= x.color ? ' text-' + x.color : '' %>"><%= formatNumber(x.x.words) %></div>
              <div class="small text-secondary"><%= tn('{n} article', '{n} articles', x.x.count) %></div>
            </div></div>
          <% }) %>
        </div>
        <div class="small text-secondary mb-3"><%= t('Average per article: {n} words', { n: formatNumber(w.average) }) %> · <%= t('Average per accepted article: {n} words', { n: formatNumber(w.averageAccepted) }) %></div>
        <div class="row g-3">
          <div class="col-12">
            <h4 class="mb-2"><%= t('Longest articles') %></h4>
            <table class="table table-sm table-vcenter mb-0"><thead><tr><th><%= t('Article') %></th><th class="text-end"><%= t('Words') %></th><th><%= t('Status') %></th></tr></thead><tbody>
              <% w.biggest.forEach((x) => { %><tr><td><a href="<%= entryUrl(x) %>" target="_blank" rel="noopener"><%= x.title %></a><div class="small text-secondary"><%= x.username %></div></td><td class="text-end"><%= formatNumber(x.words) %></td><td><span class="badge bg-<%= (SUBMISSION_STATUSES[x.status] || {}).color || 'secondary' %>-lt"><%= (SUBMISSION_STATUSES[x.status] || {}).label || x.status %></span></td></tr><% }) %>
              <% if (!w.biggest.length) { %><tr><td colspan="3" class="text-secondary"><%= t('No entries yet.') %></td></tr><% } %>
            </tbody></table>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</section>
