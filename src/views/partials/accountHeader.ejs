<%# Your own pages: the page's name and the links to the others, then the page (on the profile, who you are in a sidebar beside it); close with accountEnd. Expects: tab; optional actions (trusted HTML), eventCount. %>
<%
  const me = currentUser;
  const tabs = [
    ['profile', userPath(me.username), 'user', t('Profile')],
    ['dashboard', '/dashboard', 'layout-dashboard', t('Dashboard')],
    ['submissions', '/submissions', 'files', t('My submissions')],
  ];
  const current = tabs.find(([key]) => key === tab);
%>
<div class="page-body">
  <div class="container-xl">
    <div class="row g-4">
      <div class="col-12">
        <div class="z-account-bar mb-3">
          <h1 class="z-account-title"><% if (current) { %><i class="ti ti-<%= current[2] %>"></i><%= current[3] %><% } %></h1>
          <nav class="z-seg ms-auto" aria-label="<%= t('Account') %>">
            <% tabs.forEach(([key, href, icon, label]) => { %><a href="<%= href %>" class="<%= key === tab ? 'active' : '' %>"<%- key === tab ? ' aria-current="page"' : '' %>><i class="ti ti-<%= icon %>"></i><%= label %></a><% }) %>
          </nav>
          <% if (typeof actions !== 'undefined' && actions) { %><div class="btn-list"><%- actions %></div><% } %>
        </div>
      </div>
      <% if (tab === 'profile') { %>
        <aside class="col-lg-3">
          <div class="card z-account-nav">
            <div class="card-body text-center">
              <% const mine = typeof prefs !== 'undefined' && prefs; %>
              <% if (mine) { %>
                <button class="z-avatar-edit mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#change-picture" aria-expanded="false" aria-controls="change-picture" title="<%= t('Change picture') %>"><%- include('./avatar', { u: me, size: 'xl' }) %><span class="z-avatar-edit-icon"><i class="ti ti-camera"></i></span></button>
                <form action="/settings/avatar" method="post" class="collapse text-start mb-2" id="change-picture">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input class="form-control form-control-sm mb-2" name="file" placeholder="File:Example.jpg" aria-label="<%= t('File name on Commons') %>" maxlength="250">
                  <div class="form-hint mb-2"><%= t('A picture from Wikimedia Commons, by its file name.') %></div>
                  <div class="d-flex gap-2"><button class="btn btn-sm btn-primary flex-fill" type="submit"><%= t('Use this picture') %></button><% if (me.avatarUrl) { %><button class="btn btn-sm btn-ghost-danger" type="submit" name="remove" value="1" title="<%= t('Remove picture') %>"><i class="ti ti-trash"></i></button><% } %></div>
                </form>
              <% } else { %>
                <div class="mb-2"><%- include('./avatar', { u: me, size: 'xl' }) %></div>
              <% } %>
              <div class="h3 m-0"><%= me.username %></div>
              <div class="text-secondary small"><%= me.homeWiki ? wikiLocal(me.homeWiki) : 'Wikimedia' %></div>
            </div>
            <div class="card-body small z-account-facts">
              <% if (me.wikimediaRegisteredAt) { %><div title="<%= t('Wikimedia account since') %>"><i class="ti ti-world"></i><%= formatDate(me.wikimediaRegisteredAt) %></div><% } %>
              <div title="<%= t('Joined Zury') %>"><i class="ti ti-user-plus"></i><%= formatDate(me.createdAt) %></div>
              <% if (typeof eventCount !== 'undefined') { %><div title="<%= t('Events') %>"><i class="ti ti-calendar-event"></i><%= tn('{n} event', '{n} events', eventCount) %></div><% } %>
              <a href="https://meta.wikimedia.org/wiki/Special:CentralAuth/<%= encodeURIComponent(me.username.replace(/ /g, '_')) %>" rel="noopener" target="_blank"><i class="ti ti-external-link"></i><%= t('Wikimedia account') %></a>
            </div>
            <% if (typeof subject !== 'undefined' && subject) { %>
              <div class="card-body">
                <div class="subheader mb-1"><%= t('Roles') %></div>
                <%- include('./accessSummary', { s: subject }) %>
              </div>
            <% } %>
            <% if (mine) { %>
              <form action="/settings" method="post" novalidate class="card-body" id="preferences">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="subheader mb-2"><%= t('Language and time') %></div>
                <% if (prefs.saved) { %><div class="text-green small mb-2"><i class="ti ti-circle-check me-1"></i><%= t('Preferences saved.') %></div><% } %>
                <label for="preferredLanguage" class="form-label small mb-1"><%= t('Preferred language') %></label>
                <select id="preferredLanguage" name="preferredLanguage" data-picker="language" placeholder="<%= t('Search languages…') %>" class="form-select form-select-sm mb-2">
                  <option value=""><%= t('Default') %></option>
                  <% if (prefs.values.preferredLanguage) { %><option value="<%= prefs.values.preferredLanguage %>" selected><%= prefs.values.preferredLanguage %></option><% } %>
                </select>
                <label for="timezone" class="form-label small mb-1"><%= t('Timezone') %></label>
                <select id="timezone" name="timezone" class="form-select form-select-sm mb-2">
                  <option value=""><%= t('Not set') %></option>
                  <% prefs.timezones.forEach((tz) => { %><option value="<%= tz %>"<%= prefs.values.timezone === tz ? ' selected' : '' %>><%= tz %></option><% }) %>
                </select>
                <button type="submit" class="btn btn-sm w-100"><%= t('Save') %></button>
              </form>
            <% } %>
          </div>
        </aside>
      <% } %>
      <div class="<%= tab === 'profile' ? 'col-lg-9' : 'col-12' %>">
