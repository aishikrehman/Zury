<%# Your own pages: a sidebar with who you are, then tabs and the page; close with accountEnd. Expects: tab; optional actions (trusted HTML), eventCount. %>
<%
  const me = currentUser;
  const tabs = [
    ['profile', userPath(me.username), 'user', t('Profile')],
    ['submissions', '/submissions', 'files', t('My submissions')],
    ['settings', '/settings', 'settings', t('Preferences')],
  ];
%>
<div class="page-body">
  <div class="container-xl">
    <div class="row g-4">
      <aside class="col-lg-3">
        <div class="card z-account-nav">
          <div class="card-body text-center">
            <div class="mb-2"><%- include('./avatar', { u: me, size: 'xl' }) %></div>
            <h1 class="h3 m-0"><%= me.username %></h1>
            <div class="text-secondary small"><%= me.homeWiki ? wikiLocal(me.homeWiki) : 'Wikimedia' %></div>
            <% if (typeof actions !== 'undefined' && actions) { %><div class="btn-list justify-content-center mt-3"><%- actions %></div><% } %>
          </div>
          <div class="card-body small">
            <% if (me.wikimediaRegisteredAt) { %><div class="d-flex justify-content-between"><span class="text-secondary"><%= t("Wikimedia account since") %></span><span><%= formatDate(me.wikimediaRegisteredAt) %></span></div><% } %>
            <div class="d-flex justify-content-between mt-1"><span class="text-secondary"><%= t("Joined Zury") %></span><span><%= formatDate(me.createdAt) %></span></div>
            <% if (typeof eventCount !== 'undefined') { %><div class="d-flex justify-content-between mt-1"><span class="text-secondary"><%= t("Events") %></span><span><%= formatNumber(eventCount) %></span></div><% } %>
          </div>
          <% if (typeof subject !== 'undefined' && subject) { %>
            <div class="card-body">
              <div class="subheader mb-1"><%= t("Roles") %></div>
              <%- include('./accessSummary', { s: subject }) %>
            </div>
          <% } %>
        </div>
      </aside>
      <div class="col-lg-9">
        <nav class="z-account-tabs mb-3" aria-label="<%= t('Account') %>">
          <% tabs.forEach(([key, href, icon, label]) => { %><a href="<%= href %>" class="<%= key === tab ? 'active' : '' %>"<%- key === tab ? ' aria-current="page"' : '' %>><i class="ti ti-<%= icon %> me-1"></i><%= label %></a><% }) %>
        </nav>
