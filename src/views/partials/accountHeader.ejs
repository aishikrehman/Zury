<%# Your own pages: the page's name and the links to the others, then the page (on the profile, who you are in a sidebar beside it); close with accountEnd. Expects: tab; optional actions (trusted HTML), eventCount. %>
<%
  const me = currentUser;
  const tabs = [
    ['profile', userPath(me.username), 'user', t('Profile')],
    ['dashboard', '/dashboard', 'layout-dashboard', t('Dashboard')],
    ['submissions', '/submissions', 'files', t('My submissions')],
  ];
  const current = tabs.find(([key]) => key === tab);
%>
<div class="page-body">
  <div class="container-xl">
    <div class="row g-4">
      <div class="col-12">
        <div class="z-account-bar mb-3">
          <h1 class="z-account-title"><% if (current) { %><i class="ti ti-<%= current[2] %>"></i><%= current[3] %><% } %></h1>
          <nav class="z-seg ms-auto" aria-label="<%= t('Account') %>">
            <% tabs.forEach(([key, href, icon, label]) => { %><a href="<%= href %>" class="<%= key === tab ? 'active' : '' %>"<%- key === tab ? ' aria-current="page"' : '' %>><i class="ti ti-<%= icon %>"></i><%= label %></a><% }) %>
          </nav>
          <% if (typeof actions !== 'undefined' && actions) { %><div class="btn-list"><%- actions %></div><% } %>
        </div>
      </div>
      <% if (tab === 'profile') { %>
        <aside class="col-lg-3">
          <div class="card z-account-nav">
            <div class="card-body text-center">
              <div class="mb-2"><%- include('./avatar', { u: me, size: 'xl' }) %></div>
              <div class="h3 m-0"><%= me.username %></div>
              <div class="text-secondary small"><%= me.homeWiki ? wikiLocal(me.homeWiki) : 'Wikimedia' %></div>
            </div>
            <div class="card-body small z-account-facts">
              <% if (me.wikimediaRegisteredAt) { %><div title="<%= t('Wikimedia account since') %>"><i class="ti ti-world"></i><%= formatDate(me.wikimediaRegisteredAt) %></div><% } %>
              <div title="<%= t('Joined Zury') %>"><i class="ti ti-user-plus"></i><%= formatDate(me.createdAt) %></div>
              <% if (typeof eventCount !== 'undefined') { %><div title="<%= t('Events') %>"><i class="ti ti-calendar-event"></i><%= tn('{n} event', '{n} events', eventCount) %></div><% } %>
              <a href="https://meta.wikimedia.org/wiki/Special:CentralAuth/<%= encodeURIComponent(me.username.replace(/ /g, '_')) %>" rel="noopener" target="_blank"><i class="ti ti-external-link"></i><%= t('Wikimedia account') %></a>
            </div>
            <% if (typeof subject !== 'undefined' && subject) { %>
              <div class="card-body">
                <div class="subheader mb-1"><%= t('Roles') %></div>
                <%- include('./accessSummary', { s: subject }) %>
              </div>
            <% } %>
          </div>
        </aside>
      <% } %>
      <div class="<%= tab === 'profile' ? 'col-lg-9' : 'col-12' %>">
