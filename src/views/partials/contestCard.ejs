<% const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
<div class="card h-100 shadow-sm">
  <div class="card-body d-flex flex-column">
    <div class="d-flex flex-wrap gap-1 mb-2">
      <span class="badge text-bg-<%= st.badge %>"><%= st.label %></span>
      <span class="badge text-bg-light border"><%= CONTEST_TYPES[c.type] || c.type %></span>
      <% if (c.visibility === 'private') { %><span class="badge text-bg-warning">Private</span><% } %>
    </div>
    <h3 class="h6 card-title mb-1"><a href="/contest/<%= c.id %>" class="stretched-link text-decoration-none"><%= c.title %></a></h3>
    <p class="small text-muted mb-2"><%= c.primaryWiki %></p>
    <p class="small mb-0 mt-auto">
      <% if (c.startDate) { %><%= formatDate(c.startDate, c.timezone) %> – <%= formatDate(c.endDate, c.timezone) %><% } else { %>Dates not set<% } %>
      <% if (c._count) { %><span class="text-muted"> · <%= c._count.memberships %> participant<%= c._count.memberships === 1 ? '' : 's' %></span><% } %>
    </p>
    <% if (typeof roles !== 'undefined' && roles.length) { %>
      <div class="mt-2">
        <% roles.forEach((r) => { %><span class="badge rounded-pill text-bg-primary me-1"><%= EVENT_ROLES[r] ? EVENT_ROLES[r].label : r %></span><% }) %>
      </div>
    <% } %>
  </div>
</div>
