<% if (currentUser) { %>
  <div class="nav-item dropdown">
    <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
      <span class="avatar avatar-sm"><%= currentUser.username.charAt(0).toUpperCase() %></span>
      <div class="d-none d-xl-block ps-2">
        <div><%= currentUser.username %></div>
        <div class="mt-1 small text-secondary"><%= currentUser.homeWiki || 'Wikimedia' %></div>
      </div>
    </a>
    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
      <a href="/dashboard" class="dropdown-item"><i class="ti ti-layout-dashboard me-2"></i>Dashboard</a>
      <a href="<%= userPath(currentUser.username) %>" class="dropdown-item"><i class="ti ti-user me-2"></i>Profile</a>
      <a href="/settings" class="dropdown-item"><i class="ti ti-settings me-2"></i>Preferences</a>
      <div class="dropdown-divider"></div>
      <form action="/logout" method="post" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="dropdown-item"><i class="ti ti-logout me-2"></i>Log out</button>
      </form>
    </div>
  </div>
<% } else { %>
  <a href="/login" class="btn btn-primary btn-sm"><i class="ti ti-login me-1"></i>Log in with Wikimedia</a>
<% } %>
