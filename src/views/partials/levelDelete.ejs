<%# Deleting a series or edition: what is inside (which stops it), with a way to move each out.
    Expects: inside (structureService.impact), seriesSlug, editionSlug (or null), canDelete. %>
<% const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`; %>
<div class="card mt-3">
  <div class="card-header"><h3 class="card-title"><i class="ti ti-trash me-2"></i><%= editionSlug ? t('Delete edition') : t('Delete series') %></h3></div>
  <div class="card-body">
    <% if (inside.blocked) { %>
      <div class="alert alert-warning mb-3"><%= editionSlug ? t('It can be deleted once it has no event. Move the event out first:') : t('It can be deleted once it has no editions and no events. Move them out or delete them first:') %></div>
      <div class="list-group mb-2">
        <% inside.editions.forEach((e) => { %>
          <div class="list-group-item d-flex align-items-center gap-2">
            <i class="ti ti-calendar"></i><span class="fw-medium"><%= e.identifier || e.slug %></span><span class="text-secondary small"><%= e.title %> · <%= tn('{n} event', '{n} events', e._count.events) %></span>
            <a class="btn btn-sm ms-auto" href="/series/<%= seriesSlug %>/<%= e.slug %>?tab=settings"><%= t('Manage edition') %></a>
          </div>
        <% }) %>
        <% [...inside.directEvents.map((c) => [c, 'series']), ...inside.editionEvents.map((c) => [c, 'edition'])].forEach(([c, where]) => { %>
          <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
            <i class="ti ti-calendar-event"></i><a class="fw-medium" href="<%= c.path %>"><%= c.title %></a><span class="text-secondary small"><%= c.path %></span>
            <span class="ms-auto d-flex gap-1">
              <% if (where === 'edition') { %><form method="post" action="/series/<%= seriesSlug %>/detach" data-confirm="<%= t('Make it an event directly under the series? Its entries, people and settings stay.') %>"><%- csrf %><input type="hidden" name="eventId" value="<%= c.id %>"><input type="hidden" name="to" value="series"><input type="hidden" name="back" value="edition"><input type="hidden" name="edition" value="<%= editionSlug %>"><button class="btn btn-sm" type="submit"><%= t('Directly under the series') %></button></form><% } %>
              <form method="post" action="/series/<%= seriesSlug %>/detach" data-confirm="<%= t('Make it a standalone event? Its entries, people and settings stay.') %>"><%- csrf %><input type="hidden" name="eventId" value="<%= c.id %>"><input type="hidden" name="to" value="standalone"><% if (editionSlug) { %><input type="hidden" name="back" value="edition"><input type="hidden" name="edition" value="<%= editionSlug %>"><% } %><button class="btn btn-sm" type="submit"><%= t('Make standalone') %></button></form>
              <a class="btn btn-sm btn-ghost-secondary" href="<%= c.path %>/config"><%= t('Move or delete') %></a>
            </span>
          </div>
        <% }) %>
      </div>
    <% } else if (canDelete) { %>
      <p class="text-secondary small"><%= t('Nothing is inside. It is kept as deleted and can be restored later.') %></p>
      <form method="post" action="/series/<%= seriesSlug %><%= editionSlug ? `/${editionSlug}` : '' %>/delete" data-confirm="<%= editionSlug ? t('Delete this edition?') : t('Delete this series?') %>"><%- csrf %><button class="btn btn-ghost-danger" type="submit"><i class="ti ti-trash me-1"></i><%= editionSlug ? t('Delete edition') : t('Delete series') %></button></form>
    <% } else { %>
      <p class="text-secondary small mb-0"><%= t('Nothing is inside. Zury administrators can delete it.') %></p>
    <% } %>
  </div>
</div>
