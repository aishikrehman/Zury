<%#
  Event header in the style of a GitHub repository header: type icon,
  "Events / series / event" path with labels, actions on the right, then the
  underlined tab bar.
%>
<%
  const st = CONTEST_STATUSES[contest.status] || { label: contest.status, badge: 'secondary' };
  const color = st.badge === 'dark' ? 'secondary' : st.badge;
  const typeDef = EVENT_TYPES[contest.type];
  const tabs = [['overview', t('Overview'), '', 'info-circle']];
  if (typeDef.activity) tabs.push(['sessions', t('Sessions'), '/sessions', 'calendar-event']);
  if (typeDef.entries !== false) tabs.push(['submissions', t(typeDef.activity ? 'Uploads' : 'Submissions'), '/submissions', 'files']);
  const tracked = settings.contributionDiscoveryEnabled || settings.trackHashtags !== '[]' || settings.trackCategories !== '[]';
  if (tracked && (settings.publicStatisticsEnabled || can('viewStatistics'))) tabs.push(['tracking', t('Contributions'), '/tracking', 'activity']);
  if (typeDef.entries !== false && settings.juryReviewEnabled && (can('reviewAssignedEntry') || (scope.wikisWith && scope.wikisWith('reviewAssignedEntry').length))) {
    tabs.push(['review', t('Review'), '/review', 'gavel']);
  }
  if (typeDef.entries !== false && (contest.resultsPublishedAt || can('reviewEvent') || can('manageEvent') || settings.publicStatisticsEnabled || can('viewStatistics'))) tabs.push(['results', t('Results and statistics'), '/results', 'chart-bar']);
  if (settings.appealsEnabled && (can('reviewAppeal') || can('manageAppeals'))) tabs.push(['appeals', t('Appeals'), '/appeals', 'scale']);
  // People and the jury's assignments share one tab.
  const canAssign = typeDef.entries !== false && settings.juryReviewEnabled && (can('assignJury') || can('manageAssignments'));
  if (can('manageParticipants') || can('manageJury') || can('manageEvent')) tabs.push(['people', t('People'), '/participants', 'users']);
  else if (canAssign) tabs.push(['people', t('Assignments'), '/assignments', 'arrows-split']);
  if (can('editEvent') || can('manageEvent')) tabs.push(['configuration', t('Configuration'), '/config', 'settings']);
  if (can('manageEvent')) tabs.push(['activity', t('Activity'), '/activity', 'history']);
  const canSubmit = currentUser && contest.status === 'active' && active !== 'submit' && typeDef.entries !== false;
%>
<div class="gh-repohead d-print-none">
  <div class="container-xl">
    <div class="gh-repohead-title">
      <% if (contest.logoUrl) { %>
        <span class="avatar avatar-xs rounded" style="background-image: url('<%= contest.logoUrl %>'); background-size: contain"></span>
      <% } else { %>
        <i class="ti ti-<%= TYPE_ICONS[contest.type] || 'calendar' %>" title="<%= CONTEST_TYPES[contest.type] %>"></i>
      <% } %>
      <a href="/events"><%= t('Events') %></a>
      <span class="sep">/</span>
      <% if (series) { %><a href="/<%= series.slug %>"><%= series.title %></a><span class="sep">/</span><% } %>
      <strong><a href="<%= eventBase %>"><%= series ? contest.edition : contest.title %></a></strong>
      <% if (wikiScope) { %><span class="sep">/</span><strong><a href="<%= base %>"><%= wikiScope.code %></a></strong><% } %>
      <span class="badge bg-<%= color %>-lt"><%= st.label %></span>
      <% if (contest.visibility === 'private') { %><span class="badge"><%= t("Private") %></span><% } %>
      <% if (contest.statusMode === 'manual' && !['draft', 'cancelled', 'archived'].includes(contest.status)) { %><span class="badge" title="<%= t("Status set by an organizer") %>"><%= t("pinned") %></span><% } %>

      <div class="gh-repohead-actions">
        <% if (allWikis.length > 1) { %>
          <div class="dropdown">
            <button class="btn btn-ghost-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-world me-1"></i><%= wikiScope ? '/' + wikiScope.code : t('All wikis') %></button>
            <div class="dropdown-menu dropdown-menu-end">
              <a class="dropdown-item<%= wikiScope ? '' : ' active' %>" href="<%= eventBase %>"><%= t("All wikis") %></a>
              <div class="dropdown-divider"></div>
              <% allWikis.filter((w) => w.status !== 'pending' || scope.isGlobalController).forEach((w) => { %>
                <a class="dropdown-item d-flex<%= wikiScope && wikiScope.id === w.id ? ' active' : '' %>" href="<%= eventBase %>/<%= w.code %>">/<%= w.code %><span class="text-secondary ms-auto ps-3 small"><%= w.status === 'active' ? wikiName(w.wiki) : t(w.status === 'paused' ? 'Paused' : 'Waiting for approval') %></span></a>
              <% }) %>
            </div>
          </div>
        <% } %>
        <%
          // Taking part lives here: join, then submit, then leave.
          const isParticipant = scope.eventRoles && scope.eventRoles.includes('participant');
          const joinable = settings.registrationEnabled && ['active', 'upcoming', 'published'].includes(contest.status);
          const joinWikis = !wikiScope && eventWikis.length > 1 ? eventWikis.filter((w) => w.status === 'active') : [];
        %>
        <% if (!currentUser && joinable) { %>
          <a href="/login" class="btn btn-primary"><i class="ti ti-login me-1"></i><%= t("Log in to join") %></a>
        <% } else if (currentUser && !isParticipant && joinable && !(typeof eligibility !== 'undefined' && !eligibility.eligible)) { %>
          <% if (joinWikis.length) { %>
            <div class="dropdown">
              <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-user-plus me-1"></i><%= t("Join this event") %></button>
              <div class="dropdown-menu dropdown-menu-end">
                <div class="dropdown-header"><%= t("Your wiki") %></div>
                <% joinWikis.forEach((w) => { %>
                  <form method="post" action="<%= base %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="wiki" value="<%= w.wiki %>">
                    <button class="dropdown-item" type="submit"><%= wikiLocal(w.wiki) %></button>
                  </form>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <form method="post" action="<%= base %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary" type="submit"><i class="ti ti-user-plus me-1"></i><%= t("Join this event") %></button>
            </form>
          <% } %>
        <% } %>
        <% if (canSubmit && (isParticipant || can('submitOnBehalf') || can('manageEvent'))) { %>
          <a href="<%= base %>/submit" class="btn btn-primary"><i class="ti ti-upload me-1"></i><%= t("Submit entries") %></a>
        <% } %>
        <% if (isParticipant && !['completed', 'archived'].includes(contest.status)) { %>
          <form method="post" action="<%= base %>/leave" data-confirm="<%= t('Leave this event?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost-secondary" type="submit" title="<%= t("Leave event") %>"><i class="ti ti-logout me-1"></i><%= t("Leave") %></button>
          </form>
        <% } %>
      </div>
    </div>
    <%
      const shownWikis = wikiScope ? [wikiScope] : eventWikis;
      const facts = [
        contest.organizingCommunity,
        // One wiki: its name. Several: how many (the wiki menu lists them).
        shownWikis.length > 1 ? tn('{n} wiki', '{n} wikis', shownWikis.length) : wikiLocal((shownWikis[0] || {}).wiki || contest.primaryWiki),
        // A multi-wiki event has no single language.
        shownWikis.length > 1 ? '' : null,
      ].filter(Boolean);
      if (shownWikis.length <= 1 && contest.language) facts.push(langLocal(contest.language));
    %>
    <p class="gh-repohead-sub"><% if (contest.title && series) { %><span class="text-body"><%= contest.title %></span> · <% } %><%= facts.join(' · ') %></p>
    <nav class="nav nav-tabs" aria-label="<%= t('Event') %>">
      <% tabs.forEach(([key, label, suffix, icon]) => { %>
        <a class="nav-link<%= active === key ? ' active' : '' %>" href="<%= base %><%= suffix %>"<%= active === key ? ' aria-current="page"' : '' %>><i class="ti ti-<%= icon %>"></i><%= label %></a>
      <% }) %>
    </nav>
  </div>
</div>
<% if (contest.bannerUrl && active === 'overview') { %>
  <img src="<%= contest.bannerUrl %>" alt="" class="w-100 rounded mb-3" style="max-height: 220px; object-fit: cover" referrerpolicy="no-referrer">
<% } %>
