<%
  const st = CONTEST_STATUSES[contest.status] || { label: contest.status, badge: 'secondary' };
  const color = st.badge === 'dark' ? 'secondary' : st.badge;
  const typeDef = EVENT_TYPES[contest.type];
  const landing = typeDef.entries !== false && !typeDef.activity;
  const tabs = landing ? [] : [['overview', t('Overview'), '', 'info-circle']];
  if (typeDef.activity) tabs.push(['sessions', t('Sessions'), '/sessions', 'calendar-event']);
  if (typeDef.entries !== false) tabs.push(['submissions', typeDef.activity ? t('Uploads') : t('Submissions'), landing ? '' : '/submissions', 'files']);
  const tracked = settings.contributionDiscoveryEnabled || settings.trackHashtags !== '[]' || settings.trackCategories !== '[]';
  if (tracked && (settings.publicStatisticsEnabled || can('viewStatistics'))) tabs.push(['tracking', t('Contributions'), '/tracking', 'activity']);
  // The jury's way in is a button in the header, not a tab.
  const canReview = typeDef.entries !== false && (can('reviewAssignedEntry') || (scope.wikisWith && scope.wikisWith('reviewAssignedEntry').length));
  if (typeDef.entries !== false && (contest.resultsPublishedAt || can('reviewEvent') || can('manageEvent') || settings.publicStatisticsEnabled || can('viewStatistics'))) tabs.push(['results', t('Results'), '/results', 'trophy']);
  if (typeDef.entries !== false && (settings.publicStatisticsEnabled || can('viewStatistics'))) tabs.push(['statistics', t('Statistics and analysis'), '/statistics', 'chart-bar']);
  let appealsOpen = true; try { appealsOpen = ((JSON.parse(settings.participation || '{}').rules) || {}).appealsPublic !== 'no'; } catch (e) {}
  if (settings.appealsEnabled && (appealsOpen || currentUser || can('reviewAppeal') || can('manageAppeals'))) tabs.push(['appeals', t('Appeals'), '/appeals', 'scale']);
  // People and the jury's assignments share one tab.
  const canAssign = typeDef.entries !== false && settings.juryReviewEnabled && (can('assignJury') || can('manageAssignments'));
  if (can('manageParticipants') || can('manageJury') || can('manageEvent')) tabs.push(['people', t('People'), '/participants', 'users']);
  else if (canAssign) tabs.push(['people', t('Assignments'), '/assignments', 'arrows-split']);
  if (can('editEvent') || can('manageEvent')) tabs.push(['configuration', t('Configuration'), '/config', 'settings']);
  const canSubmit = contest.status === 'active' && active !== 'submit' && typeDef.entries !== false;
%>
<% const headProj = eventProject({ wikis: eventWikis, primaryWiki: contest.primaryWiki }); %>
    <%
      const shownWikis = wikiScope ? [wikiScope] : eventWikis;
      const facts = [
        contest.organizingCommunity,
        // One wiki: its name. Several: how many (the wiki menu lists them).
        shownWikis.length > 1 ? tn('{n} wiki', '{n} wikis', shownWikis.length) : shownWikis.length ? wikiLocal(shownWikis[0].wiki) : t('No wikis yet'),
        // A multi-wiki event has no single language.
        shownWikis.length > 1 ? '' : null,
      ].filter(Boolean);
      if (shownWikis.length <= 1 && contest.language) facts.push(langLocal(contest.language));
    %>
<header class="z-evhead d-print-none<%= contest.bannerUrl ? ' has-cover' : ' has-proj' %>" style="--z-proj: <%= headProj.color %>">
  <% if (contest.bannerUrl) { %><div class="z-evhead-cover" style="background-image: url('<%= contest.bannerUrl %>')"></div><% } %>
  <div class="container-xl">
    <div class="z-evhead-main">
      <% if (contest.logoUrl) { %>
        <span class="z-evhead-logo" style="background-image: url('<%= contest.logoUrl %>')"></span>
      <% } else { %>
        <span class="z-evhead-logo is-icon" title="<%= headProj.label %> · <%= CONTEST_TYPES[contest.type] %>"><i class="ti ti-<%= headProj.icon %>"></i></span>
      <% } %>
      <div class="z-evhead-text">
        <nav class="z-evhead-path" aria-label="<%= t('Breadcrumb') %>">
          <a href="/events"><i class="ti ti-calendar-event" aria-hidden="true"></i><%= t('Events') %></a>
          <% if (series) { %><i class="ti ti-chevron-right" aria-hidden="true"></i><a href="/<%= series.slug %>"><%= series.title %></a><% } %>
          <% if (typeof edition !== 'undefined' && edition) { %><i class="ti ti-chevron-right" aria-hidden="true"></i><a href="<%= contest.path === `/${series.slug}/${edition.slug}` ? `/series/${series.slug}/${edition.slug}` : `/${series.slug}/${edition.slug}` %>"><%= edition.slug %></a><% } %>
          <% if (wikiScope) { %><i class="ti ti-chevron-right" aria-hidden="true"></i><a href="<%= eventBase %>"><%= contest.title %></a><% } %>
        </nav>
        <h1 class="z-evhead-title"><a href="<%= base %>"><%= contest.title %></a><% if (wikiScope) { %> <span class="z-evhead-wiki">/<%= wikiScope.code %></span><% } %></h1>
        <div class="z-evhead-meta">
          <span class="z-evhead-status is-<%= color %>" title="<%= t(st.label) %>"><i></i><span class="z-status-word"><%= t(st.label) %></span></span>
          <% if (contest.startDate && contest.endDate) { const tNow = Date.now(); const tS = new Date(contest.startDate).getTime(); const tE = new Date(contest.endDate).getTime(); if (tE > tS) { const tDone = Math.min(100, Math.max(0, Math.round(((tNow - tS) / (tE - tS)) * 100))); const tLeft = Math.ceil((tE - tNow) / 86400000); %>
            <span class="z-time-pill" title="<%= formatDate(contest.startDate, contest.timezone) %> – <%= formatDate(contest.endDate, contest.timezone) %>"><i class="z-pill-dot is-<%= color %>"></i><span class="z-pill-status"><%= t(st.label) %></span><span class="z-pill-sep">·</span><%= tNow < tS ? tn('Starts in {n} day', 'Starts in {n} days', Math.ceil((tS - tNow) / 86400000)) : tNow <= tE ? tn('{n} day left', '{n} days left', tLeft) : tn('Ended {n} day ago', 'Ended {n} days ago', Math.max(1, Math.floor((tNow - tE) / 86400000))) %><% if (tNow >= tS && tNow <= tE) { %><span class="z-time-bar"><b style="width: <%= tDone %>%"></b></span><% } %></span>
          <% } } %>
          <% if (contest.visibility === 'private') { %><span><i class="ti ti-lock"></i><%= t('Private') %></span><% } %>
          <% if (contest.startDate) { %>
            <%
              const hNow = Date.now();
              const hStart = new Date(contest.startDate).getTime();
              const hEnd = contest.endDate ? new Date(contest.endDate).getTime() : null;
              const hDone = hEnd && hEnd > hStart ? Math.min(100, Math.max(0, Math.round(((hNow - hStart) / (hEnd - hStart)) * 100))) : null;
              const hDays = (at) => Math.ceil((at - hNow) / 86400000);
              const hNext = DATE_FIELDS.map(([k, label]) => ({ label, at: contest[k] ? new Date(contest[k]).getTime() : null })).filter((x) => x.at && x.at > hNow).sort((a, b) => a.at - b.at)[0];
            %>
            <span class="z-evhead-dates" title="<%= formatDateTime(contest.startDate, contest.timezone) %><%= hEnd ? ' – ' + formatDateTime(contest.endDate, contest.timezone) : '' %>">
              <i class="ti ti-calendar"></i><%= formatDate(contest.startDate, contest.timezone) %><%= hEnd ? ' – ' + formatDate(contest.endDate, contest.timezone) : '' %>
            </span>
          <% } %>
        </div>
        <div class="z-evhead-meta">
          <span><i class="ti ti-<%= typeDef.icon || 'calendar-event' %>"></i><%= t(typeDef.label) %></span>
          <% if (shownWikis.length === 1) { %><span><i class="ti ti-world"></i><%= wikiLocal(shownWikis[0].wiki) %></span><% } else if (shownWikis.length > 1) { %><span><i class="ti ti-world"></i><%= tn('{n} wiki', '{n} wikis', shownWikis.length) %></span><% } %>
        </div>
      </div>
      <div class="z-evhead-actions">
        <% if (contest.startDate) { const cNow = Date.now(); const cStart = new Date(contest.startDate).getTime(); const cEnd = contest.endDate ? new Date(contest.endDate).getTime() : null; const cDays = (at) => Math.ceil((at - cNow) / 86400000); const cDone = cEnd && cEnd > cStart ? Math.min(100, Math.max(0, Math.round(((cNow - cStart) / (cEnd - cStart)) * 100))) : null; %>
          
        <% } %>
        <% if (allWikis.length > 1) { %>
          <div class="dropdown">
            <button class="btn btn-ghost-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-world me-1"></i><%= wikiScope ? '/' + wikiScope.code : t('All wikis') %></button>
            <div class="dropdown-menu dropdown-menu-end">
              <a class="dropdown-item<%= wikiScope ? '' : ' active' %>" href="<%= eventBase %>"><%= t("All wikis") %></a>
              <div class="dropdown-divider"></div>
              <% allWikis.filter((w) => w.status !== 'pending' || scope.isGlobalController).forEach((w) => { %>
                <a class="dropdown-item d-flex<%= wikiScope && wikiScope.id === w.id ? ' active' : '' %>" href="<%= wikiHref(w) %>">/<%= w.code %><span class="text-secondary ms-auto ps-3 small"><%= w.status === 'active' ? wikiLocal(w.wiki) : t(w.status === 'paused' ? 'Paused' : 'Waiting for approval') %></span></a>
              <% }) %>
            </div>
          </div>
        <% } %>
        <%
          // Taking part lives here: join, then submit, then leave.
          const isParticipant = scope.eventRoles && scope.eventRoles.includes('participant');
          let pj = {}; try { pj = JSON.parse(settings.participation || '{}') || {}; } catch (e) { pj = {}; }
          const pmode = pj.mode || (settings.registrationRequired ? 'register' : 'submit');
          // A first entry makes someone a participant: no join button then. A fixed list joins only those listed.
          const joinable = settings.registrationEnabled && pmode !== 'submit' && !(pmode === 'list' && !pj.outsiders) && ['active', 'upcoming', 'published'].includes(contest.status);
          const joinPage = (pj.ask || []).length > 0 || (settings.participationMode && settings.participationMode !== 'individual');
          const joinWikis = !wikiScope && eventWikis.length > 1 ? eventWikis.filter((w) => w.status === 'active') : [];
        %>
        <% if (currentUser && isParticipant) { %><a class="btn" href="<%= base %>/user/<%= nameInPath(currentUser.username) %>" title="<%= t('My page') %>"><i class="ti ti-user me-1"></i><%= t('My page') %></a><% } %>
        <% if (!currentUser && joinable) { %>
          <a href="/login" class="btn btn-primary"><i class="ti ti-login me-1"></i><%= t("Log in to join") %></a>
        <% } else if (currentUser && !(scope.eventRoles || []).length && joinable && !(typeof eligibility !== 'undefined' && !eligibility.eligible)) { %>
          <% if (joinPage) { %>
            <a class="btn btn-primary" href="<%= base %>/join"><i class="ti ti-user-plus me-1"></i><%= t("Join this event") %></a>
          <% } else if (joinWikis.length) { %>
            <div class="dropdown">
              <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-user-plus me-1"></i><%= t("Join this event") %></button>
              <div class="dropdown-menu dropdown-menu-end">
                <div class="dropdown-header"><%= t("Your wiki") %></div>
                <% joinWikis.forEach((w) => { %>
                  <form method="post" action="<%= base %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="wiki" value="<%= w.wiki %>">
                    <button class="dropdown-item" type="submit"><%= wikiLocal(w.wiki) %></button>
                  </form>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <form method="post" action="<%= base %>/join"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary" type="submit"><i class="ti ti-user-plus me-1"></i><%= t("Join this event") %></button>
            </form>
          <% } %>
        <% } %>
        <% const fountainWiki = allWikis.find((w) => w.fountainCode); %>
        <% if (canReview) { %>
          <a href="<%= base %>/review" class="btn btn-outline-primary"><i class="ti ti-gavel me-1"></i><%= t('Review') %></a>
        <% } %>
        <% const eventOver = ['completed', 'archived', 'cancelled'].includes(contest.status) || (contest.endDate && new Date(contest.endDate) < new Date()); %>
        <% const organizerSubmit = !eventOver && currentUser && can('manageEvent') && typeDef.entries !== false && active !== 'submit'; %>
        <% if (organizerSubmit) { %>
          <%# Organizers: Submit, with Import beside it in a small menu (works after the event too). %>
          <div class="btn-group z-submit-split">
            <a href="<%= base %>/submit" class="btn btn-primary"><i class="ti ti-upload me-1"></i><%= t("Submit entries") %></a>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('More ways to add entries') %>" title="<%= t('More ways to add entries') %>"></button>
            <div class="dropdown-menu dropdown-menu-end">
              <a class="dropdown-item" href="<%= base %>/import"><i class="ti ti-file-import me-2"></i><%= t('Import entries') %><div class="small text-secondary"><%= t('From a wiki page, CSV or Fountain') %></div></a>
            </div>
          </div>
        <% } else if (!eventOver && canSubmit && !(currentUser && !(scope.eventRoles || []).length && joinable)) { %>
          <a href="<%= currentUser ? base + '/submit' : '/login' %>" class="btn btn-primary"><i class="ti ti-upload me-1"></i><%= t("Submit entries") %></a>
        <% } %>
      </div>
    </div>
    <nav class="z-evhead-tabs" aria-label="<%= t('Event') %>">
      <% tabs.forEach(([key, label, suffix, icon]) => { %>
        <a class="<%= active === key ? 'active' : '' %>" href="<%= base %><%= suffix %>"<%- active === key ? ' aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
  </div>
</header>
