<%# Everything about an event's life in one place: publish, pause, results, archive, cancel, move, delete.
    Opened from the header's "Manage" button. %>
<%
  const s = contest.status;
  const running = ['published', 'upcoming', 'active', 'submission_closed', 'under_review'].includes(s);
  const resultsOut = !!contest.resultsPublishedAt;
  // Results shown live (or by themselves after review): there is no publish step.
  let resultsRule = 'always'; try { resultsRule = ((JSON.parse(settings.participation || '{}').rules) || {}).results || 'always'; } catch (e) { resultsRule = 'always'; }
  // Always open: no publish step and no publish/hide button, whatever an old publish date says.
  const byHand = resultsRule !== 'always';
  const steps = byHand ? [['Draft', 'pencil'], ['Published', 'rocket'], ['Results published', 'trophy'], ['Archived', 'archive']] : [['Draft', 'pencil'], ['Published', 'rocket'], ['Archived', 'archive']];
  const stage = s === 'draft' ? 0 : s === 'archived' ? steps.length - 1 : byHand && resultsOut ? 2 : 1;
  const act = (action, icon, label, cls, confirm) => ({ action, icon, label, cls, confirm });
  const main = [];
  if (can('manageEvent')) {
    if (s === 'draft') main.push(act('publish', 'rocket', 'Publish', 'primary'));
    if (['published', 'upcoming'].includes(s)) main.push(act('unpublish', 'arrow-back-up', 'Back to draft', ''));
    if (running) main.push(act('pause', 'player-pause', 'Pause', ''));
    if (s === 'paused') main.push(act('resume', 'player-play', 'Resume', 'primary'));
    if (['completed', 'cancelled'].includes(s)) main.push(act('archive', 'archive', 'Archive (results final)', 'warning', t('Archive this event? Results become final, editing stops and chats are deleted.')));
    if (s === 'cancelled') main.push(act('reopen', 'refresh', 'Reopen', ''));
    if (!['cancelled', 'archived', 'draft'].includes(s)) main.push(act('cancel', 'ban', 'Cancel the event', 'ghost-danger', t('Cancel this event?')));
  }
  const canResults = byHand && can('publishResults') && typeDef.entries !== false && s !== 'archived' && s !== 'draft';
%>
<div class="modal fade" id="event-controls" tabindex="-1" aria-labelledby="event-controls-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h3 class="modal-title" id="event-controls-title"><i class="ti ti-adjustments me-2"></i><%= t('Manage the event') %></h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button></div>
      <div class="modal-body">
        <ol class="z-life">
          <% steps.forEach(([label, icon], i) => { %><li class="<%= i < stage ? 'is-done' : i === stage ? 'is-now' : '' %>"><span><i class="ti ti-<%= i < stage ? 'check' : icon %>"></i></span><b><%= t(label) %></b></li><% }) %>
        </ol>
        <% if (s === 'paused' || s === 'cancelled') { %><div class="alert alert-<%= s === 'paused' ? 'warning' : 'danger' %> py-2"><%= s === 'paused' ? t('The event is paused.') : t('The event is cancelled.') %></div><% } %>
        <% if (s === 'archived') { %><p class="text-secondary"><%= t('Archived. Results are final.') %></p><% } %>
        <div class="z-life-actions">
          <% main.forEach((a) => { %>
            <form method="post" action="<%= base %>/status" data-once<% if (a.confirm) { %> data-confirm="<%= a.confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= a.action %>"><button type="submit" class="btn<%= a.cls ? ' btn-' + a.cls : '' %>"><i class="ti ti-<%= a.icon %> me-1"></i><%= t(a.label) %></button></form>
          <% }) %>
          <% if (canResults) { %>
            <form method="post" action="<%= base %>/results/publish" data-once><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="published" value="<%= resultsOut ? 0 : 1 %>"><button type="submit" class="btn<%= resultsOut ? '' : ' btn-success' %>"><i class="ti ti-<%= resultsOut ? 'eye-off' : 'speakerphone' %> me-1"></i><%= resultsOut ? t('Hide results') : t('Publish results') %></button></form>
          <% } %>
        </div>
        <% if (can('deleteAnything')) { %>
          <details class="z-life-danger"><summary><i class="ti ti-alert-triangle me-1"></i><%= t('Move or delete') %></summary>
            <a class="btn btn-sm mt-2" href="<%= base %>/config#move"><i class="ti ti-arrows-move me-1"></i><%= t('Move into another event') %></a>
            <form method="post" action="<%= base %>/delete" class="d-flex flex-wrap align-items-end gap-2 mt-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="flex-fill"><label class="form-label small" for="ec-confirm"><%- th('Type {address} to confirm', { address: '<code>' + h(contest.slug) + '</code>' }) %></label><input class="form-control form-control-sm" id="ec-confirm" name="confirmation" autocomplete="off"></div>
              <button type="submit" class="btn btn-sm btn-danger"><i class="ti ti-trash me-1"></i><%= t('Delete event') %></button>
            </form>
          </details>
        <% } %>
      </div>
    </div>
  </div>
</div>
