<footer class="gh-footer d-print-none">
  <div class="container-xl">
    <a href="/?home=1" class="gh-footer-brand" aria-label="<%= t('Zury') %>"><%= t('Zury') %></a>
    <span>© <%= formatNumber(new Date().getFullYear()).replace(/,/g, '') %> <%= t('Zury') %></span>
    <span class="z-credit"><%- th('Made by {name}', { name: '<a href="https://meta.wikimedia.org/wiki/User:Aishik_Rehman" rel="noopener">' + 'Aishik Rehman' + '</a>' }) %></span>
    <nav aria-label="<%= t('Footer') %>">
      <a href="https://github.com/aishikrehman/Zury/issues" rel="noopener"><%= t('Report an issue') %></a>
      <a href="https://foundation.wikimedia.org/wiki/Policy:Privacy_policy" rel="noopener"><%= t('Wikimedia privacy policy') %></a>
    </nav>
    <nav class="z-foot-lang" aria-label="<%= t('Language') %>"><i class="ti ti-language"></i><% Object.values(LANGUAGES).forEach((l) => { %><a href="/preferences/language/<%= l.code %>?next=<%= encodeURIComponent(currentPath) %>" lang="<%= l.code %>"<%- l.code === lang.code ? ' aria-current="true" class="is-on"' : '' %>><%= l.native %></a><% }) %></nav>
  </div>
</footer>
