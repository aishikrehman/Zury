<%
  // Words by status: a bar that fills the row, then each part with its colour (parts with none left out).
  // locals: wb { approved, pending, rejected }
  const w = locals.wb || {};
  const all = (w.approved || 0) + (w.pending || 0) + (w.rejected || 0) || 1;
  const pc = (n) => Math.round(((n || 0) / all) * 1000) / 10;
  const parts = [['ok', w.approved, 'accepted'], ['wait', w.pending, 'pending'], ['bad', w.rejected, 'not accepted']].filter(([, n]) => n);
%><span class="z-wbar-wrap"><span class="z-wbar" aria-hidden="true"><% parts.forEach(([k, n]) => { %><i class="is-<%= k %>" style="width:<%= pc(n) %>%"></i><% }) %></span><span class="z-wbar-legend"><% parts.forEach(([k, n, label]) => { %><span class="is-<%= k %>"><b><%= formatNumber(n) %></b> <%= t(label) %></span><% }) %></span></span>
