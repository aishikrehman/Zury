  <% if (!wikiMode && can('manageEvent') && (places.length || contest.seriesId || contest.editionId)) { %>
    <form method="post" action="<%= eventBase %>/structure/move" class="card mb-3" id="structure">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-arrows-move me-2"></i><%= t('Move or copy') %></h3></div>
      <div class="card-body">
        <div class="text-secondary small mb-2"><%= t('Now at') %> <code><%= contest.path %></code></div>
        <div class="row g-2 align-items-end">
          <div class="col-12 col-md-5"><label class="form-label" for="st-target"><%= t('To') %></label>
            <select class="form-select" id="st-target" name="target">
              <option value="none"><%= t('No series (/…)') %></option>
              <% places.forEach((p) => { %><option value="<%= p.value %>"<%= (p.editionId && p.editionId === contest.editionId) || (p.seriesId && p.seriesId === contest.seriesId) ? ' selected' : '' %>><%= p.label %></option><% }) %>
            </select></div>
          <div class="col-12 col-md-3"><label class="form-label" for="st-slug"><%= t('Name there') %></label><input class="form-control" id="st-slug" name="slug" maxlength="80" placeholder="<%= contest.slug %>"></div>
          <div class="col-6 col-md-2"><button class="btn w-100" type="submit" data-confirm="<%= t('Move this event? Its address changes and the old one stops working.') %>"><i class="ti ti-arrows-move me-1"></i><%= t('Move') %></button></div>
          <div class="col-6 col-md-2"><button class="btn w-100" type="submit" formaction="<%= eventBase %>/structure/copy"><i class="ti ti-copy me-1"></i><%= t('Copy') %></button></div>
        </div>
        
      </div>
    </form>
  <% } %>


  <% const leaf = !!contest.editionId; const single = allWikis.length <= 1; const fw = (leaf || single) && allWikis.find((w) => w.fountainCode); %>
  <% const fws = allWikis.filter((w) => w.fountainCode); %>
  <% if (fws.length && can('manageEvent')) { %>
    <div class="card mt-4" id="fountain">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-droplet me-2"></i>Fountain</h3>
        <div class="card-actions d-flex gap-2">
          <a class="btn btn-sm" href="<%= eventBase %>/submissions"><i class="ti ti-list me-1"></i><%= t('Entries') %></a>
          <% if (can('importEvents') && fws.some((w) => w.fountainAuto || w.fountainTrackOnly)) { %><form method="post" action="<%= eventBase %>/fountain/unlink-all" data-confirm="<%= t('Stop following Fountain on every wiki? Entries already here stay.') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-ghost-danger" type="submit"><i class="ti ti-unlink me-1"></i><%= t('Unlink all') %></button></form><% } %>
        </div>
      </div>
      <div class="list-group list-group-flush">
        <% fws.forEach((w) => { %>
          <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
            <span class="fw-medium"><%= wikiLocal(w.wiki) %></span>
            <a href="https://fountain.toolforge.org/editathons/<%= encodeURIComponent(w.fountainCode) %>" rel="noopener" target="_blank"><%= w.fountainCode %> <i class="ti ti-external-link"></i></a>
            <span class="badge <%= w.fountainTrackOnly ? 'bg-azure-lt' : w.fountainAuto ? 'bg-green-lt' : 'bg-secondary-lt' %>"><%= w.fountainTrackOnly ? t('Tracking only') : w.fountainAuto ? t('Syncing every hour') : t('Unlinked') %></span>
            <span class="text-secondary small me-auto"><%= w.fountainSyncedAt ? t('Updated {when}', { when: formatDateTime(w.fountainSyncedAt, contest.timezone) }) : '' %></span>
            <form method="post" action="<%= eventBase %>/fountain/<%= w.id %>/sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-primary" type="submit" title="<%= t('Update now') %>"><i class="ti ti-refresh"></i></button></form>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% if (!leaf && !single && !wikiMode && (canManageWikis || can('manageEvent'))) { const wikiActions = { pending: [['approve', 'Approve', 'primary']], active: [['pause', 'Pause', 'outline-secondary'], ['remove', 'Remove', 'ghost-danger']], paused: [['resume', 'Resume', 'outline-primary'], ['remove', 'Remove', 'ghost-danger']] }; %>
    <div class="card mt-4" id="wikis">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th><%= t("Address") %></th><th><%= t("Wiki") %></th><th><%= t("Status") %></th><th>Fountain</th><th class="w-1"></th></tr></thead>
          <tbody>
            <% allWikis.forEach((w) => { %>
              <tr>
                <td><a href="<%= wikiHref(w) %>"><%= wikiHref(w) %></a></td>
                <td><%- wikiLabel(w.wiki) %></td>
                <td><span class="badge bg-<%= { active: 'green', pending: 'yellow', paused: 'secondary' }[w.status] || 'secondary' %>-lt"><%= t(w.status) %></span></td>
                <td class="text-nowrap">
                  <% if (w.fountainCode) { %>
                    <a href="https://fountain.toolforge.org/editathons/<%= encodeURIComponent(w.fountainCode) %>" rel="noopener" target="_blank"><%= w.fountainCode %></a><% if (w.fountainTrackOnly) { %> <span class="badge bg-azure-lt"><%= t('Tracked') %></span><% } %><% if (!w.fountainAuto && !w.fountainTrackOnly) { %> <span class="badge bg-secondary-lt"><%= t('Manual only') %></span><% } %>
                    <div class="text-secondary small"><%= w.fountainSyncedAt ? t('Updated {when}', { when: formatDateTime(w.fountainSyncedAt, contest.timezone) }) : '' %></div>
                  <% } else { %><span class="text-secondary">—</span><% } %>
                </td>
                <td class="text-nowrap">
                  <% if (w.fountainCode) { %><% [['sync', t('Update now'), 'outline-primary'], ...(can('importEvents') && w.fountainTrackOnly ? [['import', t('Import'), 'ghost-primary'], ['unlink', t('Remove tracking'), 'ghost-secondary']] : can('importEvents') && w.fountainAuto ? [['unlink', t('Unlink'), 'ghost-secondary']] : [])].forEach(([action, label, cls]) => { %>
                    <form method="post" action="<%= eventBase %>/fountain/<%= w.id %>/<%= action %>" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-<%= cls %>" type="submit"><%= label %></button></form>
                  <% }) %><% } %>
                  <% (wikiActions[w.status] || []).filter(([action]) => action !== 'remove' || can('deleteAnything')).forEach(([action, label, cls]) => { %>
                    <form method="post" action="<%= eventBase %>/wikis/<%= w.id %>/<%= action %>" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-<%= cls %>" type="submit"><%= label %></button>
                    </form>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <form method="post" action="<%= eventBase %>/wikis" class="row g-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Add a wiki…") %>" required></select></div>
          <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="ti ti-plus me-1"></i><%= t("Add wiki") %></button></div>
        </form>
        <% if (can('importEvents')) { %><form method="post" action="<%= eventBase %>/fountain" class="row g-2 align-items-center mt-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md"><input class="form-control" name="code" placeholder="<%= t('Fountain editathon code or address') %>" aria-label="<%= t('Fountain editathon code or address') %>" required></div>
          <div class="col-md-auto"><select class="form-select" name="mode" aria-label="<%= t('How') %>"><option value="track"><%= t('Track only: numbers from Fountain, nothing copied') %></option><option value="import"><%= t('Import: copy entries and reviews into Zury') %></option></select></div>
          <div class="col-auto"><button class="btn" type="submit"><%= t("Follow on Fountain") %></button></div>
        </form>
<% } %>
      </div>
    </div>
  <% } %>

  <% if (can('manageEvent') && !wikiMode) { %><%- include('./trackersManage', { trackers: typeof eventTrackers !== 'undefined' ? eventTrackers : [], trackAction: eventBase + '/track' }) %><% } %>
  <% if (can('manageEvent') && !wikiMode ) { %>
    <div class="card mt-4" id="data">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-database me-2"></i><%= t('Data') %></h3></div>
      <div class="row g-0">
        <div class="col-12">
          <div class="card-body">
            <div class="subheader mb-2"><%= t('Download') %></div>
            <div class="d-flex flex-wrap gap-2">
              <% [['entries', t('Entries')], ['results', t('Results')], ['people', t('People')], ['reviews', t('Reviews')]].forEach(([ds, label]) => { %>
                <%- include('./exportMenu', { dataset: ds, label, btn: '' }) %>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <% if (moveTargets.length) { %>
    <div class="card mt-4" id="move">
      <div class="card-status-start bg-warning"></div>
      <div class="card-header"><h3 class="card-title"><i class="ti ti-arrow-merge me-2"></i><%= t("Move into another event") %></h3></div>
      <div class="card-body">
        <p class="text-secondary"><%= t("This event becomes one wiki of the event you choose. Its entries, participants, sessions and tracked edits move with it, its organizers and reviewers run that wiki, and this address will lead there. You'll see what moves before confirming.") %></p>
        <form method="post" action="<%= base %>/move" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-8">
            <label class="form-label" for="moveTarget"><%= t("Event") %></label>
            <select class="form-select" id="moveTarget" name="target" required>
              <option value=""><%= t("Choose…") %></option>
              <% moveTargets.forEach((m) => { %><option value="<%= m.id %>"><%= m.title %> (<%= m.path %>)</option><% }) %>
            </select>
          </div>
          <div class="col-md-4"><button type="submit" class="btn btn-outline-warning w-100"><%= t("Continue") %></button></div>
        </form>
      </div>
    </div>
  <% } %>

