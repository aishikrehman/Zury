<%# Display and accessibility: each option applies at once, without reloading the page; the panel stays open. %>
<% const back = encodeURIComponent(currentPath); %>
<div class="zury-a11y dropup d-print-none">
  <button type="button" class="btn btn-icon" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="<%= t("Display and accessibility settings") %>">
    <i class="ti ti-accessible" style="font-size: 1.5rem"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end dropdown-menu-card z-a11y-menu">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-accessible me-2"></i><%= t("Display and accessibility") %></h3></div>
      <div class="card-body py-2 border-bottom">
        <div class="subheader mb-1"><%= t('Theme') %></div>
        <div class="btn-group w-100" role="group" aria-label="<%= t('Theme') %>">
          <% [['auto', t('Automatic'), 'device-desktop'], ['light', t('Light'), 'sun'], ['dark', t('Dark'), 'moon']].forEach(([key, label, icon]) => { %>
            <a href="/preferences/display?theme=<%= key %>&next=<%= back %>" class="btn btn-sm<%= ui.theme === key ? ' active' : '' %>" data-ui-theme="<%= key %>" aria-pressed="<%= ui.theme === key %>"><i class="ti ti-<%= icon %> me-1"></i><%= label %></a>
          <% }) %>
        </div>
      </div>
      <div class="list-group list-group-flush">
        <% Object.entries(DISPLAY_SWITCHES).forEach(([key, o]) => { %>
          <a href="/preferences/display?<%= key %>=<%= ui[key] ? 0 : 1 %>&next=<%= back %>" class="list-group-item list-group-item-action d-flex align-items-center" role="switch" aria-checked="<%= ui[key] %>" data-ui-switch="<%= key %>" data-ui-class="<%= o.cls %>">
            <i class="ti ti-<%= o.icon %> me-2"></i><%= t(o.label) %>
            <span class="form-check form-switch m-0 ms-auto"><input class="form-check-input" type="checkbox" tabindex="-1" aria-hidden="true"<%= ui[key] ? ' checked' : '' %> disabled></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</div>
