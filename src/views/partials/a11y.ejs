<% const back = encodeURIComponent(currentPath); %>
<div class="zury-a11y dropup d-print-none">
  <button type="button" class="btn btn-primary btn-icon" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="<%= t("Display and accessibility settings") %>">
    <i class="ti ti-accessible" style="font-size: 1.5rem"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end dropdown-menu-card">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t("Display") %></h3></div>
      <div class="list-group list-group-flush">
        <a href="/preferences/display?wide=<%= ui.wide ? 0 : 1 %>&next=<%= back %>" class="list-group-item list-group-item-action d-flex align-items-center" role="switch" aria-checked="<%= ui.wide %>">
          <i class="ti ti-arrows-horizontal me-2"></i><%= t("Wide pages") %>
          <span class="form-check form-switch m-0 ms-auto"><input class="form-check-input" type="checkbox" tabindex="-1" aria-hidden="true"<%= ui.wide ? ' checked' : '' %> disabled></span>
        </a>
        <a href="/preferences/display?textLarge=<%= ui.textLarge ? 0 : 1 %>&next=<%= back %>" class="list-group-item list-group-item-action d-flex align-items-center" role="switch" aria-checked="<%= ui.textLarge %>">
          <i class="ti ti-text-size me-2"></i><%= t("Larger text") %>
          <span class="form-check form-switch m-0 ms-auto"><input class="form-check-input" type="checkbox" tabindex="-1" aria-hidden="true"<%= ui.textLarge ? ' checked' : '' %> disabled></span>
        </a>
      </div>
      <div class="card-footer">
        <button type="button" class="btn w-100" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-settings" aria-controls="offcanvas-settings">
          <i class="ti ti-layout me-1"></i>Layout: <%= layout.label %>
        </button>
      </div>
    </div>
  </div>
</div>
