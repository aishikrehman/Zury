<div class="zury-a11y dropup d-print-none">
  <button type="button" class="btn btn-primary btn-icon" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Display and accessibility settings">
    <i class="ti ti-accessible" style="font-size: 1.5rem"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end dropdown-menu-card">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Display</h3></div>
      <div class="card-body">
        <label class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" data-zury-pref="wide">
          <span class="form-check-label"><i class="ti ti-arrows-horizontal me-1"></i>Wide pages</span>
        </label>
        <label class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" data-zury-pref="textLarge">
          <span class="form-check-label"><i class="ti ti-text-size me-1"></i>Larger text</span>
        </label>
      </div>
      <div class="card-footer">
        <button type="button" class="btn w-100" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-settings" aria-controls="offcanvas-settings">
          <i class="ti ti-layout me-1"></i>Layout: <%= layout.label %>
        </button>
      </div>
    </div>
  </div>
</div>
