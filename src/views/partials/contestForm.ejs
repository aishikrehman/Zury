<%#
  Shared by create and configure. Expects: form, errors, type, typeDef (null until a type is
  chosen), action, submitLabel. Vertical steps on the left, the current step on the right.
  Creating goes step by step and ends on a review; configuring opens any step directly.
%>
<%
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const v = (k) => (form[k] == null ? '' : Array.isArray(form[k]) ? form[k].join('\n') : form[k]);
  const inv = (k) => (errors[k] ? ' is-invalid' : '');
  const err = (k) => (errors[k] ? `<div class="invalid-feedback d-block">${esc(t(errors[k]))}</div>` : '');
  const on = (k) => form[k] === true || form[k] === 'on' || form[k] === 'true';
  const wikiScope = eventWikiScope(subject);
  const errorCount = Object.keys(errors).length;
  const listVal = (k) => [].concat(form[k] ?? []).flatMap((x) => String(x).split(/[\s,]+/)).filter(Boolean);
  // wikiMode: editing one wiki's part of a multi-wiki event; only overridable fields are shown.
  const wikiMode = !!locals.wikiMode;
  const marks = locals.wikiMode ? locals.overridden : new Set();
  const mark = (key) => (marks.has(key) ? `<span class="badge bg-orange-lt ms-1">${esc(t('this wiki'))}</span>` : '');
  const creating = action === '/events/create';
  // New events: the sections as tabs down the side (any can be opened); Configuration: tabs across the top.
  const pageMode = false;
  const sideTabs = creating;
  const judged = !typeDef || typeDef.entries !== false;
  const dateLabel = Object.fromEntries(DATE_FIELDS);
  const origin = 'zury.toolforge.org';
  const steps = [
    ['basics', t('Basic info'), wikiMode ? t('Description, contact and dates') : t('Type, project, name, address and dates')],
    ['rules', t('Submission rules'), t('Who can take part and what counts')],
    ...(judged ? [['judging', t('Review'), t('How entries are reviewed and results counted')]] : []),
    ['features', t('Features'), t('Turn parts of the event on or off')],
    ['access', wikiMode ? t('More details') : t('More details and access'), wikiMode ? t('Contact, images and more') : t('Contact, images, visibility, organizers and reviewers')],
  ];
  const dateInput = (key) => `
    <label class="form-label" for="${key}">${esc(dateLabel[key])}${mark('contest.' + key)}</label>
    <input type="datetime-local" class="form-control${inv(key)}" id="${key}" name="${key}" value="${esc(v(key))}">
    ${err(key)}`;
  const toggle = (key, label, section = 'settings') => `
    <label class="form-check form-switch">
      <input class="form-check-input" type="checkbox" id="${key}" name="${key}"${on(key) ? ' checked' : ''}>
      <span class="form-check-label">${esc(t(label))}${mark(section + '.' + key)}</span>
    </label>`;
%>
<% if (errorCount) { %>
  <div class="alert alert-danger" role="alert"><%= tn('Please fix the {n} highlighted field.', 'Please fix the {n} highlighted fields.', errorCount) %></div>
<% } %>

<form method="post" action="<%= action %>" novalidate<% if (creating && !can('deleteAnything')) { %> data-guard<% } %><% if (!creating && typeof contest !== 'undefined' && contest) { %> data-event-id="<%= contest.id %>"<% } %> data-wizard="<%= pageMode ? 'page' : 'tabs' %>" data-event-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (wikiMode) { %><input type="hidden" id="primaryWiki" value="<%= v('primaryWiki') %>"><% } %>
  <% if (!creating && !wikiMode) { %><input type="hidden" name="type" value="<%= type %>"><% } %>

  <div class="row g-4">
    <%# New events and Configuration share one layout: the sections as tabs across the top. %>
    <div class="col-12">
      <div class="card z-config<%= sideTabs ? ' z-side-tabs' : '' %>">
        <% if (!pageMode) { %>
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs z-config-tabs" role="tablist">
            <% steps.forEach(([key, label, hint], i) => { %>
              <li class="nav-item step-item<%= i === 0 ? ' active' : '' %>" role="presentation">
                <a href="#step-<%= key %>" class="nav-link" data-step-link="<%= i %>" title="<%= hint %>"><% if (creating) { %><span class="z-step-num"><%= formatNumber(i + 1) %></span><% } %><%= label %></a>
              </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <div class="card-body">

          <%# ── 1. Basic info: what, where, when; series and extras folded away. ── %>
          <% const openIf = (...keys) => keys.some((k) => errors[k] || v(k)) ? ' open' : ''; %>
          <section class="wizard-pane" id="step-basics" data-step="0">
            <% if (!wikiMode) { %>
              <%# First: the series and edition decide the address below. Open on a new event. %>
              <details class="z-form-group z-form-fold"<%= creating ? ' open' : openIf('seriesSlug', 'edition', 'previousEditionUrl') %>>
                <summary class="z-form-group-title"><%= t('Series') %> <span class="text-secondary fw-normal"><%= t('optional') %></span></summary>
                <div class="row g-3 mt-1">
                <div class="col-md-4">
                  <label class="form-label" for="seriesSlug"><%= t("Part of") %></label>
                  <select class="form-select<%= inv('seriesSlug') %>" id="seriesSlug" name="seriesSlug" data-picker="series" placeholder="<%= t("e.g. Wiki Loves Monuments") %>">
                    <% if (v('seriesSlug')) { %><option value="<%= v('seriesSlug') %>" selected><%= v('seriesSlug') %></option><% } %>
                  </select>
                  <%- err('seriesSlug') %>
                </div>
                <div class="col-md-2">
                  <label class="form-label" for="edition"><%= t("Edition") %></label>
                  <%# The chosen series' editions (filled in by eventForm.js); none: directly under the series. New editions are made on the series page. %>
                  <select class="form-select<%= inv('edition') %>" id="edition" name="edition" data-current="<%= v('edition') %>" data-none-label="<%= t('Directly under the series') %>">
                    <option value=""><%= t('Directly under the series') %></option>
                    <% if (v('edition')) { %><option value="<%= v('edition') %>" selected><%= v('edition') %></option><% } %>
                  </select>
                  <%- err('edition') %>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="previousEditionUrl"><%= t("Previous edition") %></label>
                  <input class="form-control<%= inv('previousEditionUrl') %>" id="previousEditionUrl" name="previousEditionUrl" value="<%= v('previousEditionUrl') %>" placeholder="<%= t("https://…") %>">
                  <%- err('previousEditionUrl') %>
                </div>
                </div>
              </details>
            <% } %>
            <% if (!wikiMode) { %>
              <div class="z-form-group">
                <h3 class="z-form-group-title"><%= t('What') %></h3>
                <div class="row g-3">
                <% if (creating && typeDef) { %>
                  <div class="col-md-4">
                    <span class="form-label"><%= t("Type of event") %></span>
                    <input type="hidden" name="type" value="<%= type %>">
                    <div class="d-flex align-items-center gap-2"><strong><%= t(typeDef.label) %></strong><a class="small" href="/events/create<%= form.seriesSlug ? `?series=${encodeURIComponent(form.seriesSlug)}${form.edition ? `&edition=${encodeURIComponent(form.edition)}` : ''}` : '' %>"><%= t('Change') %></a></div>
                    <div class="form-hint"><%= t(typeDef.description) %></div>
                  </div>
                <% } else { %>
                <div class="col-md-4">
                  <label class="form-label required" for="type"><%= t("Type of event") %></label>
                  <select class="form-select<%= inv('type') %>" id="type" <%- creating || (typeof contest !== 'undefined' && contest && contest.status === 'draft' && !wikiMode) ? 'name="type" required' : 'disabled' %> data-type-select>
                    <option value=""<%= type ? '' : ' selected' %>><%= t("Choose…") %></option>
                    <% Object.entries(EVENT_TYPES).forEach(([key, td]) => { %>
                      <option value="<%= key %>"<%= type === key ? ' selected' : '' %> data-defaults="<%= JSON.stringify(FEATURE_DEFAULTS[key]) %>" data-namespaces="<%= td.defaultNamespaces.join(', ') %>" data-description="<%= td.description %>" data-guide-rules="<%= (td.guide || {}).rules || '' %>" data-guide-judging="<%= (td.guide || {}).judging || '' %>"><%= td.label %></option>
                    <% }) %>
                  </select>
                  <div class="form-hint" data-type-description><%= typeDef ? typeDef.description : '' %></div>
                  <%- err('type') %>
                </div>
                <% } %>
                  <div class="col-md-8">
                    <label class="form-label required" for="title"><%= t("Title") %></label>
                    <input class="form-control<%= inv('title') %>" id="title" name="title" maxlength="200" minlength="3" required value="<%= v('title') %>" placeholder="<%= t("e.g. Wiki Loves Monuments 2026 in Bangladesh") %>">
                    <%- err('title') %>
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="slug"><%= t("Address") %></label>
                    <div class="input-group">
                      <span class="input-group-text" data-address-prefix data-origin="<%= origin %>"><%= origin %>/</span>
                      <input class="form-control<%= inv('slug') %>" id="slug" name="slug" maxlength="80" value="<%= v('slug') %>" placeholder="<%= t("made-from-the-title") %>" data-slug>
                    </div>
                    <div class="form-hint" data-address-hint><%= t("Made from the title; you can change it.") %></div>
                    <div data-address-status aria-live="polite"></div>
                    <%- err('slug') %>
                  </div>
                </div>
              </div>
            <% } %>
            <div class="z-form-group<%= wikiMode ? '' : ' pt-0 border-0' %>">
              <% if (wikiMode) { %><h3 class="z-form-group-title"><%= t('What') %></h3><% } %>
              <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="description"><%= t("Description") %><%- mark('contest.description') %></label>
                <textarea class="form-control<%= inv('description') %>" id="description" name="description" rows="5" maxlength="5000"><%= v('description') %></textarea>
                <%- err('description') %>
              </div>
              </div>
            </div>
            <% if (!wikiMode) { %>
              <div class="z-form-group">
                <h3 class="z-form-group-title"><%= t('Where') %></h3>
                <div class="row g-3">
                <div class="col-md-8">
                  <select class="form-select<%= inv('primaryWiki') %>" id="primaryWiki" name="primaryWiki" data-picker="wiki" required
                    data-language-label="<%= t('Project language') %>" data-site-label="<%= t('Project site') %>">
                    <% if (v('primaryWiki')) { %><option value="<%= v('primaryWiki') %>" selected><%= wikiText(v('primaryWiki')) %></option><% } %>
                  </select>
                  <input type="hidden" name="language" id="language" value="<%= v('language') %>">
                  <% if (wikiScope) { %>
                    <div class="form-hint">You can use: <%= wikiScope.length ? wikiScope.map(wikiLocal).join(', ') : 'none' %><%= form.primaryWiki && !wikiScope.includes(form.primaryWiki) ? ' (or keep the current one)' : '' %>.</div>
                  <% } %>
                  <%- err('primaryWiki') %><%- err('language') %>
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="category"><%= t("Project category") %></label>
                  <select class="form-select" id="category" name="category">
                    <option value=""><%= t("Choose…") %></option>
                    <% Object.entries(PROJECT_CATEGORIES).forEach(([key, label]) => { %><option value="<%= key %>"<%= v('category') === key ? ' selected' : '' %>><%= label %></option><% }) %>
                  </select>
                </div>
                </div>
              </div>
            <% } %>
            <div class="z-form-group">
              <h3 class="z-form-group-title"><%= t('When') %></h3>
              <div class="row g-3">
              <div class="col-md-4"><%- dateInput('startDate') %></div>
              <div class="col-md-4"><%- dateInput('endDate') %></div>
              <div class="col-md-4">
                <label class="form-label required" for="timezone"><%= t('Time zone') %><%- mark('contest.timezone') %></label>
                <select class="form-select<%= inv('timezone') %>" id="timezone" name="timezone" required>
                  <option value=""<%= v('timezone') ? '' : ' selected' %>><%= t("Choose…") %></option>
                  <% TIMEZONES.forEach((tz) => { %><option value="<%= tz %>"<%= v('timezone') === tz ? ' selected' : '' %>><%= tz %></option><% }) %>
                </select>
                <%- err('timezone') %>
              </div>
              </div>
            </div>
          </section>

          <%# ── 2. Submission rules ───────────────────────────────────── %>
          <section class="wizard-pane<%= pageMode ? '' : ' d-none' %>" id="step-rules" data-step="1">
            <h3 class="mb-2"><%= t("Submission rules") %></h3>
            <p class="text-secondary mb-4" data-guide="rules"><%= typeDef && typeDef.guide ? typeDef.guide.rules : '' %></p>
            <div class="row g-3 mb-4">
              <% ['registrationOpensAt', 'registrationClosesAt', 'submissionOpensAt', 'submissionDeadline'].forEach((key) => { %>
                <div class="col-sm-6 col-lg-3"><%- dateInput(key) %></div>
              <% }) %>
            </div>
            <h4 class="mb-3"><%= t("Who can take part") %></h4>
            <div class="row g-3 mb-4">
              <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="participationMode"><%= t("Participants") %><%- mark('settings.participationMode') %></label>
                <select class="form-select" id="participationMode" name="participationMode">
                  <% Object.entries(PARTICIPATION_MODES).forEach(([key, label]) => { %><option value="<%= key %>"<%= v('participationMode') === key ? ' selected' : '' %>><%= label %></option><% }) %>
                </select>
              </div>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="minAccountAgeDays"><%= t('Account age (days)') %><%- mark('settings.minAccountAgeDays') %></label>
                <input type="number" min="0" class="form-control<%= inv('minAccountAgeDays') %>" id="minAccountAgeDays" name="minAccountAgeDays" value="<%= v('minAccountAgeDays') %>" placeholder="0">
                <%- err('minAccountAgeDays') %>
              </div>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="minEditCount"><%= t('Global edits') %><%- mark('settings.minEditCount') %></label>
                <input type="number" min="0" class="form-control<%= inv('minEditCount') %>" id="minEditCount" name="minEditCount" value="<%= v('minEditCount') %>" placeholder="0">
                <%- err('minEditCount') %>
              </div>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="participantLimit"><%= t('Participant limit') %><%- mark('settings.participantLimit') %></label>
                <input type="number" min="1" class="form-control<%= inv('participantLimit') %>" id="participantLimit" name="participantLimit" value="<%= v('participantLimit') %>" placeholder="<%= t("No limit") %>">
                <%- err('participantLimit') %>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="wordCountMethod"><%= t('Word count') %><%- mark('settings.wordCountMethod') %></label>
                <select class="form-select" id="wordCountMethod" name="wordCountMethod">
                  <% [['auto', 'Auto: the ztools rule on Bengali wikis'], ['ztools', 'ztools rule (Bengali words in the wikitext)'], ['plain', 'Plain count (all words in the text)']].forEach(([key, label]) => { %><option value="<%= key %>"<%= (v('wordCountMethod') || 'auto') === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
                </select>
                <div class="form-hint"><%= t('Same counting as ztools, so both tools give the same numbers.') %></div>
              </div>
              <div class="col-md-6">
                <%- toggle('registrationRequired', 'Participants must register before submitting') %>
              </div>
            </div>

            <h4 class="mb-3"><%= t("What counts") %></h4>
            <div class="row g-3 mb-4">
              <div class="col-lg-6">
                <label class="form-label" for="eligibleNamespaces"><%= t("Namespaces") %><%- mark('settings.eligibleNamespaces') %></label>
                <select class="form-select<%= inv('eligibleNamespaces') %>" id="eligibleNamespaces" name="eligibleNamespaces" multiple data-picker="namespace" data-wiki-source="primaryWiki" placeholder="Default: <%= typeDef ? typeDef.defaultNamespaces.join(', ') : '—' %>">
                  <% listVal('eligibleNamespaces').forEach((n) => { %><option value="<%= n %>" selected><%= n %></option><% }) %>
                </select>
                <%- err('eligibleNamespaces') %>
              </div>
            </div>
            <% Object.entries(EVENT_TYPES).filter(([, td]) => td.fields.length).forEach(([key, td]) => { const current = key === type; %>
              <fieldset class="row g-3 mb-4<%= current ? '' : ' d-none' %>" data-type-fields="<%= key %>"<%= current ? '' : ' disabled' %>>
                <% td.fields.forEach((f) => { const name = 'type_' + f.key; const val = current ? form[name] : f.default; const isOn = val === true || val === 'on' || val === 'true'; %>
                  <div class="<%= f.type === 'list' ? 'col-md-6' : 'col-sm-6 col-lg-4' %>">
                    <% if (f.type === 'bool') { %>
                      <label class="form-check form-switch mt-md-4">
                        <input class="form-check-input" type="checkbox" name="<%= name %>"<%= isOn ? ' checked' : '' %>>
                        <span class="form-check-label"><%= f.label %><%- mark('type.' + f.key) %></span>
                      </label>
                    <% } else if (f.type === 'choices') { const selected = [].concat(val || []); %>
                      <span class="form-label d-block"><%= f.label %><%- mark('type.' + f.key) %></span>
                      <div class="form-selectgroup">
                        <% Object.entries(f.choices).forEach(([ck, cl]) => { %>
                          <label class="form-selectgroup-item">
                            <input type="checkbox" class="form-selectgroup-input" name="<%= name %>" value="<%= ck %>"<%= selected.includes(ck) ? ' checked' : '' %>>
                            <span class="form-selectgroup-label"><%= cl %></span>
                          </label>
                        <% }) %>
                      </div>
                    <% } else { const shown = Array.isArray(val) ? val.join('\n') : (val ?? ''); %>
                      <label class="form-label"><%= f.label %><%- mark('type.' + f.key) %></label>
                      <% if (f.type === 'list') { %>
                        <textarea class="form-control<%= current ? inv(name) : '' %>" name="<%= name %>" rows="3" placeholder="<%= t("One per line") %>"><%= shown %></textarea>
                      <% } else { %>
                        <input class="form-control<%= current ? inv(name) : '' %>" name="<%= name %>" <%= f.type === 'int' ? `type=number min=${f.min} max=${f.max}` : '' %> value="<%= shown %>">
                      <% } %>
                    <% } %>
                    <% if (f.help) { %><div class="form-hint"><%= f.help %></div><% } %>
                    <% if (current) { %><%- err(name) %><% } %>
                  </div>
                <% }) %>
              </fieldset>
            <% }) %>

            <h4 class="mb-3"><%= t("Tracking") %></h4>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="trackHashtags">Hashtags<%- mark('settings.trackHashtags') %></label>
                <input class="form-control<%= inv('trackHashtags') %>" id="trackHashtags" name="trackHashtags" value="<%= v('trackHashtags') %>" placeholder="<%= t("wam2026, asianmonth") %>">
                <div class="form-hint"><%= t("Edits with these hashtags in the summary are counted.") %></div>
                <%- err('trackHashtags') %>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="trackCategories">Categories<%- mark('settings.trackCategories') %></label>
                <textarea class="form-control<%= inv('trackCategories') %>" id="trackCategories" name="trackCategories" rows="2" placeholder="<%= t("One per line") %>"><%= v('trackCategories') %></textarea>
                <div class="form-hint"><%= t("Pages and files added to these categories during the event are counted.") %></div>
                <%- err('trackCategories') %>
              </div>
            </div>
          </section>

          <%# ── 3. Interaction and judging ────────────────────────────── %>
          <% if (judged) { %>
          <section class="wizard-pane<%= pageMode ? '' : ' d-none' %>" id="step-judging" data-step="2">
            <h3 class="mb-2"><%= t("Interaction and judging") %></h3>
            <p class="text-secondary mb-4" data-guide="judging"><%= typeDef && typeDef.guide ? typeDef.guide.judging : '' %></p>
            <div class="row g-3 mb-4">
              <% ['reviewOpensAt', 'reviewDeadline', 'appealDeadline', 'resultsAnnouncedAt'].forEach((key) => { %>
                <div class="col-sm-6 col-lg-3"><%- dateInput(key) %></div>
              <% }) %>
            </div>
            <%# Review: one row per setting, its name and a dropdown (or a switch) beside it. %>
            <%
              const row = (id, label, control, hint = '') => `
                <div class="z-set-row">
                  <label class="z-set-label" for="${id}">${esc(t(label))}${hint ? `<span class="z-set-hint">${esc(t(hint))}</span>` : ''}</label>
                  <div class="z-set-control">${control}</div>
                </div>`;
              const select = (name, options, current, extra = '') => `<select class="form-select" id="${name}" name="${name}"${extra}>${options.map(([k, l]) => `<option value="${k}"${current === k ? ' selected' : ''}>${esc(t(l))}</option>`).join('')}</select>`;
              const who = Array.isArray(v('reviewers')) ? v('reviewers') : ['jury'];
            %>
            <div class="z-set-list mb-4">
              <%- row('rankBy', 'What the results count', select('rankBy', [['articles', 'Number of articles'], ['words', 'Word count'], ['points', 'Points (scores or marks added up)']], v('rankBy') || 'articles')) %>
              <%- row('reviewMethod', 'How reviewers judge', select('reviewMethod', [['yesno', 'Yes or no (1 or 0)'], ['stars', 'Stars (1–5)'], ['number', 'A number'], ['marks', 'Custom marks']], v('reviewMethod') || 'yesno', ' data-show-source')) %>
              <div class="z-set-row" data-show-when="reviewMethod:number">
                <span class="z-set-label"><%= t('Score range') %><span class="z-set-hint"><%= t('Leave both empty for any number.') %></span></span>
                <div class="z-set-control d-flex gap-2">
                  <input type="number" step="any" class="form-control" id="scoreMin" name="scoreMin" value="<%= v('scoreMin') %>" placeholder="<%= t('Lowest') %>" aria-label="<%= t('Lowest score') %>">
                  <input type="number" step="any" class="form-control<%= inv('scoreMax') %>" id="scoreMax" name="scoreMax" value="<%= v('scoreMax') %>" placeholder="<%= t('Highest') %>" aria-label="<%= t('Highest score') %>">
                </div>
              </div>
              <% if (errors.scoreMax) { %><%- err('scoreMax') %><% } %>
              <div class="z-set-row z-set-wide" data-show-when="reviewMethod:marks">
                <span class="z-set-label"><%= t("Marks") %><span class="z-set-hint"><%= t("What the reviewers give each entry, and the points each value is worth.") %></span></span>
                <div class="z-set-control">
                <div data-marks-editor>
                  <input type="hidden" name="marks" value="<%= v('marks') || '[]' %>" data-marks-input>
                  <div data-marks-rows></div>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-sm" data-marks-add><i class="ti ti-plus me-1"></i><%= t("Add a mark") %></button>
                    <button type="button" class="btn btn-sm btn-ghost-primary" data-marks-preset="accept"><%= t("Accepted or not") %></button>
                    <button type="button" class="btn btn-sm btn-ghost-primary" data-marks-preset="quality"><%= t("Quality 0–3") %></button>
                  </div>
                  <%- err('marks') %>
                </div>
                </div>
              </div>
              <%# Who reviews: any of the three, ticked side by side. %>
              <div class="z-set-row z-set-inline">
                <span class="z-set-label"><%= t('Who reviews') %><%- mark('settings.reviewers') %></span>
                <div class="z-set-control">
                  <% [['jury', 'The reviewers you add'], ['localAdmins', 'Local admins of the wiki'], ['participants', 'Any participant']].forEach(([key, label]) => { %>
                    <label class="form-check form-check-inline m-0"><input class="form-check-input" type="checkbox" name="reviewers" value="<%= key %>"<%= who.includes(key) ? ' checked' : '' %>><span class="form-check-label"><%= t(label) %></span></label>
                  <% }) %>
                </div>
              </div>
              <%- row('reviewAssignment', 'Who reviews which entry', select('reviewAssignment', [['open', 'Anyone who reviews (common queue)'], ['assigned', 'Assigned by hand'], ['equal', 'Shared out equally, automatically'], ['fixed', 'A set number each, automatically']], v('reviewAssignment') || 'open', ' data-show-source'), 'Nobody is given their own entry.') %>
              <div class="z-set-row" data-show-when="reviewAssignment:fixed">
                <label class="z-set-label" for="assignPerJuror"><%= t('Entries per reviewer') %></label>
                <div class="z-set-control"><input type="number" min="1" class="form-control<%= inv('assignPerJuror') %>" id="assignPerJuror" name="assignPerJuror" value="<%= v('assignPerJuror') %>"><%- err('assignPerJuror') %></div>
              </div>
              <div class="z-set-row">
                <label class="z-set-label" for="requiredReviews"><%= t('Reviews needed per entry') %><%- mark('settings.requiredReviews') %><span class="z-set-hint"><%= t('Its score is the average of the reviews.') %></span></label>
                <div class="z-set-control"><input type="number" min="1" max="20" class="form-control<%= inv('requiredReviews') %>" id="requiredReviews" name="requiredReviews" value="<%= v('requiredReviews') || 1 %>"><%- err('requiredReviews') %></div>
              </div>
              <div class="z-set-row" data-show-when="reviewMethod:yesno,marks">
                <label class="z-set-label" for="decisionRule"><%= t('How reviews decide') %><%- mark('settings.decisionRule') %></label>
                <div class="z-set-control">
                  <select class="form-select" id="decisionRule" name="decisionRule" data-decision-rule>
                    <% [['majority', 'Majority of the reviews'], ['unanimous', 'Every reviewer must accept'], ['any', 'One accept is enough'], ['veto', 'One reject is enough to reject'], ['first', 'The first review decides (like Fountain)'], ['score', 'An average score of at least the pass mark']].forEach(([key, label]) => { %><option value="<%= key %>"<%= (v('decisionRule') || 'majority') === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
                  </select>
                </div>
              </div>
              <div class="z-set-row" data-show-for="majority">
                <label class="z-set-label" for="tieBreak"><%= t('On a tie') %></label>
                <div class="z-set-control"><select class="form-select" id="tieBreak" name="tieBreak"><% [['reject', 'Reject'], ['accept', 'Accept'], ['wait', 'Wait for one more review']].forEach(([key, label]) => { %><option value="<%= key %>"<%= (v('tieBreak') || 'reject') === key ? ' selected' : '' %>><%= t(label) %></option><% }) %></select></div>
              </div>
              <div class="z-set-row" data-show-for="score" data-show-when="reviewMethod:stars,number">
                <label class="z-set-label" for="passScore"><%= t('Pass mark (average points)') %><span class="z-set-hint"><%= t('An entry whose average reaches it is accepted.') %></span></label>
                <div class="z-set-control"><input type="number" min="0" step="0.5" class="form-control" id="passScore" name="passScore" value="<%= v('passScore') || 0 %>"></div>
              </div>
              <% [['allowJuryParticipation', 'Reviewers may also take part'], ['allowOrganizerParticipation', 'Organizers may also take part'], ['selfReview', 'Reviewers may review their own entries'], ['bulkReviewEnabled', 'Bulk review: decide many entries at once'], ['juryStatsEnabled', 'Reviewer statistics for everyone (else only for organizers)']].forEach(([key, label]) => { %>
                <div class="z-set-row">
                  <label class="z-set-label" for="<%= key %>"><%= t(label) %><%- mark('settings.' + key) %></label>
                  <div class="z-set-control"><label class="form-check form-switch m-0"><input class="form-check-input" type="checkbox" id="<%= key %>" name="<%= key %>"<%= on(key) ? ' checked' : '' %>></label></div>
                </div>
              <% }) %>
              <div class="z-set-row">
                <label class="z-set-label" for="secretBallot"><%= t("Secret ballot: reviewers do not see each other's reviews until the entry is decided") %></label>
                <div class="z-set-control"><label class="form-check form-switch m-0"><input class="form-check-input" type="checkbox" id="secretBallot" name="secretBallot"<%= v('secretBallot') ? ' checked' : '' %>></label></div>
              </div>
            </div>

          </section>
          <% } %>

          <%# ── Features: the event's on/off switches (every type). ── %>
          <section class="wizard-pane<%= pageMode ? '' : ' d-none' %>" id="step-features" data-step="<%= steps.findIndex(([k]) => k === 'features') %>">
            <h3 class="mb-1"><%= t("Features") %></h3>
            <p class="text-secondary mb-3"><%= t("Turn parts of the event on or off.") %></p>
            <div class="z-set-grid">
              <% FEATURE_FIELDS.forEach(([key, label, help]) => { %>
                <div class="z-set-row">
                  <label class="z-set-label" for="<%= key %>"><%= label %><%- mark('settings.' + key) %><span class="z-set-hint"><%= help %></span></label>
                  <div class="z-set-control"><label class="form-check form-switch m-0"><input class="form-check-input" type="checkbox" id="<%= key %>" name="<%= key %>"<%= on(key) ? ' checked' : '' %>></label></div>
                </div>
              <% }) %>
            </div>
          </section>

          <%# ── 4. User access levels ─────────────────────────────────── %>
          <section class="wizard-pane<%= pageMode ? '' : ' d-none' %>" id="step-access" data-step="<%= steps.findIndex(([k]) => k === 'access') %>">
            <div class="z-form-group">
              <h3 class="z-form-group-title"><%= t('More details') %> <span class="text-secondary fw-normal small"><%= t('optional') %></span></h3>
              <div class="row g-3 mt-1">
              <% if (!wikiMode) { %>
                <div class="col-md-6">
                  <label class="form-label" for="organizingCommunity"><%= t("Organizing community") %></label>
                  <select class="form-select<%= inv('organizingCommunity') %>" id="organizingCommunity" name="organizingCommunity" data-picker="community" placeholder="<%= t("Choose or type a name…") %>">
                    <% if (v('organizingCommunity')) { %><option value="<%= v('organizingCommunity') %>" selected><%= v('organizingCommunity') %></option><% } %>
                  </select>
                  <%- err('organizingCommunity') %>
                </div>
              <% } %>
              <div class="col-md-6">
                <label class="form-label" for="contactInfo"><%= t("Contact") %><%- mark('contest.contactInfo') %></label>
                <input class="form-control<%= inv('contactInfo') %>" id="contactInfo" name="contactInfo" maxlength="500" value="<%= v('contactInfo') %>" placeholder="<%= t("Talk page, email list or similar") %>">
                <%- err('contactInfo') %>
              </div>
<% if (!wikiMode) { %>
                <div class="col-md-6">
                  <label class="form-label" for="mainCategory"><%= t("Main category") %></label>
                  <div class="input-group">
                    <span class="input-group-text"><%= t("Category:") %></span>
                    <input class="form-control<%= inv('mainCategory') %>" id="mainCategory" name="mainCategory" maxlength="200" value="<%= v('mainCategory') %>" placeholder="<%= t("Wiki Loves Monuments 2026 in Bangladesh") %>">
                  </div>
                  <%- err('mainCategory') %>
                </div>
<% } %>
              <% if (!wikiMode) { %>
                <div class="col-md-6">
                  <label class="form-label" for="logoUrl"><%= t("Logo") %></label>
                  <input class="form-control<%= inv('logoUrl') %>" id="logoUrl" name="logoUrl" value="<%= v('logoUrl') %>" placeholder="<%= t("https://upload.wikimedia.org/…") %>">
                  <%- err('logoUrl') %>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="bannerUrl"><%= t("Banner") %></label>
                  <input class="form-control<%= inv('bannerUrl') %>" id="bannerUrl" name="bannerUrl" value="<%= v('bannerUrl') %>" placeholder="<%= t("https://upload.wikimedia.org/…") %>">
                  <%- err('bannerUrl') %>
                </div>
              <% } %>
              </div>
            </div>
          <% if (!wikiMode) { %>
              <h3 class="z-form-group-title mt-3"><%= t("User access levels") %></h3>
              <div class="row g-3">
                <div class="col-12">
                  <span class="form-label d-block"><%= t("Who can see the event") %></span>
                  <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column flex-md-row gap-2">
                    <label class="form-selectgroup-item flex-fill">
                      <input type="radio" name="visibility" value="public" class="form-selectgroup-input"<%= v('visibility') !== 'private' ? ' checked' : '' %>>
                      <span class="form-selectgroup-label d-flex align-items-center p-3">
                        <span class="me-3"><span class="form-selectgroup-check"></span></span>
                        <span><strong><%= t("Public") %></strong><span class="d-block text-secondary"><%= t("Anyone can see it once published.") %></span></span>
                      </span>
                    </label>
                    <label class="form-selectgroup-item flex-fill">
                      <input type="radio" name="visibility" value="private" class="form-selectgroup-input"<%= v('visibility') === 'private' ? ' checked' : '' %>>
                      <span class="form-selectgroup-label d-flex align-items-center p-3">
                        <span class="me-3"><span class="form-selectgroup-check"></span></span>
                        <span><strong><%= t("Members only") %></strong><span class="d-block text-secondary"><%= t("Only people with a role in the event.") %></span></span>
                      </span>
                    </label>
                  </div>
                </div>
                <div class="col-12"><%- toggle('anonymousParticipants', 'Hide participant names from the public') %></div>
                <% if (creating) { %>
                  <div class="col-md-6">
                    <label class="form-label" for="organizers"><%= t("Co-organizers") %></label>
                    <select class="form-select" id="organizers" name="organizers" multiple data-picker="user" placeholder="<%= t("Search Wikimedia users…") %>">
                      <% [].concat(form.organizers || []).filter(Boolean).forEach((u) => { %><option value="<%= u %>" selected><%= u %></option><% }) %>
                    </select>
                    <div class="form-hint"><%= t("You are an organizer already.") %></div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label" for="jury"><%= t("Reviewers") %></label>
                    <select class="form-select" id="jury" name="jury" multiple data-picker="user" placeholder="<%= t("Search Wikimedia users…") %>">
                      <% [].concat(form.jury || []).filter(Boolean).forEach((u) => { %><option value="<%= u %>" selected><%= u %></option><% }) %>
                    </select>
                  </div>
                <% } else { %>
                  <div class="col-12"><a class="btn btn-outline-primary" href="<%= base %>/participants"><i class="ti ti-users me-1"></i><%= t("Manage organizers, reviewers and participants") %></a></div>
                <% } %>
              </div>
          <% } %>
          </section>

        </div>

        <div class="card-footer d-flex align-items-center">
          <% if (creating) { %>
            <span class="text-secondary small me-auto"><%= t('It is made as a draft: nothing is public until you publish it.') %></span>
            <button type="submit" class="btn btn-primary btn-lg"><i class="ti ti-check me-1"></i><%= t(submitLabel) %></button>
          <% } else { %>
            <button type="submit" class="btn btn-primary ms-auto"><i class="ti ti-device-floppy me-1"></i><%= t(submitLabel) %></button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</form>
