<div class="empty">
  <div class="empty-img"><img class="z-empty-art" src="/images/art/<%= typeof art !== 'undefined' && art === 'contest' ? 'world' : 'people' %>.webp" width="128" height="128" alt="" loading="lazy" decoding="async"></div>
  <p class="empty-title"><%= title %></p>
  <% if (typeof text !== 'undefined' && text) { %><p class="empty-subtitle text-secondary"><%= text %></p><% } %>
  <% if (typeof action !== 'undefined' && action) { %><div class="empty-action"><%- action %></div><% } %>
</div>
