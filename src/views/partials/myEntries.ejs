<% const needs = my.entries.filter((e) => ['rejected', 'disqualified', 'appealed'].includes(e.status) || (e.comments && e.comments.length)); %>
<% if (needs.length) { %>
<% const groupBadge = { accepted: ['green', t('Accepted')], pending: ['yellow', t('Pending')], rejected: ['red', t('Not accepted')] }; %>
<div class="card mb-3 z-my-needs">
  <div class="card-header">
    <div><h3 class="card-title"><i class="ti ti-message-exclamation me-2"></i><%= t('My entries') %></h3><div class="text-secondary small"><%= t('Not accepted, with feedback or appealed') %></div></div>
    <div class="card-actions"><a class="small" href="<%= base %>/user/<%= nameInPath(currentUser.username) %>"><i class="ti ti-user me-1"></i><%= t('My page') %></a></div>
  </div>
  <div class="list-group list-group-flush">
    <% needs.slice(0, 50).forEach((e) => { const st = SUBMISSION_STATUSES[e.status] || { label: e.status, color: 'secondary' }; %>
      <div class="list-group-item">
        <div class="d-flex align-items-center gap-2">
          <a class="fw-medium text-truncate" href="<%= entryUrl(e) %>" target="_blank" rel="noopener"><%= e.title %></a>
          <% if (e.wordCount && settings.wordCountEnabled) { %><span class="text-secondary small text-nowrap"><%= t('{n} words', { n: formatNumber(e.wordCount) }) %></span><% } %>
          <span class="badge bg-<%= st.color %>-lt ms-auto"><%= t(st.label) %></span>
        </div>
        <% e.comments.forEach((c) => { %><div class="z-review-note small mt-1"><i class="ti ti-message-2 me-1 text-secondary"></i><%= c %></div><% }) %>
      </div>
    <% }) %>
  </div>
</div>
<% } %>
