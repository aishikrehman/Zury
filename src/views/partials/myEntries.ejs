<% const groupBadge = { accepted: ['green', t('Accepted')], pending: ['yellow', t('Pending')], rejected: ['red', t('Not accepted')] }; %>
<div class="card mb-3">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-user-check me-2"></i><%= t('My entries') %></h3>
    <div class="card-actions d-flex gap-2">
      <% ['accepted', 'pending', 'rejected'].forEach((g) => { %><span class="badge bg-<%= groupBadge[g][0] %>-lt"><%= groupBadge[g][1] %> <%= formatNumber(my.counts[g]) %></span><% }) %>
    </div>
  </div>
  <div class="list-group list-group-flush">
    <% my.entries.slice(0, 50).forEach((e) => { const st = SUBMISSION_STATUSES[e.status] || { label: e.status, color: 'secondary' }; %>
      <div class="list-group-item">
        <div class="d-flex align-items-center gap-2">
          <a class="fw-medium text-truncate" href="<%= entryUrl(e) %>" target="_blank" rel="noopener"><%= e.title %></a>
          <% if (e.wordCount && settings.wordCountEnabled) { %><span class="text-secondary small text-nowrap"><%= t('{n} words', { n: formatNumber(e.wordCount) }) %></span><% } %>
          <span class="badge bg-<%= st.color %>-lt ms-auto"><%= t(st.label) %></span>
        </div>
        <% e.comments.forEach((c) => { %><div class="z-review-note small mt-1"><i class="ti ti-message-2 me-1 text-secondary"></i><%= c %></div><% }) %>
      </div>
    <% }) %>
  </div>
</div>
