<%# Layout picker, modelled on Tabler's theme-settings offcanvas. %>
<% const groups = [
  ['Top navbar', ['horizontal', 'condensed', 'navbar-floating', 'navbar-sticky', 'navbar-dark', 'fluid']],
  ['Sidebar', ['vertical', 'vertical-right', 'vertical-floating', 'vertical-transparent', 'fluid-vertical', 'folded', 'folded-hover']],
  ['Direction', ['rtl']],
]; %>
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvas-settings" aria-labelledby="offcanvas-settings-title">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title" id="offcanvas-settings-title"><%= t("Layout") %></h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<%= t("Close") %>"></button>
  </div>
  <div class="offcanvas-body">
    <% groups.forEach(([title, keys]) => { %>
      <div class="mb-4">
        <label class="form-label"><%= title %></label>
        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
          <% keys.forEach((key) => { const selected = key === layoutKey; %>
            <a href="/layout/<%= key %>?next=<%= encodeURIComponent(currentPath === '/' ? '/dashboard' : currentPath) %>" class="form-selectgroup-item flex-fill text-decoration-none">
              <span class="form-selectgroup-label d-flex align-items-center p-3<%= selected ? ' border-primary' : '' %>">
                <span class="me-3"><span class="form-selectgroup-check<%= selected ? ' bg-primary border-primary' : '' %>"></span></span>
                <span class="form-selectgroup-label-content"><span class="font-weight-medium"><%= LAYOUTS[key].label %></span></span>
                <% if (selected) { %><span class="badge bg-primary-lt ms-auto"><%= t("Current") %></span><% } %>
              </span>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
  <div class="offcanvas-footer border-top p-3">
    <a href="/layout/horizontal?next=<%= encodeURIComponent(currentPath === '/' ? '/dashboard' : currentPath) %>" class="btn w-100"><i class="ti ti-rotate me-1"></i><%= t("Reset to default") %></a>
  </div>
</div>
