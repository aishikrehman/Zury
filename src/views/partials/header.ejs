<header class="z-topbar d-print-none">
  <div class="container-xl z-topbar-inner">
    <button class="z-icon-btn z-menu-btn" type="button" data-bs-toggle="collapse" data-bs-target="#z-navbar" aria-controls="z-navbar" aria-expanded="false" aria-label="<%= t('Toggle primary navigation') %>">
      <i class="ti ti-menu-2"></i>
    </button>
    <a href="<%= currentUser ? '/dashboard' : '/' %>" class="z-brand" aria-label="<%= t('Zury') %>">
      <span><%= t('Zury') %></span>
    </a>

    <form action="/events" method="get" role="search" class="z-search">
      <i class="ti ti-search"></i>
      <input type="search" name="q" placeholder="<%= t('Search events…') %>" aria-label="<%= t('Search events') %>" data-hotkey="/">
      <kbd>/</kbd>
    </form>

    <div class="z-topbar-end">
      <div class="dropdown">
        <button class="z-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('Language') %>" title="<%= t('Language') %>">
          <i class="ti ti-language"></i><span class="z-lang-code"><%= lang.code.toUpperCase() %></span>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <% Object.values(LANGUAGES).forEach((l) => { %>
            <a href="/preferences/language/<%= l.code %>?next=<%= encodeURIComponent(currentPath) %>" class="dropdown-item d-flex<%= l.code === lang.code ? ' active' : '' %>" lang="<%= l.code %>">
              <%= l.native %><% if (l.native !== l.name) { %><span class="text-secondary ms-auto ps-3 small"><%= l.name %></span><% } %>
            </a>
          <% }) %>
        </div>
      </div>

      <% if (currentUser) { %>
        <div class="dropdown" data-notifications data-bell-known="<%= unreadNotifications || 0 %>">
          <button class="z-bell-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="<%= t('Inbox') %><%= unreadNotifications ? ` (${unreadNotifications})` : '' %>" title="<%= t('Inbox') %>">
            <i class="ti ti-inbox"></i><span class="z-chat-dot" data-chat-dot<%= unreadRooms ? '' : ' hidden' %>></span><% if (unreadNotifications) { %><span class="z-bell-count" data-bell-count><%= unreadNotifications > 99 ? '99+' : formatNumber(unreadNotifications) %></span><% } %>
          </button>
          <div class="dropdown-menu dropdown-menu-end z-bell-menu">
            <%# Head: notifications here, chats one tap away; the sound switch. Foot: mark read, see all. %>
            <div class="z-bell-head">
              <nav class="z-mail-switch flex-fill">
                <a class="active" href="/notifications"><i class="ti ti-bell"></i><%= t('Notifications') %></a>
                <% if (features.inbox) { %><a href="/inbox"><i class="ti ti-messages"></i><%= t('Chats') %><% if (unreadRooms) { %><b><%= formatNumber(unreadRooms) %></b><% } %></a><% } %>
              </nav>
              <button class="z-bell-sound" type="button" data-bell-sound title="<%= t('Sound') %>" aria-label="<%= t('Sound') %>" aria-pressed="true"><i class="ti ti-volume"></i></button>
            </div>
            <div data-bell-list>
              <% const bell = typeof bellNotes !== 'undefined' ? bellNotes : []; %>
              <% if (!bell.length) { %><div class="z-bell-empty"><%= t('No notifications yet') %></div><% } %>
              <% bell.forEach((n) => { %><a class="dropdown-item z-bell-item z-note-<%= n.level %><%= n.unread ? ' z-unread' : '' %>" href="<%= n.href %>"><span class="z-note-icon ti ti-<%= ({ good: 'circle-check', urgent: 'alert-triangle' })[n.level] || 'bell' %>"></span><div class="min-w-0"><div class="z-bell-text"><%= n.text %></div><div class="text-secondary small"><%= n.when %></div></div></a><% }) %>
            </div>
            <div class="z-bell-foot">
              <button class="z-bell-readall" type="button" data-bell-read-all<%= unreadNotifications ? '' : ' hidden' %>><i class="ti ti-checks me-1"></i><%= t('Mark all as read') %></button>
              <a class="z-bell-link ms-auto" href="/notifications"><%= t('See all') %> <i class="ti ti-arrow-right"></i></a>
            </div>
          </div>
        </div>
        <div class="dropdown">
          <button class="z-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('Open user menu') %>">
            <%- include('./avatar', { u: currentUser, size: 'sm' }) %>
            <span class="d-none d-md-inline text-truncate"><%= currentUser.username %></span>
            <i class="ti ti-chevron-down d-none d-md-inline"></i>
          </button>
          <div class="dropdown-menu dropdown-menu-end">
            <a href="<%= userPath(currentUser.username) %>" class="dropdown-item"><i class="ti ti-user me-2"></i><%= t('Profile') %></a>
            <a href="/dashboard" class="dropdown-item"><i class="ti ti-layout-dashboard me-2"></i><%= t('Dashboard') %></a>
            <div class="dropdown-divider"></div>
            <form action="/logout" method="post" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="dropdown-item"><i class="ti ti-logout me-2"></i><%= t('Log out') %></button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-primary"><i class="ti ti-brand-wikipedia me-1"></i><%= t('Log in') %></a>
      <% } %>
    </div>
  </div>
</header>

<div class="z-navbar d-print-none">
  <div class="container-xl">
    <nav class="collapse z-navbar-collapse" id="z-navbar" aria-label="<%= t('Primary') %>">
      <form action="/events" method="get" role="search" class="z-search z-search-menu"><i class="ti ti-search"></i><input type="search" name="q" placeholder="<%= t('Search events…') %>" aria-label="<%= t('Search events') %>"></form>
      <ul class="z-navbar-list">
        <% navItems.forEach((item) => { %>
          <% if (item.children) { %>
            <li class="dropdown">
              <a href="#" class="z-navlink dropdown-toggle<%= item.active ? ' active' : '' %>" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                <i class="ti ti-<%= item.icon %>"></i><span><%= item.label %></span>
              </a>
              <div class="dropdown-menu">
                <% item.children.forEach((c) => { %><% if (c.divider) { %><div class="dropdown-divider"></div><% } else if (c.header) { %><h6 class="dropdown-header"><%= c.header %></h6><% } else { %><a class="dropdown-item<%= c.active ? ' active' : '' %>" href="<%= c.href %>"><i class="ti ti-<%= c.icon %> me-2"></i><%= c.label %></a><% } %><% }) %>
              </div>
            </li>
          <% } else { %>
            <li><a href="<%= item.href %>" class="z-navlink<%= item.active ? ' active' : '' %>"<%= item.active ? ' aria-current="page"' : '' %>><i class="ti ti-<%= item.icon %>"></i><span><%= item.label %></span></a></li>
          <% } %>
        <% }) %>
      </ul>
    </nav>
  </div>
</div>
