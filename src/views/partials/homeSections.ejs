<%# The home page after "Running now" (homeService.overview): people of the month and recent winners, the communities, the calendar, a call to organize. %>
<% const H = home; %>

<%# 5. This month's top contributors, and recent winners. %>
<% if (H.top.length || H.winners.length) { %>
<section class="z-band">
  <div class="container-xl">
    <div class="row g-4">
      <% if (H.top.length) { %>
        <div class="<%= H.winners.length ? 'col-lg-4' : 'col-12' %>">
          <%- include('./homeHead', { icon: 'star', title: t('Top contributors this month'), sub: t('By words and articles accepted.') }) %>
          <div class="z-top">
            <% H.top.forEach((p, i) => { %>
              <div class="z-top-item card">
                <span class="z-top-avatar is-<%= i + 1 %>"><%= p.username.slice(0, 1).toUpperCase() %><span class="z-medal"><%= formatNumber(i + 1) %></span></span>
                <span class="min-w-0"><span class="d-block fw-bold text-truncate"><%= p.username %></span><span class="small text-secondary"><%= p.words ? t('{n} words', { n: formatNumber(p.words) }) + ' · ' : '' %><%= tn('{n} accepted', '{n} accepted', p.accepted) %></span></span>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (H.winners.length) { %>
        <div class="<%= H.top.length ? 'col-lg-8' : 'col-12' %>">
          <%- include('./homeHead', { icon: 'medal', title: t('Recent winners'), sub: t('From the latest events with published results.') }) %>
      <div class="row g-3 mb-4">
        <% H.winners.forEach((wn) => { %>
          <div class="col-md-6 col-xl-4">
            <div class="card h-100"><div class="card-body">
              <a class="fw-medium d-block text-truncate mb-2" href="<%= wn.path %>/results"><%= wn.title %></a>
              <ol class="z-fame-list">
                <% wn.top.forEach((p, i) => { %><li class="is-<%= i + 1 %>"><span class="z-medal"><%= formatNumber(i + 1) %></span><span class="z-user-name"><%= p.username %></span><small class="text-secondary ms-auto"><%= p.words ? t('{n} words', { n: formatNumber(p.words) }) : tn('{n} accepted', '{n} accepted', p.entries) %></small></li><% }) %>
              </ol>
            </div></div>
          </div>
        <% }) %>
      </div>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%# 6. Who runs events on Zury. %>
<% if (H.communities.length) { %>
<section class="z-band is-soft">
  <div class="container-xl">
    <%- include('./homeHead', { icon: 'users-group', title: t('Who runs events on Zury'), sub: t('Communities and affiliates organizing public events.') }) %>
    <div class="z-communities">
      <% H.communities.forEach((c) => { %><span class="z-community"><i class="ti ti-users-group"></i><%= c.name %> <small><%= tn('{n} event', '{n} events', c.events) %></small></span><% }) %>
    </div>
  </div>
</section>
<% } %>

<%# 7. The calendar (bands keep alternating whether or not the communities show). %>
<% const calSoft = !H.communities.length; %>
<section class="z-band<%= calSoft ? ' is-soft' : '' %>">
  <div class="container-xl">
    <%- include('./homeHead', { icon: 'calendar', title: t('Calendar'), sub: t('What runs when, this month.'), more: '/events' }) %>
    <%- include('./calendar', { cal: calendar, calLang: lang.code, calExtra: {} }) %>
  </div>
</section>

<%# 8. A call to organize. %>
<section class="z-band<%= calSoft ? '' : ' is-soft' %>">
  <div class="container-xl">
    <div class="z-cta">
      <h2 class="m-0"><%= t('Run an event for your community') %></h2>
      <p class="text-secondary mt-2 mb-4"><%= t('Every kind of Wikimedia event, set up in minutes, with rules checked for you and a review window your reviewers will like.') %></p>
      <div class="z-types">
        <% Object.keys(CONTEST_TYPES).forEach((k) => { %>
          <div class="z-type"><span class="z-type-ico"><i class="ti ti-<%= TYPE_ICONS[k] || 'calendar-event' %>"></i></span><span><%= t(CONTEST_TYPES[k]) %></span></div>
        <% }) %>
      </div>
      <a class="btn btn-primary btn-lg mt-4" href="<%= currentUser ? '/events/create' : '/login' %>"><i class="ti ti-plus me-1"></i><%= t('Start an event') %></a>
    </div>
  </div>
</section>
