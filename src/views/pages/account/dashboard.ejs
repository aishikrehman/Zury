<%
  const organizing = myEvents.filter((e) => e.roles.includes('organizer')).length;
  const participating = myEvents.filter((e) => e.roles.includes('participant')).length;
  const tiles = [
    ['calendar-event', 'primary', myEvents.length, 'My events'],
    ['briefcase', 'green', organizing, 'Organizing'],
    ['gavel', 'orange', juryEvents.length, 'On the jury'],
    ['files', 'azure', typeof submissionCount !== 'undefined' ? submissionCount : participating, typeof submissionCount !== 'undefined' ? 'Submissions' : 'Participating'],
  ];
  const actions = [
    can('createEvent') ? '<a class="btn btn-primary" href="/events/create"><i class="ti ti-plus me-1"></i>Create event</a>' : '',
    can('accessAdmin') ? '<a class="btn btn-dark" href="/admin"><i class="ti ti-shield-lock me-1"></i>Administration</a>' : '',
  ].join('');
%>
<%- include('../../partials/pageHeader', { pretitle: 'Overview', heading: 'Dashboard', actions }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row row-deck row-cards mb-4">
      <div class="col-sm-12 col-lg-6">
        <div class="card card-gradient">
          <div class="card-body">
            <div class="row gy-3">
              <div class="col-12 col-sm-7 d-flex flex-column">
                <h2 class="h2">Welcome back, <%= currentUser.username %></h2>
                <p class="text-secondary">
                  <% const active = myEvents.filter((e) => e.contest.status === 'active').length; %>
                  You're part of <%= myEvents.length %> event<%= myEvents.length === 1 ? '' : 's' %><%= active ? `, ${active} running now` : '' %>.
                </p>
                <div class="row g-5 mt-auto">
                  <div class="col-auto">
                    <div class="subheader">Submissions</div>
                    <div class="h3 mb-0"><%= typeof submissionCount !== 'undefined' ? submissionCount : 0 %></div>
                  </div>
                  <div class="col-auto">
                    <div class="subheader">Jury roles</div>
                    <div class="h3 mb-0"><%= juryEvents.length %></div>
                  </div>
                </div>
              </div>
              <div class="col-12 col-sm-5 d-flex align-items-center justify-content-center">
                <img src="/images/illustrations/contest.svg" alt="" height="140">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-12 col-lg-6">
        <div class="row row-cards">
          <% tiles.forEach(([icon, color, value, label]) => { %>
            <div class="col-sm-6">
              <div class="card card-sm">
                <div class="card-body">
                  <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-<%= color %> text-white avatar"><i class="ti ti-<%= icon %>"></i></span></div>
                    <div class="col">
                      <div class="font-weight-medium h2 mb-0"><%= value %></div>
                      <div class="text-secondary"><%= label %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <% const statusKeys = Object.keys(SUBMISSION_STATUSES).filter((k) => activity.status[k]); const total30 = activity.series.values.reduce((a, b) => a + b, 0); %>
    <div class="row row-cards mb-4">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">My submissions</h3>
            <div class="card-actions"><span class="badge bg-primary-lt"><%= total30 %> in the last 30 days</span></div>
          </div>
          <div class="card-body">
            <%- include('../../partials/chart', { spec: { type: 'area', height: 220, series: [{ name: 'Submissions', data: activity.series.values }], labels: activity.series.labels, colors: ['primary'] }, label: 'My submissions per day, last 30 days' }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title">Entry status</h3></div>
          <div class="card-body">
            <% if (!statusKeys.length) { %>
              <%- include('../../partials/emptyArt', { title: 'Nothing submitted yet', text: 'Your entries will show up here.', action: '<a href="/events/active" class="btn btn-primary">Find an event</a>' }) %>
            <% } else { %>
              <%- include('../../partials/chart', { spec: { type: 'donut', height: 220, series: statusKeys.map((k) => activity.status[k]), labels: statusKeys.map((k) => SUBMISSION_STATUSES[k].label), colors: statusKeys.map((k) => SUBMISSION_STATUSES[k].color), totalLabel: 'Entries' }, label: 'My entries by status' }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="row row-cards">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header"><h3 class="card-title">My events</h3></div>
          <% if (!myEvents.length) { %>
            <%- include('../../partials/emptyArt', { art: 'contest', title: 'No events yet', text: 'Join an event to see it here.', action: '<a href="/events" class="btn btn-primary">Browse events</a>' }) %>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-vcenter card-table">
                <thead><tr><th>Event</th><th>Status</th><th>Your roles</th><th>Dates</th></tr></thead>
                <tbody>
                  <% myEvents.forEach(({ contest: c, roles }) => { const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
                    <tr>
                      <td><a href="/contest/<%= c.id %>"><%= c.title %></a><div class="text-secondary small"><%= CONTEST_TYPES[c.type] %> · <%= c.primaryWiki %></div></td>
                      <td><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span></td>
                      <td><% roles.forEach((r) => { %><span class="badge bg-blue-lt me-1"><%= EVENT_ROLES[r].label %></span><% }) %></td>
                      <td class="text-secondary small text-nowrap"><%= c.startDate ? formatDate(c.startDate, c.timezone) : '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Platform roles</h3></div>
          <div class="card-body"><%- include('../../partials/accessSummary', { s: subject }) %></div>
        </div>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Verified Wikimedia groups</h3></div>
          <div class="list-group list-group-flush">
            <% if (!wikiRoles.length) { %><div class="list-group-item text-secondary">None that Zury tracks.</div><% } %>
            <% wikiRoles.forEach((r) => { %>
              <div class="list-group-item">
                <div><span class="badge bg-purple-lt"><%= r.rightName %></span> on <%= r.wiki === '*' ? 'all wikis (global)' : r.wiki %></div>
                <div class="text-secondary small">Checked <%= formatDateTime(r.verifiedAt, currentUser.timezone || 'UTC') %></div>
              </div>
            <% }) %>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3 class="card-title">Profile</h3></div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action" href="<%= userPath(currentUser.username) %>"><i class="ti ti-user me-2"></i>Public profile</a>
            <a class="list-group-item list-group-item-action" href="/settings"><i class="ti ti-settings me-2"></i>Preferences</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
