<%
  const organizing = myEvents.filter((e) => e.roles.includes('organizer')).length;
  const running = myEvents.filter((e) => e.contest.status === 'active').length;
  const numbers = [
    ['calendar-event', myEvents.length, t('My events'), '/dashboard'],
    ['briefcase', organizing, t('Organizing'), '/dashboard'],
    ['gavel', juryEvents.length, t('Reviewing'), '/review'],
    ['files', submissionCount, t('Submissions'), '/submissions'],
  ];
%>
<%- include('../../partials/accountHeader', { tab: 'dashboard' }) %>

  <div class="z-dash-hello">
    <div>
      <h2 class="m-0"><%= t('Welcome back, {name}', { name: currentUser.username }) %></h2>
      <p class="text-secondary m-0"><%= tn("You're part of {n} event.", "You're part of {n} events.", myEvents.length) %><% if (running) { %> <%= tn('{n} is running now.', '{n} are running now.', running) %><% } %></p>
    </div>
    <div class="z-dash-numbers">
      <% numbers.forEach(([icon, value, label, href]) => { %><a href="<%= href %>"><i class="ti ti-<%= icon %>"></i><b><%= formatNumber(value) %></b><span><%= label %></span></a><% }) %>
    </div>
  </div>

  <% if (approvals && approvals.total) { const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`; %>
    <div class="card mb-4">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-shield-check me-2 text-warning"></i><%= t('Waiting for approval') %> <span class="badge bg-yellow-lt ms-1"><%= formatNumber(approvals.total) %></span></h3></div>
      <div class="list-group list-group-flush">
        <% [...approvals.events.map((x) => ['event', x, x.path, x.title, (x.createdBy ? x.createdBy.username + ' · ' : '') + wikiLocal(x.primaryWiki)]), ...approvals.series.map((x) => ['series', x, '/' + x.slug, x.title, t('Series')]), ...approvals.editions.map((x) => ['edition', x, '/series/' + x.series.slug + '/' + x.slug, x.series.title + ' · ' + x.title, t('Edition')])].forEach(([kind, x, href, title, sub]) => { %>
          <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
            <a class="fw-medium" href="<%= href %>"><%= title %></a><span class="text-secondary small"><%= sub %></span>
            <span class="ms-auto d-flex gap-1">
              <form method="post" action="/approvals/<%= kind %>/<%= x.id %>/approve"><%- csrf %><button class="btn btn-sm btn-success" type="submit"><i class="ti ti-check me-1"></i><%= t('Approve') %></button></form>
              <form method="post" action="/approvals/<%= kind %>/<%= x.id %>/reject"><%- csrf %><button class="btn btn-sm btn-ghost-danger" type="submit"><%= t('Reject') %></button></form>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <div class="row row-cards mb-4">
    <div class="<%= pendingWikis.length ? 'col-lg-7' : 'col-12' %>">
      <div class="card h-100">
        <div class="card-header"><h3 class="card-title"><%= t('My events') %></h3></div>
        <% if (!myEvents.length) { %>
          <%- include('../../partials/emptyArt', { art: 'contest', title: t('No events yet'), text: t('Join an event to see it here.'), action: '<a href="/events" class="btn btn-primary">' + h(t('Browse events')) + '</a>' }) %>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% myEvents.slice(0, 10).forEach(({ contest: c, roles }) => { const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="<%= eventPath(c) %>">
                <span class="z-evhead-status is-<%= st.badge === 'dark' ? 'secondary' : st.badge %>" title="<%= t(st.label) %>"><i></i></span>
                <span class="flex-fill min-w-0"><span class="d-block text-truncate fw-medium"><%= c.title %></span><span class="text-secondary small"><%= roles.map((r) => t(EVENT_ROLES[r].label)).join(' · ') %></span></span>
                <% const mc = myCounts.get(c.id); if (mc) { %><span class="d-flex gap-1 text-nowrap small"><span class="badge bg-green-lt" title="<%= t('Accepted') %>"><%= formatNumber(mc.accepted) %></span><span class="badge bg-yellow-lt" title="<%= t('Pending') %>"><%= formatNumber(mc.pending) %></span><span class="badge bg-red-lt" title="<%= t('Not accepted') %>"><%= formatNumber(mc.rejected) %></span></span><% } %>
                <span class="text-secondary small text-nowrap"><%= c.startDate ? formatDate(c.startDate, c.timezone) : '' %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    <% if (pendingWikis.length) { %>
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-clock-hour-4 me-2 text-warning"></i><%= t('Waiting for approval') %></h3><span class="badge bg-yellow-lt ms-auto"><%= formatNumber(pendingWikis.length) %></span></div>
          <div class="list-group list-group-flush">
            <% pendingWikis.forEach((w) => { %>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="<%= eventPath(w.contest) %>/config#wikis">
                <span class="flex-fill min-w-0 text-truncate"><%= wikiLocal(w.wiki) %> <span class="text-secondary">→ <%= w.contest.title %></span></span>
                <span class="text-secondary small"><%= formatDate(w.createdAt) %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('../../partials/calendar', { cal: calendar, calLang: lang.code }) %>
<%- include('../../partials/accountEnd') %>
