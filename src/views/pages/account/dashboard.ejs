<%
  const organizing = myEvents.filter((e) => e.roles.includes('organizer')).length;
  const participating = myEvents.filter((e) => e.roles.includes('participant')).length;
  const tiles = [
    ['calendar-event', 'primary', myEvents.length, 'My events'],
    ['briefcase', 'green', organizing, 'Organizing'],
    ['gavel', 'orange', juryEvents.length, 'On the jury'],
    ['files', 'azure', typeof submissionCount !== 'undefined' ? submissionCount : participating, typeof submissionCount !== 'undefined' ? 'Submissions' : 'Participating'],
  ];
  const actions = [
    can('createEvent') ? `<a class="btn btn-primary" href="/events/create"><i class="ti ti-plus me-1"></i>${h(t('Create event'))}</a>` : '',
    can('accessAdmin') ? '<a class="btn btn-dark" href="/admin"><i class="ti ti-shield-lock me-1"></i>' + h(t('Administration')) + '</a>' : '',
  ].join('');
%>
<%- include('../../partials/pageHeader', { pretitle: t('Overview'), heading: t('Dashboard'), actions }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row row-deck row-cards mb-4">
      <div class="col-sm-12 col-lg-6">
        <div class="card card-gradient">
          <div class="card-body">
            <div class="row gy-3">
              <div class="col-12 col-sm-7 d-flex flex-column">
                <h2 class="h2">Welcome back, <%= currentUser.username %></h2>
                <p class="text-secondary">
                  <% const active = myEvents.filter((e) => e.contest.status === 'active').length; %>
                  <%= tn("You're part of {n} event.", "You're part of {n} events.", myEvents.length) %><% if (active) { %> <%= tn('{n} is running now.', '{n} are running now.', active) %><% } %>
                </p>
                <div class="row g-5 mt-auto">
                  <div class="col-auto">
                    <div class="subheader"><%= t("Submissions") %></div>
                    <div class="h3 mb-0"><%= typeof submissionCount !== 'undefined' ? submissionCount : 0 %></div>
                  </div>
                  <div class="col-auto">
                    <div class="subheader"><%= t("Jury roles") %></div>
                    <div class="h3 mb-0"><%= juryEvents.length %></div>
                  </div>
                </div>
              </div>
              <div class="col-12 col-sm-5 d-flex align-items-center justify-content-center">
                <img src="/images/illustrations/contest.svg" alt="" height="140">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-12 col-lg-6">
        <div class="row row-cards">
          <% tiles.forEach(([icon, color, value, label]) => { %>
            <div class="col-sm-6">
              <div class="card card-sm">
                <div class="card-body">
                  <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-<%= color %> text-white avatar"><i class="ti ti-<%= icon %>"></i></span></div>
                    <div class="col">
                      <div class="font-weight-medium h2 mb-0"><%= value %></div>
                      <div class="text-secondary"><%= t(label) %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <% const statusKeys = Object.keys(SUBMISSION_STATUSES).filter((k) => activity.status[k]); const total30 = activity.series.values.reduce((a, b) => a + b, 0); %>
    <div class="row row-cards mb-4">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><%= t("My submissions") %></h3>
            <div class="card-actions"><span class="badge bg-primary-lt"><%= t('{n} in the last 30 days', { n: total30 }) %></span></div>
          </div>
          <div class="card-body">
            <%- include('../../partials/chart', { spec: { type: 'area', height: 220, series: [{ name: 'Submissions', data: activity.series.values }], labels: activity.series.labels, colors: ['primary'] }, label: t('My submissions per day, last 30 days') }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Entry status") %></h3></div>
          <div class="card-body">
            <% if (!statusKeys.length) { %>
              <%- include('../../partials/emptyArt', { title: t('Nothing submitted yet'), text: t('Your entries will show up here.'), action: '<a href="/events/active" class="btn btn-primary">Find an event</a>' }) %>
            <% } else { %>
              <%- include('../../partials/chart', { spec: { type: 'donut', height: 220, series: statusKeys.map((k) => activity.status[k]), labels: statusKeys.map((k) => SUBMISSION_STATUSES[k].label), colors: statusKeys.map((k) => SUBMISSION_STATUSES[k].color), totalLabel: 'Entries' }, label: t('My entries by status') }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="row row-cards">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("My events") %></h3></div>
          <% if (!myEvents.length) { %>
            <%- include('../../partials/emptyArt', { art: 'contest', title: t('No events yet'), text: t('Join an event to see it here.'), action: '<a href="/events" class="btn btn-primary">Browse events</a>' }) %>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-vcenter card-table">
                <thead><tr><th><%= t("Event") %></th><th><%= t("Status") %></th><th><%= t("Your roles") %></th><th><%= t("Dates") %></th></tr></thead>
                <tbody>
                  <% myEvents.forEach(({ contest: c, roles }) => { const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
                    <tr>
                      <td><a href="<%= eventPath(c) %>"><%= c.title %></a><div class="text-secondary small"><%= CONTEST_TYPES[c.type] %> · <%= wikiLocal(c.primaryWiki) %></div></td>
                      <td><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span></td>
                      <td><% roles.forEach((r) => { %><span class="badge bg-blue-lt me-1"><%= EVENT_ROLES[r].label %></span><% }) %></td>
                      <td class="text-secondary small text-nowrap"><%= c.startDate ? formatDate(c.startDate, c.timezone) : '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><%= t("Roles") %></h3></div>
          <div class="card-body">
            <%- include('../../partials/accessSummary', { s: subject }) %>
            <% if (wikiRoles.length) { %>
              <ul class="list-unstyled m-0 z-role-list border-top mt-2 pt-1">
                <% wikiRoles.forEach((r) => { %>
                  <li><i class="ti ti-world text-secondary"></i><div><div class="fw-medium"><%= r.rightName %> <span class="text-secondary fw-normal">· <%- r.wiki === '*' ? h(t('all wikis (global)')) : wikiLabel(r.wiki) %></span></div><div class="text-secondary small"><%= t('Verified on Wikimedia') %> · <%= formatDateTime(r.verifiedAt, currentUser.timezone || 'UTC') %></div></div></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Profile") %></h3></div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action" href="<%= userPath(currentUser.username) %>"><i class="ti ti-user me-2"></i><%= t("Public profile") %></a>
            <a class="list-group-item list-group-item-action" href="/settings"><i class="ti ti-settings me-2"></i><%= t("Preferences") %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
