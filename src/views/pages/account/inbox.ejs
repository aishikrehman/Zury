<%# Chats (messenger look) and, on /notifications, the notifications list. %>
<%
  const KIND = { event: ['Events', 'messages', 'blue'], jury: ['Reviewers', 'lock', 'red'], series: ['Series', 'stack-2', 'purple'], edition: ['Series', 'stack-2', 'purple'], direct: ['People', 'user', 'green'] };
  const unreadOf = (fn) => rooms.filter((r) => r.unread && fn(r)).length;
  const unreadChats = unreadOf(() => true);
  const folders = mode === 'notes'
    ? [['all', '/notifications', 'inbox', t('All'), 0], ['unread', '/notifications?f=unread', 'mail', t('Unread'), unreadNotes]]
    : [['chats', '/inbox', 'messages', t('All chats'), unreadChats], ['direct', '/inbox?f=direct', 'user', t('Direct messages'), unreadOf((r) => r.room === 'direct')]];
  const folder = f;
  const shownRooms = f === 'direct' ? rooms.filter((r) => r.room === 'direct') : rooms;
  const day = (d) => { const x = new Date(d); return x.toDateString() === new Date().toDateString() ? formatDateTime(d).replace(/^.*?(\d{1,2}[:.]\d{2}.*)$/, '$1') : formatDate(d); };
%>
<% if (mode !== 'notes') { %>
<%# Chats, messenger-style: the conversations on the left, the open one on the right. On phones one at a time. %>
<%
  const avatarOf = (r) => {
    if (r.person) return include('../../partials/avatar', { u: r.person, size: 'md' });
    if (r.logo) return `<span class="z-msg-ava z-msg-logo"><img src="${h(r.logo)}" alt="" loading="lazy"></span>`;
    const kd = KIND[r.room === 'jury' ? 'event' : r.room] || KIND.event;
    return `<span class="z-msg-ava bg-${kd[2]}-lt text-${kd[2]}">${h(String(r.title || '?').trim().charAt(0))}</span>`;
  };
  // One line per event: its rooms together (everyone, reviewers), the newest message shown.
  const lines = [];
  for (const r of shownRooms) {
    if (['event', 'jury'].includes(r.room)) {
      let g = lines.find((x) => x.group && x.path === r.path);
      if (!g) { g = { group: true, path: r.path, title: r.title, logo: r.logo, room: 'event', rooms: [] }; lines.push(g); }
      g.rooms.push(r);
    } else lines.push(r);
  }
  for (const g of lines.filter((x) => x.group)) {
    g.rooms.sort((a, b) => (a.room === 'event' ? -1 : 1));
    const newest = [...g.rooms].sort((a, b) => (b.lastAt ? +b.lastAt : 0) - (a.lastAt ? +a.lastAt : 0))[0];
    Object.assign(g, { channel: g.rooms[0].channel, unread: g.rooms.some((r) => r.unread), lastAt: newest.lastAt, preview: newest.preview, channels: g.rooms.map((r) => r.channel) });
  }
  const isHere = (x) => open && (x.channels ? x.channels.includes(open.channel) : x.channel === open.channel);
  const siblings = open && ['event', 'jury'].includes(open.room) ? rooms.filter((r) => r.path === open.path && ['event', 'jury'].includes(r.room)).sort((a) => (a.room === 'event' ? -1 : 1)) : [];
%>
<div class="page-body"><div class="container-xl">
  <div class="z-msg<%= open ? ' is-open' : '' %>">
    <aside class="z-msg-list">
      <div class="z-msg-head">
        <h2 class="m-0"><%= t('Chat') %></h2>
        <span class="badge bg-purple-lt"><%= t('Beta') %></span>
        <% if (features.directMessages) { %><button class="z-msg-new ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#z-compose" aria-expanded="false" title="<%= t('New message') %>" aria-label="<%= t('New message') %>"><i class="ti ti-pencil-plus"></i></button><% } %>
      </div>
      <form method="post" action="/inbox/new" class="collapse z-msg-compose" id="z-compose">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="input-group"><input class="form-control" name="username" placeholder="<%= t('Username') %>" required><button class="btn btn-primary" type="submit" aria-label="<%= t('Start') %>"><i class="ti ti-arrow-right"></i></button></div>
      </form>
      <nav class="z-msg-tabs">
        <a class="<%= f !== 'direct' ? 'is-on' : '' %>" href="/inbox"><%= t('All') %><% if (unreadChats) { %> <b><%= formatNumber(unreadChats) %></b><% } %></a>
        <a class="<%= f === 'direct' ? 'is-on' : '' %>" href="/inbox?f=direct"><%= t('Direct messages') %></a>
      </nav>
      <div class="z-msg-rows">
        <% if (!lines.length) { %><div class="z-msg-empty"><i class="ti ti-messages"></i><span><%= f === 'direct' ? t('No conversations yet.') : t('Your events’ chats appear here.') %></span></div><% } %>
        <% lines.forEach((r) => { %>
          <a class="z-msg-row<%= r.unread ? ' is-unread' : '' %><%= isHere(r) ? ' is-here' : '' %>" href="/inbox?c=<%= r.channel %><%= f === 'direct' ? '&f=direct' : '' %>">
            <%- avatarOf(r) %>
            <span class="z-msg-text">
              <span class="z-msg-top"><b class="text-truncate"><%= r.title %></b><small><%= r.lastAt ? day(r.lastAt) : '' %></small></span>
              <span class="z-msg-prev text-truncate"><%= r.preview || t('No messages yet.') %></span>
            </span>
            <% if (r.unread) { %><i class="z-msg-dot"></i><% } %>
          </a>
        <% }) %>
      </div>
    </aside>
    <section class="z-msg-main">
      <% if (open) { %>
        <div class="z-msg-bar">
          <a class="z-msg-back" href="/inbox<%= f === 'direct' ? '?f=direct' : '' %>" aria-label="<%= t('Back') %>"><i class="ti ti-arrow-left"></i></a>
          <%- avatarOf(open) %>
          <div class="min-w-0 flex-fill">
            <a class="z-msg-title text-truncate" href="<%= open.path %>"><%= open.title %></a>
            <% if (open.room === 'direct') { %><small class="text-secondary"><i class="ti ti-lock"></i> <%= t('Only the two of you') %></small><% } %><% if (open.moderator) { %><small class="text-warning"><i class="ti ti-shield"></i> <%= t('Moderator view') %></small><% } %>
          </div>
          <% if (open.wikiTalk) { %><a class="z-msg-wikitalk" href="<%= open.wikiTalk %>" target="_blank" rel="noopener" title="<%= t('Talk page on the wiki') %>"><i class="ti ti-message-circle"></i><span><%= t('On the wiki') %></span></a><% } %>
          <% if (siblings.length > 1) { %>
            <nav class="z-msg-rooms" aria-label="<%= t('Chat') %>">
              <% siblings.forEach((r) => { %><a class="<%= r.channel === open.channel ? 'is-on' : '' %><%= r.unread && r.channel !== open.channel ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>"><% if (r.room === 'jury') { %><i class="ti ti-lock"></i><% } %><%= r.room === 'jury' ? t('Reviewers') : t('Everyone') %></a><% }) %>
            </nav>
          <% } else if (open.room === 'jury') { %><span class="badge bg-red-lt"><i class="ti ti-lock me-1"></i><%= t('Reviewers') %></span><% } %>
        </div>
        <%- include('../../partials/chatBox', { box: chatBox, bare: true }) %>
      <% } else { %>
        <div class="z-msg-pick"><i class="ti ti-message-circle"></i><span><%= t('Choose a conversation') %></span></div>
      <% } %>
    </section>
  </div>
</div></div>
<% } else { %>
<div class="page-body"><div class="container-xl">
  <div class="card z-mailbox">
    <div class="row g-0">
      <%# The folders, Gmail-like: each event a group that opens to its rooms. On phones this is a drawer. %>
      <% const byEvent = []; rooms.filter((r) => ['event', 'jury'].includes(r.room)).forEach((r) => { let g = byEvent.find((x) => x.path === r.path); if (!g) { g = { path: r.path, title: r.title, rooms: [] }; byEvent.push(g); } g.rooms.push(r); });
         const levels = rooms.filter((r) => ['series', 'edition'].includes(r.room));
         const people = rooms.filter((r) => r.room === 'direct');
         const here = (r) => open && open.channel === r.channel; %>
      <aside class="col-lg-3 z-mail-side offcanvas-lg offcanvas-start" tabindex="-1" id="z-mail-folders" aria-label="<%= t('Notifications') %>">
        <div class="p-3 pb-2 d-flex align-items-center gap-2">
          <b class="flex-fill fs-3"><%= mode === 'notes' ? t('Notifications') : t('Chat') %></b>
          <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#z-mail-folders" aria-label="<%= t('Close') %>"></button>
        </div>
        <% if (mode === 'chats' && features.directMessages) { %><div class="px-3 pb-2"><button class="btn btn-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#z-compose" aria-expanded="false"><i class="ti ti-pencil me-1"></i><%= t('New message') %></button></div><% } %>
        <form method="post" action="/inbox/new" class="collapse px-3 pb-3" id="z-compose">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="input-group"><input class="form-control" name="username" placeholder="<%= t('Username') %>" required><button class="btn" type="submit" aria-label="<%= t('Start') %>"><i class="ti ti-arrow-right"></i></button></div>
          <div class="form-hint"><%= t('Someone who takes part in an event with you.') %></div>
        </form>
        <nav class="z-mail-nav">
          <% folders.forEach(([k, href, icon, label, n]) => { %><a class="<%= !open && folder === k ? 'active' : '' %>" href="<%= href %>"><i class="ti ti-<%= icon %>"></i><span><%= label %></span><% if (n) { %><b><%= formatNumber(n) %></b><% } %></a><% }) %>
          <% if (mode === 'chats') { %>

          <% if (byEvent.length) { %>
            <details class="z-mail-group" open><summary><i class="ti ti-chevron-down"></i><span><%= t('Events') %></span></summary>
              <% byEvent.forEach((g) => { const n = g.rooms.filter((r) => r.unread).length; const inside = g.rooms.some(here); %>
                <% if (g.rooms.length === 1) { const r = g.rooms[0]; %>
                  <a class="z-mail-sub<%= here(r) ? ' active' : '' %><%= r.unread ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>"><i class="z-mail-dot bg-blue"></i><span class="text-truncate"><%= g.title %></span><% if (r.unread) { %><b>•</b><% } %></a>
                <% } else { %>
                  <details class="z-mail-ev"<%= inside || n ? ' open' : '' %>><summary class="<%= n ? 'is-unread' : '' %>"><i class="ti ti-chevron-right"></i><span class="text-truncate"><%= g.title %></span><% if (n) { %><b><%= formatNumber(n) %></b><% } %></summary>
                    <% g.rooms.forEach((r) => { %><a class="z-mail-sub z-mail-room<%= here(r) ? ' active' : '' %><%= r.unread ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>"><i class="ti ti-<%= r.room === 'jury' ? 'lock' : 'messages' %>"></i><span class="text-truncate"><%= r.room === 'jury' ? t('Reviewers and organizers') : t('Everyone') %></span><% if (r.unread) { %><b>•</b><% } %></a><% }) %>
                  </details>
                <% } %>
              <% }) %>
            </details>
          <% } %>
          <% if (levels.length) { %>
            <details class="z-mail-group" open><summary><i class="ti ti-chevron-down"></i><span><%= t('Series') %></span></summary>
              <% levels.forEach((r) => { %><a class="z-mail-sub<%= here(r) ? ' active' : '' %><%= r.unread ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>"><i class="z-mail-dot bg-purple"></i><span class="text-truncate"><%= r.title %></span><% if (r.unread) { %><b>•</b><% } %></a><% }) %>
            </details>
          <% } %>
          <% if (people.length) { %>
            <details class="z-mail-group" open><summary><i class="ti ti-chevron-down"></i><span><%= t('People') %></span></summary>
              <% people.forEach((r) => { %><a class="z-mail-sub<%= here(r) ? ' active' : '' %><%= r.unread ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>"><%- include('../../partials/avatar', { u: r.person, size: 'xs' }) %><span class="text-truncate"><%= r.title %></span><% if (r.unread) { %><b>•</b><% } %></a><% }) %>
            </details>
          <% } %>
          <% } %>
          <div class="px-2 pt-3"><span class="badge bg-purple-lt"><%= t('Beta') %></span></div>
        </nav>
      </aside>
      <div class="col-lg-9 z-mail-main">
        <% if (open) { %>
          <div class="z-mail-bar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#z-mail-folders" aria-controls="z-mail-folders" aria-label="<%= t('Folders') %>" title="<%= t('Folders') %>"><i class="ti ti-menu-2"></i></button>
            <a class="btn btn-icon" href="/inbox<%= folder === 'direct' ? '?f=direct' : '' %>" title="<%= t('Back') %>" aria-label="<%= t('Back') %>"><i class="ti ti-arrow-left"></i></a>
            <% if (open.person) { %><%- include('../../partials/avatar', { u: open.person, size: 'sm' }) %><% } else { %><i class="z-mail-dot bg-<%= (KIND[open.room] || KIND.event)[2] %>"></i><% } %>
            <a class="fw-bold text-truncate" href="<%= open.path %>"><%= open.title %></a>
            <% if (open.room === 'jury') { %><span class="badge bg-red-lt"><i class="ti ti-lock me-1"></i><%= t('Reviewers and organizers only') %></span><% } %>
            <% if (open.room === 'direct') { %><span class="badge bg-green-lt"><i class="ti ti-lock me-1"></i><%= t('Only the two of you') %></span><% } %>
          </div>
          <%- include('../../partials/chatBox', { box: chatBox, bare: true, height: 'calc(100dvh - 22rem)' }) %>
        <% } else if (mode === 'chats') { %>
          <div class="z-mail-bar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#z-mail-folders" aria-controls="z-mail-folders" aria-label="<%= t('Folders') %>" title="<%= t('Folders') %>"><i class="ti ti-menu-2"></i></button>
            <a class="btn btn-icon" href="/inbox<%= f === 'direct' ? '?f=direct' : '' %>" title="<%= t('Refresh') %>" aria-label="<%= t('Refresh') %>"><i class="ti ti-refresh"></i></a>
            <span class="text-secondary small ms-auto"><%= formatNumber(shownRooms.length) %></span>
          </div>
          <% if (!lines.length) { %><div class="p-4 text-secondary"><%= f === 'direct' ? t('No conversations yet. Press New message to write to someone.') : t('Your events’ chats appear here.') %></div><% } %>
          <div class="z-mail-list">
            <% shownRooms.forEach((r) => { const kd = KIND[r.room] || KIND.event; %>
              <a class="z-mail-row<%= r.unread ? ' is-unread' : '' %>" href="/inbox?c=<%= r.channel %>">
                <span class="z-mail-from"><% if (r.person) { %><%- include('../../partials/avatar', { u: r.person, size: 'xs' }) %><% } else { %><i class="ti ti-<%= kd[1] %>"></i><% } %><span class="text-truncate"><%= r.title %></span></span>
                <span class="z-mail-subj text-truncate"><%= r.preview || t('No messages yet.') %></span>
                <i class="z-mail-dot bg-<%= kd[2] %>" title="<%= t(kd[0]) %>"></i>
                <span class="z-mail-date"><%= r.lastAt ? day(r.lastAt) : '' %></span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="z-mail-bar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#z-mail-folders" aria-controls="z-mail-folders" aria-label="<%= t('Folders') %>" title="<%= t('Folders') %>"><i class="ti ti-menu-2"></i></button>
            <% if (unreadNotes) { %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-icon" type="submit" title="<%= t('Mark all as read') %>" aria-label="<%= t('Mark all as read') %>"><i class="ti ti-checks"></i></button></form><% } %>
            <a class="btn btn-icon" href="/notifications<%= f === 'unread' ? '?f=unread' : '' %>" title="<%= t('Refresh') %>" aria-label="<%= t('Refresh') %>"><i class="ti ti-refresh"></i></a>
            <% if (notes.total > notes.perPage) { const pages = Math.ceil(notes.total / notes.perPage); %>
              <span class="ms-auto small text-secondary"><%= formatNumber(notes.page) %> / <%= formatNumber(pages) %></span>
              <a class="btn btn-icon<%= notes.page > 1 ? '' : ' disabled' %>" href="/notifications?<%= f === 'unread' ? 'f=unread&' : '' %>page=<%= notes.page - 1 %>" aria-label="<%= t('Newer') %>"><i class="ti ti-chevron-left"></i></a>
              <a class="btn btn-icon<%= notes.page < pages ? '' : ' disabled' %>" href="/notifications?<%= f === 'unread' ? 'f=unread&' : '' %>page=<%= notes.page + 1 %>" aria-label="<%= t('Older') %>"><i class="ti ti-chevron-right"></i></a>
            <% } %>
          </div>
          <% if (!notes.items.length) { %><div class="p-4 text-secondary"><%= t('Nothing yet.') %></div><% } %>
          <div class="z-mail-list">
            <% notes.items.forEach((n) => { %>
              <a class="z-mail-row<%= n.unread ? ' is-unread' : '' %>" href="/notifications/<%= n.id %>">
                <span class="z-mail-from"><i class="ti ti-bell"></i><span class="text-truncate"><%= n.event || t('Zury') %></span></span>
                <span class="z-mail-subj text-truncate"><%= n.text %></span>
                <i class="z-mail-dot <%= n.unread ? 'bg-primary' : '' %>"></i>
                <span class="z-mail-date"><%= day(n.when) %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div></div>
<% } %>
