<%- include('../../partials/accountHeader', { tab: 'settings' }) %>
    <% if (saved) { %><div class="alert alert-success" role="status"><i class="ti ti-circle-check me-1"></i><%= t("Preferences saved.") %></div><% } %>

    <div class="card mb-3">
      <div class="card-header"><h2 class="card-title"><i class="ti ti-photo me-2 text-secondary"></i><%= t('Profile picture') %></h2></div>
      <form action="/settings/avatar" method="post" class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3 align-items-center">
          <div class="col-auto"><%- include('../../partials/avatar', { u: currentUser, size: 'xl' }) %></div>
          <div class="col">
            <p class="text-secondary small mb-2"><%= t('Use a picture from Wikimedia Commons: type its file name, e.g. Example.jpg.') %></p>
            <div class="d-flex flex-wrap gap-2">
              <input class="form-control flex-fill" style="min-width: 12rem" name="file" placeholder="File:Example.jpg" aria-label="<%= t('File name on Commons') %>" maxlength="250">
              <button class="btn btn-primary" type="submit"><%= t('Use this picture') %></button>
              <% if (currentUser.avatarUrl) { %><button class="btn btn-ghost-danger" type="submit" name="remove" value="1"><%= t('Remove picture') %></button><% } %>
            </div>
          </div>
        </div>
      </form>
    </div>

    <form action="/settings" method="post" novalidate class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h2 class="card-title"><i class="ti ti-language me-2 text-secondary"></i><%= t("Language and time") %></h2></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="preferredLanguage" class="form-label"><%= t("Preferred language") %></label>
            <select id="preferredLanguage" name="preferredLanguage" data-picker="language" placeholder="<%= t("Search languages…") %>"
                    class="form-select<%= errors.preferredLanguage ? ' is-invalid' : '' %>">
              <option value=""><%= t("Default") %></option>
              <% if (values.preferredLanguage) { %><option value="<%= values.preferredLanguage %>" selected><%= values.preferredLanguage %></option><% } %>
            </select>
            <% if (errors.preferredLanguage) { %><div class="invalid-feedback"><%= errors.preferredLanguage %></div><% } %>
          </div>
          <div class="col-md-6">
            <label for="timezone" class="form-label"><%= t("Timezone") %></label>
            <select id="timezone" name="timezone" class="form-select<%= errors.timezone ? ' is-invalid' : '' %>">
              <option value=""><%= t("Not set") %></option>
              <% timezones.forEach((tz) => { %><option value="<%= tz %>"<%= values.timezone === tz ? ' selected' : '' %>><%= tz %></option><% }) %>
            </select>
            <% if (errors.timezone) { %><div class="invalid-feedback"><%= errors.timezone %></div><% } %>
          </div>
        </div>
        <p class="text-secondary small mt-3 mb-0"><i class="ti ti-home me-1"></i><%= t('Home wiki') %>: <%= currentUser.homeWiki ? wikiLocal(currentUser.homeWiki) : t('unknown') %></p>
      </div>
      <div class="card-footer d-flex justify-content-end">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i><%= t("Save preferences") %></button>
      </div>
    </form>
<%- include('../../partials/accountEnd') %>
