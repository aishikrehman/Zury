<%- include('../../partials/pageHeader', { pretitle: 'Account', heading: 'Preferences' }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="card">
      <div class="row g-0">
        <div class="col-12 col-md-3 border-end">
          <div class="card-body">
            <h4 class="subheader">Account</h4>
            <div class="list-group list-group-transparent">
              <a href="/settings" class="list-group-item list-group-item-action d-flex align-items-center active">Preferences</a>
              <a href="<%= userPath(currentUser.username) %>" class="list-group-item list-group-item-action d-flex align-items-center">Public profile</a>
              <a href="/submissions" class="list-group-item list-group-item-action d-flex align-items-center">My submissions</a>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-9 d-flex flex-column">
          <form action="/settings" method="post" novalidate class="d-flex flex-column h-100">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="card-body">
              <h2 class="mb-4">Preferences</h2>
              <% if (saved) { %><div class="alert alert-success" role="status"><i class="ti ti-circle-check me-1"></i>Preferences saved.</div><% } %>
              <h3 class="card-title">Wikimedia account</h3>
              <div class="row align-items-center mb-4">
                <div class="col-auto"><span class="avatar avatar-xl"><%= currentUser.username.charAt(0).toUpperCase() %></span></div>
                <div class="col">
                  <div class="fw-bold"><%= currentUser.username %></div>
                  <div class="text-secondary">Home wiki: <%= currentUser.homeWiki || 'unknown' %></div>
                </div>
              </div>
              <h3 class="card-title mt-4">Language and time</h3>
              <div class="row g-3">
                <div class="col-md">
                  <label for="preferredLanguage" class="form-label">Preferred language</label>
                  <input type="text" id="preferredLanguage" name="preferredLanguage" maxlength="35"
                         class="form-control<%= errors.preferredLanguage ? ' is-invalid' : '' %>"
                         value="<%= values.preferredLanguage || '' %>" placeholder="e.g. en, bn, pt-br">
                  <% if (errors.preferredLanguage) { %><div class="invalid-feedback"><%= errors.preferredLanguage %></div><% } %>
                </div>
                <div class="col-md">
                  <label for="timezone" class="form-label">Timezone</label>
                  <select id="timezone" name="timezone" class="form-select<%= errors.timezone ? ' is-invalid' : '' %>">
                    <option value="">Not set</option>
                    <% timezones.forEach((tz) => { %><option value="<%= tz %>"<%= values.timezone === tz ? ' selected' : '' %>><%= tz %></option><% }) %>
                  </select>
                  <% if (errors.timezone) { %><div class="invalid-feedback"><%= errors.timezone %></div><% } %>
                </div>
              </div>
            </div>
            <div class="card-footer bg-transparent mt-auto">
              <div class="btn-list justify-content-end">
                <a href="/dashboard" class="btn btn-1">Cancel</a>
                <button type="submit" class="btn btn-primary btn-2">Save preferences</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
