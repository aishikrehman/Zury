<%# Word count: one article, many, or a Fountain editathon's articles, counted as Zury counts them. %>
<div class="page-body"><div class="container-xl">
  <h1 class="page-title mb-3"><i class="ti ti-abc me-1"></i><%= t('Word count') %></h1>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post" action="/tools/words" class="card mb-3"><div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%# Where the articles come from: a list, a Fountain editathon, or a Dashboard course. (CampWiz runs photo campaigns: nothing to count.) %>
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label" for="w-src"><%= t('From') %></label><select class="form-select" id="w-src" name="source"><% [['titles', 'Articles, by hand'], ['fountain', 'Fountain'], ['dashboard', 'Wikimedia Dashboard']].forEach(([k, l]) => { %><option value="<%= k %>"<%= (form.source || 'titles') === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select></div>
      <div class="col-md-8 z-src-titles"><label class="form-label" for="w-wiki"><%= t('Wiki') %></label><input class="form-control" id="w-wiki" name="wiki" value="<%= form.wiki %>"></div>
      <div class="col-12 z-src-titles"><label class="form-label" for="w-t"><%= t('Articles, one per line') %></label><textarea class="form-control" id="w-t" name="titles" rows="5"><%= form.titles %></textarea></div>
      <div class="col-md-8 z-src-link"><label class="form-label" for="w-f"><%= t('Link') %></label><input class="form-control" id="w-f" name="fountain" value="<%= form.fountain %>" placeholder="https://fountain.toolforge.org/editathons/… · https://outreachdashboard.wmflabs.org/courses/…/…"></div>
    </div>
  </div><div class="card-footer text-end"><button class="btn btn-primary" type="submit"><i class="ti ti-abc me-1"></i><%= t('Count') %></button></div></form>
  <% if (rows) { const total = rows.reduce((n, r) => n + (r.words || 0), 0); %>
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t('{n} articles', { n: formatNumber(rows.length) }) %> · <%= t('{n} words', { n: formatNumber(total) }) %></h3></div>
      <div class="table-responsive"><table class="table table-sm table-vcenter card-table">
        <thead><tr><th><%= t('Article') %></th><% if (rows.some((r) => r.wiki)) { %><th><%= t('Wiki') %></th><% } %><% if (rows.some((r) => r.user)) { %><th><%= t('Participant') %></th><% } %><th class="text-end"><%= t('Words') %></th></tr></thead>
        <tbody><% rows.forEach((r) => { %><tr><td><a href="<%= r.url %>" target="_blank" rel="noopener"><%= r.title %></a></td><% if (rows.some((x) => x.wiki)) { %><td class="text-secondary small"><%= r.wiki ? wikiLocal(r.wiki) : '' %></td><% } %><% if (rows.some((x) => x.user)) { %><td class="text-secondary"><%= r.user || '' %></td><% } %><td class="text-end"><%= r.words == null ? t('Not found') : formatNumber(r.words) %></td></tr><% }) %></tbody>
      </table></div>
    </div>
  <% } %>
</div></div>
