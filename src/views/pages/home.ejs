<%
  const now = Date.now();
  const typeIcon = TYPE_ICONS;
  const typeColor = TYPE_COLORS;
  const daysLeft = (c) => (c.endDate ? Math.max(0, Math.ceil((new Date(c.endDate) - now) / 86400000)) : null);
  const elapsed = (c) => {
    if (!c.startDate || !c.endDate) return 0;
    const total = new Date(c.endDate) - new Date(c.startDate);
    return Math.min(100, Math.max(0, Math.round(((now - new Date(c.startDate)) / total) * 100)));
  };
  const month = (d) => new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'UTC' }).format(new Date(d));
  const day = (d) => new Intl.DateTimeFormat('en', { day: 'numeric', timeZone: 'UTC' }).format(new Date(d));
  const fmt = formatNumber;
  const step = currentUser ? 2 : 1;
%>

<!-- Hero -->
<div class="z-hero">
  <div class="container-xl">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="badge bg-blue-lt mb-3"><i class="ti ti-world me-1"></i><%= t("For Wikimedia communities") %></span>
        <h1 class="display-5 lh-sm mb-3 z-gradient-text"><%= t("Run Wikimedia contests from one place.") %></h1>
        <p class="fs-2 text-secondary mb-4 lh-base">
          <%= t("Zury handles photo contests, writing contests, Wikidata drives and edit-a-thons: from registration and submissions to jury review and results.") %>
        </p>
        <div class="btn-list mb-4">
          <% if (currentUser) { %>
            <a href="/dashboard" class="btn btn-primary btn-lg"><i class="ti ti-layout-dashboard me-1"></i><%= t("Go to your dashboard") %></a>
          <% } else { %>
            <a href="/login" class="btn btn-primary btn-lg"><i class="ti ti-brand-wikipedia me-1"></i><%= t("Log in with Wikipedia") %></a>
          <% } %>
          <a href="/events/active" class="btn btn-lg"><i class="ti ti-calendar-event me-1"></i><%= t("Browse events") %></a>
        </div>
        <div class="d-flex flex-wrap gap-3 text-secondary small">
          <span><i class="ti ti-circle-check text-green me-1"></i><%= t("Uses your Wikimedia account") %></span>
          <span><i class="ti ti-circle-check text-green me-1"></i><%= t("Entries checked live on the wikis") %></span>
          <span><i class="ti ti-circle-check text-green me-1"></i><%= t("Open source") %></span>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="position-relative px-lg-4">
          <div class="card card-lg shadow-sm">
            <div class="card-body text-center py-5">
              <img src="/images/illustrations/contest.svg" alt="" class="img-fluid" style="max-height: 260px">
            </div>
          </div>
          <div class="card card-sm shadow position-absolute d-none d-md-block" style="right: -0.5rem; bottom: 1.5rem; width: 13rem">
            <div class="card-body d-flex align-items-center">
              <span class="avatar bg-green text-white me-3"><i class="ti ti-upload"></i></span>
              <div><div class="h3 m-0"><%= fmt(trend.values.reduce((a, b) => a + b, 0)) %></div><div class="text-secondary small"><%= t("entries this month") %></div></div>
            </div>
          </div>
          <div class="card card-sm shadow position-absolute d-none d-md-block" style="left: -0.5rem; top: 1.5rem; width: 12rem">
            <div class="card-body d-flex align-items-center">
              <span class="avatar bg-primary text-white me-3"><i class="ti ti-player-play"></i></span>
              <div><div class="h3 m-0"><%= active.length %></div><div class="text-secondary small"><%= t("events running now") %></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Numbers -->
    <div class="card mt-5">
      <div class="row g-0 text-center">
        <% [['calendar-event', 'blue', stats.events, 'Public events'], ['files', 'green', stats.submissions, 'Submissions'], ['users', 'orange', stats.users, 'Contributors'], ['world', 'purple', stats.wikis, 'Wikis']].forEach(([icon, color, value, label], i) => { %>
          <div class="col-6 col-md-3 py-4<%= i < 3 ? ' border-end' : '' %><%= i < 2 ? ' border-bottom border-md-bottom-0' : '' %>">
            <span class="avatar avatar-sm bg-<%= color %>-lt mb-2"><i class="ti ti-<%= icon %>"></i></span>
            <div class="h1 mb-0"><%= fmt(value) %></div>
            <div class="text-secondary"><%= label %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- Happening now -->
<section class="page-body">
  <div class="container-xl">
    <div class="d-flex align-items-end mb-3">
      <div>
        <div class="subheader"><%= t("Happening now") %></div>
        <h2 class="h1 mb-0"><%= t("Join an event") %></h2>
      </div>
      <a href="/events" class="ms-auto"><%= t("All events") %> <i class="ti ti-arrow-right"></i></a>
    </div>
    <div class="row row-cards">
      <div class="col-lg-8">
        <% if (!active.length) { %>
          <div class="card"><%- include('../partials/emptyArt', { title: t('No events are running right now'), text: t('Check the upcoming events, or come back soon.') }) %></div>
        <% } %>
        <div class="row row-cards">
          <% active.slice(0, 4).forEach((c) => { const left = daysLeft(c); %>
            <div class="col-md-6">
              <div class="card card-link card-link-pop h-100">
                <div class="card-body d-flex flex-column">
                  <div class="d-flex align-items-center mb-3">
                    <span class="avatar bg-<%= typeColor[c.type] %>-lt me-3"><i class="ti ti-<%= typeIcon[c.type] %>"></i></span>
                    <div class="text-secondary small"><%= CONTEST_TYPES[c.type] %><br><%= wikiName(c.primaryWiki) %></div>
                    <span class="badge bg-green-lt ms-auto"><span class="status-dot status-dot-animated bg-green me-1"></span><%= t("Open") %></span>
                  </div>
                  <h3 class="card-title mb-3"><a href="<%= eventPath(c) %>" class="stretched-link text-reset"><%= c.title %></a></h3>
                  <div class="mt-auto">
                    <div class="d-flex small mb-1">
                      <span class="text-secondary"><i class="ti ti-users me-1"></i><%= t('{n} taking part', { n: c._count.memberships }) %></span>
                      <span class="ms-auto fw-medium"><%= left === 0 ? 'Ends today' : `${left} day${left === 1 ? '' : 's'} left` %></span>
                    </div>
                    <div class="progress progress-sm"><div class="progress-bar bg-green" style="width: <%= elapsed(c) %>%" aria-label="<%= elapsed(c) %>% of the event has passed"></div></div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card h-100">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-clock me-2 text-azure"></i><%= t("Coming up") %></h3></div>
          <% if (!upcoming.length) { %>
            <div class="card-body text-secondary"><%= t("Nothing scheduled yet.") %></div>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% upcoming.slice(0, 5).forEach((c) => { %>
                <a href="<%= eventPath(c) %>" class="list-group-item list-group-item-action">
                  <div class="row align-items-center">
                    <div class="col-auto">
                      <div class="text-center rounded border px-2 py-1" style="min-width: 3rem">
                        <div class="small text-uppercase text-secondary lh-1"><%= c.startDate ? month(c.startDate) : '—' %></div>
                        <div class="h3 m-0"><%= c.startDate ? day(c.startDate) : '' %></div>
                      </div>
                    </div>
                    <div class="col text-truncate">
                      <div class="text-reset text-truncate"><%= c.title %></div>
                      <div class="text-secondary small"><%= CONTEST_TYPES[c.type] %> · <%= wikiName(c.primaryWiki) %></div>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } %>
          <div class="card-footer"><a href="/events/upcoming"><%= t("See all upcoming") %> <i class="ti ti-arrow-right"></i></a></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Event types -->
<section class="page-body">
  <div class="container-xl">
    <div class="text-center mb-4">
      <div class="subheader"><%= t("One tool, every format") %></div>
      <h2 class="h1"><%= t("Built for how Wikimedia communities work") %></h2>
    </div>
    <div class="row row-cards">
      <% [
        ['photo', 'Photo contests', 'Commons uploads checked for resolution, category and upload date. Made for Wiki Loves Monuments and Earth.', '/events?type=photo'],
        ['writing', 'Writing contests', 'Wikipedia articles checked for size, word count and creation date, with jury scoring.', '/events?type=writing'],
        ['data', 'Data contests', 'Wikidata items, properties and lexemes checked for required statements.', '/events?type=data'],
        ['editathon', 'Edit-a-thons', 'Registration with eligibility rules, participant tracking and organizer reports.', '/events?type=editathon'],
      ].forEach(([type, title, text, href]) => { %>
        <div class="col-sm-6 col-lg-3">
          <a href="<%= href %>" class="card card-link card-link-pop h-100">
            <div class="card-status-top bg-<%= typeColor[type] %>"></div>
            <div class="card-body">
              <span class="avatar avatar-md bg-<%= typeColor[type] %>-lt mb-3"><i class="ti ti-<%= typeIcon[type] %>"></i></span>
              <h3 class="card-title mb-2"><%= title %></h3>
              <p class="text-secondary mb-0"><%= text %></p>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- For organizers -->
<section class="page-body">
  <div class="container-xl">
    <div class="card">
      <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 p-4 p-lg-5">
          <div class="subheader"><%= t("For organizers and jury") %></div>
          <h2 class="h1 mb-3"><%= t("Everything a contest needs") %></h2>
          <ul class="list-unstyled space-y-3 mb-4">
            <% [
              ['shield-check', 'Permissions checked against Wikimedia: stewards, admins and organizers each see what they should.'],
              ['list-check', 'Rules for each event: dates in your timezone, eligibility, and settings for each event type.'],
              ['gavel', 'Jury review, appeals and results, with every decision recorded.'],
              ['chart-bar', 'Live statistics for every event, public if you choose.'],
            ].forEach(([icon, text]) => { %>
              <li class="d-flex mb-3"><span class="avatar avatar-sm bg-primary-lt me-3 flex-shrink-0"><i class="ti ti-<%= icon %>"></i></span><span class="pt-1"><%= text %></span></li>
            <% }) %>
          </ul>
        </div>
        <div class="col-lg-6 border-start bg-surface-secondary p-4 p-lg-5 d-flex flex-column justify-content-center">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-baseline mb-1">
                <div class="subheader"><%= t("Submissions across Zury") %></div>
                <span class="ms-auto badge bg-green-lt"><%= t("last 30 days") %></span>
              </div>
              <div class="h1 mb-2"><%= fmt(trend.values.reduce((a, b) => a + b, 0)) %></div>
              <%- include('../partials/chart', { spec: { type: 'area', height: 140, sparkline: true, series: [{ name: 'Submissions', data: trend.values }], labels: trend.labels, colors: ['primary'] }, label: t('Submissions per day across Zury, last 30 days') }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Recently completed -->
<% if (completed.length) { %>
  <section class="page-body">
    <div class="container-xl">
      <div class="d-flex align-items-end mb-3">
        <div><div class="subheader"><%= t("Recently completed") %></div><h2 class="h1 mb-0"><%= t("Past events") %></h2></div>
        <a href="/events/completed" class="ms-auto"><%= t("See all") %> <i class="ti ti-arrow-right"></i></a>
      </div>
      <div class="row row-cards">
        <% completed.slice(0, 3).forEach((c) => { %>
          <div class="col-md-4"><%- include('../partials/contestCard', { c, roles: [] }) %></div>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- Call to action -->
<section class="page-body mb-5">
  <div class="container-xl">
    <div class="card bg-primary text-primary-fg">
      <div class="card-body p-4 p-lg-5">
        <div class="row align-items-center g-4">
          <div class="col-lg">
            <h2 class="h1 mb-2"><%= t("Organizing a contest or an edit-a-thon?") %></h2>
            <p class="mb-0 opacity-75 fs-3"><%= t("Set it up in minutes. Your community logs in with Wikipedia, and Zury handles submissions and checks.") %></p>
          </div>
          <div class="col-lg-auto">
            <% if (currentUser) { %>
              <a href="<%= can('createEvent') ? '/events/create' : '/events' %>" class="btn btn-light btn-lg"><%= can('createEvent') ? 'Create an event' : 'Explore events' %></a>
            <% } else { %>
              <a href="/login" class="btn btn-light btn-lg"><i class="ti ti-brand-wikipedia me-1"></i><%= t("Log in with Wikipedia") %></a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
