<% const fmt = formatNumber; %>

<%# 1. Hero: full-width pictures behind the welcome, cross-fading. %>
<section class="z-hero2" data-carousel aria-roledescription="carousel" aria-label="<%= t('What Zury does') %>">
  <% const ZVD = 'https://commons.wikimedia.org/wiki/Category:Wikipedia_logo_variants_via_Stable_Diffusion_by_Ziko_van_Dijk';
     const slides = [
       ['bg-mural', 'A Wikipedia globe painted as a mural among flowers', 'Contests for every Wikimedia project', 'palette', 'Ziko van Dijk', 'Public domain', ZVD],
       ['bg-octopus', 'An octopus holding the Wikipedia globe, painted on a wall', 'Many events, one place to run them', 'stack-2', 'Ziko van Dijk', 'Public domain', ZVD],
       ['bg-mandala', 'The Wikimedia logo in a round Gayo-style ornament', 'One event, many wikis and languages', 'world', 'Gunarta (WMID)', 'CC BY-SA 4.0', 'https://commons.wikimedia.org/wiki/File:Roda_Wikimedia_Gaya_Gayo.png'],
       ['bg-culture', 'Symbols of culture and knowledge on blue', 'Open knowledge, counted fairly', 'scale', 'Matthias Wörle / MOR for Wikimedia Deutschland', 'CC BY 4.0', 'https://commons.wikimedia.org/wiki/File:Offene_Kulturdaten_Visual_(background_symbols_blue).png'],
       ['bg-batik', 'Wikimedia symbols in a batik pattern', 'Made for the Wikimedia movement', 'heart', 'Gunarta', 'CC BY-SA 4.0', 'https://commons.wikimedia.org/wiki/File:Batik_Sida_Wiki.png'],
     ]; %>
  <div class="z-slides">
    <% slides.forEach(([img, alt, caption, icon, by, lic, src], i) => { const set = `/images/art/${img}-640.webp 640w, /images/art/${img}-1000.webp 1000w, /images/art/${img}-1600.webp 1600w`; %>
      <figure class="z-slide<%= i === 0 ? ' is-on' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= formatNumber(i + 1) %> / <%= formatNumber(slides.length) %>"<%- i ? ' aria-hidden="true"' : '' %> data-caption="<%= t(caption) %>" data-icon="<%= icon %>" data-credit="<%= by %> · <%= lic === 'Public domain' ? t('Public domain') : lic %>" data-credit-href="<%= src %>">
        <img <%- i === 0 ? `src="/images/art/${img}-1000.webp" srcset="${set}" fetchpriority="high"` : `data-src="/images/art/${img}-1000.webp" data-srcset="${set}"` %> sizes="100vw" width="1600" height="615" alt="<%= t(alt) %>" decoding="async">
      </figure>
    <% }) %>
  </div>
  <div class="z-hero2-shade"></div>
  <div class="container-xl z-hero2-body">
    <div class="z-hero2-text">
      <h1 class="display-5 lh-sm mb-3"><%= t("Run Wikimedia contests from one place.") %></h1>
      <p class="fs-2 mb-4 lh-base"><%= t("Zury handles photo contests, writing contests, Wikidata drives and edit-a-thons: from registration and submissions to reviewers review and results.") %></p>
      <div class="btn-list mb-4">
        <% if (currentUser) { %>
          <a href="/dashboard" class="btn btn-primary btn-lg"><i class="ti ti-layout-dashboard me-1"></i><%= t("Go to your dashboard") %></a>
        <% } else { %>
          <a href="/login" class="btn btn-primary btn-lg"><i class="ti ti-brand-wikipedia me-1"></i><%= t("Log in with Wikipedia") %></a>
        <% } %>
        <a href="/events/active" class="btn btn-lg"><i class="ti ti-calendar-event me-1"></i><%= t("Browse events") %></a>
      </div>
    </div>
    <a class="z-hero2-credit" href="<%= slides[0][6] %>" target="_blank" rel="noopener"><i class="ti ti-copyright"></i><span><%= slides[0][4] %> · <%= t('Public domain') %></span></a>
    <div class="z-dots" role="tablist">
      <% slides.forEach((s, i) => { %><button type="button" class="<%= i === 0 ? 'is-on' : '' %>" data-slide="<%= i %>" aria-label="<%= t('Slide {n}', { n: formatNumber(i + 1) }) %>"></button><% }) %>
    </div>
  </div>
</section>

<%# 3. The movement in numbers (all time / this month), and the wikis on a map. %>
<%- include('../partials/homeStats') %>

<%# 4. Running now (with events ending soon), beside events by project and the series. %>
<section class="z-band is-soft">
  <div class="container-xl">
    <div class="row g-4">
      <div class="col-lg-8">
        <%- include('../partials/homeHead', { icon: 'player-play', title: t('Running now'), count: active.length, sub: t('Events open for entries right now, on every wiki.'), more: '/events/active' }) %>
        <% if (home.ending.length) { %>
          <div class="z-ending">
            <span class="z-ending-label"><i class="ti ti-hourglass-low"></i><%= t('Ending soon') %></span>
            <% home.ending.forEach((c) => { %><a class="z-ending-item" href="<%= eventPath(c) %>"><span class="text-truncate"><%= c.title %></span><span class="badge bg-<%= c.days <= 3 ? 'red' : 'orange' %>-lt"><%= c.days === 0 ? t('Ends today') : tn('{n} day left', '{n} days left', c.days) %></span></a><% }) %>
          </div>
        <% } %>
        <% if (!active.length) { %>
          <div class="card"><%- include('../partials/emptyArt', { title: t('No events are running right now.'), art: 'contest' }) %></div>
        <% } else { %>
          <div class="row row-cards">
            <% active.forEach((c) => { %><div class="col-md-6"><%- include('../partials/contestCard', { c, roles: [], photo: home.photos[c.id] }) %></div><% }) %>
          </div>
        <% } %>
      </div>
      <div class="col-lg-4">
        <%- include('../partials/homeHead', { icon: 'category', title: t('Events by project'), sub: t('Wikipedia, Commons, Wikidata and more.'), more: '/events' }) %>
        <div class="z-projects is-stack">
          <% home.projects.forEach((p) => { %>
            <a class="z-project card card-link" href="/events?project=<%= p.key %>" style="--z-proj: <%= p.color %>">
              <span class="z-project-ico"><i class="ti ti-<%= p.icon %>"></i></span>
              <span class="z-project-name"><%= t(p.label) %></span>
              <span class="z-project-n"><%= tn('{n} event', '{n} events', p.total) %><% if (p.running) { %> · <span class="text-green"><%= t('{n} running', { n: formatNumber(p.running) }) %></span><% } %></span>
            </a>
          <% }) %>
        </div>
        <% if (home.series.length) { %>
          <div class="mt-4"><%- include('../partials/homeHead', { icon: 'stack-2', title: t('Series'), sub: t('Events that come back every year.') }) %></div>
          <div class="z-series-grid is-stack">
            <% home.series.forEach((sr) => { %>
              <a class="card card-sm card-link d-flex flex-row align-items-center gap-3 p-3" href="/<%= sr.slug %>">
                <% if (sr.logoUrl) { %><img src="<%= sr.logoUrl %>" width="40" height="40" alt="" loading="lazy" style="object-fit: contain"><% } else { %><span class="avatar bg-primary-lt"><i class="ti ti-stack-2"></i></span><% } %>
                <span class="flex-fill min-w-0"><span class="d-block fw-medium text-truncate"><%= sr.title %></span><span class="small text-secondary text-truncate d-block"><%= sr.shortDescription || tn('{n} edition', '{n} editions', sr._count.editionRecords) %></span></span>
                <i class="ti ti-chevron-right text-secondary"></i>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/homeSections') %>
