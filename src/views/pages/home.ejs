<%
  const now = Date.now();
  const typeIcon = TYPE_ICONS;
  const typeColor = TYPE_COLORS;
  const daysLeft = (c) => (c.endDate ? Math.max(0, Math.ceil((new Date(c.endDate) - now) / 86400000)) : null);
  const elapsed = (c) => {
    if (!c.startDate || !c.endDate) return 0;
    const total = new Date(c.endDate) - new Date(c.startDate);
    return Math.min(100, Math.max(0, Math.round(((now - new Date(c.startDate)) / total) * 100)));
  };
  const month = (d) => new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'UTC' }).format(new Date(d));
  const day = (d) => new Intl.DateTimeFormat('en', { day: 'numeric', timeZone: 'UTC' }).format(new Date(d));
  const fmt = formatNumber;
  const step = currentUser ? 2 : 1;
%>

<!-- Hero -->
<div class="z-hero">
  <div class="container-xl">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1 class="display-5 lh-sm mb-3 z-gradient-text"><%= t("Run Wikimedia contests from one place.") %></h1>
        <p class="fs-2 text-secondary mb-4 lh-base">
          <%= t("Zury handles photo contests, writing contests, Wikidata drives and edit-a-thons: from registration and submissions to reviewers review and results.") %>
        </p>
        <div class="btn-list mb-4">
          <% if (currentUser) { %>
            <a href="/dashboard" class="btn btn-primary btn-lg"><i class="ti ti-layout-dashboard me-1"></i><%= t("Go to your dashboard") %></a>
          <% } else { %>
            <a href="/login" class="btn btn-primary btn-lg"><i class="ti ti-brand-wikipedia me-1"></i><%= t("Log in with Wikipedia") %></a>
          <% } %>
          <a href="/events/active" class="btn btn-lg"><i class="ti ti-calendar-event me-1"></i><%= t("Browse events") %></a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="position-relative px-lg-4">
          <figure class="z-hero-art">
            <img src="/images/art/hero-760.webp" srcset="/images/art/hero-480.webp 480w, /images/art/hero-760.webp 760w" sizes="(max-width: 991px) 92vw, 560px" width="760" height="518" alt="<%= t('A Wikipedia globe painted as a mural among flowers') %>" fetchpriority="high" decoding="async">
          </figure>
          <div class="card card-sm shadow position-absolute d-none d-md-block" style="right: -0.25rem; bottom: -1rem; width: 13rem">
            <div class="card-body d-flex align-items-center">
              <span class="avatar bg-green text-white me-3"><i class="ti ti-upload"></i></span>
              <div><div class="h3 m-0"><%= fmt(trend.values.reduce((a, b) => a + b, 0)) %></div><div class="text-secondary small"><%= t("entries this month") %></div></div>
            </div>
          </div>
          <div class="card card-sm shadow position-absolute d-none d-md-block" style="left: -0.25rem; top: -1rem; width: 12rem">
            <div class="card-body d-flex align-items-center">
              <span class="avatar bg-primary text-white me-3"><i class="ti ti-player-play"></i></span>
              <div><div class="h3 m-0"><%= active.length %></div><div class="text-secondary small"><%= t("events running now") %></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- The movement in numbers -->
    <div class="z-impact">
      <% [['align-justified', home.totals.words, 'words accepted'], ['file-text', home.totals.articles, 'articles accepted'], ['users', home.totals.people, 'contributors'], ['world', home.totals.wikis, 'wikis'], ['calendar-event', stats.events, 'public events']].forEach(([icon, value, label]) => { %>
        <div><i class="ti ti-<%= icon %>"></i><b data-count="<%= value %>"><%= fmt(value) %></b><span><%= t(label) %></span></div>
      <% }) %>
    </div>
  </div>
</div>


<section class="z-how">
  <div class="container-xl">
    <h2 class="z-how-title"><%= t('How Zury works') %></h2>
    <div class="row g-4">
      <% [['world', 'Set up an event for any wiki', 'Photo contests, writing contests, Wikidata drives or edit-a-thons, on one wiki or many, in a few steps.'], ['people', 'People take part', 'Participants log in with their Wikimedia account and submit; entries are checked against the rules as they come in.'], ['results', 'Review and results', 'Reviewers judge in a fast review window, the Patrol room watches for changes, and results publish with one click.']].forEach(([img, title, text], i) => { %>
        <div class="col-md-4">
          <div class="z-how-step">
            <img src="/images/art/<%= img %>.webp" width="160" height="160" alt="" loading="lazy" decoding="async">
            <div class="z-how-n"><%= formatNumber(i + 1) %></div>
            <h3><%= t(title) %></h3>
            <p><%= t(text) %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="z-art-credit"><%= t('Illustrations') %>: <a href="https://commons.wikimedia.org/wiki/File:2023-03_AI_images_ZvD_05.png" target="_blank" rel="noopener">Ziko van Dijk</a> (<%= t('public domain') %>); <a href="https://commons.wikimedia.org/wiki/Category:Movement_Strategy_graphics" target="_blank" rel="noopener">Wikimedia Movement Strategy graphics</a> (<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>), <%= t('cropped') %>.</p>
  </div>
</section>

<section class="page-body">
  <div class="container-xl">
    <div class="d-flex align-items-center gap-2 mb-3">
      <h2 class="m-0"><i class="ti ti-player-play text-green me-1"></i><%= t('Running now') %></h2>
      <span class="badge bg-green-lt"><%= formatNumber(active.length) %></span>
      <a class="ms-auto" href="/events/active"><%= t('All events') %> <i class="ti ti-arrow-right"></i></a>
    </div>
    <% if (!active.length) { %>
      <div class="card"><%- include('../partials/emptyArt', { title: t('No events are running right now.'), art: 'contest' }) %></div>
    <% } else { %>
      <div class="row row-cards">
        <% active.forEach((c) => { %><div class="col-md-6 col-lg-4"><%- include('../partials/contestCard', { c, roles: [] }) %></div><% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/homeSections') %>
