<div class="bg-light py-5">
  <div class="container text-center">
    <h1 class="display-5 fw-bold">Zury</h1>
    <p class="lead text-muted">A unified platform for Wikimedia contests and community events.</p>
    <a href="/events" class="btn btn-primary btn-lg mt-2">Browse events</a>
    <% if (!currentUser && demoMode) { %>
      <a href="/demo" class="btn btn-outline-secondary btn-lg mt-2 ms-2">Try a demo user</a>
    <% } %>
  </div>
</div>

<div class="container py-5">
  <% sections.forEach((section) => { %>
    <section class="mb-5">
      <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h4 mb-0"><%= section.heading %></h2>
        <a href="/events/<%= section.key %>" class="small">See all</a>
      </div>
      <% if (!section.items.length) { %>
        <p class="text-muted"><%= section.empty %></p>
      <% } else { %>
        <div class="row g-3">
          <% section.items.forEach((c) => { %>
            <div class="col-sm-6 col-lg-4"><%- include('../partials/contestCard', { c, roles: [] }) %></div>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% }) %>
</div>
