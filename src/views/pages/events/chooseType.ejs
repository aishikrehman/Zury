<%- include('../../partials/pageHeader', { pretitle: 'Create an event · step 1 of 2', heading: 'What kind of event is it?' }) %>
<div class="page-body"><div class="container-xl">
  
  <p class="text-muted">Step 1 of 2: what kind of event is it? The type can't be changed later.</p>
  <div class="row g-3">
    <% Object.entries(types).forEach(([key, t]) => { %>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body">
            <h2 class="h5"><a class="stretched-link text-decoration-none" href="/events/create?type=<%= key %>"><%= t.label %></a></h2>
            <p class="mb-0 text-muted"><%= t.description %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
</div>
