<% const icons = { photo: 'photo', writing: 'writing', data: 'database', editathon: 'users-group' }; const colors = { photo: 'blue', writing: 'green', data: 'purple', editathon: 'orange' }; %>
<%- include('../../partials/pageHeader', { pretitle: 'Create an event · step 1 of 2', heading: 'What kind of event is it?' }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row row-cards">
      <% Object.entries(types).forEach(([key, t]) => { %>
        <div class="col-md-6 col-lg-3">
          <a class="card card-link card-link-pop h-100" href="/events/create?type=<%= key %>">
            <div class="card-body text-center py-5">
              <span class="avatar avatar-xl rounded bg-<%= colors[key] %>-lt mb-3"><i class="ti ti-<%= icons[key] %>" style="font-size: 2rem"></i></span>
              <h3 class="card-title mb-1"><%= t.label %></h3>
              <p class="text-secondary mb-0"><%= t.description %></p>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
    <p class="text-secondary mt-3"><i class="ti ti-info-circle me-1"></i>The type can't be changed later.</p>
  </div>
</div>
