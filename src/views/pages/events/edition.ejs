<%
  const base = `/series/${sr.slug}/${edition.slug}`;
  const tabs = [['overview', 'layout-dashboard', t('Overview')], ['statistics', 'chart-bar', t('Statistics')], ...(canRun ? [['settings', 'settings', t('Settings')]] : [])];
  const CYCLES = { annual: 'Annual', season: 'Season', phase: 'Phase', special: 'Special', other: 'Other' };
  const dates = edition.startDate ? `<span><i class="ti ti-calendar"></i>${formatDate(edition.startDate)}${edition.endDate ? ` – ${formatDate(edition.endDate)}` : ''}</span>` : '';
  const day = (d) => (d ? new Date(d).toISOString().slice(0, 10) : '');
%>
<%- include('../../partials/levelHeader', { crumbs: [[t('Events'), '/events'], [sr.title, `/${sr.slug}`]], heading: edition.title, inline: canRun ? { action: `/series/${sr.slug}/${edition.slug}/update`, name: 'title', label: t('Title'), maxlength: 200, hidden: { description: edition.description, startDate: day(edition.startDate), endDate: day(edition.endDate), back: 'overview' } } : null, status: edition.status, meta: `<span class="badge bg-primary-lt fs-4">${h(digits(edition.identifier || edition.slug))}</span>${edition.cycleType ? `<span>${t(CYCLES[edition.cycleType] || edition.cycleType)}</span>` : ''}${dates}<span><i class="ti ti-calendar-event"></i>${tn('{n} event', '{n} events', events.length)}</span>`, base, tab, tabs }) %>
<div class="page-body">
  <div class="container-xl">

    <% if (tab === 'overview') { %>
      <% if (canRun) { %>
        <div class="d-flex justify-content-end mb-3"><div class="dropdown">
          <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-plus me-1"></i><%= t('Add event') %></button>
          <div class="dropdown-menu dropdown-menu-end">
            <a class="dropdown-item" href="/create/event?series=<%= sr.slug %>&edition=<%= edition.slug %>"><i class="ti ti-file-plus me-2"></i><%= t('New event') %></a>
            <% if (can('importEvents')) { %><button class="dropdown-item" type="button" data-bs-toggle="collapse" data-bs-target="#add-fountain"><i class="ti ti-download me-2"></i><%= t('Import or track') %></button><% } %>
          </div>
        </div></div>
        <% if (can('importEvents')) { %>
          <form method="post" action="/series/<%= sr.slug %>/<%= edition.slug %>/fountain" class="card collapse mb-3" id="add-fountain">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-download me-2"></i><%= t('Import or track') %></h3></div>
            <div class="card-body"><div class="row g-2 align-items-end">
              <div class="col-12"><label class="form-label" for="af-code"><%= t('Links, one per line (Fountain or CampWiz)') %></label><textarea class="form-control" id="af-code" name="code" rows="3" required placeholder="https://fountain.toolforge.org/editathons/wam2026-bn&#10;https://fountain.toolforge.org/editathons/wam2026-as&#10;https://campwiz.toolforge.org/campaign/… | Images from …"></textarea><div class="form-hint"><%= t('CampWiz: add its Commons category after a | on the same line.') %></div></div>
              <div class="col-6 col-md-3"><label class="form-label" for="af-mode"><%= t('How') %></label><select class="form-select" id="af-mode" name="mode"><option value="track"><%= t('Track only') %></option><option value="import"><%= t('Import as events') %></option></select></div>
              <% if (seriesType) { %><input type="hidden" name="type" value="<%= seriesType %>"><% } else { %><div class="col-6 col-md-3"><label class="form-label" for="af-type"><%= t('Type') %></label><select class="form-select" id="af-type" name="type"><option value="writing"><%= t('Writing contest') %></option><option value="editathon"><%= t('Edit-a-thon') %></option></select></div><% } %>
              <div class="col-6 col-md-3"><button class="btn btn-primary w-100" type="submit"><%= t('Continue') %></button></div>
            </div></div>
          </form>
        <% } %>
      <% } %>
      <% if (canRun) { %><div class="mb-3"><%- include('../../partials/inlineEdit', { action: `/series/${sr.slug}/${edition.slug}/update`, name: 'description', value: edition.description, label: t('Description'), multiline: true, maxlength: 2000, hidden: { title: edition.title, startDate: day(edition.startDate), endDate: day(edition.endDate), back: 'overview' }, viewTag: 'p', viewClass: 'text-secondary m-0', emptyText: t('Add a description') }) %></div>
      <% } else if (edition.description) { %><p class="text-secondary" style="white-space: pre-line"><%= edition.description %></p><% } %>
      <% if (events.length) { %><%- include('../../partials/levelStats', { totals, rows, rowTitle: t('Event'), chartTitle: t('Entries per event'), table: false }) %><% } %>
      <% if (nav.prev || nav.next || carry) { %>
        <div class="z-ed-strip mb-3">
          <% if (nav.prev) { %><a class="card card-sm card-link z-ed-nav" href="/<%= sr.slug %>/<%= nav.prev.slug %>"><div class="card-body"><i class="ti ti-chevron-left"></i><div><small class="text-secondary"><%= t('Previous edition') %></small><b><%= digits(nav.prev.identifier || nav.prev.slug) %></b><small class="text-secondary"><%= tn('{n} participant', '{n} participants', nav.prev.participants) %> · <%= tn('{n} entry', '{n} entries', nav.prev.entries) %></small></div></div></a><% } %>
          <% if (carry && carry.before) { const pct = Math.round((carry.back / carry.before) * 100); %>
            <div class="card card-sm z-ed-carry"><div class="card-body">
              <div class="d-flex align-items-center gap-2"><i class="ti ti-repeat text-primary fs-2"></i><div><b><%= formatNumber(carry.back) %></b> <span class="text-secondary"><%= t('of {n} from the previous edition came back', { n: formatNumber(carry.before) }) %></span></div></div>
              <div class="z-ks-bar"><i style="width: <%= pct %>%; background: var(--z-brand)"></i></div>
              <% if (canRun && !['completed', 'archived', 'cancelled'].includes(edition.status)) { %>
                <form method="post" action="/series/<%= sr.slug %>/<%= edition.slug %>/invite" class="d-flex flex-wrap gap-2 mt-2" data-confirm="<%= t('Send a bell notification to the people from the previous edition?') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select class="form-select form-select-sm w-auto" name="who" aria-label="<%= t('Who') %>"><option value="participants"><%= t('Participants') %></option><option value="reviewers"><%= t('Reviewers') %></option><option value="both"><%= t('Participants and reviewers') %></option></select>
                  <button class="btn btn-sm" type="submit"><i class="ti ti-bell me-1"></i><%= t('Invite them back') %></button>
                </form>
              <% } %>
            </div></div>
          <% } %>
          <% if (nav.next) { %><a class="card card-sm card-link z-ed-nav is-next" href="/<%= sr.slug %>/<%= nav.next.slug %>"><div class="card-body"><div><small class="text-secondary"><%= t('Next edition') %></small><b><%= digits(nav.next.identifier || nav.next.slug) %></b><small class="text-secondary"><%= tn('{n} participant', '{n} participants', nav.next.participants) %> · <%= tn('{n} entry', '{n} entries', nav.next.entries) %></small></div><i class="ti ti-chevron-right"></i></div></a><% } %>
        </div>
      <% } %>
      <% if (!events.length) { %>
        <div class="card"><%- include('../../partials/emptyArt', { title: t('No events in this edition yet') }) %></div>
      <% } else { %>
        <div class="row row-cards">
          <% events.forEach((c) => { %><div class="col-md-6 col-xl-4"><%- include('../../partials/contestCard', { c, roles: [] }) %></div><% }) %>
        </div>
      <% } %>


    <% } else if (tab === 'settings') { %>
      <% if (canRun) { %><%- include('../../partials/trackersManage', { trackers: typeof levelTrackers !== 'undefined' ? levelTrackers : [], trackAction: '/series/' + sr.slug + '/' + edition.slug + '/track' }) %><% } %>
      <form method="post" action="/series/<%= sr.slug %>/<%= edition.slug %>/update" class="card mb-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-info-circle me-2"></i><%= t('Details') %></h3></div>
        <div class="card-body"><div class="row g-3">
          <div class="col-12 col-md-6"><label class="form-label" for="ed-title"><%= t('Title') %></label><input class="form-control" id="ed-title" name="title" value="<%= edition.title %>" maxlength="200" required></div>
          <div class="col-6 col-md-3"><label class="form-label" for="ed-start"><%= t('Starts') %></label><input class="form-control" type="date" id="ed-start" name="startDate" value="<%= day(edition.startDate) %>"></div>
          <div class="col-6 col-md-3"><label class="form-label" for="ed-end"><%= t('Ends') %></label><input class="form-control" type="date" id="ed-end" name="endDate" value="<%= day(edition.endDate) %>"></div>
          <div class="col-12 col-md-6"><label class="form-label" for="ed-slug"><%= t('Address') %></label><div class="input-group"><span class="input-group-text"><%= siteHost %>/<%= sr.slug %>/</span><input class="form-control" id="ed-slug" name="slug" value="<%= edition.slug %>" maxlength="20"></div></div>
          <div class="col-6 col-md-3"><label class="form-label" for="ed-id"><%= t('Edition name') %></label><input class="form-control" id="ed-id" name="identifier" value="<%= edition.identifier || edition.slug %>" maxlength="100" placeholder="<%= t('2026, Season 2…') %>"></div>
          <div class="col-6 col-md-3"><label class="form-label" for="ed-cycle"><%= t('Kind') %></label><select class="form-select" id="ed-cycle" name="cycleType"><option value="">—</option><% Object.entries(CYCLES).forEach(([k, l]) => { %><option value="<%= k %>"<%= edition.cycleType === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ed-year"><%= t('Year') %></label><input class="form-control" type="number" id="ed-year" name="year" min="1900" max="2200" value="<%= edition.year || '' %>"></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ed-status"><%= t('Status') %></label><% if (edition.status === 'archived') { %><div class="form-control-plaintext"><%= t('Archived') %></div><% } else { %><select class="form-select" id="ed-status" name="status"><% [['draft', 'Draft'], ['planned', 'Planned'], ['upcoming', 'Upcoming'], ['active', 'Active'], ['completed', 'Completed'], ['cancelled', 'Cancelled']].forEach(([k, l]) => { %><option value="<%= k %>"<%= ownStatus === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select><% } %></div>
          <div class="col-md-2"><label class="form-label" for="ed-vis"><%= t('Who can see it') %></label><select class="form-select" id="ed-vis" name="visibility"><% [['public', 'Public'], ['unlisted', 'Link only'], ['private', 'Members only']].forEach(([k, l]) => { %><option value="<%= k %>"<%= (edition.visibility || 'public') === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select></div>
          <div class="col-12"><label class="form-label" for="ed-desc"><%= t('Description') %></label><textarea class="form-control" id="ed-desc" name="description" rows="2" maxlength="2000"><%= edition.description %></textarea></div>
          <div class="col-12"><button class="btn btn-primary" type="submit"><%= t('Save') %></button></div>
        </div></div>
      </form>

      <%- include('../../partials/levelSettings', { seriesSlug: sr.slug, editionId: edition.id, rules, history, KEYS }) %>

      <div class="row row-cards">
        <% if (canRunSeries) { %>
          <div class="col-md-8">
            <div class="card h-100">
              <div class="card-header"><h3 class="card-title"><i class="ti ti-copy me-2"></i><%= t('Copy edition') %></h3></div>
              <div class="card-body"><p class="text-secondary small"><%= t('Copy settings into a new edition. Participants, entries, reviews and results are not copied.') %></p>
                <a class="btn btn-primary" href="/series/<%= sr.slug %>/new-edition?method=copy&from=<%= edition.slug %>"><i class="ti ti-copy me-1"></i><%= t('Copy edition') %></a></div>
            </div>
          </div>
        <% } %>
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-archive me-2"></i><%= t('Archive') %></h3></div>
            <div class="card-body">
              <p class="text-secondary small"><%= edition.status === 'archived' ? t('This edition is archived.') : t('Archives the edition and its finished events. Not allowed while an event is running.') %></p>
              <form method="post" action="/series/<%= sr.slug %>/<%= edition.slug %>/<%= edition.status === 'archived' ? 'unarchive' : 'archive' %>" data-confirm="<%= edition.status === 'archived' ? t('Take this edition out of the archive?') : t('Archive this edition and its finished events?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit"><i class="ti ti-archive me-1"></i><%= edition.status === 'archived' ? t('Take out of the archive') : t('Archive') %></button></form>

            </div>
          </div>
        </div>
      </div>

      <%- include('../../partials/levelDelete', { inside, seriesSlug: sr.slug, editionSlug: edition.slug, canDelete: can('deleteAnything') }) %>

    <% } if (tab === 'settings' && canRun) { %>
      <%- include('../../partials/levelPeople', { seriesSlug: sr.slug, editionId: edition.id, people, inherited, ROLES }) %>
    <% } else if (tab === 'statistics') { %>
      <%- include('../../partials/trackers', { trackers: typeof trackers !== 'undefined' ? trackers : [], trackAction: null }) %>
      <% if (events.length) { %><% if (canRun && fountainCount) { %><form method="post" action="/series/<%= sr.slug %>/<%= edition.slug %>/fountain-sync" class="d-flex justify-content-end mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-primary" type="submit"><i class="ti ti-refresh me-1"></i><%= t('Update all from Fountain') %> (<%= formatNumber(fountainCount) %>)</button></form><% } %>
      <%- include('../../partials/levelStats', { totals, rows, wikiRows, rowTitle: t('Event'), chartTitle: t('Entries per event') }) %><% } else { %><div class="card"><%- include('../../partials/emptyArt', { title: t('No events in this edition yet') }) %></div><% } %>
    <% } %>
  </div>
</div>

