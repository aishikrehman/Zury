<%# Deleted series and editions: restore at the old address, or (superusers) remove for good. %>
<% const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`; %>
<%- include('../../partials/pageHeader', { pretitle: t('Event series'), heading: t('Deleted series and editions'), actions: '' }) %>
<div class="page-body"><div class="container-xl">
  <% [['series', list.series], ['edition', list.editions]].forEach(([kind, rows]) => { %>
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><%= kind === 'series' ? t('Series') : t('Editions') %></h3></div>
      <% if (!rows.length) { %><div class="card-body text-secondary"><%= t('Nothing deleted.') %></div><% } else { %>
        <div class="list-group list-group-flush">
          <% rows.forEach((r) => { %>
            <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
              <div class="min-w-0">
                <div class="fw-medium"><%= kind === 'edition' ? `${r.series.title} · ${r.identifier || r.originalSlug}` : r.title %></div>
                <div class="text-secondary small">/<%= kind === 'edition' ? `${r.series.slug}/` : '' %><%= r.originalSlug %> · <%= t('Deleted {date}', { date: formatDate(r.deletedAt) }) %></div>
              </div>
              <span class="ms-auto d-flex gap-1">
                <form method="post" action="/series/deleted/<%= kind %>/<%= r.id %>/restore"><%- csrf %><button class="btn btn-sm" type="submit"<%= kind === 'edition' && r.series.deletedAt ? ' disabled' : '' %>><i class="ti ti-arrow-back-up me-1"></i><%= t('Restore') %></button></form>
                <% if (can('deleteAnything')) { %><form method="post" action="/series/deleted/<%= kind %>/<%= r.id %>/purge" data-confirm="<%= t('Remove it for good? This cannot be undone.') %>"><%- csrf %><button class="btn btn-sm btn-ghost-danger" type="submit"><i class="ti ti-trash-x me-1"></i><%= t('Remove for good') %></button></form><% } %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% }) %>
</div></div>
