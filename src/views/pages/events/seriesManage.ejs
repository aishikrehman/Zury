<%# Series and their editions, for the people who run them: rename, describe, add next year's, open an edition's settings. %>
<%- include('../../partials/pageHeader', { pretitle: t('Event series'), heading: t('Series and editions'), actions: can('createEvent') ? `<a class="btn btn-primary" href="/series/new"><i class="ti ti-plus me-1"></i>${h(t('New series'))}</a>` : '' }) %>
<div class="page-body"><div class="container-xl">
  <% if (!seriesList.length) { %>
    <div class="card"><div class="card-body text-secondary"><%= t('You are not organizing any series yet. Make one, then create its first edition with “Part of” set to it.') %></div></div>
  <% } %>
  <% seriesList.forEach((sr) => { %>
    <div class="card mb-3">
      <div class="card-header flex-wrap gap-2">
        <div class="me-auto">
          <h3 class="card-title"><a href="/<%= sr.slug %>" class="text-reset"><%= sr.title %></a> <span class="text-secondary fw-normal small">/<%= sr.slug %></span></h3>
          <div class="text-secondary small"><%= tn('{n} edition', '{n} editions', sr.editions.length) %></div>
        </div>
        <% if (sr.editions.length) { %>
          <form method="post" action="/<%= sr.slug %>/next-edition" data-confirm="<%= t('Make next year’s edition from the latest one?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-sm" type="submit"><i class="ti ti-calendar-plus me-1"></i><%= t('Create next edition') %></button></form>
        <% } else { %>
          <a class="btn btn-primary btn-sm" href="/events/create"><i class="ti ti-calendar-plus me-1"></i><%= t('Create the first edition') %></a>
        <% } %>
        <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#edit-<%= sr.id %>" aria-expanded="false"><i class="ti ti-pencil me-1"></i><%= t('Edit') %></button>
      </div>
      <div class="collapse" id="edit-<%= sr.id %>">
        <form method="post" action="/series/<%= sr.slug %>/update" class="card-body border-bottom">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-2">
            <div class="col-md-4"><label class="form-label" for="t-<%= sr.id %>"><%= t('Name') %></label><input class="form-control" id="t-<%= sr.id %>" name="title" value="<%= sr.title %>" required maxlength="120"></div>
            <div class="col-md-8"><label class="form-label" for="d-<%= sr.id %>"><%= t('Description') %></label><input class="form-control" id="d-<%= sr.id %>" name="description" value="<%= sr.description %>" maxlength="2000"></div>
          </div>
          <div class="d-flex gap-2 mt-2">
            <button class="btn btn-primary btn-sm" type="submit"><%= t('Save') %></button>
            <% if (!sr.editions.length) { %><button class="btn btn-ghost-danger btn-sm ms-auto" type="submit" formaction="/series/<%= sr.slug %>/delete" data-confirm="<%= t('Delete this series?') %>"><i class="ti ti-trash me-1"></i><%= t('Delete series') %></button><% } %>
          </div>
        </form>
      </div>
      <% if (sr.editions.length) { %>
        <div class="table-responsive">
          <table class="table table-vcenter card-table">
            <thead><tr><th><%= t('Edition') %></th><th><%= t('Wikis') %></th><th><%= t('Starts') %></th><th><%= t('Status') %></th><th class="w-1"><span class="visually-hidden"><%= t('Actions') %></span></th></tr></thead>
            <tbody>
              <% sr.editions.forEach((e) => { const st = CONTEST_STATUSES[e.status] || { label: e.status, badge: 'secondary' }; %>
                <tr>
                  <td><a href="/<%= sr.slug %>/<%= e.edition %>" class="fw-bold"><%= e.edition %></a><div class="text-secondary small"><%= e.title %></div></td>
                  <td><div class="d-flex flex-wrap gap-1"><% e.wikis.forEach((w) => { %><span class="badge bg-blue-lt"><%= w.code %></span><% }) %></div></td>
                  <td class="text-secondary text-nowrap"><%= e.startDate ? formatDate(e.startDate) : '—' %></td>
                  <td><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span></td>
                  <td><div class="z-row-actions">
                    <a class="btn btn-sm btn-ghost-secondary btn-icon" href="/<%= sr.slug %>/<%= e.edition %>" title="<%= t('View') %>" aria-label="<%= t('View') %>"><i class="ti ti-eye"></i></a>
                    <a class="btn btn-sm btn-ghost-secondary btn-icon" href="/<%= sr.slug %>/<%= e.edition %>/config" title="<%= t('Configuration') %>" aria-label="<%= t('Configuration') %>"><i class="ti ti-settings"></i></a>
                  </div></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% }) %>
</div></div>
