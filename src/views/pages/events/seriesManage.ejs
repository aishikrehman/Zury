<%# Level 1: every series you run. Each leads to its own page. %>
<%- include('../../partials/pageHeader', { pretitle: t('Event series'), heading: t('Series and editions'), actions: `${can('deleteAnyEvent') ? `<a class="btn" href="/series/deleted"><i class="ti ti-trash me-1"></i>${h(t('Deleted'))}</a> ` : ''}${can('createEvent') ? `<a class="btn btn-primary" href="/series/new"><i class="ti ti-plus me-1"></i>${h(t('New series'))}</a>` : ''}` }) %>
<div class="page-body"><div class="container-xl">
  <% if (!seriesList.length) { %>
    <div class="card"><div class="card-body text-secondary"><%= t('You are not organizing any series yet. Make one, then create its first edition with “Part of” set to it.') %></div></div>
  <% } %>
  <div class="row row-cards">
    <% seriesList.forEach((sr) => { const latest = sr.editions[0]; %>
      <div class="col-md-6 col-lg-4">
        <a class="card card-link card-link-pop h-100 text-reset" href="/<%= sr.slug %>">
          <div class="card-body">
            <div class="d-flex align-items-center mb-2">
              <span class="avatar bg-primary-lt me-3"><i class="ti ti-stack-2"></i></span>
              <div class="min-w-0"><div class="fw-bold text-truncate"><%= sr.title %></div><div class="text-secondary small">/<%= sr.slug %></div></div>
              <i class="ti ti-chevron-right ms-auto text-secondary"></i>
            </div>
            <% if (sr.description) { %><p class="text-secondary small mb-2 text-truncate"><%= sr.description %></p><% } %>
            <div class="d-flex gap-3 small text-secondary">
              <span><strong class="text-body"><%= sr.editions.length %></strong> <%= tn('edition', 'editions', sr.editions.length) %></span>
              <% if (latest) { %><span><%= t('Latest: {edition}', { edition: latest.edition }) %></span><% } %>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div></div>
