<%# Level 3: one edition. Its numbers, its wikis (each with its own settings), and the way into everything else. %>
<%
  const path = '/' + sr.slug + '/' + edition.edition;
  const st = CONTEST_STATUSES[edition.status] || { label: edition.status, badge: 'secondary' };
  const wikiStatus = { active: ['green', t('Active')], paused: ['secondary', t('Paused')], pending: ['yellow', t('Waiting for approval')] };
%>
<div class="page-header d-print-none"><div class="container-xl">
  <ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/series"><%= t('Series and editions') %></a></li><li class="breadcrumb-item"><a href="/series/<%= sr.slug %>"><%= sr.title %></a></li><li class="breadcrumb-item active"><%= edition.edition %></li></ol>
  <div class="row g-2 align-items-center">
    <div class="col min-w-0">
      <h2 class="page-title"><%= edition.title %> <span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt ms-2"><%= st.label %></span></h2>
      <div class="text-secondary small"><%= edition.startDate ? formatDate(edition.startDate, edition.timezone) + ' – ' + formatDate(edition.endDate, edition.timezone) : t('Dates not set') %></div>
    </div>
    <div class="col-auto btn-list">
      <% if (others.length > 1) { %>
        <div class="dropdown">
          <button class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><%= t('Edition') %> <%= edition.edition %></button>
          <div class="dropdown-menu dropdown-menu-end"><% others.forEach((ed) => { %><a class="dropdown-item<%= ed === edition.edition ? ' active' : '' %>" href="/series/<%= sr.slug %>/<%= ed %>"><%= ed %></a><% }) %></div>
        </div>
      <% } %>
      <a class="btn" href="<%= path %>"><i class="ti ti-eye me-1"></i><%= t('Public page') %></a>
      <a class="btn btn-primary" href="<%= path %>/config"><i class="ti ti-settings me-1"></i><%= t('Event settings') %></a>
    </div>
  </div>
</div></div>
<div class="page-body"><div class="container-xl">
  <div class="row row-cards mb-3">
    <% [[t('Wikis'), wikis.length, 'world', path + '/config#wikis'], [t('Entries'), edition._count.submissions, 'files', path + '/submissions'], [t('Reviews'), edition._count.reviews, 'gavel', path + '/results'], [t('People'), edition._count.memberships, 'users', path + '/participants']].forEach(([label, value, icon, href]) => { %>
      <div class="col-6 col-lg-3">
        <a class="card card-sm card-link text-reset" href="<%= href %>"><div class="card-body d-flex align-items-center">
          <span class="avatar bg-primary-lt me-3"><i class="ti ti-<%= icon %>"></i></span>
          <div><div class="h2 m-0"><%= formatNumber(value) %></div><div class="text-secondary small"><%= label %></div></div>
        </div></a>
      </div>
    <% }) %>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t('Wikis') %></h3><div class="card-actions"><a class="btn btn-sm" href="<%= path %>/config#wikis"><i class="ti ti-plus me-1"></i><%= t('Add wiki') %></a></div></div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th><%= t('Wiki') %></th><th><%= t('Status') %></th><th class="text-end"><%= t('Entries') %></th><th class="text-end"><%= t('Participants') %></th><th class="text-end"><%= t('Organizers') %></th><th class="text-end"><%= t('Jury') %></th><th class="text-end"><%= t('Own settings') %></th><th class="w-1"><span class="visually-hidden"><%= t('Actions') %></span></th></tr></thead>
        <tbody>
          <% wikis.forEach((w) => { const [color, label] = wikiStatus[w.status] || ['secondary', w.status]; const pr = eventProject({ primaryWiki: w.wiki }); %>
            <tr>
              <td><div class="d-flex align-items-center"><span class="avatar avatar-sm me-2" style="background: color-mix(in srgb, <%= pr.color %> 14%, transparent); color: <%= pr.color %>"><i class="ti ti-<%= pr.icon %>"></i></span><div><div class="fw-medium"><%= wikiLocal(w.wiki) %></div><div class="text-secondary small"><%= path %>/<%= w.code %></div></div></div></td>
              <td><span class="badge bg-<%= color %>-lt"><%= label %></span></td>
              <td class="text-end"><%= formatNumber(w.entries) %></td>
              <td class="text-end"><%= formatNumber(w.participants) %></td>
              <td class="text-end"><%= formatNumber(w.organizers) %></td>
              <td class="text-end"><%= formatNumber(w.jury) %></td>
              <td class="text-end text-secondary"><%= w.own ? formatNumber(w.own) : '—' %></td>
              <td><div class="z-row-actions">
                <a class="btn btn-sm btn-ghost-secondary btn-icon" href="<%= path %>/<%= w.code %>" title="<%= t('View') %>" aria-label="<%= t('View') %>"><i class="ti ti-eye"></i></a>
                <a class="btn btn-sm btn-ghost-secondary btn-icon" href="<%= path %>/<%= w.code %>/config" title="<%= t('Settings for this wiki') %>" aria-label="<%= t('Settings for this wiki') %>"><i class="ti ti-settings"></i></a>
                <a class="btn btn-sm btn-ghost-secondary btn-icon" href="<%= path %>/<%= w.code %>/participants" title="<%= t('People') %>" aria-label="<%= t('People') %>"><i class="ti ti-users"></i></a>
              </div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div></div>
