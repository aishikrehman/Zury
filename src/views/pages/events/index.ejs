<%
  const base = filters.group ? `/events/${filters.group}` : '/events';
  const qs = (extra) => {
    const p = new URLSearchParams();
    if (filters.type) p.set('type', filters.type);
    if (filters.wiki) p.set('wiki', filters.wiki);
    if (filters.q) p.set('q', filters.q);
    if (filters.sort !== 'newest') p.set('sort', filters.sort);
    if (filters.project) p.set('project', filters.project);
    if (filters.view !== 'series') p.set('view', filters.view);
    Object.entries(extra).forEach(([k, v]) => p.set(k, v));
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const filtered = filters.type || filters.wiki || filters.q || filters.project;
  const groupLabels = { active: 'Active', upcoming: 'Upcoming', completed: 'Completed' };
%>
<div class="page-body">
  <div class="container-xl">
    <div class="z-events-head">
      <div>
        <h1 class="page-title m-0"><%= t(heading) %></h1>
        <div class="text-secondary small"><%= tn('{n} event', '{n} events', result.total) %></div>
      </div>
      <% if (can('createEvent')) { %><a class="btn btn-primary" href="/create/event"><i class="ti ti-plus me-1"></i><%= t('Create event') %></a><% } %>
    </div>
    <div class="z-events-toolbar">
      <form method="get" action="<%= base %>" class="z-events-filters">
        <select class="form-select form-select-sm" aria-label="<%= t('Status') %>" data-nav-select>
          <option value="/events<%= qs({}) %>"<%= !filters.group ? ' selected' : '' %>><%= t('All') %></option>
          <% groups.forEach((g) => { %><option value="/events/<%= g %><%= qs({}) %>"<%= filters.group === g ? ' selected' : '' %>><%= t(groupLabels[g]) %></option><% }) %>
        </select>
        <% if (filters.view !== 'series') { %><input type="hidden" name="view" value="<%= filters.view %>"><% } %>
        <div class="input-icon z-events-search"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input name="q" type="search" class="form-control form-control-sm" value="<%= filters.q %>" placeholder="<%= t('Title or community') %>" aria-label="<%= t('Search events') %>"></div>
        <select name="project" class="form-select form-select-sm" aria-label="<%= t('Project') %>" data-autosubmit>
          <option value=""><%= t('All projects') %></option>
          <% Object.entries(PROJECTS).forEach(([key, pr]) => { %><option value="<%= key %>"<%= filters.project === key ? ' selected' : '' %>><%= t(pr.label) %></option><% }) %>
        </select>
        <select name="type" class="form-select form-select-sm" aria-label="<%= t('Type') %>" data-autosubmit>
          <option value=""><%= t('All types') %></option>
          <% Object.entries(CONTEST_TYPES).forEach(([key, label]) => { %><option value="<%= key %>"<%= filters.type === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
        </select>
        <select name="wiki" class="form-select form-select-sm" aria-label="<%= t('Wiki') %>" data-autosubmit>
          <option value=""><%= t('All wikis') %></option>
          <% result.wikis.forEach((w) => { %><option value="<%= w %>"<%= filters.wiki === w ? ' selected' : '' %>><%= wikiLocal(w) %></option><% }) %>
        </select>
        <select name="sort" class="form-select form-select-sm" aria-label="<%= t('Sort') %>" data-autosubmit>
          <% [['newest', 'Newest first'], ['soonest', 'Oldest first'], ['title', 'Title']].forEach(([key, label]) => { %><option value="<%= key %>"<%= filters.sort === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
        </select>
        <% if (filtered) { %><a class="btn btn-sm btn-ghost-secondary" href="<%= base %>"><i class="ti ti-x me-1"></i><%= t('Reset') %></a><% } %>
      </form>
      <div class="z-seg" role="group" aria-label="<%= t('View') %>">
        <a class="<%= filters.view === 'series' ? 'active' : '' %>" href="<%= base %><%= qs({ view: 'series' }).replace('view=series', '').replace(/[?&]$/, '').replace('?&', '?') %>" title="<%= t('By series') %>" aria-label="<%= t('By series') %>"><i class="ti ti-stack-2"></i></a>
        <a class="<%= filters.view === 'all' ? 'active' : '' %>" href="<%= base %><%= qs({ view: 'all' }) %>" title="<%= t('All') %>" aria-label="<%= t('All') %>"><i class="ti ti-layout-grid"></i></a>
        <a class="<%= filters.view === 'list' ? 'active' : '' %>" href="<%= base %><%= qs({ view: 'list' }) %>" title="<%= t('List') %>" aria-label="<%= t('List') %>"><i class="ti ti-list"></i></a>
      </div>
    </div>
    <div>
        <% if (!result.items.length) { %>
          <div class="card">
            <div class="empty">
              <div class="empty-icon"><i class="ti ti-calendar-off icon"></i></div>
              <p class="empty-title"><%= t("No events found") %></p>
              <p class="empty-subtitle text-secondary"><%= t("Try a different search or remove some filters.") %></p>
              <div class="empty-action"><a href="/events" class="btn btn-primary"><%= t("Show all events") %></a></div>
            </div>
          </div>
        <% } else { %>
          <% if (filters.view === 'list') { %>
            <div class="card">
              <div class="table-responsive">
                <table class="table table-vcenter card-table z-ev-table">
                  <thead><tr><th><%= t('Event') %></th><th><%= t('Type') %></th><th><%= t('Dates') %></th><th class="text-end"><%= t('Participants') %></th><th><%= t('Status') %></th></tr></thead>
                  <tbody>
                    <% result.items.forEach((c) => { const pr = eventProject(c); const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
                      <tr class="z-proj" style="--z-proj: <%= pr.color %>">
                        <td>
                          <div class="d-flex align-items-center">
                            <span class="avatar avatar-sm z-proj-icon me-2" title="<%= pr.label %>"><i class="ti ti-<%= pr.icon %>"></i></span>
                            <div class="min-w-0"><a href="<%= eventPath(c) %>" class="fw-medium text-reset"><%= c.title %></a><div class="small"><span class="z-proj-name"><%= pr.label %></span> · <%= c.wikis && c.wikis.length > 1 ? tn('{n} wiki', '{n} wikis', c.wikis.length) : (c.primaryWiki === 'metawiki' && c.wikis && !c.wikis.length ? t('No wikis yet') : wikiLocal(c.primaryWiki)) %></div></div>
                          </div>
                        </td>
                        <td class="text-secondary"><%= CONTEST_TYPES[c.type] %></td>
                        <td class="text-secondary text-nowrap"><%= c.startDate ? formatDate(c.startDate, c.timezone) + ' – ' + formatDate(c.endDate, c.timezone) : '—' %></td>
                        <td class="text-end"><%= formatNumber(c._count ? c._count.memberships : 0) %></td>
                        <td><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= t(st.label) %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } else { %>
          <% if (!filters.group) { %>
            <%
              // All events: in sections — running first, then upcoming (cards), then finished (compact rows).
              const sectionOf = (c) => STATUS_GROUPS.active.includes(c.status) || c.status === 'paused' ? 'active' : STATUS_GROUPS.upcoming.includes(c.status) || c.status === 'draft' ? 'upcoming' : 'completed';
              const sections = [['active', t('Running'), 'player-play'], ['upcoming', t('Upcoming'), 'calendar-event'], ['completed', t('Finished'), 'flag-check']];
            %>
            <% sections.forEach(([key, label, icon]) => { const list = result.items.filter((c) => sectionOf(c) === key); if (!list.length) return; %>
              <section class="z-ev-section is-<%= key %>">
                <h2 class="z-ev-section-head"><i class="ti ti-<%= icon %>"></i><%= label %><span class="z-ev-count"><%= formatNumber(list.length) %></span><a class="ms-auto small" href="/events/<%= key %><%= qs({}) %>"><%= t('Only these') %> <i class="ti ti-arrow-right"></i></a></h2>
                <% if (key !== 'completed') { %>
                  <%# Grouped by series (a tree: series → its events, by language); events outside a series last. %>
                  <% const sOf = (c) => (c.editionOf && c.editionOf.series) || c.series || null; const groups = new Map(); const grouped = filters.view === 'series';
                     list.forEach((c) => { const sr = grouped ? sOf(c) : null; const ed = sr && c.editionOf && c.editionOf.slug ? c.editionOf : null; const g = ed ? 'e' + c.editionId : sr ? 's' + sr.slug : '~'; if (!groups.has(g)) groups.set(g, { sr, ed, items: [] }); groups.get(g).items.push(c); });
                     const ordered = [...groups.values()].sort((x, y) => (x.sr ? 0 : 1) - (y.sr ? 0 : 1) || (x.sr && y.sr ? x.sr.title.localeCompare(y.sr.title) : 0)); %>
                  <%# One grid: a series is one card holding its events; other events are their own cards beside them. %>
                  <% const srGroups = ordered.filter((g) => g.sr); const loose = ordered.filter((g) => !g.sr); %>
                  <% [srGroups, loose].forEach((part, pi) => { if (!part.length) return; %>
                  <% if (pi === 1 && srGroups.length) { %><div class="z-ev-subhead"><i class="ti ti-calendar-event"></i><%= t('Other events') %><span class="z-ev-count"><%= formatNumber(part.reduce((n, g) => n + g.items.length, 0)) %></span></div><% } %>
                  <div class="row row-cards<%= pi === 0 && loose.length ? ' mb-3' : '' %>">
                  <% part.forEach((g) => { g.items.sort((x, y) => String(x.language || x.primaryWiki).localeCompare(String(y.language || y.primaryWiki))); %>
                    <% if (g.sr) { const wide = g.items.length >= 4; const cap = wide ? 24 : 5; if (wide) g.items.sort((x, y) => wikiLocal(x.primaryWiki).localeCompare(wikiLocal(y.primaryWiki), 'bn')); const P0 = eventProject(g.items[0]); const allWp = wide && g.items.every((c) => eventProject(c).key === 'wikipedia'); const eds = [...new Set(g.items.map((c) => c.editionOf && c.editionOf.title).filter(Boolean))];
                         const st0 = g.items.map((c) => c.startDate).filter(Boolean).sort()[0]; const en0 = g.items.map((c) => c.endDate).filter(Boolean).sort().pop(); %>
                      <div class="<%= wide ? 'col-12' : 'col-sm-6 col-lg-4 col-xxl-3' %>">
                        <div class="card h-100 z-sr-card<%= wide ? ' is-wide' : '' %>">
                          <a class="z-sr-card-head" href="/<%= g.sr.slug %><%= g.ed ? '/' + g.ed.slug : '' %>">
                            <span class="z-sr-card-logo"><% if (g.sr.logoUrl) { %><img src="<%= g.sr.logoUrl %>" alt="" loading="lazy"><% } else { %><i class="ti ti-stack-2" style="color: <%= P0.color %>"></i><% } %></span>
                            <span class="min-w-0"><span class="z-sr-card-title"><%= g.sr.title %></span><span class="z-sr-card-sub"><%= eds.length === 1 ? (digits(eds[0].replace(g.sr.title, '').trim()) || eds[0]) + ' · ' : '' %><%= tn('{n} event', '{n} events', g.items.length) %></span></span>
                          </a>
                          <% if (st0 || en0) { %><div class="z-sr-card-when"><i class="ti ti-calendar"></i><%= st0 ? formatDate(st0) : '' %> – <%= en0 ? formatDate(en0) : '' %></div><% } %>
                          <div class="z-sr-card-list">
                            <% g.items.slice(0, cap).forEach((c) => { const P = eventProject(c); %>
                              <a class="z-sr-item st-<%= c.status %>" href="<%= c.path %>" title="<%= c.title %>">
                                <i class="ti ti-<%= P.icon %>" style="color: <%= P.color %>"></i>
                                <span class="z-sr-item-name"><%= allWp ? wikiLocal(c.primaryWiki).replace(/\s*উইকিপিডিয়া$/, '') : wikiLocal(c.primaryWiki) %></span>
                                <% const dl = c.endDate ? Math.ceil((new Date(c.endDate) - Date.now()) / 86400000) : null; const ds = c.startDate ? Math.ceil((new Date(c.startDate) - Date.now()) / 86400000) : null; %><span class="z-sr-item-date"><%= ds != null && ds > 0 ? tn('Starts in {n} day', 'Starts in {n} days', ds) : dl != null && dl >= 0 ? tn('{n} day left', '{n} days left', dl) : '' %></span>
                                <i class="z-dot"></i>
                              </a>
                            <% }) %>
                            <% if (g.items.length > cap) { %><a class="z-sr-more" href="/<%= g.sr.slug %><%= g.ed ? '/' + g.ed.slug : '' %>"><%= t('{n} more', { n: formatNumber(g.items.length - cap) }) %> <i class="ti ti-arrow-right"></i></a><% } %>
                          </div>
                        </div>
                      </div>
                    <% } else { g.items.forEach((c) => { %>
                      <div class="col-sm-6 col-lg-4 col-xxl-3"><%- include('../../partials/contestCard', { c, roles: [] }) %></div>
                    <% }) } %>
                  <% }) %>
                  </div>
                  <% }) %>
                <% } else { %>
                  <div class="z-ev-done">
                    <% list.forEach((c, i) => { const pr = eventProject(c); %>
                      <a class="z-ev-row z-proj<%= i >= 12 ? ' is-more' : '' %>" style="--z-proj: <%= pr.color %>" href="<%= eventPath(c) %>">
                        <% if (c.logoUrl) { %><span class="avatar avatar-sm z-ev-logo"><img src="<%= c.logoUrl %>" alt="" loading="lazy"></span><% } else { %><span class="avatar avatar-sm z-proj-icon"><i class="ti ti-<%= pr.icon %>"></i></span><% } %>
                        <span class="z-ev-row-main"><span class="z-ev-row-title"><%= c.title %></span><span class="z-ev-row-sub"><%= c.wikis && c.wikis.length > 1 ? tn('{n} wiki', '{n} wikis', c.wikis.length) : wikiLocal(c.primaryWiki) %> · <%= CONTEST_TYPES[c.type] %></span></span>
                        <span class="z-ev-row-date"><%= c.startDate ? formatDate(c.endDate || c.startDate, c.timezone) : '' %></span>
                        <span class="z-ev-row-people" title="<%= t('Participants') %>"><i class="ti ti-users"></i><%= formatNumber(c._count ? c._count.memberships : 0) %></span>
                      </a>
                    <% }) %>
                    <% if (list.length > 12) { %><button type="button" class="z-ev-more" data-show-more><%= t('Show {n} more', { n: formatNumber(list.length - 12) }) %></button><% } %>
                  </div>
                <% } %>
              </section>
            <% }) %>
          <% } else { %>
          <div class="row row-cards">
            <% result.items.forEach((c) => { %>
              <div class="col-sm-6 col-lg-4 col-xxl-3"><%- include('../../partials/contestCard', { c, roles: [] }) %></div>
            <% }) %>
          </div>
          <% } %>
          <% } %>
        <% } %>
        <% if (result.pages > 1) { %>
          <div class="d-flex mt-4">
            <ul class="pagination ms-auto">
              <li class="page-item<%= result.page === 1 ? ' disabled' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: result.page - 1 }) %>"><i class="ti ti-chevron-left"></i><%= t("prev") %></a></li>
              <% for (let i = 1; i <= result.pages; i++) { %>
                <li class="page-item<%= i === result.page ? ' active' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: i }) %>"><%= i %></a></li>
              <% } %>
              <li class="page-item<%= result.page === result.pages ? ' disabled' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: result.page + 1 }) %>"><%= t("next") %><i class="ti ti-chevron-right"></i></a></li>
            </ul>
          </div>
        <% } %>
    </div>
  </div>
</div>
