<%
  const base = filters.group ? `/events/${filters.group}` : '/events';
  const qs = (extra) => {
    const p = new URLSearchParams();
    if (filters.type) p.set('type', filters.type);
    if (filters.wiki) p.set('wiki', filters.wiki);
    if (filters.q) p.set('q', filters.q);
    if (filters.sort !== 'newest') p.set('sort', filters.sort);
    if (filters.project) p.set('project', filters.project);
    if (filters.view !== 'grid') p.set('view', filters.view);
    Object.entries(extra).forEach(([k, v]) => p.set(k, v));
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const filtered = filters.type || filters.wiki || filters.q || filters.project;
  const groupLabels = { active: 'Active', upcoming: 'Upcoming', completed: 'Completed' };
%>
<div class="page-body">
  <div class="container-xl">
    <div class="z-events-head">
      <div>
        <h1 class="page-title m-0"><%= t(heading) %></h1>
        <div class="text-secondary small"><%= tn('{n} event', '{n} events', result.total) %></div>
      </div>
      <% if (can('createEvent')) { %><a class="btn btn-primary" href="/events/create"><i class="ti ti-plus me-1"></i><%= t('Create event') %></a><% } %>
    </div>
    <div class="z-events-toolbar">
      <nav class="z-seg" aria-label="<%= t('Events') %>">
        <a class="<%= !filters.group ? 'active' : '' %>" href="/events<%= qs({}) %>"><%= t('All') %></a>
        <% groups.forEach((g) => { %><a class="<%= filters.group === g ? 'active' : '' %>" href="/events/<%= g %><%= qs({}) %>"><%= t(groupLabels[g]) %></a><% }) %>
      </nav>
      <form method="get" action="<%= base %>" class="z-events-filters">
        <% if (filters.view !== 'grid') { %><input type="hidden" name="view" value="<%= filters.view %>"><% } %>
        <div class="input-icon z-events-search"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input name="q" type="search" class="form-control form-control-sm" value="<%= filters.q %>" placeholder="<%= t('Title or community') %>" aria-label="<%= t('Search events') %>"></div>
        <select name="project" class="form-select form-select-sm" aria-label="<%= t('Project') %>" data-autosubmit>
          <option value=""><%= t('All projects') %></option>
          <% Object.entries(PROJECTS).forEach(([key, pr]) => { %><option value="<%= key %>"<%= filters.project === key ? ' selected' : '' %>><%= t(pr.label) %></option><% }) %>
        </select>
        <select name="type" class="form-select form-select-sm" aria-label="<%= t('Type') %>" data-autosubmit>
          <option value=""><%= t('All types') %></option>
          <% Object.entries(CONTEST_TYPES).forEach(([key, label]) => { %><option value="<%= key %>"<%= filters.type === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
        </select>
        <select name="wiki" class="form-select form-select-sm" aria-label="<%= t('Wiki') %>" data-autosubmit>
          <option value=""><%= t('All wikis') %></option>
          <% result.wikis.forEach((w) => { %><option value="<%= w %>"<%= filters.wiki === w ? ' selected' : '' %>><%= wikiLocal(w) %></option><% }) %>
        </select>
        <select name="sort" class="form-select form-select-sm" aria-label="<%= t('Sort') %>" data-autosubmit>
          <% [['newest', 'Newest first'], ['soonest', 'Oldest first'], ['title', 'Title']].forEach(([key, label]) => { %><option value="<%= key %>"<%= filters.sort === key ? ' selected' : '' %>><%= t(label) %></option><% }) %>
        </select>
        <% if (filtered) { %><a class="btn btn-sm btn-ghost-secondary" href="<%= base %>"><i class="ti ti-x me-1"></i><%= t('Reset') %></a><% } %>
      </form>
      <div class="z-seg" role="group" aria-label="<%= t('View') %>">
        <a class="<%= filters.view === 'grid' ? 'active' : '' %>" href="<%= base %><%= qs({ view: 'grid' }).replace('view=grid', '').replace(/[?&]$/, '') %>" title="<%= t('Cards') %>" aria-label="<%= t('Cards') %>"><i class="ti ti-layout-grid"></i></a>
        <a class="<%= filters.view === 'list' ? 'active' : '' %>" href="<%= base %><%= qs({ view: 'list' }) %>" title="<%= t('List') %>" aria-label="<%= t('List') %>"><i class="ti ti-list"></i></a>
      </div>
    </div>
    <div>
        <% if (!result.items.length) { %>
          <div class="card">
            <div class="empty">
              <div class="empty-icon"><i class="ti ti-calendar-off icon"></i></div>
              <p class="empty-title"><%= t("No events found") %></p>
              <p class="empty-subtitle text-secondary"><%= t("Try a different search or remove some filters.") %></p>
              <div class="empty-action"><a href="/events" class="btn btn-primary"><%= t("Show all events") %></a></div>
            </div>
          </div>
        <% } else { %>
          <% if (filters.view === 'list') { %>
            <div class="card">
              <div class="table-responsive">
                <table class="table table-vcenter card-table z-ev-table">
                  <thead><tr><th><%= t('Event') %></th><th><%= t('Type') %></th><th><%= t('Dates') %></th><th class="text-end"><%= t('Participants') %></th><th><%= t('Status') %></th></tr></thead>
                  <tbody>
                    <% result.items.forEach((c) => { const pr = eventProject(c); const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
                      <tr class="z-proj" style="--z-proj: <%= pr.color %>">
                        <td>
                          <div class="d-flex align-items-center">
                            <span class="avatar avatar-sm z-proj-icon me-2" title="<%= pr.label %>"><i class="ti ti-<%= pr.icon %>"></i></span>
                            <div class="min-w-0"><a href="<%= eventPath(c) %>" class="fw-medium text-reset"><%= c.title %></a><div class="small"><span class="z-proj-name"><%= pr.label %></span> · <%= c.wikis && c.wikis.length > 1 ? tn('{n} wiki', '{n} wikis', c.wikis.length) : (c.primaryWiki === 'metawiki' && c.wikis && !c.wikis.length ? t('No wikis yet') : wikiLocal(c.primaryWiki)) %></div></div>
                          </div>
                        </td>
                        <td class="text-secondary"><%= CONTEST_TYPES[c.type] %></td>
                        <td class="text-secondary text-nowrap"><%= c.startDate ? formatDate(c.startDate, c.timezone) + ' – ' + formatDate(c.endDate, c.timezone) : '—' %></td>
                        <td class="text-end"><%= formatNumber(c._count ? c._count.memberships : 0) %></td>
                        <td><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= t(st.label) %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } else { %>
          <div class="row row-cards">
            <% result.items.forEach((c) => { %>
              <div class="col-sm-6 col-lg-4 col-xxl-3"><%- include('../../partials/contestCard', { c, roles: [] }) %></div>
            <% }) %>
          </div>
          <% } %>
        <% } %>
        <% if (result.pages > 1) { %>
          <div class="d-flex mt-4">
            <ul class="pagination ms-auto">
              <li class="page-item<%= result.page === 1 ? ' disabled' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: result.page - 1 }) %>"><i class="ti ti-chevron-left"></i><%= t("prev") %></a></li>
              <% for (let i = 1; i <= result.pages; i++) { %>
                <li class="page-item<%= i === result.page ? ' active' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: i }) %>"><%= i %></a></li>
              <% } %>
              <li class="page-item<%= result.page === result.pages ? ' disabled' : '' %>"><a class="page-link" href="<%= base %><%= qs({ page: result.page + 1 }) %>"><%= t("next") %><i class="ti ti-chevron-right"></i></a></li>
            </ul>
          </div>
        <% } %>
    </div>
  </div>
</div>
