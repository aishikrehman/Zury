<%- include('../../partials/pageHeader', { pretitle: t('Event management'), heading: t('Import from Fountain') }) %>
<div class="page-body">
  <div class="container-xl" style="max-width: 44rem">
    <form method="post" action="/events/import" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <p class="text-secondary"><%= t('Bring an editathon from Fountain into Zury. Its articles become entries, the Fountain reviewers decides them, and Zury keeps them up to date every hour.') %></p>
        <label class="form-label" for="code"><%= t('Fountain editathon code or address') %></label>
        <input class="form-control<%= error ? ' is-invalid' : '' %>" id="code" name="code" value="<%= value %>" placeholder="https://fountain.toolforge.org/editathons/…" required autofocus>
        <% if (error) { %><div class="invalid-feedback"><%= error %></div><% } %>
        <label class="form-label mt-3" for="target"><%= t("Import into") %></label>
        <select class="form-select" id="target" name="target" data-import-target>
          <option value=""><%= t("A new event") %></option>
          <% if (events.length) { %><optgroup label="<%= t('An existing event, as one more wiki') %>">
            <% events.forEach((e) => { %><option value="<%= e.id %>"<%= String(e.id) === target ? ' selected' : '' %>><%= e.label %></option><% }) %>
          </optgroup><% } %>
        </select>
        <div data-new-only<%- target ? ' hidden' : '' %>>
        <label class="form-label mt-3" for="type"><%= t("Type") %></label>
        <select class="form-select" id="type" name="type">
          <% types.forEach((k) => { %><option value="<%= k %>"<%= k === type ? ' selected' : '' %>><%= t(CONTEST_TYPES[k]) %></option><% }) %>
        </select>
        </div>
      </div>
      <div class="card-footer d-flex justify-content-end">
        <button class="btn btn-primary" type="submit"><%= t('Import') %></button>
      </div>
    </form>
  </div>
</div>
