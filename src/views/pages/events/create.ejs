<%
  const ICONS = { writing: 'file-text', editathon: 'edit', photo: 'camera', photowalk: 'walk', data: 'database', proofread: 'book', digitization: 'scan', glam: 'building-bank', workshop: 'presentation', training: 'school' };
  const ORDER = ['writing', 'editathon', 'photo', 'photowalk', 'data', 'proofread', 'digitization', 'glam', 'workshop', 'training'];
  const keep = new URLSearchParams({ ...(form.seriesSlug && { series: form.seriesSlug }), ...(form.edition && { edition: form.edition }) });
%>
<%- include('../../partials/createTabs', { kind: 'event' }) %>
<div class="page-body">
  <div class="container-xl">
    <% if (!typeDef) { %>
      <%
        // One card per kind, each with its own colour; kinds that don't fully work yet come last.
        const CARDS = [
          { key: 'writing', icon: 'writing', color: '#3366cc', name: 'Writing contest', desc: 'Wikipedia, Wiktionary, Wikibooks or any text wiki; words or entries counted' },
          { key: 'data', icon: 'database', color: '#990000', name: 'Data/Lexeme event', desc: 'Wikidata items and lexemes, many at a time' },
          { key: 'photo', icon: 'camera', color: '#339966', name: 'Photo contest', desc: 'Photos on Commons, judged in rounds' },
          { key: 'audio', icon: 'microphone', color: '#d6336c', name: 'Audio edit-a-thon', desc: 'Recordings on Commons: pronunciations, spoken articles, songs' },
          { key: 'proofread', project: 'wikisource', icon: 'book', color: '#006699', name: 'Wikisource proofreading', desc: 'Proofread scanned pages for points' },
          { key: 'workshop', icon: 'presentation', color: '#ac6600', name: 'Sessions', desc: 'Registration and attendance, certificates' },
          { key: 'editathon', icon: 'edit', color: '#72777d', name: 'Edit-a-thon', desc: 'Edits counted over the dates', soon: true },
          { key: 'photowalk', icon: 'walk', color: '#72777d', name: 'Photowalk', desc: 'A walk with a meeting point', soon: true },
          { key: 'glam', icon: 'building-bank', color: '#72777d', name: 'Commons collections', desc: 'GLAM and scanning', soon: true },
          { key: 'training', icon: 'school', color: '#72777d', name: 'Training course', desc: 'Topics and levels', soon: true },
        ];
        const link = (c) => { keep.set('type', c.key); if (c.project) keep.set('project', c.project); else keep.delete('project'); return `/create/event?${keep.toString()}`; };
      %>
      <div class="z-pick-cards">
        <% CARDS.filter((c) => EVENT_TYPES[c.key]).forEach((c) => { %>
          <% if (c.soon) { %><div class="z-pick-card is-soon" style="--g: <%= c.color %>" aria-disabled="true"><% } else { %><a class="z-pick-card" style="--g: <%= c.color %>" href="<%= link(c) %>"><% } %>
            <span class="z-pick-icon"><i class="ti ti-<%= c.icon %>"></i></span>
            <span class="z-pick-name"><%= t(c.name) %></span>
            <span class="z-pick-desc"><%= t(c.desc) %></span>
            <% if (c.soon) { %><span class="badge bg-secondary-lt z-pick-soon"><%= t('Coming soon') %></span><% } else { %><span class="z-pick-go"><i class="ti ti-arrow-right"></i></span><% } %>
          <% if (c.soon) { %></div><% } else { %></a><% } %>
        <% }) %>
      </div>
    <% } else { %>
      <%- include('../../partials/contestForm', { action: '/events/create', submitLabel: 'Create draft' }) %>
    <% } %>
  </div>
</div>
