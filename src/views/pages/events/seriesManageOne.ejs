<%# Level 2: one series. Its name and description, and its editions, each leading to its own page. %>
<div class="page-header d-print-none"><div class="container-xl">
  <ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/series"><%= t('Series and editions') %></a></li><li class="breadcrumb-item active"><%= sr.title %></li></ol>
  <div class="row g-2 align-items-center">
    <div class="col">
      <%# Name and description, edited where they are shown. %>
      <form method="post" action="/series/<%= sr.slug %>/update" class="z-inline" data-inline>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="z-inline-view">
          <h2 class="page-title"><%= sr.title %><button class="btn btn-sm btn-icon btn-ghost-secondary ms-1" type="button" data-inline-open title="<%= t('Edit') %>" aria-label="<%= t('Edit') %>"><i class="ti ti-pencil"></i></button></h2>
          <% if (sr.description) { %><p class="text-secondary m-0 mt-1" style="white-space: pre-line"><%= sr.description %></p><% } %>
        </div>
        <div class="z-inline-edit">
          <input class="form-control form-control-lg mb-2" name="title" value="<%= sr.title %>" required maxlength="120" aria-label="<%= t('Name') %>">
          <textarea class="form-control mb-2" name="description" rows="2" maxlength="2000" placeholder="<%= t('Description') %>" aria-label="<%= t('Description') %>"><%= sr.description %></textarea>
          <div class="d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit"><%= t('Save') %></button><button class="btn btn-sm" type="button" data-inline-cancel><%= t('Cancel') %></button>
            <% if (!sr.editions.length && can('deleteAnyEvent')) { %><button class="btn btn-sm btn-ghost-danger ms-auto" type="submit" formaction="/series/<%= sr.slug %>/delete" data-confirm="<%= t('Delete this series?') %>"><i class="ti ti-trash me-1"></i><%= t('Delete series') %></button><% } %>
          </div>
        </div>
      </form>
      <div class="text-secondary small">/<%= sr.slug %> · <a href="/<%= sr.slug %>"><%= t('Public page') %></a></div></div>
  </div>
</div></div>
<div class="page-body"><div class="container-xl">

  <div class="row row-cards">
    <div class="col-12">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-calendar me-2"></i><%= t('Editions') %></h3><div class="card-actions">
      <% if (sr.editions.length) { %>
        <form method="post" action="/<%= sr.slug %>/next-edition" class="d-inline" data-confirm="<%= t('Make next year’s edition from the latest one, with a copy of each of its events?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"><i class="ti ti-copy me-1"></i><%= t('Next edition from the latest') %></button></form>
      <% } %>
        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#new-edition" aria-expanded="false"><i class="ti ti-calendar-plus me-1"></i><%= t('New edition') %></button>
</div></div>
    <%# An empty edition: a name and, if known, its dates. Its events are added on its page. %>
    <form method="post" action="/series/<%= sr.slug %>/first-edition" class="collapse border-bottom" id="new-edition">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-6 col-md-2"><label class="form-label" for="ne-edition"><%= t('Edition') %></label><input class="form-control" id="ne-edition" name="edition" value="<%= new Date().getFullYear() %>" maxlength="20" required></div>
          <div class="col-6 col-md-4"><label class="form-label" for="ne-title"><%= t('Title') %></label><input class="form-control" id="ne-title" name="title" maxlength="200" placeholder="<%= sr.title %> <%= new Date().getFullYear() %>"></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ne-start"><%= t('Starts') %></label><input class="form-control" type="date" id="ne-start" name="startDate"></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ne-end"><%= t('Ends') %></label><input class="form-control" type="date" id="ne-end" name="endDate"></div>
          <div class="col-12 col-md-2"><button class="btn btn-primary w-100" type="submit"><%= t('Create') %></button></div>
        </div>
      </div>
    </form>
        <% if (!sr.editions.length) { %><div class="card-body text-secondary"><%= t('No editions yet') %></div><% } else { %>
          <div class="list-group list-group-flush">
            <% sr.editions.forEach((e) => { const st = CONTEST_STATUSES[e.status] || { label: e.status, badge: 'secondary' }; const sum = summary.find((x) => x.id === e.id) || {}; %>
              <a class="list-group-item list-group-item-action" href="/<%= sr.slug %>/<%= e.edition %>">
                <div class="row align-items-center">
                  <div class="col-auto"><div class="h2 m-0"><%= e.edition %></div></div>
                  <div class="col min-w-0">
                    <div class="text-truncate"><%= e.title %></div>
                    <div class="text-secondary small"><%= tn('{n} event', '{n} events', e.events) %> · <%= tn('{n} entry', '{n} entries', sum.entries || 0) %> · <%= tn('{n} participant', '{n} participants', sum.participants || 0) %></div>
                  </div>
                  <div class="col-auto"><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= t(st.label) %></span></div>
                  <div class="col-auto text-secondary"><i class="ti ti-chevron-right"></i></div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <%# Settings for the events below: locked (cannot be changed below), default (used until an event sets its own) or optional (only suggested). %>
    <div class="col-12" id="settings">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-adjustments me-2"></i><%= t('Settings for the events below') %></h3></div>
        <form method="post" action="/series/<%= sr.slug %>/settings" class="card-body border-bottom" data-level-setting>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3"><label class="form-label" for="ls-key"><%= t('Setting') %></label><select class="form-select" id="ls-key" name="key"><% Object.entries(KEYS).forEach(([k, d]) => { %><option value="<%= k %>" data-def="<%= JSON.stringify(d) %>"><%= t(d.label) %></option><% }) %></select></div>
            <div class="col-6 col-md-2"><label class="form-label" for="ls-value"><%= t('Value') %></label><div data-value-slot><input class="form-control" id="ls-value" name="value"></div></div>
            <div class="col-6 col-md-2"><label class="form-label" for="ls-mode"><%= t('How') %></label><select class="form-select" id="ls-mode" name="mode"><option value="default"><%= t('Default') %></option><option value="locked"><%= t('Locked') %></option><option value="optional"><%= t('Suggested') %></option></select></div>
            <div class="col-6 col-md-3"><label class="form-label" for="ls-level"><%= t('On') %></label><select class="form-select" id="ls-level" name="editionId"><option value=""><%= t('The series') %></option><% sr.editions.forEach((e) => { %><option value="<%= e.id %>"><%= t('Edition {name}', { name: e.edition }) %></option><% }) %></select></div>
            <div class="col-6 col-md-2"><button class="btn btn-primary w-100" type="submit"><%= t('Save') %></button></div>
          </div>
          <div class="form-hint mt-2"><%= t('Locked: every event below uses it and cannot change it. Default: events use it until they set their own; their own values are never overwritten. Suggested: shown to organizers, not applied.') %></div>
        </form>
        <% if (!rules.length) { %><div class="card-body text-secondary"><%= t('Nothing set here yet; each event has its own settings.') %></div><% } else { %>
          <div class="list-group list-group-flush">
            <% rules.forEach((r) => { const d = KEYS[r.key]; const val = JSON.parse(r.value); %>
              <div class="list-group-item"><div class="row align-items-center">
                <div class="col"><span class="fw-medium"><%= d ? t(d.label) : r.key %></span>: <%= typeof val === 'boolean' ? t(val ? 'Yes' : 'No') : (val === null ? '—' : val) %>
                  <span class="badge <%= r.mode === 'locked' ? 'bg-red-lt' : r.mode === 'default' ? 'bg-blue-lt' : 'bg-secondary-lt' %> ms-1"><% if (r.mode === 'locked') { %><i class="ti ti-lock me-1"></i><% } %><%= t(r.mode === 'locked' ? 'Locked' : r.mode === 'default' ? 'Default' : 'Suggested') %></span>
                  <span class="text-secondary small ms-1"><%= r.editionId ? t('Edition {name}', { name: r.edition.slug }) : t('The series') %></span></div>
                <div class="col-auto"><form method="post" action="/series/<%= sr.slug %>/settings/<%= r.id %>/remove" data-confirm="<%= t('Remove this setting? Events below keep their current values as their own.') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-icon btn-ghost-danger" type="submit" title="<%= t('Remove') %>" aria-label="<%= t('Remove') %>"><i class="ti ti-x"></i></button></form></div>
              </div></div>
            <% }) %>
          </div>
        <% } %>
        <% if (history.length) { %>
          <details class="card-footer"><summary class="text-secondary"><%= t('History') %></summary>
            <ul class="list-unstyled small m-0 mt-2">
              <% history.forEach((h) => { const d = JSON.parse(h.details || '{}'); const show = (x) => x ? `${typeof x.value === 'boolean' ? t(x.value ? 'Yes' : 'No') : x.value} (${t(x.mode === 'locked' ? 'Locked' : x.mode === 'default' ? 'Default' : 'Suggested')})` : '—'; %>
                <li class="mb-1"><span class="text-secondary"><%= formatDate(h.createdAt) %> · <%= h.actor ? h.actor.username : '' %>:</span> <%= KEYS[d.key] ? t(KEYS[d.key].label) : d.key %> <%= show(d.from) %> → <%= h.action === 'levelSetting.removed' ? t('removed') : show(d.to) %><% if (d.eventsChanged) { %> · <%= tn('{n} event changed', '{n} events changed', d.eventsChanged) %><% } %></li>
              <% }) %>
            </ul>
          </details>
        <% } %>
      </div>
    </div>

    <%# Roles on this series or one edition. A role counts on its own level; "also below" makes it count on every edition and event underneath. %>
    <div class="col-12" id="people">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-users me-2"></i><%= t('People') %></h3></div>
        <form method="post" action="/series/<%= sr.slug %>/people" class="card-body border-bottom">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3"><label class="form-label" for="sp-user"><%= t('Username') %></label><input class="form-control" id="sp-user" name="username" required maxlength="255"></div>
            <div class="col-6 col-md-2"><label class="form-label" for="sp-role"><%= t('Role') %></label><select class="form-select" id="sp-role" name="role"><% ROLES.forEach((r) => { %><option value="<%= r %>"><%= t(EVENT_ROLES[r].label) %></option><% }) %></select></div>
            <div class="col-6 col-md-3"><label class="form-label" for="sp-level"><%= t('On') %></label><select class="form-select" id="sp-level" name="editionId"><option value=""><%= t('The series') %></option><% sr.editions.forEach((e) => { %><option value="<%= e.id %>"><%= t('Edition {name}', { name: e.edition }) %></option><% }) %></select></div>
            <div class="col-12 col-md-2"><label class="form-check m-0 mb-2"><input class="form-check-input" type="checkbox" name="appliesToChildren"><span class="form-check-label"><%= t('Also everything below it') %></span></label></div>
            <div class="col-12 col-md-2"><button class="btn btn-primary w-100" type="submit"><%= t('Add') %></button></div>
          </div>
          <div class="form-hint mt-2"><%= t('A role counts only where it is given. Roles on one event, or on one wiki of an event, are given on that event.') %></div>
        </form>
        <% if (!people.length) { %><div class="card-body text-secondary"><%= t('No one has a role here yet') %></div><% } else { %>
          <div class="list-group list-group-flush">
            <% people.forEach((r) => { %>
              <div class="list-group-item"><div class="row align-items-center">
                <div class="col"><a href="/users/<%= encodeURIComponent(r.user.username) %>"><%= r.user.username %></a>
                  <span class="badge bg-secondary-lt ms-1"><%= t(EVENT_ROLES[r.role] ? EVENT_ROLES[r.role].label : r.role) %></span>
                  <span class="text-secondary small ms-1"><%= r.editionId ? t('Edition {name}', { name: r.edition.slug }) : t('The series') %><% if (r.appliesToChildren) { %> · <%= t('and everything below it') %><% } %></span></div>
                <div class="col-auto"><form method="post" action="/series/<%= sr.slug %>/people/<%= r.id %>/remove" data-confirm="<%= t('Remove this role?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-icon btn-ghost-danger" type="submit" title="<%= t('Remove') %>" aria-label="<%= t('Remove') %>"><i class="ti ti-x"></i></button></form></div>
              </div></div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div></div>
