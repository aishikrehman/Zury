<%# Level 2: one series. Its name and description, and its editions, each leading to its own page. %>
<div class="page-header d-print-none"><div class="container-xl">
  <ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/series"><%= t('Series and editions') %></a></li><li class="breadcrumb-item active"><%= sr.title %></li></ol>
  <div class="row g-2 align-items-center">
    <div class="col">
      <%# Name and description, edited where they are shown. %>
      <form method="post" action="/series/<%= sr.slug %>/update" class="z-inline" data-inline>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="z-inline-view">
          <h2 class="page-title"><%= sr.title %><button class="btn btn-sm btn-icon btn-ghost-secondary ms-1" type="button" data-inline-open title="<%= t('Edit') %>" aria-label="<%= t('Edit') %>"><i class="ti ti-pencil"></i></button></h2>
          <% if (sr.description) { %><p class="text-secondary m-0 mt-1" style="white-space: pre-line"><%= sr.description %></p><% } %>
        </div>
        <div class="z-inline-edit">
          <input class="form-control form-control-lg mb-2" name="title" value="<%= sr.title %>" required maxlength="120" aria-label="<%= t('Name') %>">
          <textarea class="form-control mb-2" name="description" rows="2" maxlength="2000" placeholder="<%= t('Description') %>" aria-label="<%= t('Description') %>"><%= sr.description %></textarea>
          <div class="d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit"><%= t('Save') %></button><button class="btn btn-sm" type="button" data-inline-cancel><%= t('Cancel') %></button>
            <% if (!sr.editions.length && can('deleteAnyEvent')) { %><button class="btn btn-sm btn-ghost-danger ms-auto" type="submit" formaction="/series/<%= sr.slug %>/delete" data-confirm="<%= t('Delete this series?') %>"><i class="ti ti-trash me-1"></i><%= t('Delete series') %></button><% } %>
          </div>
        </div>
      </form>
      <div class="text-secondary small">/<%= sr.slug %> · <a href="/<%= sr.slug %>"><%= t('Public page') %></a></div></div>
  </div>
</div></div>
<div class="page-body"><div class="container-xl">

  <div class="row row-cards">
    <div class="col-12">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-calendar me-2"></i><%= t('Editions') %></h3><div class="card-actions">
      <% if (sr.editions.length) { %>
        <form method="post" action="/<%= sr.slug %>/next-edition" class="d-inline" data-confirm="<%= t('Make next year’s edition from the latest one, with a copy of each of its events?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"><i class="ti ti-copy me-1"></i><%= t('Next edition from the latest') %></button></form>
      <% } %>
        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#new-edition" aria-expanded="false"><i class="ti ti-calendar-plus me-1"></i><%= t('New edition') %></button>
</div></div>
    <%# An empty edition: a name and, if known, its dates. Its events are added on its page. %>
    <form method="post" action="/series/<%= sr.slug %>/first-edition" class="collapse border-bottom" id="new-edition">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-6 col-md-2"><label class="form-label" for="ne-edition"><%= t('Edition') %></label><input class="form-control" id="ne-edition" name="edition" value="<%= new Date().getFullYear() %>" maxlength="20" required></div>
          <div class="col-6 col-md-4"><label class="form-label" for="ne-title"><%= t('Title') %></label><input class="form-control" id="ne-title" name="title" maxlength="200" placeholder="<%= sr.title %> <%= new Date().getFullYear() %>"></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ne-start"><%= t('Starts') %></label><input class="form-control" type="date" id="ne-start" name="startDate"></div>
          <div class="col-6 col-md-2"><label class="form-label" for="ne-end"><%= t('Ends') %></label><input class="form-control" type="date" id="ne-end" name="endDate"></div>
          <div class="col-12 col-md-2"><button class="btn btn-primary w-100" type="submit"><%= t('Create') %></button></div>
        </div>
      </div>
    </form>
        <% if (!sr.editions.length) { %><div class="card-body text-secondary"><%= t('No editions yet') %></div><% } else { %>
          <div class="list-group list-group-flush">
            <% sr.editions.forEach((e) => { const st = CONTEST_STATUSES[e.status] || { label: e.status, badge: 'secondary' }; const sum = summary.find((x) => x.id === e.id) || {}; %>
              <a class="list-group-item list-group-item-action" href="/<%= sr.slug %>/<%= e.edition %>">
                <div class="row align-items-center">
                  <div class="col-auto"><div class="h2 m-0"><%= e.edition %></div></div>
                  <div class="col min-w-0">
                    <div class="text-truncate"><%= e.title %></div>
                    <div class="text-secondary small"><%= tn('{n} event', '{n} events', e.events) %> · <%= tn('{n} entry', '{n} entries', sum.entries || 0) %> · <%= tn('{n} participant', '{n} participants', sum.participants || 0) %></div>
                  </div>
                  <div class="col-auto"><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= t(st.label) %></span></div>
                  <div class="col-auto text-secondary"><i class="ti ti-chevron-right"></i></div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div></div>
