<%- include('../../partials/pageHeader', { pretitle: 'Account', heading: 'My submissions' }) %>
<div class="page-body"><div class="container-xl">
  <div class="card">
    <% if (!submissions.length) { %>
      <div class="empty">
        <div class="empty-icon"><i class="ti ti-files-off icon"></i></div>
        <p class="empty-title">No submissions yet</p>
        <p class="empty-subtitle text-secondary">Find an active event and submit your first entry.</p>
        <div class="empty-action"><a href="/events/active" class="btn btn-primary">Active events</a></div>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th>Entry</th><th>Event</th><th>Status</th><th>Submitted</th></tr></thead>
          <tbody>
            <% submissions.forEach((s) => { %>
              <tr>
                <td><a href="/contest/<%= s.contest.id %>/submissions/<%= s.id %>"><%= s.title %></a><div class="text-secondary small"><%= s.wiki %> · <%= s.entryType %></div></td>
                <td><a href="/contest/<%= s.contest.id %>" class="text-reset"><%= s.contest.title %></a></td>
                <td><%- include('../../partials/submissionStatus', { s: s.status }) %></td>
                <td class="text-secondary text-nowrap"><%= formatDate(s.submittedAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div></div>
