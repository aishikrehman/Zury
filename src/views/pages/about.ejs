<%- include('../partials/pageHeader', { pretitle: 'About', heading: 'About Zury' }) %>
<div class="page-body"><div class="container-xl"><div class="card"><div class="card-body">
  <p class="lead text-muted">
    Zury is an open-source, web-based platform for creating, organizing, managing, and
    evaluating Wikimedia contests and community events across multiple Wikimedia projects
    and languages.
  </p>
  <p>
    It supports photo contests, writing contests, data contests, and edit-a-thons, with
    configurable submission rules, jury workflows, appeals, and results.
  </p>
</div></div></div>
</div>
