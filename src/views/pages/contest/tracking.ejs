<%
  const n = formatNumber;
  const on = [tracking.participants && t("participants' edits"), ...tracking.hashtags.map((h) => '#' + h), ...tracking.categories.map((c) => 'Category:' + c)].filter(Boolean);
%>
<%- include('../../partials/contestHeader', { active: 'tracking' }) %>
<div class="page-body"><div class="container-xl">

  <div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-2">
      <div class="flex-fill">
        <% if (on.length) { %>
          <span class="text-secondary me-1"><%= t("Counting") %></span>
          <% on.forEach((x) => { %><span class="badge bg-azure-lt me-1"><%= x %></span><% }) %>
        <% } else { %>
          <span class="text-secondary"><%= t("Tracking is off. Turn it on in the configuration: participants' edits, hashtags or categories.") %></span>
        <% } %>
        <div class="text-secondary small mt-1"><%= t('Last checked') %>: <%= trackedAt ? formatDateTime(trackedAt, contest.timezone) : t('never') %> · <%= t('checked again every hour while the event runs') %></div>
      </div>
      <% if (can('manageEvent') && on.length) { %>
        <form method="post" action="<%= base %>/tracking/refresh">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary" type="submit"><i class="ti ti-refresh me-1"></i><%= t("Check now") %></button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="row row-cards mb-3">
    <% [['Contributions', summary.total, 'edit'], ['New pages', summary.newPages, 'file-plus'], ['Bytes added', summary.bytes, 'plus'], ['Contributors', summary.contributors, 'users']].forEach(([label, value, icon]) => { %>
      <div class="col-6 col-lg-3">
        <div class="card card-sm"><div class="card-body d-flex align-items-center">
          <span class="avatar bg-primary-lt me-3"><i class="ti ti-<%= icon %>"></i></span>
          <div><div class="h2 m-0"><%= n(value) %></div><div class="text-secondary"><%= t(label) %></div></div>
        </div></div>
      </div>
    <% }) %>
  </div>

  <div class="row row-cards mb-3">
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header"><h3 class="card-title"><%= t("Found by") %></h3></div>
        <div class="list-group list-group-flush">
          <% Object.entries(sources).forEach(([k, label]) => { %>
            <div class="list-group-item d-flex justify-content-between"><span><%= t(label) %></span><strong><%= n(summary.bySource[k] || 0) %></strong></div>
          <% }) %>
        </div>
      </div>
    </div>
    <% const manyWikis = !wikiScope && eventWikis.length > 1; %>
    <% if (manyWikis) { %>
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header"><h3 class="card-title"><%= t("By wiki") %></h3></div>
        <div class="list-group list-group-flush">
          <% if (!summary.byWiki.length) { %><div class="list-group-item text-secondary"><%= t("Nothing yet.") %></div><% } %>
          <% summary.byWiki.forEach((w) => { %>
            <div class="list-group-item d-flex justify-content-between"><span><%= wikiLocal(w.wiki) %></span><span><strong><%= n(w.count) %></strong> <span class="text-secondary small">· <%= t('{n} bytes', { n: w.bytes }) %></span></span></div>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="col-lg-<%= manyWikis ? 4 : 8 %>">
      <div class="card h-100">
        <div class="card-header"><h3 class="card-title"><%= t("Top contributors") %></h3></div>
        <div class="list-group list-group-flush">
          <% if (!summary.byUser.length) { %><div class="list-group-item text-secondary"><%= t("Nothing yet.") %></div><% } %>
          <% summary.byUser.forEach((u) => { %>
            <div class="list-group-item d-flex justify-content-between"><a href="<%= userPath(u.username) %>"><%= u.username %></a><strong><%= n(u.count) %></strong></div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("Latest") %></h3></div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th><%= t("Page") %></th><th><%= t("User") %></th><% if (manyWikis) { %><th><%= t("Wiki") %></th><% } %><th><%= t("Found by") %></th><th class="text-end"><%= t("Bytes") %></th><th><%= t("When") %></th></tr></thead>
        <tbody>
          <% if (!summary.recent.length) { %><tr><td colspan="<%= manyWikis ? 6 : 5 %>" class="text-secondary"><%= t("No contributions found yet.") %></td></tr><% } %>
          <% summary.recent.forEach((c) => { %>
            <tr>
              <td><%= c.pageTitle %><% if (c.isNew) { %> <span class="badge bg-green-lt"><%= t("new") %></span><% } %></td>
              <td><%= c.username || '—' %></td>
              <% if (manyWikis) { %><td class="text-secondary"><%= wikiLocal(c.wiki) %></td><% } %>
              <td><span class="badge bg-secondary-lt"><%= t(sources[c.source]) %></span></td>
              <td class="text-end <%= c.sizeDiff < 0 ? 'text-danger' : '' %>"><%= c.revId ? (c.sizeDiff > 0 ? '+' : '') + n(c.sizeDiff) : '—' %></td>
              <td class="text-secondary text-nowrap"><%= formatDateTime(c.timestamp, contest.timezone) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</div>
