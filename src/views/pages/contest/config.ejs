<%
  const statusLabel = (st) => t((CONTEST_STATUSES[st] || { label: st }).label);
  const st = CONTEST_STATUSES[contest.status] || { badge: 'secondary' };
  // The status follows the dates; organizers only publish, pause, cancel or delete.
  const action = (name, label, cls, icon, confirm) => ({ name, label, cls, icon, confirm });
  const actions = [
    contest.status === 'draft' && action('publish', t('Publish'), 'primary', 'rocket'),
    ['published', 'upcoming'].includes(contest.status) && action('unpublish', t('Back to draft'), 'ghost-secondary', 'arrow-back-up'),
    contest.status === 'paused' && action('resume', t('Resume'), 'primary', 'player-play'),
    !['draft', 'paused', 'cancelled', 'archived'].includes(contest.status) && action('pause', t('Pause'), 'outline-secondary', 'player-pause', t('Pause this event? Nobody can join or submit until you resume it.')),
    contest.status === 'cancelled' && action('reopen', t('Reopen as draft'), 'outline-secondary', 'refresh'),
    ['completed', 'cancelled'].includes(contest.status) && action('archive', t('Archive'), 'outline-secondary', 'archive'),
    !['cancelled', 'archived'].includes(contest.status) && action('cancel', t('Cancel event'), 'outline-danger', 'ban', t('Cancel this event?')),
  ].filter(Boolean);
%>
<%- include('../../partials/contestHeader', { active: 'configuration' }) %>
<div class="page-body"><div class="container-xl">

  <% if (can('manageEvent') && !wikiMode) { %>
    <div class="card mb-3 z-statebar">
      <div class="card-body d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt fs-5 me-1"><%= statusLabel(contest.status) %></span>
        <span class="text-secondary small me-auto"><%= ['draft', 'paused', 'cancelled', 'archived'].includes(contest.status) ? '' : t('Follows the event dates.') %></span>
        <% actions.forEach((a) => { %>
          <form method="post" action="<%= base %>/status"<% if (a.confirm) { %> data-confirm="<%= a.confirm %>"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="<%= a.name %>">
            <button type="submit" class="btn btn-<%= a.cls %>"><i class="ti ti-<%= a.icon %> me-1"></i><%= a.label %></button>
          </form>
        <% }) %>
        <% if (can('deleteEvent')) { %>
          <button class="btn btn-ghost-danger" type="button" data-bs-toggle="collapse" data-bs-target="#delete-event" aria-expanded="false" aria-controls="delete-event"><i class="ti ti-trash me-1"></i><%= t('Delete') %></button>
        <% } %>
      </div>
      <% if (can('deleteEvent')) { %>
        <div class="collapse" id="delete-event">
          <form method="post" action="<%= base %>/delete" class="card-body border-top d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="flex-fill" style="max-width: 24rem">
              <label class="form-label" for="confirmation"><%- th('Type {address} to confirm', { address: '<code>' + h(contest.slug) + '</code>' }) %></label>
              <input class="form-control" id="confirmation" name="confirmation" autocomplete="off">
            </div>
            <button type="submit" class="btn btn-danger"><i class="ti ti-trash me-1"></i><%= t("Delete event") %></button>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (wikiMode && can('editEvent')) { %>
    <div class="alert alert-info d-flex align-items-center">
      <div class="flex-fill"><%- th('Settings for {wiki}. Anything you change here applies to this wiki only; everything else follows the event.', { wiki: '<strong>' + wikiLabel(wikiScope.wiki) + '</strong>' }) %> <% if (overridden.size) { %><span class="badge bg-orange-lt ms-1"><%= t('{n} own', { n: overridden.size }) %></span><% } %></div>
      <% if (overridden.size) { %>
        <form method="post" action="<%= base %>/config" class="ms-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="reset" value="1">
          <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t("Follow the event again") %></button>
        </form>
      <% } %>
    </div>
  <% } %>

  <%# Settings from the series or edition: where each comes from, and whether this event follows it. %>
  <% if (inherited.length) { %>
    <div class="card mb-3" id="inherited" data-locked-settings="<%= JSON.stringify(inherited.filter((i) => i.mode === 'locked').map((i) => i.key)) %>">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-hierarchy-2 me-2"></i><%= t('From the series') %></h3></div>
      <div class="list-group list-group-flush">
        <% inherited.forEach((i) => { const show = (v) => typeof v === 'boolean' ? t(v ? 'Yes' : 'No') : (v === null ? '—' : v); %>
          <div class="list-group-item"><div class="row align-items-center g-2">
            <div class="col"><span class="fw-medium"><%= t(i.label) %></span>: <%= show(i.following ? i.value : i.own) %>
              <div class="text-secondary small">
                <% if (i.mode === 'locked') { %><i class="ti ti-lock me-1"></i><%= t('Locked by {name}; it cannot be changed here.', { name: i.name }) %>
                <% } else if (i.mode === 'optional') { %><%= t('{name} suggests {value}.', { name: i.name, value: show(i.value) }) %>
                <% } else if (i.following) { %><%= t('Default from {name}.', { name: i.name }) %>
                <% } else { %><%= t('This event’s own value; the default from {name} is {value}.', { name: i.name, value: show(i.value) }) %><% } %>
              </div></div>
            <% if (i.mode !== 'locked' && !i.following && can('editEvent') && JSON.stringify(i.own) !== JSON.stringify(i.value)) { %>
              <div class="col-auto"><form method="post" action="<%= eventBase %>/config/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="key" value="<%= i.key %>"><button class="btn btn-sm" type="submit"><%= t(i.mode === 'optional' ? 'Use it' : 'Use the default') %></button></form></div>
            <% } %>
          </div></div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (can('editEvent')) { %>
    <%- include('../../partials/contestForm', { action: `${base}/config`, submitLabel: 'Save settings', wikiMode }) %>
  <% } %>

  <% if (!wikiMode && (canManageWikis || can('manageEvent'))) { const wikiActions = { pending: [['approve', 'Approve', 'primary']], active: [['pause', 'Pause', 'outline-secondary'], ['remove', 'Remove', 'ghost-danger']], paused: [['resume', 'Resume', 'outline-primary'], ['remove', 'Remove', 'ghost-danger']] }; %>
    <div class="card mt-4" id="wikis">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th><%= t("Address") %></th><th><%= t("Wiki") %></th><th><%= t("Status") %></th><th>Fountain</th><th class="w-1"></th></tr></thead>
          <tbody>
            <% allWikis.forEach((w) => { %>
              <tr>
                <td><a href="<%= eventBase %>/<%= w.code %>"><%= eventBase %>/<%= w.code %></a></td>
                <td><%- wikiLabel(w.wiki) %></td>
                <td><span class="badge bg-<%= { active: 'green', pending: 'yellow', paused: 'secondary' }[w.status] || 'secondary' %>-lt"><%= t(w.status) %></span></td>
                <td class="text-nowrap">
                  <% if (w.fountainCode) { %>
                    <a href="https://fountain.toolforge.org/editathons/<%= encodeURIComponent(w.fountainCode) %>" rel="noopener" target="_blank"><%= w.fountainCode %></a>
                    <div class="text-secondary small"><%= w.fountainSyncedAt ? t('Updated {when}', { when: formatDateTime(w.fountainSyncedAt, contest.timezone) }) : '' %></div>
                  <% } else { %><span class="text-secondary">—</span><% } %>
                </td>
                <td class="text-nowrap">
                  <% if (w.fountainCode) { %><% [['sync', t('Update now'), 'outline-primary'], ...(can('importEvents') ? [['unlink', t('Stop following'), 'ghost-secondary']] : [])].forEach(([action, label, cls]) => { %>
                    <form method="post" action="<%= eventBase %>/fountain/<%= w.id %>/<%= action %>" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-<%= cls %>" type="submit"><%= label %></button></form>
                  <% }) %><% } %>
                  <% (wikiActions[w.status] || []).filter(([action]) => action !== 'remove' || can('deleteEvent')).forEach(([action, label, cls]) => { %>
                    <form method="post" action="<%= eventBase %>/wikis/<%= w.id %>/<%= action %>" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-<%= cls %>" type="submit"><%= label %></button>
                    </form>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <form method="post" action="<%= eventBase %>/wikis" class="row g-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Add a wiki…") %>" required></select></div>
          <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="ti ti-plus me-1"></i><%= t("Add wiki") %></button></div>
        </form>
        <% if (can('importEvents')) { %><form method="post" action="<%= eventBase %>/fountain" class="row g-2 align-items-center mt-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col"><input class="form-control" name="code" placeholder="<%= t('Fountain editathon code or address') %>" aria-label="<%= t('Fountain editathon code or address') %>" required></div>
          <div class="col-auto"><button class="btn" type="submit"><%= t("Follow on Fountain") %></button></div>
        </form><% } %>
      </div>
    </div>
  <% } %>

  <%# ── The event's data: take it out in any format, or clear what's no longer needed ── %>
  <% if (can('manageEvent') && !wikiMode && typeof dataCounts !== 'undefined') { %>
    <div class="card mt-4" id="data">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-database me-2"></i><%= t('Data') %></h3></div>
      <div class="row g-0">
        <div class="col-lg-6 border-end">
          <div class="card-body">
            <div class="subheader mb-2"><%= t('Download') %></div>
            <div class="d-flex flex-wrap gap-2">
              <% [['entries', t('Entries')], ['results', t('Results')], ['people', t('People')], ['reviews', t('Reviews')]].forEach(([ds, label]) => { %>
                <%- include('../../partials/exportMenu', { dataset: ds, label, btn: '' }) %>
              <% }) %>
            </div>
            <p class="text-secondary small mt-2 mb-0"><%= t('CSV and Excel open in spreadsheets; wikitext pastes into a wiki page; Markdown into GitHub or a document.') %></p>
          </div>
        </div>
        <% if (can('deleteEvent')) { %>
        <div class="col-lg-6">
          <div class="card-body">
            <div class="subheader mb-2"><%= t('Clear') %></div>
            <% Object.entries(dataCounts).forEach(([key, d]) => { %>
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="flex-fill"><%= t(d.label) %> <span class="text-secondary small">· <%= formatNumber(d.count) %></span></div>
                <form method="post" action="<%= base %>/data/clear/<%= key %>" data-confirm="<%= t('Delete these rows for good? Download them first if you may need them.') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-ghost-danger" type="submit"<%= d.count ? '' : ' disabled' %>><i class="ti ti-trash me-1"></i><%= t('Delete') %></button>
                </form>
              </div>
            <% }) %>
            <p class="text-secondary small mb-0"><%= t('Entries, reviews and results stay. Only what you delete here goes, for good.') %></p>
          </div>
        <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <% if (moveTargets.length) { %>
    <div class="card mt-4" id="move">
      <div class="card-status-start bg-warning"></div>
      <div class="card-header"><h3 class="card-title"><i class="ti ti-arrow-merge me-2"></i><%= t("Move into another event") %></h3></div>
      <div class="card-body">
        <p class="text-secondary"><%= t("This event becomes one wiki of the event you choose. Its entries, participants, sessions and tracked edits move with it, its organizers and jury run that wiki, and this address will lead there. You'll see what moves before confirming.") %></p>
        <form method="post" action="<%= base %>/move" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-8">
            <label class="form-label" for="moveTarget"><%= t("Event") %></label>
            <select class="form-select" id="moveTarget" name="target" required>
              <option value=""><%= t("Choose…") %></option>
              <% moveTargets.forEach((m) => { %><option value="<%= m.id %>"><%= m.title %> (<%= m.path %>)</option><% }) %>
            </select>
          </div>
          <div class="col-md-4"><button type="submit" class="btn btn-outline-warning w-100"><%= t("Continue") %></button></div>
        </form>
      </div>
    </div>
  <% } %>

</div>
</div>
