<%
  const statusLabel = (s) => (CONTEST_STATUSES[s] || { label: s }).label;
  const sticky = ['draft', 'cancelled', 'archived'].includes(contest.status);
  const action = (name, label, cls, icon) => ({ name, label, cls, icon });
  const actions = [
    contest.status === 'draft' && action('publish', 'Publish', 'primary', 'rocket'),
    ['published', 'upcoming'].includes(contest.status) && action('unpublish', 'Back to draft', 'outline-secondary', 'arrow-back-up'),
    !sticky && contest.statusMode === 'manual' && action('resume_auto', 'Follow the dates again', 'outline-primary', 'calendar-time'),
    ['completed', 'cancelled'].includes(contest.status) && action('archive', 'Archive', 'outline-secondary', 'archive'),
    contest.status === 'cancelled' && action('reopen', 'Reopen as draft', 'outline-secondary', 'refresh'),
    !['cancelled', 'archived'].includes(contest.status) && action('cancel', 'Cancel event', 'outline-danger', 'ban'),
  ].filter(Boolean);
%>
<div class="page-body"><div class="container-xl">
  <%- include('../../partials/contestHeader', { active: 'configuration' }) %>

  <% if (can('manageEvent') && !wikiMode) { %>
    <div class="card mb-4">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-progress me-2"></i><%= t("Status") %></h3></div>
      <div class="card-body">
        <div class="row align-items-center g-3">
          <div class="col-md">
            <div class="h3 mb-1"><%= statusLabel(contest.status) %></div>
            <div class="text-secondary">
              <% if (!sticky) { %>
                <% if (contest.statusMode === 'auto') { %><i class="ti ti-calendar-time me-1"></i>Follows the dates automatically.<% } else { %><i class="ti ti-pin me-1"></i>Pinned by an organizer. By the dates it would be <%= statusLabel(autoStatus) %>.<% } %>
              <% } else { %><%= t('Set by hand.') %><% } %>
            </div>
          </div>
          <div class="col-md-auto">
            <div class="btn-list">
              <% actions.forEach((a) => { %>
                <form method="post" action="<%= base %>/status">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="<%= a.name %>">
                  <button type="submit" class="btn btn-<%= a.cls %>"><i class="ti ti-<%= a.icon %> me-1"></i><%= a.label %></button>
                </form>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
      <% if (!sticky) { %>
        <div class="card-footer">
          <form method="post" action="<%= base %>/status" class="row g-2 align-items-center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="set_status">
            <div class="col-auto"><label class="form-label m-0" for="pinStatus"><%= t("Pin status to") %></label></div>
            <div class="col-auto">
              <select id="pinStatus" name="status" class="form-select">
                <% manualStatuses.forEach((s) => { %><option value="<%= s %>"<%= s === contest.status ? ' selected' : '' %>><%= statusLabel(s) %></option><% }) %>
              </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><%= t("Set") %></button></div>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (canManageWikis) { const wikiActions = { pending: [['approve', 'Approve', 'primary']], active: [['pause', 'Pause', 'outline-secondary'], ['remove', 'Remove', 'ghost-danger']], paused: [['resume', 'Resume', 'outline-primary'], ['remove', 'Remove', 'ghost-danger']] }; %>
    <div class="card mb-4" id="wikis">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th><%= t("Address") %></th><th><%= t("Wiki") %></th><th><%= t("Status") %></th><th class="w-1"></th></tr></thead>
          <tbody>
            <% allWikis.forEach((w) => { %>
              <tr>
                <td><a href="<%= eventBase %>/<%= w.code %>"><%= eventBase %>/<%= w.code %></a></td>
                <td><%- wikiLabel(w.wiki) %></td>
                <td><span class="badge bg-<%= { active: 'green', pending: 'yellow', paused: 'secondary' }[w.status] || 'secondary' %>-lt"><%= w.status %></span></td>
                <td class="text-nowrap">
                  <% (wikiActions[w.status] || []).forEach(([action, label, cls]) => { %>
                    <form method="post" action="<%= eventBase %>/wikis/<%= w.id %>/<%= action %>" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-<%= cls %>" type="submit"><%= label %></button>
                    </form>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <form method="post" action="<%= eventBase %>/wikis" class="row g-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Add a wiki…") %>" required></select></div>
          <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="ti ti-plus me-1"></i><%= t("Add wiki") %></button></div>
        </form>
      </div>
    </div>
  <% } %>

  <% if (wikiMode && can('editEvent')) { %>
    <div class="alert alert-info d-flex align-items-center">
      <div class="flex-fill"><%- th('Settings for {wiki}. Anything you change here applies to this wiki only; everything else follows the event.', { wiki: '<strong>' + wikiLabel(wikiScope.wiki) + '</strong>' }) %> <% if (overridden.size) { %><span class="badge bg-orange-lt ms-1"><%= t('{n} own', { n: overridden.size }) %></span><% } %></div>
      <% if (overridden.size) { %>
        <form method="post" action="<%= base %>/config" class="ms-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="reset" value="1">
          <button class="btn btn-sm btn-outline-secondary" type="submit"><%= t("Follow the event again") %></button>
        </form>
      <% } %>
    </div>
  <% } %>

  <% if (can('editEvent')) { %>
    <%- include('../../partials/contestForm', { action: `${base}/config`, submitLabel: 'Save settings', wikiMode }) %>
  <% } %>

  <% if (moveTargets.length) { %>
    <div class="card mt-4" id="move">
      <div class="card-status-start bg-warning"></div>
      <div class="card-header"><h3 class="card-title"><i class="ti ti-arrow-merge me-2"></i><%= t("Move into another event") %></h3></div>
      <div class="card-body">
        <p class="text-secondary"><%= t("This event becomes one wiki of the event you choose. Its entries, participants, sessions and tracked edits move with it, its organizers and jury run that wiki, and this address will lead there. You'll see what moves before confirming.") %></p>
        <form method="post" action="<%= base %>/move" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-8">
            <label class="form-label" for="moveTarget"><%= t("Event") %></label>
            <select class="form-select" id="moveTarget" name="target" required>
              <option value=""><%= t("Choose…") %></option>
              <% moveTargets.forEach((m) => { %><option value="<%= m.id %>"><%= m.title %> (<%= m.path %>)</option><% }) %>
            </select>
          </div>
          <div class="col-md-4"><button type="submit" class="btn btn-outline-warning w-100"><%= t("Continue") %></button></div>
        </form>
      </div>
    </div>
  <% } %>

  <% if (can('deleteEvent') && !wikiMode) { %>
    <div class="card card-borderless mt-4">
      <div class="card-status-start bg-danger"></div>
      <div class="card-header"><h3 class="card-title text-danger"><i class="ti ti-alert-triangle me-2"></i><%= t("Danger zone") %></h3></div>
      <div class="card-body">
        <form method="post" action="<%= base %>/delete" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-sm-6 col-md-4">
            <label class="form-label" for="confirmation"><%- th('Type {address} to confirm', { address: '<code>' + h(contest.slug) + '</code>' }) %></label>
            <input class="form-control" id="confirmation" name="confirmation" autocomplete="off">
          </div>
          <div class="col-auto"><button type="submit" class="btn btn-danger"><i class="ti ti-trash me-1"></i><%= t("Delete event") %></button></div>
        </form>
      </div>
    </div>
  <% } %>
</div>
</div>
