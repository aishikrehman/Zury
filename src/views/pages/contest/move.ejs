<div class="page-body"><div class="container-xl">
  <%- include('../../partials/contestHeader', { active: 'configuration' }) %>
  <div class="card">
    <div class="card-status-top bg-warning"></div>
    <div class="card-header"><h3 class="card-title"><i class="ti ti-arrow-merge me-2"></i>Move into “<%= target.title %>”</h3></div>
    <div class="card-body">
      <p>
        This event becomes <strong><%- wikiLabel(plan.wiki) %></strong> of <a href="<%= targetPath %>"><%= target.title %></a>
        <% if (plan.existing) { %>(that wiki is already in it, so they will be joined)<% } %>.
      </p>
      <div class="datagrid mb-4">
        <div class="datagrid-item"><div class="datagrid-title">Entries</div><div class="datagrid-content"><%= plan.counts.submissions %></div></div>
        <div class="datagrid-item"><div class="datagrid-title">People with a role</div><div class="datagrid-content"><%= plan.counts.members %></div></div>
        <div class="datagrid-item"><div class="datagrid-title">Sessions</div><div class="datagrid-content"><%= plan.counts.sessions %></div></div>
        <div class="datagrid-item"><div class="datagrid-title">Tracked edits</div><div class="datagrid-content"><%= plan.counts.contributions %></div></div>
      </div>
      <ul class="text-secondary">
        <li>Participants take part in “<%= target.title %>” from <%= wikiName(plan.wiki) %>; organizers and jury run that wiki.</li>
        <li>This event's own dates, rules and type settings are kept as that wiki's settings.</li>
        <li>This event closes, and <code><%= base %></code> will lead to its new place.</li>
        <li>People blocked in “<%= target.title %>” are not moved.</li>
      </ul>
      <form method="post" action="<%= base %>/move" class="row g-2 align-items-end mt-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="target" value="<%= target.id %>">
        <div class="col-md-6">
          <label class="form-label" for="confirmation">Type <code><%= contest.slug %></code> to confirm</label>
          <input class="form-control" id="confirmation" name="confirmation" autocomplete="off" required>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-warning">Move</button></div>
        <div class="col-auto"><a class="btn" href="<%= base %>/config">Cancel</a></div>
      </form>
    </div>
  </div>
</div>
</div>
