<%
  const byWords = !!rows.byWords;
  const medal = { 1: 'gold', 2: 'silver', 3: 'bronze' };
%>
<%- include('../../partials/contestHeader', { active: 'results' }) %>
<div class="page-body"><div class="container-xl">

  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div>
      <div class="h3 m-0"><%= t('Results') %></div>
      <div class="text-secondary small">
        <% if (published) { %><i class="ti ti-world me-1"></i><%= t('Published {date}', { date: formatDateTime(published, contest.timezone) }) %>
        <% } else { %><i class="ti ti-lock me-1"></i><%= t('Not published: only organizers and reviewers see this page.') %><% } %>
      </div>
    </div>
    <% if (can('publishResults')) { %>
      <form method="post" action="<%= base %>/results/publish" class="ms-auto">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="published" value="<%= published ? 0 : 1 %>">
        <button class="btn <%= published ? '' : 'btn-primary' %>" type="submit"><i class="ti ti-<%= published ? 'eye-off' : 'speakerphone' %> me-1"></i><%= published ? t('Hide results') : t('Publish results') %></button>
      </form>
    <% } %>
  </div>

  <% if (progress) { %>
    <div class="z-keystats mb-3">
      <div class="z-ks is-wait"><b><%= formatNumber(progress.waiting) %></b><span><%= t('Waiting for review') %></span></div>
      <div class="z-ks is-ok"><b><%= formatNumber(progress.approved) %></b><span><%= t('Approved') %></span></div>
      <div class="z-ks is-bad"><b><%= formatNumber(progress.rejected) %></b><span><%= t('Rejected') %></span></div>
      <div class="z-ks"><b><%= formatNumber(progress.jurors.length) %></b><span><%= t('Reviewers') %></span></div>
    </div>
  <% } %>
  <% if (!showRanking) { %>
    <div class="alert alert-info"><i class="ti ti-lock"></i><div><%= t('The ranking is published when the reviewers has finished.') %></div></div>
  <% } else if (!rows.length) { %>
    <div class="card"><%- include('../../partials/emptyArt', { title: t('No results yet'), text: t('The ranking fills in as entries are decided.') }) %></div>
  <% } else { %>
    <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-list-numbers me-2"></i><%= t('Leaderboard') %></h3><% if (can('manageEvent') || can('exportData')) { %><div class="card-actions"><%- include('../../partials/exportMenu', { dataset: 'results', btn: '' }) %></div><% } %></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table z-lb" data-sortable>
          <% const th = (label, cls = '') => `<th class="${cls}" aria-sort="none"><button type="button" class="z-sort-th" data-sort-col>${h(label)}<i class="ti ti-selector"></i></button></th>`; %>
          <thead><tr>
            <%- th(t('Rank'), 'w-1') %><%- th(t('Participant')) %><%- th(t('Submitted'), 'text-end') %><%- th(t('Accepted'), 'text-end') %>
            <% if (rows.withWordsBy) { %><%- th(t('Accepted words'), 'text-end text-green') %><%- th(t('Pending words'), 'text-end text-yellow') %><%- th(t('Not accepted words'), 'text-end text-red') %><% } %>
            <%- th(byWords ? t('Words') : t('Points'), 'text-end') %>
          </tr></thead>
          <tbody>
            <% rows.forEach((r) => { %>
              <tr>
                <td class="z-lb-rank" data-v="<%= r.rank %>"><span class="z-rank<%= medal[r.rank] ? ' z-' + medal[r.rank] : '' %>"><%= formatNumber(r.rank) %></span></td>
                <td class="z-lb-name" data-v="<%= showNames ? r.username : '' %>"><% if (showNames) { %><a href="<%= `${base}/user/${nameInPath(r.username)}` %>"><%= r.username %></a><% } else { %><span class="text-secondary"><%= t('Participant') %></span><% } %></td>
                <td class="text-end text-secondary z-lb-stat" data-v="<%= r.submitted ?? r.entries %>" data-label="<%= t('Submitted') %>"><%= formatNumber(r.submitted ?? r.entries) %></td>
                <td class="text-end z-lb-stat" data-v="<%= r.entries %>" data-label="<%= t('Accepted') %>"><%= formatNumber(r.entries) %></td>
                <% if (rows.withWordsBy) { %><td class="text-end text-green z-lb-stat" data-v="<%= r.wordsBy.approved %>" data-label="<%= t('Accepted words') %>"><%= formatNumber(r.wordsBy.approved) %></td><td class="text-end text-yellow z-lb-stat" data-v="<%= r.wordsBy.pending %>" data-label="<%= t('Pending words') %>"><%= formatNumber(r.wordsBy.pending) %></td><td class="text-end text-red z-lb-stat" data-v="<%= r.wordsBy.rejected %>" data-label="<%= t('Not accepted words') %>"><%= formatNumber(r.wordsBy.rejected) %></td><% } %>
                <td class="text-end fw-bold z-lb-score" data-v="<%= byWords ? r.words : r.points %>"><%= formatNumber(byWords ? r.words : r.points) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <% if (stats && stats.wordStats) { %><div class="mt-3"><%- include('../../partials/eventStats', { stats, part: 'breakdown' }) %></div><% } %>
</div>
</div>
