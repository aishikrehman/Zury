<%
  const SETTING_NAMES = Object.assign(Object.fromEntries(DATE_FIELDS), Object.fromEntries(FEATURE_FIELDS.map(([k, l]) => [k, l])), {
    title: 'Title', slug: 'Address', description: 'Description', primaryWiki: 'Wiki', language: 'Language', timezone: 'Time zone', visibility: 'Who can see it',
    participation: 'How people take part', registrationEnabled: 'How people take part', registrationRequired: 'How people take part', participationMode: 'Participants',
    minAccountAgeDays: 'Minimum account age', minEditCount: 'Minimum edit count', participantLimit: 'Participant limit', typeConfig: 'Submission rules', eligibleNamespaces: 'Namespaces',
    trackHashtags: 'Hashtags', trackCategories: 'Categories', reviewers: 'Who reviews', reviewMethod: 'How reviewers judge', rankBy: 'Results count', requiredReviews: 'Reviews per entry',
    decisionRule: 'How the reviews decide', reviewAssignment: 'Who reviews which entry', marks: 'Marks', organizingCommunity: 'Organizing community', contactInfo: 'Contact',
  });
%>
<%
  const describe = (e) => {
    let d = {};
    try { d = JSON.parse(e.details || '{}'); } catch { d = {}; }
    const label = (s) => (CONTEST_STATUSES[s] || { label: s }).label;
    // Each line in the reader's language.
    const n = (d.changed || []).length;
    switch (e.action) {
      case 'contest.created': return t('created the event');
      case 'contest.updated': return tn('changed {n} setting: {list}', 'changed {n} settings: {list}', n).replace('{list}', (d.changed || []).map((k) => t(SETTING_NAMES[k.replace(/^settings\./, '')] || k.replace(/^settings\./, ''))).join(', '));
      case 'contest.statusChanged': return t('status {from} → {to}', { from: t(label(d.from)), to: t(label(d.to)) });
      case 'contest.deleted': return t('deleted the event');
      case 'membership.added': return t('added {user} as {role}', { user: d.username, role: t(EVENT_ROLES[d.role] ? EVENT_ROLES[d.role].label : d.role) });
      case 'membership.removed': return t('removed {user} ({role})', { user: d.username, role: t(EVENT_ROLES[d.role] ? EVENT_ROLES[d.role].label : d.role) });
      case 'membership.joined': return t('joined as a participant');
      case 'membership.left': return t('left the event');
      case 'contestPermission.set': return t(d.allowed ? 'allowed {permission} for {user}' : 'denied {permission} for {user}', { permission: d.permission, user: d.username });
      case 'contestPermission.removed': return t('removed the {permission} override for {user}', { permission: d.permission, user: d.username });
      case 'submissions.created': return tn('submitted {n} entry', 'submitted {n} entries', d.count || 1);
      case 'results.published': return t('published the results');
      case 'results.unpublished': return t('hid the results');
      default: return e.action;
    }
  };
%>
<%- include('../../partials/contestHeader', { active: 'activity' }) %>
<div class="page-body"><div class="container-xl">
  <% const iconFor = (a) => ({ 'contest.created': ['plus', 'green'], 'contest.updated': ['pencil', 'blue'], 'contest.statusChanged': ['progress', 'azure'], 'contest.deleted': ['trash', 'red'], 'membership.added': ['user-plus', 'green'], 'membership.removed': ['user-minus', 'orange'], 'membership.joined': ['login', 'teal'], 'membership.left': ['logout', 'secondary'], 'contestPermission.set': ['key', 'purple'], 'contestPermission.removed': ['key-off', 'purple'], 'submissions.created': ['upload', 'blue'] }[a] || ['point', 'secondary']); %>
  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("Activity") %></h3><div class="card-actions text-secondary"><%= t('Latest {n}', { n: entries.length }) %> · <%= contest.timezone %></div></div>
    <% if (!entries.length) { %>
      <div class="empty"><div class="empty-icon"><i class="ti ti-history-off icon"></i></div><p class="empty-title"><%= t("No activity yet") %></p></div>
    <% } else { %>
      <div class="card-body">
        <div class="divide-y">
          <% entries.forEach((e) => { const [icon, color] = iconFor(e.action); %>
            <div>
              <div class="row">
                <div class="col-auto"><span class="avatar bg-<%= color %>-lt"><i class="ti ti-<%= icon %>"></i></span></div>
                <div class="col">
                  <div class="text-truncate"><strong><%= e.actor ? e.actor.username : 'Zury' %></strong> <%= describe(e) %></div>
                  <div class="text-secondary"><%= formatDateTime(e.createdAt, contest.timezone) %></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</div>
</div>
