<%
  const tz = contest.timezone;
  // The jury's own dates (review opens, review deadline) stay off the public timeline.
  const HIDDEN_DATES = ['reviewOpensAt', 'reviewDeadline'];
  const timeline = dateFields.filter(([key]) => contest[key] && !HIDDEN_DATES.includes(key)).map(([key, label]) => ({ key, label, at: contest[key] }));
  const showParticipants = !settings.anonymousParticipants || can('manageParticipants');
  const enabled = featureFields.filter(([key]) => settings[key]);
  const display = (f, value) => {
    if (f.type === 'bool') return t(value ? 'Yes' : 'No');
    if (f.type === 'choices') return [].concat(value).map((k) => f.choices[k] || k).join(', ');
    if (f.type === 'list') return value.length ? value.join(', ') : '—';
    if (f.type === 'int' && value === 0 && /max/i.test(f.key)) return t('No limit');
    if (f.type === 'int') return formatNumber(value);
    return value === '' ? '—' : value;
  };
%>
<%- include('../../partials/contestHeader', { active: 'overview' }) %>
<div class="page-body"><div class="container-xl">

  <% if (signUp && signUp.url) { %>
    <div class="alert alert-info d-flex align-items-center gap-2"><i class="ti ti-list-check"></i><div class="flex-fill"><%= signUp.onwiki ? t('Sign up on the event page on the wiki, then join here.') : t('Add your name to the participants list on the wiki.') %></div><a class="btn btn-sm btn-primary" href="<%= signUp.url %>" target="_blank" rel="noopener"><i class="ti ti-external-link me-1"></i><%= t('Open the wiki page') %></a></div>
  <% } %>


  <% if (!wikiScope && can('editEvent')) { %>
    <div class="card mb-3 z-about"><div class="card-body">
      <%- include('../../partials/inlineEdit', { action: `${eventBase}/inline`, name: 'description', value: contest.description, label: t('Description'), multiline: true, maxlength: 10000, viewTag: 'p', viewClass: 'mb-0 z-lead', emptyText: t('Add a description') }) %>
    </div></div>
  <% } else if (contest.description) { %>
    <div class="card mb-3 z-about"><div class="card-body"><p class="mb-0 z-lead" style="white-space: pre-line"><%= contest.description %></p></div></div>
  <% } %>
  <% if (wikiParts.length) { %>
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3><div class="card-actions text-secondary small"><%= t('{n} taking part', { n: wikiParts.filter((w) => w.status !== 'pending').length }) %></div></div>
      <% const mostEntries = Math.max(1, ...wikiParts.map((w) => w.entries)); %>
      <div class="card-body">
        <div class="row row-cards g-3">
          <% wikiParts.forEach((w) => { const st = CONTEST_STATUSES[w.status] || { label: t(w.status === 'paused' ? 'Paused' : 'Waiting for approval'), badge: 'secondary' }; const pr = eventProject({ primaryWiki: w.wiki }); %>
            <div class="col-sm-6 col-lg-4">
              <a class="z-wiki-card" href="<%= wikiHref(w) %>" style="--z-proj: <%= pr.color %>">
                <div class="d-flex align-items-start gap-2">
                  <span class="avatar avatar-sm z-proj-icon"><i class="ti ti-<%= pr.icon %>"></i></span>
                  <div class="min-w-0 flex-fill">
                    <div class="z-wiki-name text-truncate"><%= wikiLocal(w.wiki) %></div>
                    <div class="z-wiki-code">/<%= w.code %><% if (w.overridden) { %> · <%= t('{n} own settings', { n: w.overridden }) %><% } %></div>
                  </div>
                  <span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span>
                </div>
                <div class="z-wiki-bar" title="<%= t('{n} entries', { n: w.entries }) %>"><span style="width: <%= Math.round((w.entries / mostEntries) * 100) %>%"></span></div>
                <div class="z-wiki-stats">
                  <span><strong><%= formatNumber(w.entries) %></strong> <%= t('Entries') %></span>
                  <span><strong><%= formatNumber(w.organizers) %></strong> <%= t('Organizers') %></span>
                  <span><strong><%= formatNumber(w.jury) %></strong> <%= t('Reviewers') %></span>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <%
    // One stop per day: things that happen the same day share it.
    const now = Date.now();
    const stops = [];
    [...timeline].sort((x, y) => new Date(x.at) - new Date(y.at)).forEach((x) => {
      const dayKey = formatDate(x.at, tz);
      const last = stops[stops.length - 1];
      if (last && last.day === dayKey) last.labels.push(x.label);
      else stops.push({ day: dayKey, at: x.at, labels: [x.label] });
    });
    const current = stops.filter((x) => new Date(x.at).getTime() <= now).length - 1;
    const daysTo = (at) => Math.ceil((new Date(at).getTime() - now) / 86400000);
    const dayPart = (at, opts) => new Intl.DateTimeFormat(lang.code === 'bn' ? 'bn-BD' : 'en-GB', { timeZone: tz, ...opts }).format(new Date(at));
    const start = contest.startDate ? new Date(contest.startDate).getTime() : null;
    const finish = contest.endDate ? new Date(contest.endDate).getTime() : null;
    const length = start && finish ? Math.max(1, Math.round((finish - start) / 86400000)) : null;
    const done = start && finish ? Math.min(100, Math.max(0, Math.round(((now - start) / (finish - start)) * 100))) : null;
    const next = stops.find((x) => new Date(x.at).getTime() > now);
    const st = CONTEST_STATUSES[contest.status] || { label: contest.status, badge: 'secondary' };
  %>


  <% const hasSide = (!series || wikiScope) || (requestableWikis && series && !wikiScope); %>
  <div class="row row-cards">
    <div class="<%= hasSide ? 'col-lg-8' : 'col-12' %>">
      <% if (stats) { %>
        <%- include('../../partials/eventStats', { stats, part: 'tiles', wide: !hasSide }) %>
        <%- include('../../partials/eventStats', { stats, part: 'charts' }) %>
      <% } %>
      <% if (latest && latest.items.length) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-files me-2"></i><%= t('Submissions') %> <span class="badge bg-secondary-lt ms-1"><%= formatNumber(latest.total) %></span></h3><div class="card-actions"><a class="btn btn-sm" href="<%= base %>/submissions"><%= t('All submissions') %></a></div></div>
          <div class="list-group list-group-flush">
            <% latest.items.forEach((s) => { const st = SUBMISSION_STATUSES[s.status] || { label: s.status, color: 'secondary' }; %>
              <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="<%= base %>/submissions/<%= s.id %>">
                <span class="fw-medium text-truncate"><%= s.title %></span>
                <% if (s.participant && !settings.anonymousParticipants) { %><span class="text-secondary small text-truncate"><%= s.participant.username %></span><% } %>
                <% if (s.wordCount) { %><span class="text-secondary small text-nowrap ms-auto"><%= t('{n} words', { n: formatNumber(s.wordCount) }) %></span><% } %>
                <span class="badge bg-<%= st.color %>-lt<%= s.wordCount ? '' : ' ms-auto' %>"><%= t(st.label) %></span>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (jury) { %><%- include('../../partials/juryProgress', { jury }) %><% } %>
      <% if (myEntries && myEntries.entries.length) { %><%- include('../../partials/myEntries', { my: myEntries }) %><% } %>
    </div>
    <% if (hasSide) { %><div class="col-lg-4">
      <% if (!series || wikiScope) { %>
      <div class="card mb-3">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-list-check me-2"></i><%= t("Rules") %></h3></div>

        <div class="list-group list-group-flush">
          <div class="list-group-item py-2"><%= PARTICIPATION_MODES[settings.participationMode] %></div>
          <% if (settings.minAccountAgeDays) { %><div class="list-group-item py-2"><%= t('Wikimedia account at least {n} days old', { n: settings.minAccountAgeDays }) %></div><% } %>
          <% if (settings.minEditCount) { %><div class="list-group-item py-2"><%= t('At least {n} edits across Wikimedia projects', { n: settings.minEditCount }) %></div><% } %>
          <% if (settings.registrationRequired) { %><div class="list-group-item py-2"><%= t("Register before submitting") %></div><% } %>
          <% typeDef.fields.forEach((f) => { %><div class="list-group-item py-2 d-flex justify-content-between"><span><%= f.label %></span><span class="text-secondary"><%= display(f, typeConfig[f.key]) %></span></div><% }) %>
        </div>
        <% if (contest.contactInfo) { let ci; try { ci = JSON.parse(contest.contactInfo); } catch (e) { ci = { page: contest.contactInfo }; } if (!ci || typeof ci !== 'object') ci = { page: contest.contactInfo }; %>
          <div class="list-group-item py-2 d-flex flex-wrap gap-3 small">
            <% [['page', 'Contact page', 'message'], ['eventPage', 'On-wiki event page', 'world'], ['email', 'Email', 'mail'], ['phone', 'Phone', 'phone'], ['website', 'Website', 'link']].filter(([k]) => ci[k]).forEach(([k, label, icon]) => { const val = ci[k]; const href = k === 'email' ? 'mailto:' + val : k === 'phone' ? 'tel:' + val : /^https?:/.test(val) ? val : null; %>
              <span><i class="ti ti-<%= icon %> me-1 text-secondary"></i><% if (href) { %><a href="<%= href %>" rel="noopener"<%= /^https?:/.test(href) ? ' target=_blank' : '' %>><%= k === 'email' || k === 'phone' ? val : t(label) %></a><% } else { %><%= val %><% } %></span>
            <% }) %>
          </div>
        <% } %>
        <% if (enabled.length) { %>
          <div class="card-footer"><% enabled.forEach(([, label]) => { %><span class="badge bg-green-lt me-1 mb-1"><i class="ti ti-check me-1"></i><%= label %></span><% }) %></div>
        <% } %>

      </div>
      <% } %>
      <% if (requestableWikis && series && !wikiScope) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-world-plus me-2"></i><%= t("Bring your wiki") %></h3></div>
          <div class="card-body">
            <form method="post" action="<%= eventBase %>/wikis/request" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-12"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Search wikis…") %>" required></select></div>
              <div class="col-12"><button class="btn btn-outline-primary w-100" type="submit"><%= t("Ask to join as organizer") %></button></div>
            </form>
          </div>
        </div>
      <% } %>
    </div><% } %>
  </div>
</div>
</div>
