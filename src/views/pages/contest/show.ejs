<%
  const tz = contest.timezone;
  // The jury's own dates (review opens, review deadline) stay off the public timeline.
  const HIDDEN_DATES = ['reviewOpensAt', 'reviewDeadline'];
  const timeline = dateFields.filter(([key]) => contest[key] && !HIDDEN_DATES.includes(key)).map(([key, label]) => ({ key, label, at: contest[key] }));
  const showParticipants = !settings.anonymousParticipants || can('manageParticipants');
  const enabled = featureFields.filter(([key]) => settings[key]);
  const display = (f, value) => {
    if (f.type === 'bool') return t(value ? 'Yes' : 'No');
    if (f.type === 'choices') return [].concat(value).map((k) => f.choices[k] || k).join(', ');
    if (f.type === 'list') return value.length ? value.join(', ') : '—';
    if (f.type === 'int' && value === 0 && /max/i.test(f.key)) return t('No limit');
    if (f.type === 'int') return formatNumber(value);
    return value === '' ? '—' : value;
  };
%>
<%- include('../../partials/contestHeader', { active: 'overview' }) %>
<div class="page-body"><div class="container-xl">

  <%# Why the Join button is missing, for someone who can't take part. %>
  <% if (currentUser && !isParticipant && !eligibility.eligible && eligibility.reasons.length) { %>
    <div class="alert alert-warning"><i class="ti ti-info-circle"></i><div><% eligibility.reasons.forEach((r) => { %><div><%= t(r) %></div><% }) %></div></div>
  <% } %>

  <%# ── About the event and how to take part ── %>
  <div class="row row-cards mb-3">
    <div class="col-12">
      <div class="card z-about">
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge bg-blue-lt"><i class="ti ti-<%= typeDef.icon || 'calendar-event' %> me-1"></i><%= typeDef.label %></span>
          </div>
          <% if (contest.description) { %>
            <p class="mb-0 z-lead" style="white-space: pre-line"><%= contest.description %></p>
          <% } else { %>
            <p class="mb-0 text-secondary"><%= t("No description yet.") %></p>
          <% } %>
        </div>
      <%
        // One stop per day: things that happen the same day share it.
        const now = Date.now();
        const stops = [];
        [...timeline].sort((x, y) => new Date(x.at) - new Date(y.at)).forEach((x) => {
          const dayKey = formatDate(x.at, tz);
          const last = stops[stops.length - 1];
          if (last && last.day === dayKey) last.labels.push(x.label);
          else stops.push({ day: dayKey, at: x.at, labels: [x.label] });
        });
        const current = stops.filter((x) => new Date(x.at).getTime() <= now).length - 1;
        const daysTo = (at) => Math.round((new Date(at).getTime() - now) / 86400000);
      %>
      <% if (stops.length) { %>
        <div class="card-footer bg-transparent z-timeline-wrap">
          <ol class="z-timeline">
            <% stops.forEach((x, i) => { const state = i < current ? 'done' : i === current ? 'now' : 'next'; const d = daysTo(x.at); %>
              <li class="z-stop z-stop-<%= state %>" title="<%= formatDateTime(x.at, tz) %>">
                <span class="z-stop-dot"><% if (state === 'done') { %><i class="ti ti-check"></i><% } %></span>
                <span class="z-stop-date"><%= x.day %></span>
                <span class="z-stop-label"><%= x.labels.join(' · ') %></span>
                <% if (state === 'next' && d >= 0 && d <= 60) { %><span class="z-stop-when"><%= d === 0 ? t('Today') : tn('in {n} day', 'in {n} days', d) %></span><% } %>
              </li>
            <% }) %>
          </ol>
        </div>
      <% } %>
      </div>
    </div>
  </div>

  <%# ── Numbers ── %>
  <% if (stats) { %><%- include('../../partials/eventStats', { stats, part: 'summary' }) %><% } %>

  <%# ── Wikis, then the details and rules in one card ── %>
  <div class="row row-cards">
    <div class="col-lg-8">
      <% if (wikiParts.length) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3><div class="card-actions text-secondary small"><%= t('{n} taking part', { n: wikiParts.filter((w) => w.status !== 'pending').length }) %></div></div>
          <% const mostEntries = Math.max(1, ...wikiParts.map((w) => w.entries)); %>
          <div class="card-body">
            <div class="row row-cards g-3">
              <% wikiParts.forEach((w) => { const st = CONTEST_STATUSES[w.status] || { label: t(w.status === 'paused' ? 'Paused' : 'Waiting for approval'), badge: 'secondary' }; const pr = eventProject({ primaryWiki: w.wiki }); %>
                <div class="col-sm-6 col-lg-4">
                  <a class="z-wiki-card" href="<%= eventBase %>/<%= w.code %>" style="--z-proj: <%= pr.color %>">
                    <div class="d-flex align-items-start gap-2">
                      <span class="avatar avatar-sm z-proj-icon"><i class="ti ti-<%= pr.icon %>"></i></span>
                      <div class="min-w-0 flex-fill">
                        <div class="z-wiki-name text-truncate"><%= wikiLocal(w.wiki) %></div>
                        <div class="z-wiki-code">/<%= w.code %><% if (w.overridden) { %> · <%= t('{n} own settings', { n: w.overridden }) %><% } %></div>
                      </div>
                      <span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span>
                    </div>
                    <div class="z-wiki-bar" title="<%= t('{n} entries', { n: w.entries }) %>"><span style="width: <%= Math.round((w.entries / mostEntries) * 100) %>%"></span></div>
                    <div class="z-wiki-stats">
                      <span><strong><%= formatNumber(w.entries) %></strong> <%= t('Entries') %></span>
                      <span><strong><%= formatNumber(w.organizers) %></strong> <%= t('Organizers') %></span>
                      <span><strong><%= formatNumber(w.jury) %></strong> <%= t('Jury') %></span>
                    </div>
                  </a>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>
      <div class="card">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-list-check me-2"></i><%= t("Rules") %></h3></div>

        <div class="list-group list-group-flush">
          <div class="list-group-item py-2"><%= PARTICIPATION_MODES[settings.participationMode] %></div>
          <% if (settings.minAccountAgeDays) { %><div class="list-group-item py-2"><%= t('Wikimedia account at least {n} days old', { n: settings.minAccountAgeDays }) %></div><% } %>
          <% if (settings.minEditCount) { %><div class="list-group-item py-2"><%= t('At least {n} edits across Wikimedia projects', { n: settings.minEditCount }) %></div><% } %>
          <% if (settings.registrationRequired) { %><div class="list-group-item py-2"><%= t("Register before submitting") %></div><% } %>
          <% typeDef.fields.forEach((f) => { %><div class="list-group-item py-2 d-flex justify-content-between"><span><%= f.label %></span><span class="text-secondary"><%= display(f, typeConfig[f.key]) %></span></div><% }) %>
        </div>
        <% if (contest.contactInfo) { %><div class="list-group-item py-2 d-flex justify-content-between gap-3"><span><%= t("Contact") %></span><span class="text-secondary text-end"><%= contest.contactInfo %></span></div><% } %>
        <% if (enabled.length) { %>
          <div class="card-footer"><% enabled.forEach(([, label]) => { %><span class="badge bg-green-lt me-1 mb-1"><i class="ti ti-check me-1"></i><%= label %></span><% }) %></div>
        <% } %>

      </div>
    </div>
    <div class="col-lg-4">
      <% if (requestableWikis && series && !wikiScope) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-world-plus me-2"></i><%= t("Bring your wiki") %></h3></div>
          <div class="card-body">
            <form method="post" action="<%= eventBase %>/wikis/request" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-12"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Search wikis…") %>" required></select></div>
              <div class="col-12"><button class="btn btn-outline-primary w-100" type="submit"><%= t("Ask to join as organizer") %></button></div>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
</div>
