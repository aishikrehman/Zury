<%
  const tz = contest.timezone;
  const timeline = dateFields.filter(([key]) => contest[key]).map(([key, label]) => ({ label, at: contest[key] }));
  const showParticipants = !settings.anonymousParticipants || can('manageParticipants');
  const enabled = featureFields.filter(([key]) => settings[key]);
  const display = (f, value) => {
    if (f.type === 'bool') return value ? 'Yes' : 'No';
    if (f.type === 'choices') return [].concat(value).map((k) => f.choices[k] || k).join(', ');
    if (f.type === 'list') return value.length ? value.join(', ') : '—';
    if (f.type === 'int' && value === 0 && /max/i.test(f.key)) return 'No limit';
    return value === '' ? '—' : value;
  };
%>
<div class="container py-5">
  <%- include('../../partials/contestHeader', { active: 'overview' }) %>

  <div class="row g-4">
    <div class="col-lg-8">
      <% if (contest.description) { %><p class="lead" style="white-space: pre-line"><%= contest.description %></p><% } %>

      <h2 class="h5 mt-4">Timeline <span class="small text-muted fw-normal">(<%= tz %>)</span></h2>
      <% if (!timeline.length) { %>
        <p class="text-muted">Dates haven't been set yet.</p>
      <% } else { %>
        <ul class="list-group list-group-flush mb-4">
          <% timeline.forEach((t) => { %>
            <li class="list-group-item d-flex justify-content-between px-0">
              <span><%= t.label %></span><span class="text-muted"><%= formatDateTime(t.at, tz) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2 class="h5">Details</h2>
      <dl class="row">
        <% if (contest.organizingCommunity) { %><dt class="col-sm-4">Organized by</dt><dd class="col-sm-8"><%= contest.organizingCommunity %></dd><% } %>
        <dt class="col-sm-4">Wikis</dt><dd class="col-sm-8"><%= [contest.primaryWiki, ...additionalWikis].join(', ') %></dd>
        <dt class="col-sm-4">Language</dt><dd class="col-sm-8"><%= contest.language %></dd>
        <% if (contest.contactInfo) { %><dt class="col-sm-4">Contact</dt><dd class="col-sm-8"><%= contest.contactInfo %></dd><% } %>
        <dt class="col-sm-4">Organizers</dt>
        <dd class="col-sm-8">
          <% if (!organizers.length) { %><span class="text-muted">None listed</span><% } %>
          <% organizers.forEach((u, i) => { %><a href="<%= userPath(u.username) %>"><%= u.username %></a><%= i < organizers.length - 1 ? ', ' : '' %><% }) %>
        </dd>
        <% if (settings.juryReviewEnabled) { %><dt class="col-sm-4">Jury</dt><dd class="col-sm-8"><%= jury.length %> member<%= jury.length === 1 ? '' : 's' %></dd><% } %>
        <dt class="col-sm-4">Participants</dt>
        <dd class="col-sm-8">
          <%= participantCount %><%= settings.participantLimit ? ` of ${settings.participantLimit}` : '' %>
          <% if (showParticipants && participants.length) { %>
            <details class="small"><summary>Show names</summary>
              <% participants.forEach((u, i) => { %><a href="<%= userPath(u.username) %>"><%= u.username %></a><%= i < participants.length - 1 ? ', ' : '' %><% }) %>
            </details>
          <% } %>
        </dd>
      </dl>

      <h2 class="h5 mt-4">Rules</h2>
      <ul class="small">
        <li><%= PARTICIPATION_MODES[settings.participationMode] %>.</li>
        <% if (settings.minAccountAgeDays) { %><li>Wikimedia account at least <%= settings.minAccountAgeDays %> days old.</li><% } %>
        <% if (settings.minEditCount) { %><li>At least <%= settings.minEditCount %> edits across Wikimedia projects.</li><% } %>
        <% if (settings.registrationRequired) { %><li>Register before submitting.</li><% } %>
        <% typeDef.fields.forEach((f) => { %><li><%= f.label %>: <%= display(f, typeConfig[f.key]) %></li><% }) %>
      </ul>
      <% if (enabled.length) { %>
        <p class="small mb-0">
          <% enabled.forEach(([, label]) => { %><span class="badge text-bg-light border me-1"><%= label %></span><% }) %>
        </p>
      <% } %>
    </div>

    <div class="col-lg-4">
      <div class="card mb-3">
        <div class="card-body">
          <h2 class="h6">Take part</h2>
          <% if (isParticipant) { %>
            <p class="small text-success mb-2">You're a participant.</p>
            <% if (!['completed', 'archived'].includes(contest.status)) { %>
              <form method="post" action="/contest/<%= contest.id %>/leave">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Leave event</button>
              </form>
            <% } %>
          <% } else if (!currentUser) { %>
            <a class="btn btn-sm btn-primary" href="/login">Log in to join</a>
          <% } else if (eligibility.eligible) { %>
            <form method="post" action="/contest/<%= contest.id %>/join">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-primary" type="submit">Join this event</button>
            </form>
          <% } else { %>
            <ul class="small text-muted mb-0 ps-3">
              <% eligibility.reasons.forEach((r) => { %><li><%= r %></li><% }) %>
            </ul>
          <% } %>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h2 class="h6">Your access to this event</h2>
          <% if (!currentUser) { %>
            <p class="small text-muted mb-0">Log in to see what you can do here.</p>
          <% } else { %>
            <p class="small mb-1"><strong>Event roles:</strong>
              <% if (!scope.eventRoles.length) { %><span class="text-muted">none</span><% } %>
              <% scope.eventRoles.forEach((r) => { %><span class="badge rounded-pill text-bg-primary me-1"><%= EVENT_ROLES[r].label %></span><% }) %>
            </p>
            <p class="small mb-2"><strong>Platform authority here:</strong>
              <% const here = scope.platformRoles.filter((r) => r !== 'local-admin' || scope.isLocalAdminHere).filter((r) => PLATFORM_ROLES[r].source === 'wikimedia'); %>
              <% if (!here.length) { %><span class="text-muted">none</span><% } %>
              <% here.forEach((r) => { %><span class="badge text-bg-secondary me-1"><%= PLATFORM_ROLES[r].label %></span><% }) %>
            </p>
            <% if (scope.overrides.length) { %>
              <p class="small mb-2"><strong>Overrides:</strong>
                <% scope.overrides.forEach((o) => { %><span class="badge text-bg-<%= o.allowed ? 'success' : 'danger' %> me-1"><%= o.allowed ? '+' : '−' %> <%= o.permission %></span><% }) %>
              </p>
            <% } %>
            <details class="small">
              <summary><%= permissionList.length %> permission<%= permissionList.length === 1 ? '' : 's' %></summary>
              <ul class="mt-2 mb-0 ps-3">
                <% permissionList.forEach((p) => { %><li><%= permissionLabels[p] %> <code class="text-muted"><%= p %></code></li><% }) %>
              </ul>
            </details>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
