<div class="container py-5">
  <%- include('../../partials/contestHeader', { active: 'overview' }) %>

  <div class="row g-4">
    <div class="col-lg-8">
      <% if (contest.description) { %><p class="lead"><%= contest.description %></p><% } %>
      <dl class="row">
        <dt class="col-sm-4">Dates</dt>
        <dd class="col-sm-8">
          <% if (contest.startDate) { %><%= formatDate(contest.startDate, contest.timezone) %> – <%= formatDate(contest.endDate, contest.timezone) %> <span class="text-muted small">(<%= contest.timezone %>)</span><% } else { %>Not set<% } %>
        </dd>
        <dt class="col-sm-4">Primary wiki</dt><dd class="col-sm-8"><%= contest.primaryWiki %></dd>
        <dt class="col-sm-4">Language</dt><dd class="col-sm-8"><%= contest.language %></dd>
        <dt class="col-sm-4">Organizers</dt>
        <dd class="col-sm-8">
          <% if (!organizers.length) { %><span class="text-muted">None listed</span><% } %>
          <% organizers.forEach((u, i) => { %><a href="<%= userPath(u.username) %>"><%= u.username %></a><%= i < organizers.length - 1 ? ', ' : '' %><% }) %>
        </dd>
        <dt class="col-sm-4">Jury</dt>
        <dd class="col-sm-8"><%= jury.length %> member<%= jury.length === 1 ? '' : 's' %></dd>
        <dt class="col-sm-4">Participants</dt>
        <dd class="col-sm-8"><%= participantCount %></dd>
      </dl>
      <p class="text-muted small">Submissions, jury review and results will appear here in later phases.</p>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">
          <h2 class="h6">Your access to this event</h2>
          <% if (!currentUser) { %>
            <p class="small text-muted mb-0">Log in to see what you can do here.</p>
          <% } else { %>
            <p class="small mb-1"><strong>Event roles:</strong>
              <% if (!scope.eventRoles.length) { %><span class="text-muted">none</span><% } %>
              <% scope.eventRoles.forEach((r) => { %><span class="badge rounded-pill text-bg-primary me-1"><%= EVENT_ROLES[r].label %></span><% }) %>
            </p>
            <p class="small mb-2"><strong>Platform authority here:</strong>
              <% const here = scope.platformRoles.filter((r) => r !== 'local-admin' || scope.isLocalAdminHere).filter((r) => PLATFORM_ROLES[r].source === 'wikimedia'); %>
              <% if (!here.length) { %><span class="text-muted">none</span><% } %>
              <% here.forEach((r) => { %><span class="badge text-bg-secondary me-1"><%= PLATFORM_ROLES[r].label %></span><% }) %>
            </p>
            <% if (scope.overrides.length) { %>
              <p class="small mb-2"><strong>Overrides:</strong>
                <% scope.overrides.forEach((o) => { %><span class="badge text-bg-<%= o.allowed ? 'success' : 'danger' %> me-1"><%= o.allowed ? '+' : '−' %> <%= o.permission %></span><% }) %>
              </p>
            <% } %>
            <details class="small">
              <summary><%= permissionList.length %> permission<%= permissionList.length === 1 ? '' : 's' %></summary>
              <ul class="mt-2 mb-0 ps-3">
                <% permissionList.forEach((p) => { %><li><%= permissionLabels[p] %> <code class="text-muted"><%= p %></code></li><% }) %>
              </ul>
            </details>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
