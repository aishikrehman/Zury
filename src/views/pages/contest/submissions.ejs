<%
  const qs = (extra) => {
    const p = new URLSearchParams();
    if (filters.status) p.set('status', filters.status);
    if (filters.q) p.set('q', filters.q);
    if (filters.mine) p.set('mine', '1');
    if (filters.participant) p.set('participant', filters.participant);
    if (filters.view) p.set('view', filters.view);
    if (filters.sort !== 'submitted' || filters.dir !== 'desc') { p.set('sort', filters.sort); p.set('dir', filters.dir); }
    Object.entries(extra).forEach(([k, v]) => (v === null ? p.delete(k) : p.set(k, v)));
    const s = p.toString();
    return `?${s}`;
  };
  const pages = Math.max(1, Math.ceil(result.total / result.perPage));
  const totalAll = (result.counts.pending || 0) + (result.counts.approved || 0) + (result.counts.rejected || 0);
  // A header that sorts by its column; a second click turns the order round.
  const sortHead = (key, label, cls = '') => {
    const on = filters.sort === key;
    const dir = on ? (filters.dir === 'asc' ? 'desc' : 'asc') : key === 'submitted' ? 'desc' : 'asc';
    const icon = on ? (filters.dir === 'asc' ? 'chevron-up' : 'chevron-down') : 'selector';
    return `<th class="${cls}"${on ? ` aria-sort="${filters.dir === 'asc' ? 'ascending' : 'descending'}"` : ''}><a class="z-sort${on ? ' active' : ''}" href="${h(qs({ sort: key, dir, page: null }))}">${h(label)} <i class="ti ti-${icon}"></i></a></th>`;
  };
  const canManage = can('manageEvent');
  const canReview = (s) => reviewWikis === null || (reviewWikis || []).includes(s.wiki);
  const reviewable = (s) => juryOn && currentUser && canReview(s) && ['pending', 'validated', 'under_review'].includes(s.status);
  const bulk = canManage && settings.bulkReviewEnabled !== false && currentUser && reviewWikis !== undefined && (reviewWikis === null || reviewWikis.length > 0) && result.items.some(reviewable);
  const hidden = `<input type="hidden" name="_csrf" value="${h(csrfToken)}"><input type="hidden" name="back" value="${h(back)}">`;
%>
<%- include('../../partials/contestHeader', { active: 'submissions' }) %>
<div class="page-body"><div class="container-xl">

  <div class="card" data-live>
    <div class="card-header z-list-head">
      <form class="z-list-filters" method="get" id="subs-filters">
        <% if (filters.view) { %><input type="hidden" name="view" value="<%= filters.view %>"><% } %>
        <% if (filters.sort !== 'submitted' || filters.dir !== 'desc') { %><input type="hidden" name="sort" value="<%= filters.sort %>"><input type="hidden" name="dir" value="<%= filters.dir %>"><% } %>
        <select class="form-select form-select-sm z-fit" name="status" aria-label="<%= t('Status') %>" data-autosubmit>
          <option value=""><%= t('All') %> (<%= formatNumber(totalAll) %>)</option>
          <% ['pending', 'approved', 'rejected', 'withdrawn'].filter((s) => result.counts[s] || filters.status === s).forEach((s) => { %>
            <option value="<%= s %>"<%= filters.status === s ? ' selected' : '' %>><%= SUBMISSION_STATUSES[s].label %> (<%= formatNumber(result.counts[s] || 0) %>)</option>
          <% }) %>
        </select>
        <div class="input-icon z-search-sm">
          <span class="input-icon-addon"><i class="ti ti-search"></i></span>
          <input class="form-control form-control-sm" type="search" name="q" value="<%= filters.q %>" placeholder="<%= t('Search titles') %>" aria-label="<%= t('Search titles') %>">
        </div>
        <% const peopleList = showNames && result.participants.length > 1; if (peopleList || currentUser) { %>
        <div class="input-group input-group-sm z-people-pick">
          <% if (currentUser) { %><label class="btn btn-sm btn-icon z-mine-btn<%= filters.mine ? ' btn-primary' : '' %>" title="<%= t('Only mine') %>"><input type="checkbox" class="visually-hidden" name="mine" value="1"<%= filters.mine ? ' checked' : '' %> data-autosubmit aria-label="<%= t('Only mine') %>"><i class="ti ti-user-check"></i></label><% } %>
          <% if (peopleList) { %><select class="form-select form-select-sm" name="participant" aria-label="<%= t('Participant') %>" data-autosubmit<%= filters.mine ? ' disabled' : '' %>>
            <option value=""><%= t('All participants') %></option>
            <% [...result.participants].sort((x, y) => y.entries - x.entries).forEach((pp) => { %>
              <option value="<%= pp.id %>"<%= filters.participant === pp.id ? ' selected' : '' %>><%= pp.username %> · <%= formatNumber(pp.entries) %></option>
            <% }) %>
          </select><% } %>
        </div>
        <% } %>
        <% if (currentUser) { %>
        <% } %>
      </form>
      <div class="z-head-actions">
        <span class="z-bulk-slot"></span>
        <% if ((bulk || canManage) && result.items.length) { %><label class="btn btn-sm btn-icon d-md-none z-check-all-m" title="<%= t('Select all') %>"><i class="ti ti-checks"></i><input class="visually-hidden" type="checkbox" data-check-all="bulk-ids" aria-label="<%= t('Select all') %>"></label><% } %>
        <div class="dropdown">
          <button class="btn btn-sm btn-icon<%= filters.view ? ' btn-primary' : '' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="<%= t('Show') %>" aria-label="<%= t('Show') %>"><i class="ti ti-<%= { people: 'users', reviewers: 'gavel' }[filters.view] || 'layout-list' %>"></i></button>
          <div class="dropdown-menu dropdown-menu-end">
            <h6 class="dropdown-header"><%= t('Show') %></h6>
            <% [['', 'Plain list', 'list'], ['people', 'By participant', 'users'], ['reviewers', 'By reviewer', 'gavel']].forEach(([key, label, icon]) => { %>
              <a class="dropdown-item<%= (filters.view || '') === key ? ' active' : '' %>" href="<%= qs({ view: key || null, page: null }) %>"><i class="ti ti-<%= icon %> me-2"></i><%= t(label) %></a>
            <% }) %>
          </div>
        </div>
        <div class="dropdown">
          <button class="btn btn-sm btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="<%= t('More') %>" aria-label="<%= t('More') %>"><i class="ti ti-dots-vertical"></i></button>
          <div class="dropdown-menu dropdown-menu-end">
            <% if (canManage) { %>
              <form method="post" action="<%= base %>/submissions/revalidate-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="dropdown-item" type="submit"><i class="ti ti-refresh me-2"></i><%= t('Check all again') %><% if (allWikis && allWikis.some((w) => w.fountainCode)) { %> <span class="text-secondary small ms-1">+ Fountain</span><% } %></button></form>
            <% } %>
            <% if (can('manageEvent') || can('exportData')) { %>
              <div class="dropdown-divider"></div>
              <h6 class="dropdown-header"><%= t('Download') %></h6>
              <% [['csv', 'CSV', 'file-type-csv'], ['xls', 'Excel', 'file-spreadsheet'], ['wiki', t('Wikitext'), 'brand-wikipedia'], ['md', 'Markdown', 'markdown']].forEach(([f, name, icon]) => { %><a class="dropdown-item" href="<%= base %>/export/entries.<%= f %>"><i class="ti ti-<%= icon %> me-2"></i><%= name %></a><% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% const picked = filters.participant && result.participants.find((pp) => pp.id === filters.participant); %>
    <% if (result.total && (picked || settings.wordCountEnabled)) { %>
      <div class="card-body border-bottom py-2 d-flex flex-wrap gap-3 align-items-center small">
        <% if (picked) { %>
          <span><i class="ti ti-user me-1"></i><a href="/users/<%= encodeURIComponent(picked.username) %>" class="fw-medium"><%= picked.username %></a></span>
        <% } %>
        <span class="text-secondary"><%= tn('{n} entry', '{n} entries', result.total) %></span>
        <% if (settings.wordCountEnabled) { %><span class="z-wordsby"><span class="text-secondary"><%= t('{n} words', { n: formatNumber(result.words) }) %></span><%- include('../../partials/wordsBar', { wb: result.wordsBy }) %></span><% } %>
        <% if (picked) { %><a class="ms-auto" href="<%= qs({ participant: null, page: null }) %>"><i class="ti ti-x me-1"></i><%= t('Show everyone') %></a><% } %>
      </div>
    <% } %>
    <% if (!result.items.length) { %>
      <div class="z-empty-line text-secondary small">
        <%= filters.mine ? t('You have no entries here') : (filters.status || filters.q || filters.participant) ? t('No entries') : t('No submissions yet') %>
        <% if (!currentUser && !filters.mine) { %> · <%= t('Log in to see your own entries.') %><% } %>
        <% if (currentUser && contest.status === 'active') { %> · <a href="<%= base %>/submit"><%= t('Submit entries') %></a><% } %>
      </div>
    <% } else { %>
        <form method="post" action="<%= base %>/review/bulk" id="bulk-review" class="z-bulkbar" data-bulk-bar="bulk-ids" hidden>
          <%- hidden %>
          <span class="badge bg-primary-lt" data-bulk-count></span>
          <% marks.forEach((m) => { %>
            <select class="form-select form-select-sm w-auto" name="mark:<%= m.name %>" aria-label="<%= m.name %>" required>
              <option value=""><%= m.name %>…</option>
              <% m.values.forEach((val) => { %><option value="<%= val.label %>"><%= val.label %> (<%= val.points %>)</option><% }) %>
            </select>
          <% }) %>
          <input type="hidden" name="comment">
          <% if (currentUser && (bulk || canManage)) { %><button class="btn btn-sm btn-icon btn-primary" type="button" data-review-selected="<%= base %>/review" title="<%= t('Review') %>" aria-label="<%= t('Review') %>"><i class="ti ti-gavel"></i></button><% } %>
          <% if (bulk) { %>
            <button class="btn btn-sm btn-icon btn-success" type="submit" name="decision" value="accept" title="<%= t('Accept selected') %>" aria-label="<%= t('Accept selected') %>"><i class="ti ti-check"></i></button>
            <button class="btn btn-sm btn-icon btn-danger" type="submit" name="decision" value="reject" data-ask="comment" data-ask-text="<%= t('Why are they not accepted?') %>" title="<%= t('Reject selected') %>" aria-label="<%= t('Reject selected') %>"><i class="ti ti-x"></i></button>
            <button class="btn btn-sm btn-icon btn-ghost-warning" type="submit" formaction="<%= base %>/review/bulk-delete" data-confirm="<%= t('Delete the reviews of the selected entries? Reviewers delete only their own.') %>" title="<%= t('Delete reviews') %>" aria-label="<%= t('Delete reviews') %>"><i class="ti ti-eraser"></i></button>
          <% } %>
          <% if (canManage) { %><button class="btn btn-sm btn-icon btn-ghost-danger" type="submit" formaction="<%= base %>/submissions/remove" data-confirm="<%= t('Remove the selected entries from the event?') %>" title="<%= t('Remove selected') %>" aria-label="<%= t('Remove selected') %>"><i class="ti ti-trash"></i></button><% } %>
        </form>
      <div class="table-responsive">
        <table class="table table-vcenter card-table z-subs-table">
          <thead><tr><% if (bulk || canManage) { %><th class="w-1"><input class="form-check-input m-0" type="checkbox" data-check-all="bulk-ids" aria-label="<%= t('Select all') %>"></th><% } %><%- sortHead('title', t('Entry')) %><%- sortHead('participant', t('Participant')) %><%- sortHead('status', t('Status')) %><% if (showReviewers) { %><%- sortHead('reviewers', t('Reviewers')) %><% } %><% if (settings.wordCountEnabled) { %><%- sortHead('words', t('Words'), 'text-end') %><% } %><%- sortHead('submitted', t('Submitted')) %><th class="w-1"><span class="visually-hidden"><%= t('Actions') %></span></th></tr></thead>
          <tbody>
            <% let lastPerson = null; const personOf = Object.fromEntries(result.participants.map((pp) => [pp.id, pp])); %>
            <% let rows = result.items.map((s) => ({ s, group: null })); %>
            <% if (filters.view === 'reviewers') { const by = new Map(); result.items.forEach((s) => { const names = (s.reviews || []).map((rv) => rv.juror && rv.juror.username).filter(Boolean); (names.length ? [...new Set(names)] : ['']).forEach((n) => { if (!by.has(n)) by.set(n, []); by.get(n).push(s); }); }); rows = [...by.entries()].sort((x, y) => (x[0] === '') - (y[0] === '') || x[0].localeCompare(y[0])).flatMap(([n, list]) => list.map((s, i) => ({ s, group: n, first: i === 0, count: list.length }))); } %>
            <% rows.forEach(({ s, group, first, count }) => { const meta = JSON.parse(s.metadata); %>
              <% if (filters.view === 'reviewers' && first) { %>
                <tr class="z-group-row" data-group-toggle="r-<%= group || 'none' %>"><td colspan="20"><i class="ti ti-chevron-down z-group-caret"></i><span class="fw-bold"><%= group || t('Not reviewed yet') %></span><span class="text-secondary small ms-2"><%= tn('{n} entry', '{n} entries', count) %></span></td></tr>
              <% } %>
              <% if (filters.view === 'people' && s.participantId !== lastPerson) { lastPerson = s.participantId; const pp = personOf[s.participantId] || { entries: 0, words: 0 }; %>
                <tr class="z-group-row" data-group-toggle="<%= s.participantId %>"><td colspan="20"><div class="z-group-line">
                  <i class="ti ti-chevron-down z-group-caret"></i>
                  <% if (showNames || (currentUser && currentUser.id === s.participantId)) { %><a class="fw-bold" href="<%= base %>/user/<%= nameInPath(s.participant.username) %>" onclick="event.stopPropagation()"><%= s.participant.username %></a><% } else { %><span class="fw-bold"><%= t('Anonymous') %></span><% } %>
                  <span class="z-group-stats"><%= tn('{n} entry', '{n} entries', pp.entries) %><% if (settings.wordCountEnabled) { %> · <%= t('{n} words', { n: formatNumber(pp.words) }) %><% } %></span><% if (settings.wordCountEnabled) { %><%- include('../../partials/wordsBar', { wb: pp.wordsBy }) %><% } %></div>
                </td></tr>
              <% } %>
              <tr<%- filters.view === 'people' ? ` data-group="${s.participantId}"` : filters.view === 'reviewers' ? ` data-group="r-${group || 'none'}"` : '' %>>
                <% if (bulk || canManage) { %><td class="z-c-tick"><% if (canManage) { %><input class="form-check-input m-0" type="checkbox" name="ids" value="<%= s.id %>" form="bulk-review" data-check="bulk-ids" aria-label="<%= t('Select') %> <%= s.title %>"><% } %></td><% } %>
                <td class="z-c-title">
                  <div class="d-flex align-items-center">
                    <% if (meta.file && meta.file.thumbUrl) { %>
                      <span class="avatar avatar-sm me-2" style="background-image: url('<%= meta.file.thumbUrl %>')"></span>
                    <% } %>
                    <div>
                      <a href="<%= entryUrl(s) %>" target="_blank" rel="noopener"><%= s.title %></a>
                      <% if (showWiki) { %><div class="text-secondary small z-entry-wiki"><%= wikiLocal(s.wiki) %></div><% } %>
                    </div>
                  </div>
                <% if (currentUser && (s.participantId === currentUser.id || canManage) && ['approved', 'rejected', 'disqualified'].includes(s.status)) { (s.reviews || []).filter((rv) => rv.comment).forEach((rv) => { %><div class="z-review-note small mt-1" tabindex="0" data-toggle-open title="<%= t('Show all') %>"><i class="ti ti-message-2 me-1 text-secondary"></i><%= rv.comment %></div><% }) } %></td>
                <td class="z-c-who"><i class="ti ti-user d-md-none me-1" aria-hidden="true"></i>                  <% if (showNames || (currentUser && currentUser.id === s.participantId)) { %>
                    <a href="<%= base %>/user/<%= nameInPath(s.participant.username) %>" class="z-user-name"><%= s.participant.username %></a>
                  <% } else { %><span class="text-secondary"><%= t('Anonymous') %></span><% } %>
                </td>
                <td class="z-c-status"><%- include('../../partials/submissionStatus', { s: s.status }) %></td>
                <% if (showReviewers) { %><td class="small z-c-rev<%= (s.reviews || []).length > 1 ? ' z-multi' : '' %>"><span class="d-md-none z-rev-status"><%- include('../../partials/submissionStatus', { s: s.status }) %></span><% if ((s.reviews || []).length) { %><span class="d-md-none text-secondary"><i class="ti ti-gavel me-1" aria-hidden="true"></i><%= t('Reviewer') %>: </span><% } %><% (s.reviews || []).forEach((rv, i) => { %><%= i ? ', ' : '' %><span class="text-<%= rv.decision === 'accept' ? 'green' : rv.decision === 'reject' ? 'red' : 'secondary' %><%= rv.juror && /[ঀ-৿]/.test(rv.juror.username) ? ' z-bn' : '' %>"><% if (rv.juror) { const open = rv.decision !== 'accept' && rv.decision !== 'reject'; %><a class="z-rev-link<%= open ? ' is-open' : '' %>" href="<%= base %>/user/<%= nameInPath(rv.juror.username) %>"<% if (open) { %> title="<%= t('Assigned; not decided yet') %>"<% } %>><% if (open) { %><i class="ti ti-clock me-1" aria-hidden="true"></i><% } %><%= rv.juror.username %></a><% } %></span><% }) %><% if (!(s.reviews || []).length) { %><span class="text-secondary">—</span><% } %></td><% } %>
                <% if (settings.wordCountEnabled) { %><td class="text-end z-c-words"><%= s.wordCount != null ? formatNumber(s.wordCount) : '—' %></td><% } %>
                <td class="text-secondary text-nowrap z-c-when" title="<%= formatDateTime(s.submittedAt, contest.timezone) %>"><%= formatDate(s.submittedAt, contest.timezone) %></td>
                <td class="z-c-act">
                  <div class="z-row-actions">
                    <% if (currentUser && canReview(s)) { %><a class="btn btn-sm btn-ghost-primary btn-icon d-none d-md-inline-flex" href="<%= base %>/review?entry=<%= s.id %>" title="<%= t('Review') %>" aria-label="<%= t('Review') %>"><i class="ti ti-gavel"></i></a><% } %>
                    <a class="btn btn-sm btn-ghost-secondary btn-icon d-none d-md-inline-flex" href="<%= entryUrl(s) %>" target="_blank" rel="noopener" title="<%= t('Open on wiki') %>" aria-label="<%= t('Open on wiki') %>"><i class="ti ti-external-link"></i></a>
                    <% const more = canWithdraw(s) || canAppealRow(s) || canManage || can('deleteAnything'); { %>
                      <div class="dropdown d-inline-block<%= more ? '' : ' d-md-none' %>">
                        <button class="btn btn-sm btn-ghost-secondary btn-icon" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="<%= t('More') %>"><i class="ti ti-dots-vertical"></i></button>
                        <div class="dropdown-menu dropdown-menu-end">
                          <% if (currentUser && canReview(s)) { %><a class="dropdown-item d-md-none" href="<%= base %>/review?entry=<%= s.id %>"><i class="ti ti-gavel me-2"></i><%= t('Review') %></a><% } %>
                          <a class="dropdown-item d-md-none" href="<%= entryUrl(s) %>" target="_blank" rel="noopener"><i class="ti ti-external-link me-2"></i><%= t('Open on wiki') %></a>
                          <% if (canAppealRow(s)) { %><form method="post" action="<%= base %>/submissions/<%= s.id %>/appeal" data-ask="reason" data-ask-text="<%= t('Why should the organizers look at this again?') %>"><%- hidden %><input type="hidden" name="reason"><button class="dropdown-item" type="submit"><i class="ti ti-scale me-2"></i><%= t('Appeal a decision') %></button></form><% } %>
                          <% if (canWithdraw(s)) { %><form method="post" action="<%= base %>/submissions/<%= s.id %>/withdraw" data-confirm="<%= t('Withdraw this entry?') %>"><%- hidden %><button class="dropdown-item" type="submit"><i class="ti ti-arrow-back-up me-2"></i><%= t('Withdraw my entry') %></button></form><% } %>
                          <% if (can('deleteAnything')) { %><form method="post" action="<%= base %>/submissions/<%= s.id %>/delete" data-confirm="<%= t('Delete this entry for good, with its reviews and history?') %>"><%- hidden %><button class="dropdown-item text-danger" type="submit"><i class="ti ti-trash me-2"></i><%= t('Delete') %></button></form><% } else if (canManage && s.status !== 'withdrawn') { %><form method="post" action="<%= base %>/submissions/remove" data-confirm="<%= t('Remove this entry from the event?') %>"><%- hidden %><input type="hidden" name="ids" value="<%= s.id %>"><button class="dropdown-item text-danger" type="submit"><i class="ti ti-trash me-2"></i><%= t('Delete') %></button></form><% } %>
                        </div>
                      </div>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (bulk || canManage) { %>
      <% } %>
      <% if (pages > 1) { %>
        <div class="card-footer d-flex align-items-center">
          <p class="m-0 text-secondary"><%= t('Page {page} of {pages}', { page: result.page, pages }) %> · <%= tn('{n} entry', '{n} entries', result.total) %></p>
          <ul class="pagination m-0 ms-auto">
            <% for (let i = 1; i <= pages; i++) { %><li class="page-item<%= i === result.page ? ' active' : '' %>"><a class="page-link" href="<%= qs({ page: i }) %>"><%= i %></a></li><% } %>
          </ul>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
</div>

