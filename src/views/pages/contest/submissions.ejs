<%
  const qs = (extra) => {
    const p = new URLSearchParams();
    if (filters.status) p.set('status', filters.status);
    if (filters.q) p.set('q', filters.q);
    if (filters.mine) p.set('mine', '1');
    if (filters.participant) p.set('participant', filters.participant);
    if (filters.sort !== 'submitted' || filters.dir !== 'desc') { p.set('sort', filters.sort); p.set('dir', filters.dir); }
    Object.entries(extra).forEach(([k, v]) => (v === null ? p.delete(k) : p.set(k, v)));
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const pages = Math.max(1, Math.ceil(result.total / result.perPage));
  const totalAll = Object.values(result.counts).reduce((a, b) => a + b, 0);
  // A header that sorts by its column; a second click turns the order round.
  const sortHead = (key, label, cls = '') => {
    const on = filters.sort === key;
    const dir = on ? (filters.dir === 'asc' ? 'desc' : 'asc') : key === 'submitted' ? 'desc' : 'asc';
    const icon = on ? (filters.dir === 'asc' ? 'chevron-up' : 'chevron-down') : 'selector';
    return `<th class="${cls}"${on ? ` aria-sort="${filters.dir === 'asc' ? 'ascending' : 'descending'}"` : ''}><a class="z-sort${on ? ' active' : ''}" href="${h(qs({ sort: key, dir, page: null }))}">${h(label)} <i class="ti ti-${icon}"></i></a></th>`;
  };
  const canManage = can('manageEvent');
  const canReview = (s) => reviewWikis === null || (reviewWikis || []).includes(s.wiki);
  const hidden = `<input type="hidden" name="_csrf" value="${h(csrfToken)}"><input type="hidden" name="back" value="${h(back)}">`;
%>
<%- include('../../partials/contestHeader', { active: 'submissions' }) %>
<div class="page-body"><div class="container-xl">

  <div class="card">
    <div class="card-header flex-wrap gap-2">
      <ul class="nav nav-pills card-header-pills">
        <li class="nav-item"><a class="nav-link<%= !filters.status ? ' active' : '' %>" href="<%= qs({ status: null, page: null }) %>"><%= t("All") %> <span class="badge bg-secondary-lt ms-1"><%= totalAll %></span></a></li>
        <% statuses.filter((s) => result.counts[s]).forEach((s) => { %>
          <li class="nav-item"><a class="nav-link<%= filters.status === s ? ' active' : '' %>" href="<%= qs({ status: s, page: null }) %>"><%= SUBMISSION_STATUSES[s].label %> <span class="badge bg-<%= SUBMISSION_STATUSES[s].color %>-lt ms-1"><%= result.counts[s] %></span></a></li>
        <% }) %>
      </ul>
      <form class="ms-auto d-flex gap-2" method="get">
        <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
        <% if (showNames && result.participants.length > 1) { %>
          <select class="form-select w-auto" name="participant" aria-label="<%= t('Participant') %>" data-autosubmit>
            <option value=""><%= t('All participants') %></option>
            <% result.participants.forEach((pp) => { %>
              <option value="<%= pp.id %>"<%= filters.participant === pp.id ? ' selected' : '' %>><%= pp.username %> (<%= settings.wordCountEnabled ? t('{n} entries, {w} words', { n: pp.entries, w: formatNumber(pp.words) }) : pp.entries %>)</option>
            <% }) %>
          </select>
        <% } %>
        <% if (filters.sort !== 'submitted' || filters.dir !== 'desc') { %><input type="hidden" name="sort" value="<%= filters.sort %>"><input type="hidden" name="dir" value="<%= filters.dir %>"><% } %>
        <% if (currentUser) { %>
          <label class="form-check form-switch m-0 align-self-center">
            <input class="form-check-input" type="checkbox" name="mine" value="1"<%= filters.mine ? ' checked' : '' %> data-autosubmit>
            <span class="form-check-label"><%= t("Only mine") %></span>
          </label>
        <% } %>
        <div class="input-icon">
          <span class="input-icon-addon"><i class="ti ti-search"></i></span>
          <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="<%= t("Search titles") %>" aria-label="<%= t("Search titles") %>">
        </div>
      </form>
    </div>

    <% const picked = filters.participant && result.participants.find((pp) => pp.id === filters.participant); %>
    <% if (result.total && (picked || settings.wordCountEnabled)) { %>
      <div class="card-body border-bottom py-2 d-flex flex-wrap gap-3 align-items-center small">
        <% if (picked) { %>
          <span><i class="ti ti-user me-1"></i><a href="/users/<%= encodeURIComponent(picked.username) %>" class="fw-medium"><%= picked.username %></a></span>
        <% } %>
        <span class="text-secondary"><%= tn('{n} entry', '{n} entries', result.total) %></span>
        <% if (settings.wordCountEnabled) { %><span><i class="ti ti-letter-case me-1"></i><%= t('{n} words in all', { n: formatNumber(result.words) }) %></span><% } %>
        <% if (picked) { %><a class="ms-auto" href="<%= qs({ participant: null, page: null }) %>"><i class="ti ti-x me-1"></i><%= t('Show everyone') %></a><% } %>
      </div>
    <% } %>
    <% if (!result.items.length) { %>
      <div class="empty">
        <div class="empty-icon"><i class="ti ti-files-off icon"></i></div>
        <p class="empty-title">No submissions<%= filters.status || filters.q || filters.mine ? ' match these filters' : ' yet' %></p>
        <% if (!currentUser) { %><p class="empty-subtitle text-secondary"><%= t("Log in to see your own entries.") %></p><% } %>
        <% if (currentUser && contest.status === 'active') { %><div class="empty-action"><a href="<%= base %>/submit" class="btn btn-primary"><i class="ti ti-upload me-1"></i><%= t("Submit entries") %></a></div><% } %>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><%- sortHead('title', t('Entry')) %><%- sortHead('participant', t('Participant')) %><%- sortHead('status', t('Status')) %><% if (settings.wordCountEnabled) { %><%- sortHead('words', t('Words'), 'text-end') %><% } %><%- sortHead('submitted', t('Submitted')) %><th class="w-1"><span class="visually-hidden"><%= t('Actions') %></span></th></tr></thead>
          <tbody>
            <% result.items.forEach((s) => { const meta = JSON.parse(s.metadata); %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <% if (meta.file && meta.file.thumbUrl) { %>
                      <span class="avatar avatar-sm me-2" style="background-image: url('<%= meta.file.thumbUrl %>')"></span>
                    <% } else { %>
                      <span class="avatar avatar-sm me-2 bg-primary-lt"><i class="ti ti-<%= { article: 'file-text', file: 'photo', item: 'database', lexeme: 'language', property: 'tag' }[s.entryType] || 'file' %>"></i></span>
                    <% } %>
                    <div>
                      <a href="<%= base %>/submissions/<%= s.id %>"><%= s.title %></a>
                      <% if (showWiki) { %><div class="text-secondary small z-entry-wiki"><%= wikiName(s.wiki) %></div><% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (showNames || (currentUser && currentUser.id === s.participantId)) { %>
                    <a href="<%= qs({ participant: s.participantId, page: null }) %>" title="<%= t('Only this participant') %>"><%= s.participant.username %></a>
                  <% } else { %><span class="text-secondary"><%= t('Anonymous') %></span><% } %>
                </td>
                <td><%- include('../../partials/submissionStatus', { s: s.status }) %></td>
                <% if (settings.wordCountEnabled) { %><td class="text-end"><%= s.wordCount != null ? formatNumber(s.wordCount) : '—' %></td><% } %>
                <td class="text-secondary text-nowrap"><%= formatDateTime(s.submittedAt, contest.timezone) %></td>
                <td>
                  <div class="z-row-actions">
                    <a class="btn btn-sm btn-ghost-secondary btn-icon" href="<%= base %>/submissions/<%= s.id %>" title="<%= t('View') %>" aria-label="<%= t('View') %>"><i class="ti ti-eye"></i></a>
                    <% if (currentUser && canReview(s) && ['pending', 'validated', 'under_review'].includes(s.status)) { %>
                      <a class="btn btn-sm btn-ghost-primary btn-icon" href="<%= base %>/review?entry=<%= s.id %>" title="<%= t('Review') %>" aria-label="<%= t('Review') %>"><i class="ti ti-gavel"></i></a>
                    <% } %>
                    <a class="btn btn-sm btn-ghost-secondary btn-icon" href="<%= s.url %>" target="_blank" rel="noopener" title="<%= t('Open on wiki') %>" aria-label="<%= t('Open on wiki') %>"><i class="ti ti-external-link"></i></a>
                    <% if (canManage) { %>
                      <form method="post" action="<%= base %>/submissions/<%= s.id %>/revalidate"><%- hidden %>
                        <button class="btn btn-sm btn-ghost-secondary btn-icon" type="submit" title="<%= t('Check again') %>" aria-label="<%= t('Check again') %>"><i class="ti ti-refresh"></i></button>
                      </form>
                      <% if (s.status !== 'disqualified') { %>
                        <form method="post" action="<%= base %>/submissions/<%= s.id %>/status" data-confirm="<%= t('Remove this entry from the event?') %>"><%- hidden %>
                          <input type="hidden" name="status" value="disqualified">
                          <button class="btn btn-sm btn-ghost-danger btn-icon" type="submit" title="<%= t('Remove') %>" aria-label="<%= t('Remove') %>"><i class="ti ti-trash"></i></button>
                        </form>
                      <% } %>
                    <% } else if (currentUser && currentUser.id === s.participantId && withdrawable.includes(s.status)) { %>
                      <form method="post" action="<%= base %>/submissions/<%= s.id %>/withdraw" data-confirm="<%= t('Withdraw this entry?') %>"><%- hidden %>
                        <button class="btn btn-sm btn-ghost-danger btn-icon" type="submit" title="<%= t('Withdraw') %>" aria-label="<%= t('Withdraw') %>"><i class="ti ti-arrow-back-up"></i></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (pages > 1) { %>
        <div class="card-footer d-flex align-items-center">
          <p class="m-0 text-secondary"><%= t('Page {page} of {pages}', { page: result.page, pages }) %> · <%= tn('{n} entry', '{n} entries', result.total) %></p>
          <ul class="pagination m-0 ms-auto">
            <% for (let i = 1; i <= pages; i++) { %><li class="page-item<%= i === result.page ? ' active' : '' %>"><a class="page-link" href="<%= qs({ page: i }) %>"><%= i %></a></li><% } %>
          </ul>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
</div>
