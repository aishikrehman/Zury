<% const statusColor = { open: 'yellow', upheld: 'green', dismissed: 'secondary' }; const statusLabel = { open: t('Open'), upheld: t('Upheld'), dismissed: t('Dismissed') }; %>
<%- include('../../partials/contestHeader', { active: 'appeals' }) %>
<div class="page-body"><div class="container-xl">
<%
    const FLAGS = { deleted: ['Deleted', 'trash', 'red'], redirect: ['Now a redirect', 'arrow-forward-up', 'orange'], moved: ['Moved', 'arrows-right-left', 'blue'], shrunk: ['Much shorter since the decision', 'trending-down', 'yellow'], grew: ['Much improved since it was rejected', 'trending-up', 'green'], split: ['Reviewers disagree', 'arrows-split', 'purple'] };
    const openAppeals = appeals.filter((a) => a.status === 'open').length;
    const onMine = (a) => currentUser && (a.submission.reviews || []).some((rv) => rv.jurorId === currentUser.id);
    const mineCount = appeals.filter((a) => a.status === 'open' && onMine(a)).length;
    const countOf = (k) => flagged.filter((r) => r.flags.includes(k)).length;
    const chips = staff ? [['all', t('All'), flagged.length + openAppeals], ...Object.keys(FLAGS).map((k) => [k, t(FLAGS[k][0]), countOf(k)]), ['appeals', t('Appeals'), openAppeals], ...(mineCount ? [['mine', t('On my reviews'), mineCount]] : [])] : [];
    const shown = show === 'all' ? flagged : ['appeals', 'mine'].includes(show) ? [] : flagged.filter((r) => r.flags.includes(show));
%>
<%# The Patrol room: appeals first; below, the patrol list and reviewer progress as sections that fold. %>
<% const flagOpen = show !== 'all' && !['appeals', 'mine'].includes(show); %>
<div class="row g-3 z-patrol-grid">
  <div class="<%= staff ? 'col-lg-8' : 'col-12' %>">
  <section class="card z-sec">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-scale me-2"></i><%= t('Appeals') %><% if (openAppeals) { %> <span class="badge bg-red-lt ms-2"><%= formatNumber(openAppeals) %></span><% } %></h3>
      <% if (mineCount) { %><div class="card-actions z-chips"><a class="z-chip<%= show !== 'mine' ? ' is-on' : '' %>" href="<%= base %>/patrol"><%= t('All') %></a><a class="z-chip<%= show === 'mine' ? ' is-on' : '' %>" href="<%= base %>/patrol?show=mine"><%= t('On my reviews') %> <b><%= formatNumber(mineCount) %></b></a></div><% } %>
    </div>
    <div class="card-body">
      <% const listA = show === 'mine' ? appeals.filter(onMine) : appeals;
         const openA = listA.filter((a) => a.status === 'open'); const doneA = listA.filter((a) => a.status !== 'open'); %>
    <div class="z-set-head mt-2"><%= t('Open appeals') %> · <%= formatNumber(openA.length) %></div>
    <% if (!openA.length) { %><p class="text-secondary"><%= t('No appeals') %></p><% } %>
    <div class="z-appeals">
      <% openA.forEach((a) => { const r = (typeof rights !== 'undefined' && rights[a.id]) || {}; %>
        <div class="z-appeal">
          <div class="d-flex flex-wrap gap-2 align-items-baseline">
            <a class="fw-semibold" href="<%= base %>/review?entry=<%= a.submission.id %>"><%= a.submission.title %></a>
            <a class="text-secondary" href="<%= entryUrl(a.submission) %>" target="_blank" rel="noopener" title="<%= t('Open on the wiki') %>"><i class="ti ti-external-link"></i></a>
            <span class="text-secondary small ms-auto"><%= a.user.username %> · <%= formatDateTime(a.createdAt, contest.timezone) %></span>
          </div>
          <p class="mb-1 mt-1" style="white-space: pre-line"><%= a.reason %></p>
          <% if (a.submission.reviews && a.submission.reviews.length) { %><div class="small text-secondary"><% a.submission.reviews.forEach((rv, i) => { %><%= i ? ' · ' : '' %><i class="ti ti-<%= rv.decision === 'accept' ? 'check text-green' : 'x text-red' %>"></i> <%= rv.juror ? rv.juror.username : '' %><%= rv.comment ? ': ' + rv.comment : '' %><% }) %></div><% } %>
          <% if (r.accept || r.uphold || r.dismiss) { %>
            <form method="post" class="z-appeal-act" action="<%= base %>/appeals/<%= a.id %>/dismiss">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="form-control form-control-sm" name="response" maxlength="2000" placeholder="<%= t('Reply to the participant (optional)') %>">
              <% if (r.accept) { %><button class="btn btn-sm btn-icon btn-success" type="submit" formaction="<%= base %>/appeals/<%= a.id %>/accept" title="<%= t('Accept the entry') %>" aria-label="<%= t('Accept the entry') %>"><i class="ti ti-check"></i></button><% } %>
              <% if (r.uphold) { %><button class="btn btn-sm btn-icon" type="submit" formaction="<%= base %>/appeals/<%= a.id %>/uphold" title="<%= t('Review again') %>" aria-label="<%= t('Review again') %>"><i class="ti ti-refresh"></i></button><% } %>
              <% if (r.dismiss) { %><button class="btn btn-sm btn-icon btn-outline-danger" type="submit" title="<%= t('Dismiss') %>" aria-label="<%= t('Dismiss') %>"><i class="ti ti-x"></i></button><% } %>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>
    <% if (doneA.length) { %>
      <details class="mt-3"><summary class="z-set-head"><%= t('Settled') %> · <%= formatNumber(doneA.length) %></summary>
        <div class="z-appeals">
          <% doneA.forEach((a) => { %>
            <div class="z-appeal is-done">
              <div class="d-flex flex-wrap gap-2 align-items-baseline"><a href="<%= base %>/review?entry=<%= a.submission.id %>"><%= a.submission.title %></a><span class="badge bg-<%= statusColor[a.status] %>-lt"><%= statusLabel[a.status] %></span><span class="text-secondary small ms-auto"><%= a.user.username %></span>
                <% if (can('deleteAnything')) { %><form method="post" action="<%= base %>/appeals/<%= a.id %>/delete" data-confirm="<%= t('Delete this appeal from the log?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-ghost-danger btn-icon" type="submit" title="<%= t('Delete') %>"><i class="ti ti-trash"></i></button></form><% } %>
              </div>
              <div class="small text-secondary"><%= a.reason %></div>
              <% if (a.resolvedBy || a.response) { %><div class="small mt-1"><i class="ti ti-message-reply me-1"></i><%= a.resolvedBy ? a.resolvedBy.username : '' %><%= a.response ? ': ' + a.response : '' %></div><% } %>
            </div>
          <% }) %>
        </div>
      </details>
    <% } %>
    </div>
  </section>
  </div>
  <% if (staff) { %>
    <aside class="col-lg-4 d-flex flex-column gap-3">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-shield-search me-2"></i><%= t('Patrol') %></h3>
          <div class="card-actions"><form method="post" action="<%= base %>/patrol/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-icon" type="submit" title="<%= t('Check all articles now') %>" aria-label="<%= t('Check all articles now') %>"><i class="ti ti-refresh"></i></button></form></div>
        </div>
        <div class="card-body z-flag-grid">
          <% Object.keys(FLAGS).forEach((k) => { const [label, icon, color] = FLAGS[k]; const n = countOf(k); %>
            <a class="z-flag<%= show === k ? ' is-on' : '' %><%= n ? '' : ' is-zero' %>" href="<%= base %>/patrol?show=<%= k %>#patrol-list"><i class="ti ti-<%= icon %> text-<%= color %>"></i><b><%= formatNumber(n) %></b><span><%= t(label) %></span></a>
          <% }) %>
        </div>
      </div>
      <% if (typeof jury !== 'undefined' && jury) { %>
        <details class="card z-sec">
          <summary class="card-header"><h3 class="card-title"><i class="ti ti-users me-2"></i><%= t('Reviewer progress') %></h3><i class="ti ti-chevron-down z-sec-caret"></i></summary>
          <div class="card-body"><%- include('../../partials/juryProgress', { jury }) %></div>
        </details>
      <% } %>
    </aside>
    <% if (flagged.length || flagOpen) { %>
      <div class="col-12" id="patrol-list">
        <details class="card z-sec" open>
          <summary class="card-header"><h3 class="card-title"><i class="ti ti-list-search me-2"></i><%= flagOpen ? t(FLAGS[show] ? FLAGS[show][0] : 'Patrol') : t('Articles to look at') %> <span class="badge bg-secondary-lt ms-2"><%= formatNumber(shown.length) %></span></h3><% if (flagOpen) { %><a class="small me-3" href="<%= base %>/patrol#patrol-list"><%= t('All') %></a><% } %><i class="ti ti-chevron-down z-sec-caret"></i></summary>
          <div class="card-body p-0">
      <% if (!shown.length) { %>
        <div class="mb-0"><div class="card-body text-secondary"><i class="ti ti-circle-check text-green me-1"></i><%= t('No entered article was deleted, redirected, moved or cut down.') %></div></div>
      <% } else { %>
        <div class="mb-0"><div class="list-group list-group-flush z-patrol">
          <% shown.forEach((r) => { const w = r.watch; const st = SUBMISSION_STATUSES[r.status] || { label: r.status, badge: 'secondary' }; %>
            <div class="list-group-item">
              <div class="d-flex flex-wrap align-items-start gap-2">
                <div class="min-w-0 flex-fill">
                  <a class="fw-medium" href="<%= base %>/review?entry=<%= r.id %>"><%= r.title %></a>
                  <span class="badge bg-<%= st.badge %>-lt ms-1"><%= t(st.label) %></span>
                  <div class="small text-secondary"><span class="z-user-name"><%= r.participant.username %></span> · <%= wikiLocal(r.wiki) %><% if (r.wordCount != null) { %> · <%= t('{n} words', { n: formatNumber(r.wordCount) }) %><% } %></div>
                  <div class="d-flex flex-wrap gap-1 mt-1">
                    <% r.flags.forEach((k) => { const [label, icon, color] = FLAGS[k]; %>
                      <span class="badge bg-<%= color %>-lt"><i class="ti ti-<%= icon %> me-1"></i><%= t(label) %><% if (k === 'moved' && w.movedFrom) { %>: <%= w.movedFrom %> → <%= r.title %><% } %><% if (k === 'shrunk' && w.shrunk) { %>: <%= formatNumber(w.shrunk.from) %> → <%= formatNumber(w.shrunk.to) %><% } %><% if (k === 'grew' && w.grew) { %>: <%= formatNumber(w.grew.from) %> → <%= formatNumber(w.grew.to) %><% } %></span>
                    <% }) %>
                  </div>
                </div>
                <div class="btn-list flex-nowrap">
                  <a class="btn btn-sm btn-icon" href="<%= entryUrl(r) %>" target="_blank" rel="noopener" title="<%= t('Open on the wiki') %>" aria-label="<%= t('Open on the wiki') %>"><i class="ti ti-external-link"></i></a>
                  <% if (r.flags.includes('shrunk') && r.revId) { %><a class="btn btn-sm btn-icon" href="<%= entryUrl(r).replace(/\/wiki\/.*$/, '') %>/w/index.php?diff=cur&oldid=<%= r.revId %>" target="_blank" rel="noopener" title="<%= t('Changes since the reviewed revision') %>" aria-label="<%= t('Changes since the reviewed revision') %>"><i class="ti ti-file-diff"></i></a><% } %>
                  <% if (r.flags.includes('deleted')) { %><a class="btn btn-sm btn-icon" href="<%= entryUrl(r).replace(/\/wiki\/.*$/, '') %>/w/index.php?title=Special:Log&type=delete&page=<%= encodeURIComponent(r.title) %>" target="_blank" rel="noopener" title="<%= t('Deletion log') %>" aria-label="<%= t('Deletion log') %>"><i class="ti ti-list-search"></i></a><% } %>
                  <% const act = (a, icon, label, cls, confirm, flag) => `<form method="post" action="${base}/patrol/${r.id}/${a}"${confirm ? ` data-confirm="${h(confirm)}"` : ''}><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="show" value="${show}">${flag ? `<input type="hidden" name="flag" value="${flag}">` : ''}<button class="btn btn-sm ${cls}" type="submit" title="${h(label)}"><i class="ti ti-${icon} me-1"></i>${h(label)}</button></form>`; %>
                  <% if (!r.flags.includes('deleted')) { %><%- act('refresh', 'refresh', t('Update'), '', '') %><% } %>
                  <% if ((can('manageEvent') || can('manageAppeals')) && ['approved', 'rejected', 'disqualified'].includes(r.status)) { %><%- act('reopen', 'arrow-back-up', t('Review again'), '', t('Clear its reviews and send it back to the reviewers?')) %><% } %>
                  <% if (can('manageEvent')) { %><%- act('withdraw', 'circle-minus', t('Remove'), 'btn-ghost-danger', t('Remove this entry from the event?')) %><% } %>
                  <% if (!(r.flags.length === 1 && r.flags[0] === 'split')) { %><%- act('seen', 'eye-check', t('Looked at'), 'btn-ghost-secondary', '', r.flags.length === 1 && ['shrunk', 'grew'].includes(r.flags[0]) ? r.flags[0] : 'state') %><% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div></div>
      <% } %>
          </div>
        </details>
      </div>
    <% } %>
  <% } %>
</div>
</div></div>
