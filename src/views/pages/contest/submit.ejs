<%
  const okCount = items ? items.filter((i) => i.ok).length : 0;
  const rules = [];
  if (typeConfig.maxEntriesPerParticipant) rules.push(t('At most {n} entries per participant', { n: typeConfig.maxEntriesPerParticipant }));
  if (typeConfig.minResolutionMegapixels) rules.push(t('At least {n} MP', { n: typeConfig.minResolutionMegapixels }));
  if (typeConfig.requiredCategory) rules.push(t('In “{category}”', { category: typeConfig.requiredCategory }));
  if (typeConfig.uploadedDuringEventOnly) rules.push(t('Uploaded during the event'));
  if (typeConfig.minWordCount) rules.push(t('At least {n} words', { n: typeConfig.minWordCount }));
  if (typeConfig.minBytes) rules.push(t('At least {n} bytes', { n: typeConfig.minBytes }));
  if (typeConfig.createdDuringEventOnly) rules.push(t(typeConfig.allowExpansions ? 'Created or expanded during the event' : 'Created during the event'));
  if (typeConfig.requiredProperties && typeConfig.requiredProperties.length) rules.push(t('Required properties: {list}', { list: typeConfig.requiredProperties.join(', ') }));
  if (typeConfig.minStatements) rules.push(t('At least {n} statements', { n: typeConfig.minStatements }));
%>
<%- include('../../partials/contestHeader', { active: 'submit' }) %>
<div class="page-body"><div class="container-xl">

  <div class="row row-cards">
    <div class="col-lg-8">
      <form method="post" action="<%= base %>/submit/preview" class="card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-upload me-2"></i><%= mass ? t('Submit entries') : t('Submit an entry') %></h3></div>
        <div class="card-body">
          <% if (error) { %><div class="alert alert-danger" role="alert"><i class="ti ti-alert-circle me-1"></i><%= error %></div><% } %>
          <% if (!window.open) { %><div class="alert alert-warning"><i class="ti ti-clock me-1"></i><%= t(window.reason) %><%= canOthers ? ' ' + t('As an organizer you can still submit for participants.') : '' %></div><% } %>
          <div class="mb-3">
            <label class="form-label" for="entries"><%= t(mass ? 'URLs or titles, one per line' : 'URL or title') %></label>
            <% if (mass) { %>
              <textarea class="form-control font-monospace" id="entries" name="entries" rows="8" placeholder="https://commons.wikimedia.org/wiki/File:Example.jpg&#10;File:Another example.jpg"><%= text %></textarea>
            <% } else { %>
              <div class="z-suggest"><input class="form-control" id="entries" name="entries" value="<%= text %>" autocomplete="off" spellcheck="false" placeholder="<%= t("https://… or a page title") %>" data-suggest="<%= (eventWikis.length ? eventWikis : [{ wiki: contest.primaryWiki }]).map((w) => wikiHost(w.wiki)).filter(Boolean).join(',') %>" data-suggest-ns="<%= contest.type === 'writing' ? 0 : contest.type === 'photo' ? 6 : 0 %>"><div class="z-suggest-list list-group" hidden></div></div>
            <% } %>
          </div>
          <% if (canOthers) { %>
            <div class="mb-3">
              <label class="form-label" for="participant"><%= t("On behalf of") %> <span class="text-secondary fw-normal"><%= t("(optional)") %></span></label>
              <select class="form-select" id="participant" name="participant" data-picker="user" placeholder="<%= t("Search participants…") %>"><% if (participant) { %><option value="<%= participant %>" selected><%= participant %></option><% } %></select>
            </div>
          <% } %>
        </div>
        <div class="card-footer text-end">
          <button class="btn btn-primary" type="submit"><i class="ti ti-search me-1"></i><%= t("Check entries") %></button>
        </div>
      </form>

      <% if (items) { %>
        <div class="card mt-3">
          <div class="card-header">
            <h3 class="card-title"><%= t("Preview") %></h3>
            <div class="card-actions"><span class="badge bg-green-lt"><%= t('{n} ready', { n: okCount }) %></span> <span class="badge bg-red-lt"><%= t('{n} with problems', { n: items.length - okCount }) %></span></div>
          </div>
          <div class="card-body z-check-list">
            <% items.forEach((i) => { %>
              <div class="z-check-item <%= i.ok ? (i.warnings.length ? 'is-warn' : 'is-ok') : 'is-bad' %>">
                <% if (i.meta && i.meta.file && i.meta.file.thumbUrl) { %><span class="avatar avatar-lg" style="background-image: url('<%= i.meta.file.thumbUrl %>')"></span>
                <% } else { %><span class="z-check-icon"><i class="ti ti-<%= i.ok ? (i.warnings.length ? 'alert-triangle' : 'circle-check') : 'circle-x' %>"></i></span><% } %>
                <div class="flex-fill min-w-0">
                  <div class="fw-bold text-truncate">
                    <% if (i.meta && i.meta.exists) { %><a href="<%= i.meta.url %>" rel="noopener" target="_blank"><%= i.meta.title %> <i class="ti ti-external-link small"></i></a>
                    <% } else { %><span class="font-monospace"><%= i.input %></span><% } %>
                  </div>
                  <div class="d-flex flex-wrap gap-1 mt-1">
                    <% if (i.meta && i.meta.exists && eventWikis.length > 1) { %><span class="badge bg-secondary-lt"><%= wikiLocal(i.meta.wiki) %></span><% } %>
                    <% if (i.meta && i.meta.entryType) { %><span class="badge bg-secondary-lt"><%= i.meta.entryType %></span><% } %>
                    <% if (i.meta && i.meta.wordCount != null) { %><span class="badge bg-blue-lt"><i class="ti ti-letter-case me-1"></i><%= t('{n} words', { n: formatNumber(i.meta.wordCount) }) %></span><% } %>
                    <% if (i.meta && i.meta.file) { %><span class="badge bg-blue-lt"><%= i.meta.file.megapixels %> MP</span><% } %>
                    <% if (i.meta && i.meta.entity) { %><span class="badge bg-blue-lt"><%= i.meta.entity.label || i.meta.entity.id %> · <%= t('{n} statements', { n: i.meta.entity.statementCount }) %></span><% } %>
                  </div>
                  <% i.reasons.forEach((r) => { %><div class="small text-red mt-1"><i class="ti ti-x me-1"></i><%= t(r) %></div><% }) %>
                  <% i.warnings.forEach((w) => { %><div class="small text-yellow mt-1"><i class="ti ti-alert-triangle me-1"></i><%= t(w) %></div><% }) %>
                </div>
                <span class="badge <%= i.ok ? 'bg-green' : 'bg-red' %> text-white align-self-start"><%= i.ok ? t('Ready') : t('Not accepted') %></span>
              </div>
            <% }) %>
          </div>
          <% if (okCount) { %>
            <form method="post" action="<%= base %>/submit" class="card-footer d-flex align-items-center">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="entries" value="<%= items.filter((i) => i.ok).map((i) => i.input).join('\n') %>">
              <input type="hidden" name="participant" value="<%= participant %>">
              <button class="btn btn-success ms-auto" type="submit"><i class="ti ti-check me-1"></i><%= tn('Submit {n} entry', 'Submit {n} entries', okCount) %></button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><%= t("What's accepted") %></h3></div>
        <div class="list-group list-group-flush">
          <div class="list-group-item"><%= t('{type} on {wikis}', { type: t(EVENT_TYPES[contest.type].label), wikis: (eventWikis.length ? eventWikis.map((w) => w.wiki) : [contest.primaryWiki]).map(wikiLocal).join(', ') }) %></div>
          <% rules.forEach((r) => { %><div class="list-group-item"><i class="ti ti-check text-green me-1"></i><%= r %></div><% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
