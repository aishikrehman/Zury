<%
  const total = progress.waiting + progress.decided;
  const done = total ? Math.round((progress.decided / total) * 100) : 0;
  const decisionLabel = { accept: t('Accept'), reject: t('Reject') };
  const fq = (extra) => filterQuery(filters, extra || {});
  const filtered = !!(filters.mode || filters.participantId || filters.q || filters.minWords || filters.maxWords || filters.wiki || filters.sort || filters.status || filters.reviews || filters.checks || filters.from || filters.to);
  const day = (d) => (d ? d.toISOString().slice(0, 10) : '');
  const modes = [['', t('Waiting for me')], ['open', t('All not yet decided')], ['mine', t('Reviewed by me')]];
%>
<%- include('../../partials/contestHeader', { active: 'review' }) %>
<div class="page-body"><div class="container-xl">
<div class="card z-review-card"><div class="card-body">
<div class="z-review-wrap">

  <div class="z-review-bar">
    <div class="z-go me-auto" title="<%= t('{n} waiting for you', { n: queue.remaining }) %> · <%= t('{n} reviewed by you', { n: queue.reviewedByMe }) %> · <%= t('{n}% decided', { n: done }) %>">
      <select data-review-picker data-url="<%= base %>/review/entries?<%= fq() %>" data-go="<%= base %>/review?<%= fq() %>" aria-label="<%= t('Entries') %>" placeholder="<%= t('Search the entries…') %>">
        <% if (entry) { %><option value="<%= entry.id %>" selected><%= entry.title %></option><% } %>
      </select>
    </div>
    <button class="btn<%= filtered ? ' btn-primary' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#review-filters" aria-expanded="<%= filtered %>" aria-controls="review-filters" title="<%= t('Filter') %>" aria-label="<%= t('Filter') %>" data-filter-btn><i class="ti ti-filter"></i></button>
    <button class="btn btn-icon" type="button" data-review-full title="<%= t('Full screen') %>" aria-label="<%= t('Full screen') %>" aria-pressed="false"><i class="ti ti-maximize"></i></button>
  </div>

  <div class="z-review-stats" title="<%= t('{n} waiting for you', { n: queue.remaining }) %> · <%= t('{n} reviewed by you', { n: queue.reviewedByMe }) %> · <%= t('{n}% decided', { n: done }) %>">
    <span class="z-ring" style="--p: <%= done %>"><b><%= formatNumber(done) %>%</b></span>
    <span class="z-ring-text">
      <% if (position) { %><span><b><%= formatNumber(position) %></b> / <%= formatNumber(queue.remaining) %> <%= t('waiting') %></span><% } else { %><span><b><%= formatNumber(queue.remaining) %></b> <%= t('waiting') %></span><% } %>
      <span class="text-secondary"><%= t('You reviewed {n}', { n: formatNumber(queue.reviewedByMe) }) %></span>
    </span>
  </div>
  <form method="get" class="z-review-filters collapse<%= filtered ? ' show' : '' %>" id="review-filters">
    <div class="z-pop-title"><%= t('Entries and filters') %></div>
    <button type="button" class="btn-close z-pop-close" data-close-filters aria-label="<%= t('Close') %>"></button>
    <div class="row g-2 align-items-end">
      <div class="col-sm-6 col-lg-3">
        <label class="form-label" for="f-mode"><%= t('Show') %></label>
        <select class="form-select" id="f-mode" name="mode"><% modes.forEach(([v, label]) => { %><option value="<%= v %>"<%= filters.mode === v ? ' selected' : '' %>><%= label %></option><% }) %></select>
      </div>
      <div class="col-sm-6 col-lg-3">
        <label class="form-label" for="f-participant"><%= t('Participant') %></label>
        <select class="form-select" id="f-participant" name="participant">
          <option value=""><%= t('All participants') %></option>
          <% writers.forEach((u) => { %><option value="<%= u.id %>"<%= filters.participantId === u.id ? ' selected' : '' %>><%= u.username %></option><% }) %>
        </select>
      </div>
      <% if (reviewWikiList.length > 1) { %>
        <div class="col-sm-4 col-lg-2">
          <label class="form-label" for="f-wiki"><%= t('Wiki') %></label>
          <select class="form-select" id="f-wiki" name="wiki"><option value=""><%= t('All wikis') %></option><% reviewWikiList.forEach((w) => { %><option value="<%= w %>"<%= filters.wiki === w ? ' selected' : '' %>><%= wikiLocal(w) %></option><% }) %></select>
        </div>
      <% } %>
      <div class="col-sm-4 col-lg-2">
        <label class="form-label" for="f-status"><%= t('Status') %></label>
        <select class="form-select" id="f-status" name="status">
          <option value=""><%= t('Any') %></option>
          <% ['pending', 'validated', 'under_review', 'approved', 'rejected', 'appealed'].forEach((v) => { %><option value="<%= v %>"<%= filters.status === v ? ' selected' : '' %>><%= SUBMISSION_STATUSES[v].label %></option><% }) %>
        </select>
      </div>
      <div class="col-sm-4 col-lg-2">
        <label class="form-label" for="f-reviews"><%= t('Reviews so far') %></label>
        <select class="form-select" id="f-reviews" name="reviews">
          <option value=""><%= t('Any') %></option>
          <option value="none"<%= filters.reviews === 'none' ? ' selected' : '' %>><%= t('None yet') %></option>
          <option value="some"<%= filters.reviews === 'some' ? ' selected' : '' %>><%= t('At least one') %></option>
        </select>
      </div>
      <div class="col-sm-4 col-lg-2">
        <label class="form-label" for="f-checks"><%= t('Automatic checks') %></label>
        <select class="form-select" id="f-checks" name="checks">
          <option value=""><%= t('Any') %></option>
          <option value="warnings"<%= filters.checks === 'warnings' ? ' selected' : '' %>><%= t('With warnings') %></option>
        </select>
      </div>
      <% if (settings.wordCountEnabled) { %>
        <div class="col-6 col-lg-1">
          <label class="form-label" for="f-words"><%= t('Min. words') %></label>
          <input class="form-control" id="f-words" name="minWords" type="number" min="0" value="<%= filters.minWords || '' %>">
        </div>
        <div class="col-6 col-lg-1">
          <label class="form-label" for="f-maxwords"><%= t('Max. words') %></label>
          <input class="form-control" id="f-maxwords" name="maxWords" type="number" min="0" value="<%= filters.maxWords || '' %>">
        </div>
      <% } %>
      <div class="col-sm-4 col-lg-2">
        <label class="form-label" for="f-sort"><%= t('Order') %></label>
        <select class="form-select" id="f-sort" name="sort">
          <% [['', t('Oldest first')], ['newest', t('Newest first')], ...(settings.wordCountEnabled ? [['words-desc', t('Most words')], ['words-asc', t('Fewest words')]] : []), ['title', t('Title')]].forEach(([v, label]) => { %><option value="<%= v %>"<%= filters.sort === v ? ' selected' : '' %>><%= label %></option><% }) %>
        </select>
      </div>
      <div class="col-auto d-flex gap-2">
        <button class="btn btn-primary" type="submit"><%= t('Apply') %></button>
        <% if (filtered) { %><a class="btn btn-ghost-secondary" href="<%= base %>/review"><%= t('Clear') %></a><% } %>
      </div>
    </div>
  </form>

  <% if (!entry) { %>
    <div class="card">
      <div class="card-body text-center py-6">
        <div class="z-done-icon"><i class="ti ti-circle-check"></i></div>
        <h3 class="mt-3 mb-1"><%= filtered ? t('Nothing matches these filters') : t('All caught up') %></h3>
        <p class="text-secondary mb-3"><%= filtered ? t('Change or clear the filters to see more entries.') : t('There is nothing waiting for your review right now.') %></p>
        <a class="btn" href="<%= base %>/results"><i class="ti ti-chart-bar me-1"></i><%= t('See the results') %></a>
      </div>
    </div>
  <% } else { %>
    <% const problems = [...(validation.errors || []), ...(validation.warnings || [])]; %>
    <div class="z-review-layout">
      <section class="card z-review-entry" aria-label="<%= entry.title %>">
        <div class="z-entry-head">
          <h2 class="z-entry-title" title="<%= entry.title %>"><%= entry.title %></h2>
          <% const eBase = entry.url.split('/wiki/')[0]; const eTitle = encodeURIComponent(entry.title.replace(/ /g, '_')); %>
          <span class="z-entry-links">
            <a class="btn btn-sm btn-icon btn-ghost-secondary" href="<%= entry.url %>" target="_blank" rel="noopener" title="<%= t('Open on wiki') %>" aria-label="<%= t('Open on wiki') %>"><i class="ti ti-external-link"></i><span class="z-link-label"><%= t('Open on wiki') %></span></a>
            <a class="btn btn-sm btn-icon btn-ghost-secondary" href="<%= eBase %>/wiki/Talk:<%= eTitle %>" target="_blank" rel="noopener" title="<%= t('Talk page') %>" aria-label="<%= t('Talk page') %>"><i class="ti ti-messages"></i><span class="z-link-label"><%= t('Talk page') %></span></a>
            <a class="btn btn-sm btn-icon btn-ghost-secondary" href="<%= eBase %>/w/index.php?title=<%= eTitle %>&action=history" target="_blank" rel="noopener" title="<%= t('History') %>" aria-label="<%= t('History') %>"><i class="ti ti-history"></i><span class="z-link-label"><%= t('History') %></span></a>
          </span>
          <div class="z-entry-tools" data-bar-slot></div>
        </div>
        <div class="z-review-frame">
          <% if (preview) { %>
            <iframe src="<%= preview %>" title="<%= entry.title %>" loading="eager" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
          <% } else if (meta.file && meta.file.thumbUrl) { %>
            <div class="z-review-media"><img src="<%= meta.file.thumbUrl %>" alt="<%= entry.title %>" referrerpolicy="no-referrer"></div>
          <% } else if (meta.entity) { %>
            <div class="card-body">
              <div class="h3 mb-1"><%= meta.entity.label || meta.entity.id %></div>
              <div class="text-secondary mb-2"><%= meta.entity.description || '' %></div>
              <div class="d-flex flex-wrap gap-1"><% (meta.entity.properties || []).forEach((prop) => { %><span class="badge"><%= prop %></span><% }) %></div>
            </div>
          <% } else { %>
            <div class="card-body text-secondary"><i class="ti ti-file-text me-1"></i><%= t('No preview; open the entry on the wiki.') %></div>
          <% } %>
        </div>
      </section>

      <button class="z-side-toggle" type="button" data-side-toggle aria-label="<%= t('More') %>" title="<%= t('More') %>"><i class="ti ti-layout-sidebar-right"></i></button>
      <div class="z-side-backdrop" data-side-toggle></div>
      <aside class="z-review-side">
        <button type="button" class="btn-close z-sheet-close" data-side-close aria-label="<%= t('Close') %>"></button>
        <form method="post" action="<%= base %>/review/<%= entry.id %>" class="card z-review-panel" data-review-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="filters" value="<%= fq() %>">
          <input type="hidden" name="decision" value="<%= mine ? mine.decision : '' %>" data-decision>
          <% if (mine) { %><div class="px-3 pt-2 small text-secondary"><%= t('Your review') %>: <span class="badge bg-<%= mine.decision === 'accept' ? 'green' : 'red' %>-lt"><%= decisionLabel[mine.decision] %></span></div><% } %>
          <div class="card-body">
            <% const myMarks = mine ? JSON.parse(mine.marks || '{}') : {}; %>
            <% scheme.forEach((mark, mi) => { %>
              <div class="mb-3">
                <div class="form-label"><%= mark.name %></div>
                <div class="form-selectgroup form-selectgroup-pills" data-mark-group="<%= mi %>">
                  <% mark.values.forEach((v, vi) => { %>
                    <label class="form-selectgroup-item">
                      <input type="radio" class="form-selectgroup-input" name="mark:<%= mark.name %>" value="<%= v.label %>"<%= myMarks[mark.name] === v.label ? ' checked' : '' %> required>
                      <span class="form-selectgroup-label"><%= v.label %> <span class="text-secondary small">· <%= v.points %></span><% if (mi === 0 && vi < 9) { %><kbd class="ms-1 d-none d-md-inline"><%= vi + 1 %></kbd><% } %></span>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% }) %>
            <% const method = settings.reviewMethod || 'marks'; %>
            <% if (method === 'stars') { %>
              <div class="mb-3">
                <div class="form-label"><%= t('Stars') %> <span class="text-secondary fw-normal small">· <%= t('pass mark {n}', { n: settings.passScore || 0 }) %></span></div>
                <div class="z-stars" role="radiogroup" aria-label="<%= t('Stars') %>">
                  <% for (let n = 5; n >= 1; n -= 1) { %><input type="radio" id="star-<%= n %>" name="score" value="<%= n %>"<%= mine && mine.points === n ? ' checked' : '' %> required><label for="star-<%= n %>" title="<%= tn('{n} star', '{n} stars', n) %>"><span aria-hidden="true">★</span></label><% } %>
                </div>
              </div>
            <% } else if (method === 'number') { %>
              <div class="mb-3">
                <label class="form-label" for="score"><%= t('Score') %> <span class="text-secondary fw-normal small"><%= settings.scoreMin != null || settings.scoreMax != null ? `${settings.scoreMin ?? '…'}–${settings.scoreMax ?? '…'}` : '' %> · <%= t('pass mark {n}', { n: settings.passScore || 0 }) %></span></label>
                <input type="number" step="any" class="form-control form-control-lg" id="score" name="score" required<% if (settings.scoreMin != null) { %> min="<%= settings.scoreMin %>"<% } %><% if (settings.scoreMax != null) { %> max="<%= settings.scoreMax %>"<% } %> value="<%= mine ? mine.points : '' %>">
              </div>
            <% } %>
            <details class="z-review-more z-review-comment mb-2" open>
              <summary title="<%= t('(needed to reject)') %>"><i class="ti ti-message me-1"></i><%= t('Comment') %></summary>
              <button type="button" class="btn-close z-pop-close" data-close-note aria-label="<%= t('Close') %>"></button>
              <div class="pt-2">
              
              <% const readyReasons = ['Too short', 'Not enough words', 'Created before the event', 'Machine translation', 'Not encyclopedic', 'No references', 'Copied text', 'Wrong namespace'].map((r) => t(r)); const ownText = mine && mine.comment && !readyReasons.includes(mine.comment); %>
              <div class="z-reason-row">
              <div class="z-comment-box">
                <select class="form-select form-select-sm" data-reason-select aria-label="<%= t('Reason') %>">
                  <option value=""><%= t('Add a ready reason…') %></option>
                  <% readyReasons.forEach((r) => { %><option value="<%= r %>"><%= r %></option><% }) %>
                </select>
                <textarea class="form-control form-control-sm mt-1" id="comment" name="comment" rows="2" maxlength="2000" placeholder="<%= t('Comment (needed to reject)') %>"><%= mine ? mine.comment : '' %></textarea>
              </div>
                <div class="dropdown z-notify">
                  <input type="hidden" name="notify" id="notify" value="auto">
                  <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="<%= t('Tell the participant') %>" aria-label="<%= t('Tell the participant') %>"><i class="ti ti-bell" data-notify-icon></i></button>
                  <div class="dropdown-menu dropdown-menu-end">
                    <h6 class="dropdown-header"><%= t('Tell the participant') %></h6>
                    <% [['auto', 'Automatic (bell when not accepted)', 'bell'], ['bell', 'Bell notification', 'bell-ringing'], ['onwiki', 'Message on their talk page', 'message'], ['none', 'Do not tell', 'bell-off']].forEach(([val, label, icon], i) => { %>
                      <button type="button" class="dropdown-item<%= i === 0 ? ' active' : '' %>" data-notify="<%= val %>" data-icon="<%= icon %>"><i class="ti ti-<%= icon %> me-2"></i><%= t(label) %></button>
                    <% }) %>
                  </div>
                </div>
              </div>
              </div>
            </details>
            <% if (method === 'stars' || method === 'number') { %>
              <button type="submit" class="btn btn-primary w-100"><i class="ti ti-device-floppy me-1"></i><%= t('Save the score') %><kbd class="ms-2 d-none d-md-inline">Ctrl+Enter</kbd></button>
            <% } else { %>
            <div class="z-decide">
              <button type="submit" class="btn btn-success" data-decide="accept" title="<%= t('Accept') %> (A)" aria-label="<%= t('Accept') %>"><i class="ti ti-check me-1"></i><%= t('Accept') %><kbd class="ms-2 d-none d-md-inline">A</kbd></button>
              <button type="submit" class="btn btn-danger" data-decide="reject" title="<%= t('Reject') %> (R)" aria-label="<%= t('Reject') %>"><i class="ti ti-x me-1"></i><%= t('Reject') %><kbd class="ms-2 d-none d-md-inline">R</kbd></button>
              <button class="btn d-md-none" type="button" data-open-comment title="<%= t('Comment') %>" aria-label="<%= t('Comment') %>"><i class="ti ti-message"></i></button>
              <a class="btn" href="<%= base %>/review?<%= fq({ after: entry.id }) %>" data-review-skip title="<%= t('Skip') %> (S)"><i class="ti ti-player-skip-forward me-1"></i><%= t('Skip') %></a>
              <% if (handTo.length) { %><button class="btn" type="button" data-open-handover title="<%= settings.reviewAssignment === 'assigned' ? t('Hand to another reviewer') : t('Ask another reviewer') %>"><i class="ti ti-arrows-exchange me-1"></i><%= settings.reviewAssignment === 'assigned' ? t('Hand over') : t('Ask another') %></button><% } %>
            </div>
            <% } %>
        <% if (handTo.length) { %>
          <details class="z-review-more z-review-handover mt-2" hidden>
            <summary><i class="ti ti-arrows-exchange me-1"></i><%= settings.reviewAssignment === 'assigned' ? t('Hand to another reviewer') : t('Ask another reviewer') %></summary>
            <div class="d-flex gap-2 pt-2">
                            <select class="form-select form-select-sm" name="to" form="handover-form" required aria-label="<%= t('Reviewer') %>"><option value=""><%= t('Choose…') %></option><% handTo.forEach((u) => { %><option value="<%= u.id %>"><%= u.username %></option><% }) %></select>
              <button class="btn btn-sm btn-primary" type="submit" form="handover-form"><%= t('Send') %></button>
            </div>
          </details>
        <% } %>
          </div>
        </form>
        <form method="post" action="<%= base %>/review/<%= entry.id %>/handover" id="handover-form" hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>

        <div class="card z-facts-card<%= problems.length ? '' : ' d-none d-md-block' %>">
          <div class="card-body py-2">
            <% const wordsNow = entry.wordCount != null ? entry.wordCount : meta.wordCount; const wikiBase = entry.url.split('/wiki/')[0]; const startsAt = contest.startDate ? new Date(contest.startDate) : null; const createdAt = meta.createdAt ? new Date(meta.createdAt) : null; const expansion = startsAt && createdAt && createdAt < startsAt; %>
            <dl class="z-facts-list d-none d-md-grid">
              <% if (wordsNow != null) { %><dt class="z-f-words" title="<%= t('Words') %>"><span class="visually-hidden"><%= t('Words') %></span></dt><dd class="fw-bold" title="<%= t('Words') %>"><i class="z-f-ico ti ti-align-justified" aria-hidden="true"></i><%= formatNumber(wordsNow) %></dd><% } %>
              <% if (meta.sizeBytes != null) { %><dt class="z-f-size" title="<%= t('Size') %>"><span class="visually-hidden"><%= t('Size') %></span></dt><dd title="<%= t('Size') %>"><i class="z-f-ico ti ti-database" aria-hidden="true"></i><%= t('{n} bytes', { n: formatNumber(meta.sizeBytes) }) %></dd><% } %>
              <% const resultsOut = !!contest.resultsPublishedAt; %>
              <dt class="z-f-rev" title="<%= t('Revision') %>"><span class="visually-hidden"><%= t('Revision') %></span></dt><dd title="<%= t('Revision') %>"><i class="z-f-ico ti ti-git-commit" aria-hidden="true"></i><% if (revMode === 'latest') { %><span class="text-secondary"><%= t('Always the latest') %></span><% } else if (entry.revId) { %><a href="<%= wikiBase %>/w/index.php?oldid=<%= entry.revId %>" target="_blank" rel="noopener">#<%= entry.revId %></a><% } else { %><span class="text-secondary"><%= t('Latest') %></span><% } %></dd>
              <% if (createdAt) { %><dt class="z-f-created" title="<%= t('Created') %>"><span class="visually-hidden"><%= t('Created') %></span></dt><dd title="<%= t('Created') %>"><i class="z-f-ico ti ti-calendar-plus" aria-hidden="true"></i><%= formatDateTime(createdAt, contest.timezone) %></dd><% } %>
              <dt class="z-f-submitted" title="<%= t('Submitted') %>"><span class="visually-hidden"><%= t('Submitted') %></span></dt><dd title="<%= t('Submitted') %>"><i class="z-f-ico ti ti-send" aria-hidden="true"></i><%= formatDateTime(entry.submittedAt, contest.timezone) %></dd>
              <% if (meta.creator) { %><dt class="z-f-creator" title="<%= t('Created by') %>"><span class="visually-hidden"><%= t('Created by') %></span></dt><dd title="<%= t('Created by') %>"><i class="z-f-ico ti ti-pencil" aria-hidden="true"></i><%= meta.creator %></dd><% } %>
              <dt class="z-f-participant" title="<%= t('Participant') %>"><span class="visually-hidden"><%= t('Participant') %></span></dt><dd title="<%= t('Participant') %>"><i class="z-f-ico ti ti-user" aria-hidden="true"></i><a href="<%= base %>/user/<%= nameInPath(entry.participant.username) %>" target="_blank" rel="noopener"><%= entry.participant.username %></a></dd>
              <% if (entry.submittedBy && entry.submittedBy.id !== entry.participantId) { %><dt class="z-f-by" title="<%= t('Submitted by') %>"><span class="visually-hidden"><%= t('Submitted by') %></span></dt><dd title="<%= t('Submitted by') %>"><i class="z-f-ico ti ti-user-share" aria-hidden="true"></i><%= entry.submittedBy.username %></dd><% } %>
              <% if (createdAt && startsAt) { %><dt class="z-f-kind" title="<%= t('Kind') %>"><span class="visually-hidden"><%= t('Kind') %></span></dt><dd title="<%= t('Kind') %>"><i class="z-f-ico ti ti-tag" aria-hidden="true"></i><span class="badge <%= expansion ? 'bg-azure-lt' : 'bg-green-lt' %>"><%= expansion ? t('Expansion') : t('New article') %></span></dd><% } %>
              <% if (meta.file) { %><dt class="z-f-res" title="<%= t('Resolution') %>"><span class="visually-hidden"><%= t('Resolution') %></span></dt><dd title="<%= t('Resolution') %>"><i class="z-f-ico ti ti-dimensions" aria-hidden="true"></i><%= meta.file.width %>×<%= meta.file.height %> (<%= meta.file.megapixels %> MP)</dd><% } %>
              <% if (meta.proofread) { %><dt class="z-f-proof" title="<%= t('Proofreading level') %>"><span class="visually-hidden"><%= t('Proofreading level') %></span></dt><dd title="<%= t('Proofreading level') %>"><i class="z-f-ico ti ti-checks" aria-hidden="true"></i><%= meta.proofread.label || meta.proofread.level %></dd><% } %>
            </dl>
            <% if (revMode === 'pinned' && !resultsOut && revChanged) { %>
              <div class="alert alert-warning py-2 px-2 mt-2 mb-0 small"><i class="ti ti-alert-triangle me-1"></i><%= t('The article has changed after this revision.') %> <a href="<%= wikiBase %>/w/index.php?diff=cur&oldid=<%= entry.revId %>" target="_blank" rel="noopener"><%= t('See the changes') %></a></div>
            <% } %>
            <% if (entry.entryType === 'article' && revMode === 'pinned' && !resultsOut) { %>
              <details class="z-rev-change mt-2">
                <summary><i class="ti ti-git-commit me-1"></i><%= t('Change the revision') %></summary>
                <div class="d-flex gap-2 mt-2">
                  <form method="post" action="<%= base %>/submissions/<%= entry.id %>/latest"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"><%= t('Latest') %></button></form>
                  <form method="post" action="<%= base %>/submissions/<%= entry.id %>/revision" class="d-flex gap-1 flex-fill"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" name="rev" placeholder="<%= t('Revision number or link') %>" required><button class="btn btn-sm btn-primary" type="submit"><%= t('Use') %></button></form>
                </div>
              </details>
            <% } else if (entry.entryType === 'article' && revMode === 'pinned' && resultsOut) { %>
              <div class="small text-secondary mt-2"><i class="ti ti-lock me-1"></i><%= t('Revision locked: results are out') %></div>
            <% } %>
            <div class="small mt-1">
              <% if (!problems.length) { %><span class="text-success d-none d-md-inline"><i class="ti ti-circle-check me-1"></i><%= t('Passed automatic checks') %></span><% } %>
              <% (validation.errors || []).forEach((e) => { %><div class="text-danger"><i class="ti ti-alert-circle me-1"></i><%= e %></div><% }) %>
              <% (validation.warnings || []).forEach((w) => { %><div class="text-warning"><i class="ti ti-alert-triangle me-1"></i><%= w %></div><% }) %>
            </div>
          </div>
        </div>

        <% if (others.length) { %>
          <div class="card">
            <div class="card-header py-2"><h3 class="card-title small text-uppercase text-secondary"><%= t('Other reviewers') %></h3></div>
            <div class="card-body py-2">
              <% others.forEach((r) => { %>
                <div class="small mb-2">
                  <strong><%= r.juror.username %></strong>
                  <span class="badge bg-<%= r.decision === 'accept' ? 'green' : 'red' %>-lt ms-1"><%= decisionLabel[r.decision] %></span>
                  <span class="text-secondary"><%= t('{n} points', { n: r.points }) %></span>
                  <% if (r.comment) { %><div class="text-secondary"><%= r.comment %></div><% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

      </aside>
    </div>
  <% } %>
</div>
</div></div>
</div></div>
