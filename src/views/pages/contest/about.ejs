<%
  const tz = contest.timezone;
  // The jury's own dates (review opens, review deadline) stay off the public timeline.
  const HIDDEN_DATES = ['reviewOpensAt', 'reviewDeadline'];
  const timeline = dateFields.filter(([key]) => contest[key] && !HIDDEN_DATES.includes(key)).map(([key, label]) => ({ key, label, at: contest[key] }));
  const showParticipants = !settings.anonymousParticipants || can('manageParticipants');
  const enabled = featureFields.filter(([key]) => settings[key]);
  const display = (f, value) => {
    if (f.type === 'bool') return t(value ? 'Yes' : 'No');
    if (f.type === 'choices') return [].concat(value).map((k) => f.choices[k] || k).join(', ');
    if (f.type === 'list') return value.length ? value.join(', ') : '—';
    if (f.type === 'int' && value === 0 && /max/i.test(f.key)) return t('No limit');
    if (f.type === 'int') return formatNumber(value);
    return value === '' ? '—' : value;
  };
%>
<%- include('../../partials/contestHeader', { active: 'about' }) %>
<div class="page-body"><div class="container-xl">
  <%
    // One stop per day: things that happen the same day share it.
    const now = Date.now();
    const stops = [];
    [...timeline].sort((x, y) => new Date(x.at) - new Date(y.at)).forEach((x) => {
      const dayKey = formatDate(x.at, tz);
      const last = stops[stops.length - 1];
      if (last && last.day === dayKey) last.labels.push(x.label);
      else stops.push({ day: dayKey, at: x.at, labels: [x.label] });
    });
    const current = stops.filter((x) => new Date(x.at).getTime() <= now).length - 1;
    const daysTo = (at) => Math.ceil((new Date(at).getTime() - now) / 86400000);
    const dayPart = (at, opts) => new Intl.DateTimeFormat(lang.locale, { timeZone: tz, ...opts }).format(new Date(at));
    const start = contest.startDate ? new Date(contest.startDate).getTime() : null;
    const finish = contest.endDate ? new Date(contest.endDate).getTime() : null;
    const length = start && finish ? Math.max(1, Math.round((finish - start) / 86400000)) : null;
    const done = start && finish ? Math.min(100, Math.max(0, Math.round(((now - start) / (finish - start)) * 100))) : null;
    const next = stops.find((x) => new Date(x.at).getTime() > now);
    const st = CONTEST_STATUSES[contest.status] || { label: contest.status, badge: 'secondary' };
  %>



  <% const hasSide = true; %>
  <div class="row row-cards">
    <div class="col-lg-8">
      <% if (extras.announcements.length || can('editEvent')) { %>
        <div class="z-announce mb-3">
          <% [...extras.announcements].reverse().slice(0, 3).forEach((a) => { %>
            <div class="z-announce-item"><i class="ti ti-speakerphone"></i><div><div><%= a.text %></div><small class="text-secondary"><%= formatDateTime(a.at, contest.timezone) %></small></div></div>
          <% }) %>
          <% if (can('editEvent')) { %>
            <form method="post" action="<%= base %>/announce" class="z-announce-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="form-control" name="text" maxlength="500" required placeholder="<%= t('Post an announcement (participants get a notification)') %>">
              <button class="btn btn-primary" type="submit"><i class="ti ti-send me-1"></i><%= t('Post') %></button>
            </form>
          <% } %>
        </div>
      <% } %>
      <% if (myProgress) { %>
        <div class="card mb-3 z-myprog"><div class="card-body d-flex flex-wrap align-items-center gap-4">
          <span class="z-create-ico"><i class="ti ti-user-star"></i></span>
          <div><b><%= formatNumber(myProgress.entries) %></b><span><%= t('your entries') %></span></div>
          <div><b class="text-green"><%= formatNumber(myProgress.accepted) %></b><span><%= t('accepted') %></span></div>
          <% if (myProgress.words) { %><div><b><%= formatNumber(myProgress.words) %></b><span><%= t('words accepted') %></span></div><% } %>
          <% if (myProgress.rank) { %><div><b>#<%= formatNumber(myProgress.rank) %></b><span><%= t('your place') %></span></div><% } %>
          <% if (myProgress.certificate) { %><a class="btn ms-auto" href="<%= base %>/certificate"><i class="ti ti-certificate me-1"></i><%= t('Your certificate') %></a><% } %>
        </div></div>
      <% } %>
      <%
        // The event at a glance: its description, and where to find it and its people.
        let ciA = {}; try { ciA = JSON.parse(contest.contactInfo || '{}') || {}; } catch (e) { ciA = { page: contest.contactInfo }; } if (!ciA || typeof ciA !== 'object') ciA = {};
        const urlOf = (v) => (/^https?:/.test(v || '') ? v : v ? entryUrl({ wiki: contest.primaryWiki, url: '', title: v }) : null);
        const fountains = (eventWikis || []).filter((w) => w.fountainCode);
        let tags = []; try { tags = JSON.parse(settings.trackHashtags || '[]'); } catch (e) { tags = []; }
        const facts = [
          contest.organizingCommunity && ['users-group', t('Organized by'), contest.organizingCommunity, null],
          ciA.eventPage && ['world', t('On-wiki event page'), t('Open'), urlOf(ciA.eventPage)],
          ciA.page && ['message', t('Talk and questions'), t('Open'), urlOf(ciA.page)],
          ciA.website && ['link', t('Website'), ciA.website.replace(/^https?:\/\//, ''), ciA.website],
          ciA.email && ['mail', t('Email'), ciA.email, 'mailto:' + ciA.email],
          ...fountains.map((w) => ['droplet', t('On Fountain') + (fountains.length > 1 ? ' · ' + w.code : ''), w.fountainCode, 'https://fountain.toolforge.org/editathons/' + encodeURIComponent(w.fountainCode)]),
          tags.length && ['hash', t('Hashtags'), tags.map((x) => '#' + x).join(' '), null],
        ].filter(Boolean);
      %>
      <div class="card mb-3"><div class="card-body">
        <h3 class="card-title mb-2"><i class="ti ti-info-circle me-2 text-primary"></i><%= t('About this event') %></h3>
        <% if (contest.description) { %><div class="z-about-text"><%= contest.description %></div>
        <% } else if (can('editEvent')) { %><p class="text-secondary mb-0"><a href="<%= base %>/config#step-basics"><%= t('Add a description') %></a></p>
        <% } else { %><p class="text-secondary mb-0"><%= t('No description yet.') %></p><% } %>
        <% if (facts.length) { %>
          <dl class="z-facts">
            <% facts.forEach(([icon, label, value, href]) => { %>
              <div><dt><i class="ti ti-<%= icon %>"></i><%= label %></dt><dd><% if (href) { %><a href="<%= href %>" target="_blank" rel="noopener"><%= value %> <i class="ti ti-external-link"></i></a><% } else { %><%= value %><% } %></dd></div>
            <% }) %>
          </dl>
        <% } %>
      </div></div>

      <% if (stops.length) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-timeline me-2"></i><%= t('Timeline') %></h3>
            <% if (next) { const d = daysTo(next.at); %><div class="card-actions small text-secondary"><%= t('Next') %>: <b><%= next.labels.map((l) => t(l)).join(', ') %></b> · <%= d <= 0 ? t('Today') : tn('in {n} day', 'in {n} days', d) %></div><% } %>
          </div>
          <div class="card-body">
            <ol class="z-tl">
              <% stops.forEach((x, i) => { %>
                <li class="<%= i < current ? 'is-done' : i === current ? 'is-now' : '' %>">
                  <span class="z-tl-dot"></span>
                  <span class="z-tl-day"><%= x.day %></span>
                  <span class="z-tl-what"><%= x.labels.map((l) => t(l)).join(' · ') %></span>
                </li>
              <% }) %>
            </ol>
            <% if (done != null) { %><div class="z-tl-bar" title="<%= formatNumber(done) %>%"><i style="width: <%= done %>%"></i></div><% } %>
          </div>
        </div>
      <% } %>

      <% if (extras.prizes.length || extras.topics.length || extras.topicsPage) { %>
        <div class="row g-3 mb-3">
          <% if (extras.prizes.length) { %><div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h3 class="card-title mb-3"><i class="ti ti-gift me-2 text-primary"></i><%= t('Prizes') %></h3>
            <ul class="z-prizes"><% extras.prizes.forEach((p, i) => { %><li class="is-<%= i + 1 %>"><span class="z-medal"><%= p.place || formatNumber(i + 1) %></span><span><%= p.prize %></span></li><% }) %></ul>
          </div></div></div><% } %>
          <% if (extras.topics.length || extras.topicsPage) { %><div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h3 class="card-title mb-3"><i class="ti ti-bulb me-2 text-primary"></i><%= t('Suggested topics') %></h3>
            <% if (extras.topics.length) { %><div class="d-flex flex-wrap gap-1 mb-2"><% extras.topics.slice(0, 40).forEach((x) => { %><span class="badge bg-blue-lt"><%= x %></span><% }) %></div><% } %>
            <% if (extras.topicsPage) { %><a class="small" href="<%= /^https?:/.test(extras.topicsPage) ? extras.topicsPage : entryUrl({ wiki: contest.primaryWiki, url: '', title: extras.topicsPage }) %>" target="_blank" rel="noopener"><%= t('The full list') %> <i class="ti ti-external-link"></i></a><% } %>
          </div></div></div><% } %>
        </div>
      <% } %>

      <% if (currentUser && eligibility && !eligibility.alreadyJoined && !(scope.eventRoles || []).length) { %>
        <div class="alert alert-<%= eligibility.eligible ? 'success' : 'warning' %> d-flex gap-2 mb-3">
          <i class="ti ti-<%= eligibility.eligible ? 'circle-check' : 'alert-triangle' %> mt-1"></i>
          <div><b><%= eligibility.eligible ? t('You can take part in this event.') : t('You cannot take part yet') %></b>
            <% if (!eligibility.eligible) { %><ul class="mb-0 mt-1"><% eligibility.reasons.forEach((r) => { %><li><%= t(r) %></li><% }) %></ul><% } %></div>
        </div>
      <% } %>

      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-route me-2"></i><%= t('How to take part') %></h3></div>
        <div class="card-body">
          <%
            const joinSteps = [
              { icon: 'brand-wikipedia', title: t('Log in with your Wikimedia account'), note: currentUser ? t('You are logged in.') : t('One click, with your Wikipedia account.'), done: !!currentUser },
              ...(signUp && signUp.url ? [{ icon: 'list-check', title: signUp.onwiki ? t('Sign up on the event page on the wiki') : t('Add your name to the event page on the wiki'), note: t('On the wiki, then come back.'), link: signUp.url }] : []),
              ...(settings.registrationRequired ? [{ icon: 'user-plus', title: t('Join the event here'), note: isParticipant ? t('You have joined.') : t('Before you submit.'), done: isParticipant }] : []),
              { icon: 'writing', title: t('Write or improve, then submit'), note: t('Entries are checked against the rules as they come in.') },
              { icon: 'trophy', title: t('Reviewers decide; results follow'), note: t('Follow your entries on the Submissions tab.') },
            ];
          %>
          <ol class="z-join">
            <% joinSteps.forEach((st, i) => { %>
              <li class="<%= st.done ? 'is-done' : '' %>">
                <span class="z-join-ico"><i class="ti ti-<%= st.done ? 'check' : st.icon %>"></i><span class="z-join-n"><%= formatNumber(i + 1) %></span></span>
                <span class="z-join-text">
                  <b><%= st.title %></b>
                  <small><%= st.note %><% if (st.link) { %> <a href="<%= st.link %>" target="_blank" rel="noopener"><%= t('Open') %> <i class="ti ti-external-link"></i></a><% } %></small>
                </span>
              </li>
            <% }) %>
          </ol>
          <% if (!currentUser) { %><a class="btn btn-primary mt-3" href="/login"><i class="ti ti-brand-wikipedia me-1"></i><%= t('Log in with Wikipedia') %></a><% } %>
        </div>
      </div>

  <% if (wikiParts.length) { %>
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-world me-2"></i><%= t("Wikis") %></h3><div class="card-actions text-secondary small"><%= t('{n} taking part', { n: wikiParts.filter((w) => w.status !== 'pending').length }) %></div></div>
      <% const mostEntries = Math.max(1, ...wikiParts.map((w) => w.entries)); %>
      <div class="card-body">
        <div class="row row-cards g-3">
          <% wikiParts.forEach((w) => { const st = CONTEST_STATUSES[w.status] || { label: t(w.status === 'paused' ? 'Paused' : 'Waiting for approval'), badge: 'secondary' }; const pr = eventProject({ primaryWiki: w.wiki }); %>
            <div class="col-sm-6 col-lg-4">
              <a class="z-wiki-card" href="<%= wikiHref(w) %>" style="--z-proj: <%= pr.color %>">
                <div class="d-flex align-items-start gap-2">
                  <span class="avatar avatar-sm z-proj-icon"><i class="ti ti-<%= pr.icon %>"></i></span>
                  <div class="min-w-0 flex-fill">
                    <div class="z-wiki-name text-truncate"><%= wikiLocal(w.wiki) %></div>
                    <div class="z-wiki-code">/<%= w.code %><% if (w.overridden) { %> · <%= t('{n} own settings', { n: w.overridden }) %><% } %></div>
                  </div>
                  <span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= st.label %></span>
                </div>
                <div class="z-wiki-bar" title="<%= t('{n} entries', { n: w.entries }) %>"><span style="width: <%= Math.round((w.entries / mostEntries) * 100) %>%"></span></div>
                <div class="z-wiki-stats">
                  <span><strong><%= formatNumber(w.entries) %></strong> <%= t('Entries') %></span>
                  <span><strong><%= formatNumber(w.organizers) %></strong> <%= t('Organizers') %></span>
                  <span><strong><%= formatNumber(w.jury) %></strong> <%= t('Reviewers') %></span>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>


      <% if (extras.faq.length) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-help-circle me-2"></i><%= t('Questions and answers') %></h3></div>
          <div class="list-group list-group-flush">
            <% extras.faq.forEach((f) => { %><details class="list-group-item z-faq"><summary><%= f.q %></summary><div class="text-secondary mt-2" style="white-space: pre-line"><%= f.a %></div></details><% }) %>
          </div>
        </div>
      <% } %>
      <% if ((organizers || []).length || (reviewers || []).length) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-users me-2"></i><%= t('People') %></h3><div class="card-actions"><a href="<%= base %>/participants"><%= t('See all') %></a></div></div>
          <div class="card-body">
            <% [['Organizers', organizers || []], ['Reviewers', reviewers || []]].forEach(([label, list]) => { if (!list.length) return; %>
              <div class="mb-2"><div class="subheader mb-1"><%= t(label) %></div><div class="d-flex flex-wrap gap-2"><% list.slice(0, 30).forEach((m) => { const u = m.user || m; %><a class="z-person" href="/users/<%= encodeURIComponent(u.username) %>"><%- include('../../partials/avatar', { u, size: 'xs' }) %><span><%= u.username %></span></a><% }) %></div></div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
    <% if (hasSide) { %><div class="col-lg-4">
      <%- include('../../partials/aboutRules') %>
      <% if (contest.contactInfo) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-address-book me-2"></i><%= t('Contact') %></h3></div>
          <% if (contest.contactInfo) { let ci; try { ci = JSON.parse(contest.contactInfo); } catch (e) { ci = { page: contest.contactInfo }; } if (!ci || typeof ci !== 'object') ci = { page: contest.contactInfo }; %>
          <div class="list-group-item py-2 d-flex flex-wrap gap-3 small">
            <% [['page', 'Contact page', 'message'], ['eventPage', 'On-wiki event page', 'world'], ['email', 'Email', 'mail'], ['phone', 'Phone', 'phone'], ['website', 'Website', 'link']].filter(([k]) => ci[k]).forEach(([k, label, icon]) => { const val = ci[k]; const href = k === 'email' ? 'mailto:' + val : k === 'phone' ? 'tel:' + val : /^https?:/.test(val) ? val : null; %>
              <span><i class="ti ti-<%= icon %> me-1 text-secondary"></i><% if (href) { %><a href="<%= href %>" rel="noopener"<%= /^https?:/.test(href) ? ' target=_blank' : '' %>><%= k === 'email' || k === 'phone' ? val : t(label) %></a><% } else { %><%= val %><% } %></span>
            <% }) %>
          </div>
        <% } %>
        </div>
      <% } %>
      <% if (requestableWikis && series && !wikiScope) { %>
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-world-plus me-2"></i><%= t("Bring your wiki") %></h3></div>
          <div class="card-body">
            <form method="post" action="<%= eventBase %>/wikis/request" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-12"><select class="form-select" name="wiki" data-picker="wiki" placeholder="<%= t("Search wikis…") %>" required></select></div>
              <div class="col-12"><button class="btn btn-outline-primary w-100" type="submit"><%= t("Ask to join as organizer") %></button></div>
            </form>
          </div>
        </div>
      <% } %>
    </div><% } %>
  </div>
</div>
</div>
