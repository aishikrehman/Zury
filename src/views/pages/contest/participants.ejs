<% const roleOrder = Object.keys(EVENT_ROLES); %>
<div class="page-body"><div class="container-xl">
  <%- include('../../partials/contestHeader', { active: 'people' }) %>

  <div class="row row-cards">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header"><h3 class="card-title">Members</h3><div class="card-actions text-secondary small"><%= members.length %> active</div></div>
        <% if (roleOptions.length) { %>
          <div class="card-body border-bottom">
            <form method="post" action="/contest/<%= contest.id %>/members" class="row g-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-6">
                <label class="form-label" for="memberUsername">Wikimedia username</label>
                <select class="form-select" id="memberUsername" name="username" required data-picker="user" placeholder="Search Wikimedia users…"></select>
              </div>
              <div class="col-sm-4">
                <label class="form-label" for="memberRole">Role</label>
                <select class="form-select" id="memberRole" name="role">
                  <% roleOptions.forEach(([key, role]) => { %><option value="<%= key %>"><%= role.label %></option><% }) %>
                </select>
              </div>
              <div class="col-sm-2"><button class="btn btn-primary w-100" type="submit"><i class="ti ti-user-plus me-1"></i>Add</button></div>
            </form>
          </div>
        <% } %>
        <div class="table-responsive">
          <table class="table table-vcenter card-table">
            <thead><tr><th>User</th><th>Role</th><th>Home wiki</th><th>Since</th><th class="w-1"></th></tr></thead>
            <tbody>
              <% if (!members.length) { %><tr><td colspan="5" class="text-secondary">No members yet.</td></tr><% } %>
              <% roleOrder.forEach((role) => members.filter((m) => m.role === role).forEach((m) => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <span class="avatar avatar-xs me-2"><%= m.user.username.charAt(0).toUpperCase() %></span>
                      <a href="<%= userPath(m.user.username) %>"><%= m.user.username %></a>
                    </div>
                  </td>
                  <td><span class="badge bg-<%= { organizer: 'green', jury: 'orange', participant: 'blue', viewer: 'secondary' }[role] %>-lt"><%= EVENT_ROLES[role].label %></span></td>
                  <td class="text-secondary"><%= m.user.homeWiki || '—' %></td>
                  <td class="text-secondary text-nowrap"><%= formatDate(m.assignedAt, contest.timezone) %></td>
                  <td>
                    <% if (can(ROLE_MANAGEMENT_PERMISSION[m.role])) { %>
                      <form method="post" action="/contest/<%= contest.id %>/members/<%= m.id %>/remove" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-ghost-danger" type="submit" title="Remove <%= m.user.username %>"><i class="ti ti-trash"></i><span class="visually-hidden">Remove</span></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% })) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><h3 class="card-title">Permission overrides</h3></div>
        <div class="card-body">
          <p class="text-secondary small">Give or take away one permission for one person in this event. Overrides never reduce the authority of stewards, global sysops or local admins.</p>
          <% if (!overrides.length) { %><p class="text-secondary small mb-0">No overrides.</p><% } %>
        </div>
        <% if (overrides.length) { %>
          <div class="list-group list-group-flush">
            <% overrides.forEach((o) => { %>
              <div class="list-group-item">
                <div class="d-flex align-items-start">
                  <div class="flex-fill">
                    <div><strong><%= o.user.username %></strong> <span class="badge bg-<%= o.allowed ? 'green' : 'red' %>-lt"><%= o.allowed ? 'allowed' : 'denied' %></span></div>
                    <div class="text-secondary small"><%= permissionLabels[o.permission] || o.permission %> · <code><%= o.permission %></code></div>
                  </div>
                  <% if (can('manageEvent')) { %>
                    <form method="post" action="/contest/<%= contest.id %>/overrides/<%= o.id %>/remove">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-ghost-danger" type="submit" title="Remove override"><i class="ti ti-x"></i><span class="visually-hidden">Remove</span></button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (can('manageEvent')) { %>
          <div class="card-footer">
            <form method="post" action="/contest/<%= contest.id %>/overrides">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-2">
                <label class="form-label" for="ovUser">Username</label>
                <select class="form-select" id="ovUser" name="username" required data-picker="user" placeholder="Search Wikimedia users…"></select>
              </div>
              <div class="mb-2">
                <label class="form-label" for="ovPermission">Permission</label>
                <select class="form-select" id="ovPermission" name="permission">
                  <% overridable.forEach((p) => { %><option value="<%= p %>"><%= permissionLabels[p] %> (<%= p %>)</option><% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label" for="ovAllowed">Effect</label>
                <select class="form-select" id="ovAllowed" name="allowed">
                  <option value="true">Allow</option>
                  <option value="false">Deny</option>
                </select>
              </div>
              <button class="btn btn-outline-primary w-100" type="submit">Save override</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
</div>
