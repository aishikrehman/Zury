<%
  // One row per person: their roles in this event, whether they're blocked, and
  // any permission changes. Everything you can do to someone sits on their row.
  const roleOrder = Object.keys(EVENT_ROLES);
  const roleColor = { organizer: 'green', jury: 'orange', participant: 'blue', viewer: 'secondary' };
  const people = new Map();
  const person = (user) => {
    if (!people.has(user.id)) people.set(user.id, { user, roles: [], block: null, overrides: [], since: null });
    return people.get(user.id);
  };
  members.forEach((m) => {
    const p = person(m.user);
    p.roles.push(m);
    if (!p.since || m.assignedAt < p.since) p.since = m.assignedAt;
  });
  blocks.forEach((b) => { person(b.user).block = b; });
  overrides.forEach((o) => { person(o.user).overrides.push(o); });
  const rank = (p) => Math.min(...p.roles.map((m) => roleOrder.indexOf(m.role)), p.block ? 98 : 99);
  const rows = [...people.values()].sort((a, b) => rank(a) - rank(b) || a.user.username.localeCompare(b.user.username));

  const show = ['blocked', ...roleOrder].includes(query.show) ? query.show : '';
  const matches = (p) => !show || (show === 'blocked' ? !!p.block : p.roles.some((m) => m.role === show));
  // Shown 50 at a time (an event can have thousands of participants); the name search runs on the server.
  const q = (query.q || '').toLowerCase();
  const shown = rows.filter(matches).filter((p) => !q || p.user.username.toLowerCase().includes(q));
  const PER = 50;
  const pages = Math.max(1, Math.ceil(shown.length / PER));
  const pageNo = Math.min(pages, Math.max(1, query.page || 1));
  const pageRows = shown.slice((pageNo - 1) * PER, pageNo * PER);
  const pageHref = (n) => `?${new URLSearchParams({ ...(show && { show }), ...(q && { q }), ...(n > 1 && { page: n }) })}`;
  const count = (key) => rows.filter((p) => (key === 'blocked' ? p.block : p.roles.some((m) => m.role === key))).length;
  const canRemove = (m) => (m.wiki ? scope.forWiki(m.wiki) : (wikiScope && m.role !== 'participant' ? scope.global : scope.permissions)).has(ROLE_MANAGEMENT_PERMISSION[m.role]);
  const manage = can('manageEvent');
  const csrf = `<input type="hidden" name="_csrf" value="${h(csrfToken)}">`;
%>
<%- include('../../partials/contestHeader', { active: 'people' }) %>
<div class="page-body"><div class="container-xl">
  <%- include('../../partials/peopleTabs', { tab: 'people' }) %>

  <div class="card">
    <div class="card-header z-list-head">
      <ul class="nav nav-pills z-status-pills">
        <li class="nav-item"><a class="nav-link<%= !show ? ' active' : '' %>" href="?"><%= t('All') %> <span class="badge bg-secondary-lt ms-1"><%= formatNumber(rows.length) %></span></a></li>
        <% roleOrder.filter((r) => count(r)).forEach((r) => { %>
          <li class="nav-item"><a class="nav-link<%= show === r ? ' active' : '' %>" href="?show=<%= r %>"><%= t(EVENT_ROLES[r].label) %> <span class="badge bg-<%= roleColor[r] %>-lt ms-1"><%= count(r) %></span></a></li>
        <% }) %>
        <% if (count('blocked')) { %>
          <li class="nav-item"><a class="nav-link<%= show === 'blocked' ? ' active' : '' %>" href="?show=blocked"><%= t('Blocked') %> <span class="badge bg-red-lt ms-1"><%= count('blocked') %></span></a></li>
        <% } %>
      </ul>
      <div class="z-list-filters">
        <form method="get" class="input-icon" role="search">
          <% if (show) { %><input type="hidden" name="show" value="<%= show %>"><% } %>
          <span class="input-icon-addon"><i class="ti ti-search"></i></span>
          <input class="form-control" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('Find a person') %>" aria-label="<%= t('Find a person') %>">
        </form>
        <% if (can('manageParticipants') && importable) { %><form method="post" action="<%= base %>/participants/import"><%- csrf %><button class="btn btn-outline-primary" type="submit"><i class="ti ti-download me-1"></i><%= t('Import from the wiki page') %></button></form><% } %>
        <% if (can('sendNotifications')) { %><a href="<%= base %>/message" class="btn btn-outline-primary"><i class="ti ti-mail me-1"></i><%= t('Message') %></a><% } %>
        <% if (roleOptions.length) { %><button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#add-person" aria-expanded="false" aria-controls="add-person"><i class="ti ti-user-plus me-1"></i><%= t('Add person') %></button><% } %>
      </div>
    </div>

    <% if (roleOptions.length) { %>
      <div class="collapse" id="add-person">
        <div class="card-body border-bottom bg-body-tertiary">
          <form method="post" action="<%= base %>/members" class="row g-2 align-items-end">
            <%- csrf %>
            <div class="<%= memberWikis.length ? 'col-sm-4' : 'col-sm-6' %>">
              <label class="form-label" for="memberUsername"><%= t('Wikimedia username') %></label>
              <select class="form-select" id="memberUsername" name="username" required data-picker="user" placeholder="<%= t('Search Wikimedia users…') %>"></select>
            </div>
            <div class="<%= memberWikis.length ? 'col-sm-3' : 'col-sm-4' %>">
              <label class="form-label" for="memberRole"><%= t('Role') %></label>
              <select class="form-select" id="memberRole" name="role">
                <% roleOptions.forEach(([key, role]) => { %><option value="<%= key %>"><%= t(role.label) %></option><% }) %>
              </select>
            </div>
            <% if (memberWikis.length) { %>
              <div class="col-sm-3">
                <label class="form-label" for="memberWiki"><%= t('For') %></label>
                <select class="form-select" id="memberWiki" name="wiki">
                  <option value=""><%= t('Whole event') %></option>
                  <% memberWikis.forEach((w) => { %><option value="<%= w.wiki %>"><%= wikiText(w.wiki) %></option><% }) %>
                </select>
              </div>
            <% } %>
            <div class="col-sm-2"><button class="btn btn-primary w-100" type="submit"><%= t('Add') %></button></div>
          </form>
        </div>
      </div>
    <% } %>
    <% if (canBlock) { %>
      <div class="collapse" id="block-person">
        <div class="card-body border-bottom bg-body-tertiary">
          <form method="post" action="<%= base %>/blocks" class="row g-2 align-items-end">
            <%- csrf %>
            <div class="col-sm-4">
              <label class="form-label" for="blockUser"><%= t('Username') %></label>
              <select class="form-select" id="blockUser" name="username" required data-picker="user" placeholder="<%= t('Search Wikimedia users…') %>"></select>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="blockReason"><%= t('Reason') %></label>
              <input class="form-control" id="blockReason" name="reason" maxlength="500">
            </div>
            <div class="col-sm-2"><button class="btn btn-danger w-100" type="submit"><%= t('Block') %></button></div>
          </form>
          <p class="text-secondary small mt-2 mb-0"><%= t("Blocked people can't join, submit or hold a role in this event. Accounts that are globally locked, globally blocked or blocked on their wiki are kept out automatically.") %></p>
        </div>
      </div>
    <% } %>

    <div class="table-responsive">
      <table class="table table-vcenter card-table" id="people-table">
        <thead><tr><th><%= t('User') %></th><th><%= t('Roles') %></th><th><%= t('Status') %></th><th><%= t('Since') %></th><th class="w-1"><span class="visually-hidden"><%= t('Actions') %></span></th></tr></thead>
        <tbody>
          <% if (!pageRows.length) { %><tr><td colspan="5" class="text-secondary"><%= t('No members yet.') %></td></tr><% } %>
          <% pageRows.forEach((p) => { const u = p.user; const panel = `person-${u.id}`; %>
            <tr class="z-person-row" data-filter-text="<%= u.username.toLowerCase() %>">
              <td class="z-p-user">
                <div class="d-flex align-items-center">
                  <span class="me-2"<% if (u.lastLoginAt === null) { %> title="<%= t('Has not logged in to Zury yet') %>"<% } %>><%- include('../../partials/avatar', { u, size: 'sm' }) %></span>
                  <div class="min-w-0">
                    <a href="<%= `${base}/user/${nameInPath(u.username)}` %>" class="fw-medium"><%= u.username %></a>
                    <% const pm = p.roles.find((m) => m.role === 'participant'); let det = {}; try { det = JSON.parse((pm && pm.details) || '{}'); } catch (e) { det = {}; } %>
                    <% if (pm && pm.team) { %><span class="badge bg-azure-lt ms-1"><i class="ti ti-users-group me-1"></i><%= pm.team.name %></span><% } %>
                    <% if (can('manageEvent') && Object.keys(det).length) { %><div class="small text-secondary"><%= Object.values(det).join(' · ') %></div><% } %>
                    <div class="text-secondary small"><%= (fromWikis[u.id] || []).map(wikiLocal).join(', ') %></div>
                  </div>
                </div>
              </td>
              <td class="z-p-roles">
                <div class="d-flex flex-wrap gap-1">
                  <% p.roles.forEach((m) => { %>
                    <span class="badge bg-<%= roleColor[m.role] %>-lt"><%= t(EVENT_ROLES[m.role].label) %><%= m.wiki && !wikiScope && allWikis.length > 1 ? ` · ${wikiLocal(m.wiki)}` : '' %>
                      <% if (canRemove(m)) { %>
                        <form method="post" action="<%= base %>/members/<%= m.id %>/remove" class="d-inline" data-confirm="<%= t('Remove {user} as {role}?', { user: u.username, role: EVENT_ROLES[m.role].label }) %>"><%- csrf %>
                          <button class="z-pill-x" type="submit" aria-label="<%= t('Remove') %>" title="<%= t('Remove') %>"><i class="ti ti-x"></i></button>
                        </form>
                      <% } %>
                    </span>
                  <% }) %>
                  <% if (!p.roles.length && !roleOptions.length) { %><span class="text-secondary">—</span><% } %>
                  <% p.overrides.forEach((o) => { %>
                    <span class="badge bg-<%= o.allowed ? 'green' : 'red' %>-lt z-ovr-pill" title="<%= o.allowed ? t('Allow') : t('Deny') %>"><i class="ti ti-<%= o.allowed ? 'key' : 'key-off' %> me-1"></i><%= permissionLabels[o.permission] || o.permission %>
                      <% if (manage) { %><form method="post" action="<%= base %>/overrides/<%= o.id %>/remove" class="d-inline"><%- csrf %><button class="z-pill-x" type="submit" aria-label="<%= t('Remove override') %>" title="<%= t('Remove override') %>"><i class="ti ti-x"></i></button></form><% } %>
                    </span>
                  <% }) %>
                  <% const canAdd = roleOptions.filter(([key]) => !p.roles.some((m) => m.role === key && (!m.wiki || wikiScope || !memberWikis.length))); if (canAdd.length) { %>
                    <div class="dropdown d-inline-block">
                      <button class="badge z-role-add" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="<%= t('Add a role') %>" aria-label="<%= t('Add a role') %>"><i class="ti ti-plus"></i></button>
                      <div class="dropdown-menu">
                        <% canAdd.forEach(([key, role]) => { %>
                          <% if (memberWikis.length) { %><h6 class="dropdown-header"><%= t(role.label) %></h6><% } %>
                          <% [['', memberWikis.length ? t('Whole event') : t(role.label)], ...memberWikis.map((w) => [w.wiki, wikiLocal(w.wiki)])].forEach(([wk, lab]) => { %>
                            <form method="post" action="<%= base %>/members"><%- csrf %><input type="hidden" name="username" value="<%= u.username %>"><input type="hidden" name="role" value="<%= key %>"><% if (wk) { %><input type="hidden" name="wiki" value="<%= wk %>"><% } %><button class="dropdown-item" type="submit"><%= lab %></button></form>
                          <% }) %>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                </div>
              </td>
              <td class="z-p-status">
                <div class="d-flex flex-wrap gap-1">
                  <% if (p.block) { %><span class="badge bg-red-lt" title="<%= p.block.reason || t('No reason given') %>"><i class="ti ti-ban me-1"></i><%= t('Blocked') %></span><% } %>
                  
                  <% if (!p.block) { %><span class="text-secondary"><%= t('Active') %></span><% } %>
                </div>
              </td>
              <td class="text-secondary text-nowrap z-p-since"><%= p.since ? formatDate(p.since, contest.timezone) : p.block ? formatDate(p.block.createdAt, contest.timezone) : '—' %></td>
              <td class="z-p-act">
                <div class="dropdown">
                  <button class="btn btn-sm btn-ghost-secondary btn-icon" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="<%= t('Actions') %>"><i class="ti ti-dots-vertical"></i></button>
                  <div class="dropdown-menu dropdown-menu-end">
                  <a class="dropdown-item" href="<%= `${base}/user/${nameInPath(u.username)}` %>"><i class="ti ti-eye me-2"></i><%= t('View') %></a>
                  <% if (manage) { %>
                    <button class="dropdown-item" type="button" data-bs-toggle="collapse" data-bs-target="#<%= panel %>" aria-expanded="false" aria-controls="<%= panel %>"><i class="ti ti-key me-2"></i><%= t('Permission overrides') %></button>
                  <% } %>
                  <% if (canBlock && p.block) { %>
                    <form method="post" action="<%= base %>/blocks/<%= p.block.id %>/lift"><%- csrf %>
                      <button class="dropdown-item" type="submit" ><i class="ti ti-lock-open me-2"></i><%= t('Unblock') %></button>
                    </form>
                  <% } else if (canBlock) { %>
                    <form method="post" action="<%= base %>/blocks" data-confirm="<%= t('Block {user} from this event?', { user: u.username }) %>"><%- csrf %>
                      <input type="hidden" name="username" value="<%= u.username %>">
                      <button class="dropdown-item text-danger" type="submit" ><i class="ti ti-ban me-2"></i><%= t('Block from this event') %></button>
                    </form>
                  <% } %>
                  </div>
                </div>
              </td>
            </tr>
            <% if (manage) { %>
              <tr class="collapse z-person-panel" id="<%= panel %>">
                <td colspan="5">
                  <div class="row g-3">
                    <% if (manage) { %>
                      <div class="col-lg-7">
                        <div class="subheader mb-2"><%= t('Permission overrides') %></div>
                        <form method="post" action="<%= base %>/overrides" class="d-flex gap-2"><%- csrf %>
                          <input type="hidden" name="username" value="<%= u.username %>">
                          <select class="form-select form-select-sm" name="permission" aria-label="<%= t('Permission') %>">
                            <% overridable.forEach((perm) => { %><option value="<%= perm %>"><%= permissionLabels[perm] %></option><% }) %>
                          </select>
                          <select class="form-select form-select-sm w-auto" name="allowed" aria-label="<%= t('Effect') %>">
                            <option value="true"><%= t('Allow') %></option>
                            <option value="false"><%= t('Deny') %></option>
                          </select>
                          <button class="btn btn-sm btn-outline-primary" type="submit"><%= t('Save') %></button>
                        </form>
                        <p class="text-secondary small mt-2 mb-0"><%= t('Give or take away one permission for one person in this event. Overrides never reduce the authority of stewards, global sysops or local admins.') %></p>
                      </div>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (pages > 1) { %>
      <div class="card-footer d-flex align-items-center gap-2">
        <span class="text-secondary small me-auto"><%= t('{a}–{b} of {n}', { a: formatNumber((pageNo - 1) * PER + 1), b: formatNumber(Math.min(pageNo * PER, shown.length)), n: formatNumber(shown.length) }) %></span>
        <% if (pageNo > 1) { %><a class="btn btn-sm" href="<%= pageHref(pageNo - 1) %>"><i class="ti ti-chevron-left"></i><%= t('Previous') %></a><% } %>
        <% if (pageNo < pages) { %><a class="btn btn-sm" href="<%= pageHref(pageNo + 1) %>"><%= t('Next') %><i class="ti ti-chevron-right"></i></a><% } %>
      </div>
    <% } %>
    <div>
    </div>
  </div>
</div>
</div>
