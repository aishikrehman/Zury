<div class="container py-5">
  <h1 class="h3">Demo users</h1>
  <p class="text-muted">Log in as any of these sample accounts to see Zury from their point of view. Demo login only exists when <code>DEMO_MODE=true</code> outside production.</p>

  <% if (!rows.length) { %>
    <div class="alert alert-warning">No demo data yet. Run <code>npm run seed</code> and reload.</div>
  <% } %>

  <div class="row g-3">
    <% rows.forEach(({ user: u, subject: s, roleCounts }) => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100<%= currentUser && currentUser.id === u.id ? ' border-primary' : '' %>">
          <div class="card-body d-flex flex-column">
            <h2 class="h6 mb-2"><%= u.username %><% if (currentUser && currentUser.id === u.id) { %> <span class="badge text-bg-primary">current</span><% } %></h2>
            <div class="small mb-2"><%- include('../../partials/accessSummary', { s }) %></div>
            <p class="small text-muted mb-3">
              <% const parts = Object.entries(roleCounts).map(([r, n]) => `${EVENT_ROLES[r] ? EVENT_ROLES[r].label : r} in ${n}`); %>
              <%= parts.length ? 'Event roles: ' + parts.join(', ') : 'No event roles' %>
            </p>
            <form method="post" action="/demo/login" class="mt-auto">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="userId" value="<%= u.id %>">
              <button type="submit" class="btn btn-sm btn-primary">Log in as <%= u.username %></button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
