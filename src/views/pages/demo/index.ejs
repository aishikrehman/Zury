<%- include('../../partials/pageHeader', { pretitle: t('Demo mode'), heading: t('Demo users') }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="alert alert-info"><i class="ti ti-flask me-1"></i><%= t("Log in as any sample account to see Zury from their point of view. Demo login only exists when") %> <code><%= t("DEMO_MODE=true") %></code> <%= t("outside production.") %></div>
    <% if (!rows.length) { %>
      <div class="card"><div class="empty">
        <div class="empty-icon"><i class="ti ti-database-off icon"></i></div>
        <p class="empty-title"><%= t("No demo data yet") %></p>
        <p class="empty-subtitle text-secondary"><%- th('Run {command} and reload this page.', { command: '<code>npm run seed</code>' }) %></p>
      </div></div>
    <% } %>
    <div class="row row-cards">
      <% rows.forEach(({ user: u, subject: s, roleCounts }) => { const current = currentUser && currentUser.id === u.id; %>
        <div class="col-md-6 col-lg-3">
          <div class="card h-100<%= current ? ' card-active' : '' %>">
            <div class="card-body p-4 text-center">
              <span class="avatar avatar-xl mb-3 rounded"><%= u.username.charAt(0).toUpperCase() %></span>
              <h3 class="m-0 mb-1"><%= u.username.replace(' (demo)', '') %></h3>
              <div class="text-secondary mb-2"><%= wikiName(u.homeWiki) %></div>
              <div class="mb-2 d-flex justify-content-center"><%- include('../../partials/accessSummary', { s }) %></div>
              <div class="mt-2">
                <% const entries = Object.entries(roleCounts); %>
                <% if (!entries.length) { %><span class="badge bg-secondary-lt"><%= t("No event roles") %></span><% } %>
                <% entries.forEach(([r, n]) => { %><span class="badge bg-blue-lt me-1"><%= EVENT_ROLES[r] ? EVENT_ROLES[r].label : r %> × <%= n %></span><% }) %>
              </div>
            </div>
            <div class="d-flex">
              <form method="post" action="/demo/login" class="card-btn p-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="userId" value="<%= u.id %>">
                <button type="submit" class="btn btn-link w-100 h-100 py-3 text-decoration-none<%= current ? ' disabled' : '' %>">
                  <i class="ti ti-login me-1"></i><%= current ? 'Current user' : 'Log in as ' + u.username %>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
