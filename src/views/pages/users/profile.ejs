<%
  const wikiUserUrl = 'https://meta.wikimedia.org/wiki/Special:CentralAuth/' + encodeURIComponent(profileUser.username.replace(/ /g, '_'));
  const eventList = (items, empty) => ({ items, empty });
  const groups = [
    { heading: 'Organized', ...eventList(organized, 'No public events organized.') },
    { heading: 'Jury member', ...eventList(judged, 'No public jury roles.') },
    { heading: 'Participated', ...eventList(participated, 'No public event participation.') },
  ];
%>
<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-3 align-items-center">
      <div class="col-auto"><span class="avatar avatar-lg rounded"><%= profileUser.username.charAt(0).toUpperCase() %></span></div>
      <div class="col">
        <div class="page-pretitle">Profile</div>
        <h2 class="page-title"><%= profileUser.username %><% if (profileUser.isDemo) { %><span class="badge bg-yellow-lt ms-2">Demo user</span><% } %></h2>
      </div>
      <div class="col-auto ms-auto btn-list">
        <% if (!profileUser.isDemo) { %><a class="btn btn-outline-secondary" href="<%= wikiUserUrl %>" rel="noopener" target="_blank"><i class="ti ti-world me-1"></i>Wikimedia account</a><% } %>
        <% if (isOwnProfile) { %><a class="btn btn-primary" href="/settings"><i class="ti ti-settings me-1"></i>Preferences</a><% } %>
      </div>
    </div>
  </div>
</div>
<div class="page-body"><div class="container-xl">

  <div class="row g-4">
    <div class="col-lg-4">
      <dl>
        <% if (profileUser.homeWiki) { %><dt>Home wiki</dt><dd><%= profileUser.homeWiki %></dd><% } %>
        <% if (profileUser.wikimediaRegisteredAt) { %><dt>Wikimedia account since</dt><dd><%= formatDate(profileUser.wikimediaRegisteredAt) %></dd><% } %>
        <dt>Joined Zury</dt><dd><%= formatDate(profileUser.createdAt) %></dd>
        <dt>Roles</dt><dd><%- include('../../partials/accessSummary', { s: profileSubject }) %></dd>
      </dl>
    </div>
    <div class="col-lg-8">
      <% groups.forEach((g) => { %>
        <h2 class="h5"><%= g.heading %></h2>
        <% if (!g.items.length) { %>
          <p class="text-muted small"><%= g.empty %></p>
        <% } else { %>
          <ul class="list-unstyled mb-4">
            <% g.items.forEach(({ contest: c }) => { %>
              <li class="mb-1"><a href="/contest/<%= c.id %>"><%= c.title %></a>
                <span class="small text-muted">· <%= CONTEST_TYPES[c.type] %> · <%= (CONTEST_STATUSES[c.status] || {}).label %></span></li>
            <% }) %>
          </ul>
        <% } %>
      <% }) %>
      <p class="text-muted small">Submissions and badges will appear here in later phases.</p>
    </div>
  </div>
</div>
</div>
