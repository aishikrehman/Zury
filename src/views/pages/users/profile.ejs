<%
  const groups = [
    { key: 'organized', heading: t('Organized'), icon: 'briefcase', color: 'green', items: organized },
    { key: 'reviewer', heading: t('Reviewer'), icon: 'gavel', color: 'orange', items: judged },
    { key: 'participated', heading: t('Participated'), icon: 'users', color: 'blue', items: participated },
  ];
  const RUNNING = ['published', 'upcoming', 'active', 'submission_closed', 'under_review'];
  const pick = show ? groups.find((g) => g.key === show) : (groups.find((g) => g.items.length) || groups[0]);
  const list = pick.items.filter(({ contest: c }) => when === 'all' || (when === 'running' ? RUNNING.includes(c.status) : !RUNNING.includes(c.status)));
  const allIds = new Set([...organized, ...judged, ...participated].map((e) => e.contest.id));
  const q = (o) => '?' + new URLSearchParams({ show: o.show || pick.key, ...(o.when && o.when !== 'all' ? { when: o.when } : {}) }).toString();
  const tiles = [['calendar-event', allIds.size, t('Events'), 'blue'], ['files', numbers.entries, t('Entries'), 'azure'], ['circle-check', numbers.accepted, t('Accepted'), 'green'], ['letter-case', numbers.words, t('Words'), 'purple'], ['gavel', numbers.reviews, t('Reviews'), 'orange']];
%>
<% if (isOwnProfile) { %><%- include('../../partials/accountHeader', { tab: 'profile', eventCount: allIds.size }) %><% } else { %>
<div class="page-body"><div class="container-xl"><div class="row g-4">
  <div class="col-12"><div class="card z-prof-head"><div class="card-body">
    <div class="z-prof-avatar"><%- include('../../partials/avatar', { u: profileUser, size: 'xl' }) %></div>
    <div class="z-prof-main"><div class="z-prof-name"><%= profileUser.username %> <span><%= profileUser.homeWiki ? wikiLocal(profileUser.homeWiki) : 'Wikimedia' %></span></div>
      <div class="z-prof-roles"><%- include('../../partials/accessSummary', { s: profileSubject }) %></div></div>
  </div></div></div>
<% } %>
    <div class="col-12">
      <div class="z-prof-tiles">
        <% tiles.forEach(([icon, n, label, color]) => { %><div class="z-prof-tile"><span class="bg-<%= color %>-lt text-<%= color %>"><i class="ti ti-<%= icon %>"></i></span><div><b><%= formatNumber(n) %></b><small><%= label %></small></div></div><% }) %>
      </div>
    </div>
    <div class="col-12">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <nav class="z-seg" aria-label="<%= t('Events') %>">
          <% groups.forEach((g) => { %><a class="<%= g.key === pick.key ? 'active' : '' %>" href="<%= q({ show: g.key, when }) %>"><i class="ti ti-<%= g.icon %>"></i><%= g.heading %> <span class="badge bg-<%= g.color %>-lt ms-1"><%= formatNumber(g.items.length) %></span></a><% }) %>
        </nav>
        <div class="z-chips ms-auto">
          <% [['all', t('All')], ['running', t('Running')], ['done', t('Finished')]].forEach(([k, label]) => { %><a class="z-chip<%= when === k ? ' is-on' : '' %>" href="<%= q({ when: k }) %>"><%= label %></a><% }) %>
        </div>
      </div>
      <% if (!list.length) { %>
        <div class="card"><div class="card-body text-secondary text-center py-5"><i class="ti ti-calendar-off d-block mb-2" style="font-size: 2rem"></i><%= t('No events here.') %></div></div>
      <% } else { %>
        <div class="z-prof-grid">
          <% list.forEach(({ contest: c }) => { const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; const m = mine[c.id] || { entries: 0, accepted: 0, reviews: 0 }; %>
            <a class="card card-link z-prof-ev" href="<%= eventPath(c) %>">
              <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2"><span class="badge bg-<%= st.badge === 'dark' ? 'secondary' : st.badge %>-lt"><%= t(st.label) %></span><span class="text-secondary small ms-auto"><%= c.startDate ? formatDate(c.startDate, c.timezone) : '' %></span></div>
                <div class="z-prof-ev-title"><%= c.title %></div>
                <div class="text-secondary small mt-1"><%= t(CONTEST_TYPES[c.type]) %> · <%= wikiLocal(c.primaryWiki) %><% if (c.series) { %> · <%= c.series.title %><% } %></div>
              </div>
              <div class="card-footer z-prof-ev-foot">
                <% if (pick.key === 'participated') { %><span><i class="ti ti-files"></i><%= formatNumber(m.entries) %></span><span class="text-green"><i class="ti ti-circle-check"></i><%= formatNumber(m.accepted) %></span>
                <% } else if (pick.key === 'reviewer') { %><span><i class="ti ti-gavel"></i><%= tn('{n} review', '{n} reviews', m.reviews) %></span>
                <% } else { %><span><i class="ti ti-users"></i><%= tn('{n} participant', '{n} participants', c._count ? c._count.memberships : 0) %></span><% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
<% if (isOwnProfile) { %><%- include('../../partials/accountEnd') %><% } else { %></div></div></div><% } %>
