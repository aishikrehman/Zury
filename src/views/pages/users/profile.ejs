<%
  const wikiUserUrl = 'https://meta.wikimedia.org/wiki/Special:CentralAuth/' + encodeURIComponent(profileUser.username.replace(/ /g, '_'));
  const groups = [
    { heading: t('Organized'), icon: 'briefcase', color: 'green', items: organized, empty: 'No public events organized.' },
    { heading: t('Jury member'), icon: 'gavel', color: 'orange', items: judged, empty: 'No public jury roles.' },
    { heading: t('Participated'), icon: 'users', color: 'blue', items: participated, empty: 'No public event participation.' },
  ];
%>
<% if (isOwnProfile) { %><%- include('../../partials/accountHeader', { tab: 'profile', prefs, eventCount: organized.length + judged.length + participated.length }) %><% } else { %>
<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-3 align-items-center">
      <div class="col-auto"><%- include('../../partials/avatar', { u: profileUser, size: 'lg' }) %></div>
      <div class="col">
        <div class="page-pretitle"><%= t("Profile") %></div>
        <h2 class="page-title"><%= profileUser.username %></h2>
        <% if (!profileUser.lastLoginAt) { %><div class="text-secondary small mt-1"><i class="ti ti-clock me-1"></i><%= t('Has not logged in to Zury yet') %></div><% } %>
      </div>
      <div class="col-auto ms-auto btn-list">
        <a class="btn btn-outline-secondary" href="<%= wikiUserUrl %>" rel="noopener" target="_blank"><i class="ti ti-world me-1"></i><%= t("Wikimedia account") %></a>
        <% if (isOwnProfile) { %><a class="btn btn-primary" href="/settings"><i class="ti ti-settings me-1"></i><%= t("Preferences") %></a><% } %>
      </div>
    </div>
  </div>
</div>
<div class="page-body">
  <div class="container-xl">
<% } %>
    <div class="row row-cards">
      <% if (!isOwnProfile) { %>
      <div class="col-lg-4">
        <div class="card">
          <div class="card-body p-4 text-center">
            <div class="mb-3"><%- include('../../partials/avatar', { u: profileUser, size: 'xl' }) %></div>
            <h3 class="m-0 mb-1"><%= profileUser.username %></h3>
            <div class="text-secondary"><%- profileUser.homeWiki ? wikiLabel(profileUser.homeWiki) : 'Wikimedia' %></div>
          </div>
          <div class="card-body">
            <div class="datagrid">
              <% if (profileUser.wikimediaRegisteredAt) { %><div class="datagrid-item"><div class="datagrid-title"><%= t("Wikimedia account since") %></div><div class="datagrid-content"><%= formatDate(profileUser.wikimediaRegisteredAt) %></div></div><% } %>
              <div class="datagrid-item"><div class="datagrid-title"><%= t("Joined Zury") %></div><div class="datagrid-content"><%= formatDate(profileUser.createdAt) %></div></div>
              <div class="datagrid-item"><div class="datagrid-title"><%= t("Events") %></div><div class="datagrid-content"><%= organized.length + judged.length + participated.length %></div></div>
            </div>
          </div>
          <div class="card-footer">
            <div class="subheader mb-2"><%= t("Roles") %></div>
            <%- include('../../partials/accessSummary', { s: profileSubject }) %>
          </div>
        </div>
      </div>
      <% } %>
      <div class="<%= isOwnProfile ? 'col-12' : 'col-lg-8' %>">
        <% groups.forEach((g) => { %>
          <details class="card mb-3 z-fold-card"<%= g.items.length ? ' open' : '' %>>
            <summary class="card-header"><h3 class="card-title"><span class="avatar avatar-xs bg-<%= g.color %>-lt me-2"><i class="ti ti-<%= g.icon %>"></i></span><%= g.heading %></h3><span class="ms-auto badge bg-secondary-lt"><%= formatNumber(g.items.length) %></span><i class="ti ti-chevron-down z-fold-icon"></i></summary>
            <% if (!g.items.length) { %>
              <div class="card-body text-secondary"><%= t(g.empty) %></div>
            <% } else { %>
              <div class="list-group list-group-flush">
                <% g.items.forEach(({ contest: c }) => { const st = CONTEST_STATUSES[c.status] || { label: c.status, badge: 'secondary' }; %>
                  <a href="<%= eventPath(c) %>" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                    <span class="z-evhead-status is-<%= st.badge === 'dark' ? 'secondary' : st.badge %>" title="<%= t(st.label) %>"><i></i></span>
                    <div class="flex-fill min-w-0">
                      <div class="text-truncate"><%= c.title %></div>
                      <div class="text-secondary small"><%= t(CONTEST_TYPES[c.type]) %> · <%= wikiLocal(c.primaryWiki) %></div>
                    </div>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </details>
        <% }) %>
      </div>
    </div>
<% if (isOwnProfile) { %><%- include('../../partials/accountEnd') %><% } else { %>
  </div>
</div>
<% } %>
