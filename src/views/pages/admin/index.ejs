<% const tiles = [
  ['users', 'primary', 'Users', stats.users, '/admin/users'],
  ['calendar-event', 'green', 'Events', stats.contests, '/events'],
  ['shield-lock', 'orange', 'Platform administrators', stats.admins, '/admin/users'],
  ['history', 'azure', 'Audit log entries', stats.auditEntries, '/admin/logs'],
]; %>
<%- include('../../partials/pageHeader', { pretitle: t('Administration'), heading: t('Overview') }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row row-deck row-cards mb-4">
      <% tiles.forEach(([icon, color, label, value, href]) => { %>
        <div class="col-sm-6 col-lg-3">
          <a href="<%= href %>" class="card card-sm card-link">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-auto"><span class="bg-<%= color %> text-white avatar"><i class="ti ti-<%= icon %>"></i></span></div>
                <div class="col">
                  <div class="h2 mb-0"><%= value %></div>
                  <div class="text-secondary"><%= t(label) %></div>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
    <%
      const p = platform;
      const typeKeys = Object.keys(p.eventsByType);
      const statusKeys = Object.keys(p.eventsByStatus);
      const statusColor = (k) => { const b = (CONTEST_STATUSES[k] || {}).badge || 'secondary'; return b === 'dark' ? 'gray-500' : b === 'light' ? 'gray-300' : b; };
      const wikis = Object.entries(p.submissionsByWiki);
    %>
    <div class="row row-cards mb-4">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Activity, last 30 days") %></h3></div>
          <div class="card-body">
            <%- include('../../partials/chart', { spec: { type: 'line', height: 260, legend: true, series: [{ name: 'Submissions', data: p.submissions.values }, { name: 'New users', data: p.signups.values }], labels: p.submissions.labels, colors: ['primary', 'green'] }, label: t('Submissions and new users per day') }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Events by type") %></h3></div>
          <div class="card-body">
            <%- include('../../partials/chart', { spec: { type: 'donut', height: 260, series: typeKeys.map((k) => p.eventsByType[k]), labels: typeKeys.map((k) => CONTEST_TYPES[k] || k), colors: ['blue', 'green', 'purple', 'orange'], totalLabel: 'Events' }, label: t('Events by type') }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Events by status") %></h3></div>
          <div class="card-body">
            <%- include('../../partials/chart', { spec: { type: 'bar', height: 220, distributed: true, series: [{ name: 'Events', data: statusKeys.map((k) => p.eventsByStatus[k]) }], labels: statusKeys.map((k) => (CONTEST_STATUSES[k] || { label: k }).label), colors: statusKeys.map(statusColor) }, label: t('Events by status') }) %>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Top wikis by submissions") %></h3></div>
          <div class="card-body">
            <% const maxWiki = Math.max(1, ...wikis.map((w) => w[1])); %>
            <% if (!wikis.length) { %><p class="text-secondary mb-0"><%= t("No submissions yet.") %></p><% } %>
            <% wikis.forEach(([wiki, n]) => { %>
              <div class="mb-3">
                <div class="d-flex mb-1"><span><%= wiki %></span><span class="ms-auto text-secondary"><%= n %></span></div>
                <div class="progress progress-sm"><div class="progress-bar" style="width: <%= Math.round((n / maxWiki) * 100) %>%"></div></div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <div class="row row-cards">
      <div class="col-md-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Platform administration") %></h3></div>
          <div class="card-body text-secondary"><%= t("This area runs Zury itself. It is separate from Wikimedia community administration: being a platform administrator gives no authority over events.") %></div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t("Shortcuts") %></h3></div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action" href="/admin/users"><i class="ti ti-users me-2"></i><%= t("Manage users and platform roles") %></a>
            <a class="list-group-item list-group-item-action" href="/admin/permissions"><i class="ti ti-key me-2"></i><%= t("Permission matrix") %></a>
            <% if (can('viewAuditLog')) { %><a class="list-group-item list-group-item-action" href="/admin/logs"><i class="ti ti-history me-2"></i><%= t("Audit log") %></a><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
