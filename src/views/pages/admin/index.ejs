<% const tiles = [
  ['users', 'primary', 'Users', stats.users, '/admin/users'],
  ['calendar-event', 'green', 'Events', stats.contests, '/events'],
  ['shield-lock', 'orange', 'Platform administrators', stats.admins, '/admin/users'],
  ['history', 'azure', 'Audit log entries', stats.auditEntries, '/admin/logs'],
]; %>
<%- include('../../partials/pageHeader', { pretitle: 'Administration', heading: 'Overview' }) %>
<div class="page-body">
  <div class="container-xl">
    <div class="row row-deck row-cards mb-4">
      <% tiles.forEach(([icon, color, label, value, href]) => { %>
        <div class="col-sm-6 col-lg-3">
          <a href="<%= href %>" class="card card-sm card-link">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-auto"><span class="bg-<%= color %> text-white avatar"><i class="ti ti-<%= icon %>"></i></span></div>
                <div class="col">
                  <div class="h2 mb-0"><%= value %></div>
                  <div class="text-secondary"><%= label %></div>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
    <div class="row row-cards">
      <div class="col-md-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title">Platform administration</h3></div>
          <div class="card-body text-secondary">This area runs Zury itself. It is separate from Wikimedia community administration: being a platform administrator gives no authority over events.</div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-header"><h3 class="card-title">Shortcuts</h3></div>
          <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action" href="/admin/users"><i class="ti ti-users me-2"></i>Manage users and platform roles</a>
            <a class="list-group-item list-group-item-action" href="/admin/permissions"><i class="ti ti-key me-2"></i>Permission matrix</a>
            <% if (can('viewAuditLog')) { %><a class="list-group-item list-group-item-action" href="/admin/logs"><i class="ti ti-history me-2"></i>Audit log</a><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
