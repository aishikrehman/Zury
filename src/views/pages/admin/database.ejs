<%
  const mb = (b) => (b / 1048576).toFixed(1);
  const up = (sec) => (sec >= 86400 ? t('{n} days', { n: Math.floor(sec / 86400) }) : sec >= 3600 ? t('{n} hours', { n: Math.floor(sec / 3600) }) : t('{n} minutes', { n: Math.floor(sec / 60) }));
%>
<%- include('../../partials/adminHeader', { tab: 'database' }) %>
<div class="page-body">
  <div class="container-xl">
    <%# One layout: the tables down the side (with the size and a backup at the bottom); the open table,
        or with none open the clean-up and server cards, on the right. %>
    <div class="row g-4">
      <aside class="col-lg-3">
        <div class="card z-db-side">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-database me-2"></i><%= t('Tables') %></h3><% if (status) { %><div class="card-actions text-secondary small"><%= t('{n} MB', { n: mb(status.dbBytes) }) %></div><% } %></div>
          <div class="list-group list-group-flush">
            <a href="/admin/database" class="list-group-item list-group-item-action d-flex align-items-center<%= view ? '' : ' active' %>"><i class="ti ti-tool me-2"></i><span><%= t('Maintenance') %></span></a>
            <% tables.forEach((tb) => { %>
              <a href="/admin/database?table=<%= tb.name %>" class="list-group-item list-group-item-action d-flex align-items-center<%= view && view.name === tb.name ? ' active' : '' %>"><span class="text-truncate"><%= tb.name %></span><span class="ms-auto text-secondary small"><%= formatNumber(tb.rows) %></span></a>
            <% }) %>
          </div>
          <% if (status) { %><div class="card-footer">
            <form method="post" action="/admin/maintenance/backup" class="d-flex flex-column gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary w-100" type="submit"><i class="ti ti-download me-1"></i><%= t('Download a backup') %></button>
            </form>
          </div><% } %>
        </div>
      </aside>
      <div class="col-lg-9">
        <% if (!view) { %>
          <% if (status) { %>
            <div class="row row-cards">
              <div class="col-xl-7">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-brush me-2"></i><%= t('Clean up') %></h3></div>
          <div class="list-group list-group-flush">
            <div class="list-group-item d-flex align-items-center gap-2">
              <div class="flex-fill"><div><%= t('Expired sign-in sessions') %></div><div class="text-secondary small"><%= formatNumber(status.expiredSessions) %></div></div>
              <form method="post" action="/admin/maintenance/clean/sessions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"<%= status.expiredSessions ? '' : ' disabled' %>><%= t('Remove') %></button></form>
            </div>
            <div class="list-group-item d-flex align-items-center gap-2">
              <div class="flex-fill"><div><%= t('Activity log older than a year') %></div><div class="text-secondary small"><%= status.oldestLog ? t('Oldest: {date}', { date: formatDate(status.oldestLog) }) : '—' %></div></div>
              <form method="post" action="/admin/maintenance/clean/activity" data-confirm="<%= t('Remove activity log rows older than a year?') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"><%= t('Remove') %></button></form>
            </div>
            <% if (typeof chatCount !== 'undefined' && chatCount !== null) { %>
            <div class="list-group-item d-flex align-items-center gap-2">
              <div class="flex-fill"><div><%= t('All chat messages') %></div><div class="text-secondary small"><%= formatNumber(chatCount) %></div></div>
              <form method="post" action="/chat/clear" data-confirm="<%= t('Delete every chat message on Zury? This cannot be undone.') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="all" value="1"><input type="hidden" name="back" value="/admin/database"><button class="btn btn-sm btn-ghost-danger" type="submit"<%= chatCount ? '' : ' disabled' %>><%= t('Remove') %></button></form>
            </div>
            <% } %>
          </div>
        </div>
              </div>
              <div class="col-xl-5">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><i class="ti ti-server me-2"></i><%= t('Server') %></h3></div>
          <div class="card-body">
            <dl class="z-facts-list">
              <dt><%= t('Zury') %></dt><dd><%= status.version %></dd>
              <dt>Node.js</dt><dd><%= status.node %></dd>
              <dt><%= t('Memory') %></dt><dd><%= t('{n} MB', { n: status.memoryMB }) %></dd>
              <dt><%= t('Running for') %></dt><dd><%= up(status.uptimeSeconds) %></dd>
            </dl>
          </div>
        </div>
              </div>
            </div>
          <% } else { %>
            <div class="card"><div class="card-body text-secondary"><%= t('Choose a table.') %></div></div>
          <% } %>
        <% } else { %>
          <div class="card">
            <div class="card-header">
              <h2 class="card-title"><%= view.name %></h2>
              <span class="ms-auto text-secondary small"><%= tn('{n} row', '{n} rows', view.total) %></span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-vcenter card-table z-db-table">
                <thead><tr><% view.columns.forEach((c) => { %><th><%= c %></th><% }) %><% if (canRemove) { %><th></th><% } %></tr></thead>
                <tbody>
                  <% if (!view.rows.length) { %><tr><td colspan="<%= view.columns.length %>" class="text-secondary"><%= t('No rows.') %></td></tr><% } %>
                  <% view.rows.forEach((r) => { const rowId = canRemove ? r[view.columns.indexOf(idField)] : null; %><tr><% r.forEach((v) => { %><td<%- v === null ? ' class="text-secondary"' : '' %>><%= v === null ? '—' : v %></td><% }) %><% if (canRemove) { %><td class="text-end"><form method="post" action="/admin/database/<%= view.name %>/<%= encodeURIComponent(rowId) %>/remove" data-confirm="<%= t('Remove this row for good? Records that belong to it go too.') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="page" value="<%= view.page %>"><button class="btn btn-sm btn-ghost-danger btn-icon" type="submit" title="<%= t('Remove') %>" aria-label="<%= t('Remove') %>"><i class="ti ti-trash"></i></button></form></td><% } %></tr><% }) %>
                </tbody>
              </table>
            </div>
            <% if (view.pages > 1) { %>
              <div class="card-footer d-flex align-items-center">
                <span class="text-secondary small"><%= t('Page {page} of {pages}', { page: formatNumber(view.page), pages: formatNumber(view.pages) }) %></span>
                <div class="btn-list ms-auto">
                  <a class="btn btn-sm<%= view.page === 1 ? ' disabled' : '' %>" href="/admin/database?table=<%= view.name %>&page=<%= view.page - 1 %>"><i class="ti ti-chevron-left"></i></a>
                  <a class="btn btn-sm<%= view.page === view.pages ? ' disabled' : '' %>" href="/admin/database?table=<%= view.name %>&page=<%= view.page + 1 %>"><i class="ti ti-chevron-right"></i></a>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
