<%- include('../../partials/adminHeader', { tab: 'database' }) %>
<div class="page-body">
  <div class="container-xl">
    <p class="text-secondary"><i class="ti ti-lock me-1"></i><%= t('Read only: nothing here changes the database. Sessions are not shown.') %></p>
    <div class="row g-4">
      <aside class="col-lg-3">
        <div class="card">
          <div class="list-group list-group-flush">
            <% tables.forEach((tb) => { %>
              <a href="/admin/database?table=<%= tb.name %>" class="list-group-item list-group-item-action d-flex align-items-center<%= view && view.name === tb.name ? ' active' : '' %>"><span class="text-truncate"><%= tb.name %></span><span class="ms-auto text-secondary small"><%= formatNumber(tb.rows) %></span></a>
            <% }) %>
          </div>
        </div>
      </aside>
      <div class="col-lg-9">
        <% if (!view) { %>
          <div class="card"><div class="card-body text-secondary"><%= t('Choose a table.') %></div></div>
        <% } else { %>
          <div class="card">
            <div class="card-header">
              <h2 class="card-title"><%= view.name %></h2>
              <span class="ms-auto text-secondary small"><%= tn('{n} row', '{n} rows', view.total) %></span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-vcenter card-table z-db-table">
                <thead><tr><% view.columns.forEach((c) => { %><th><%= c %></th><% }) %></tr></thead>
                <tbody>
                  <% if (!view.rows.length) { %><tr><td colspan="<%= view.columns.length %>" class="text-secondary"><%= t('No rows.') %></td></tr><% } %>
                  <% view.rows.forEach((r) => { %><tr><% r.forEach((v) => { %><td<%- v === null ? ' class="text-secondary"' : '' %>><%= v === null ? '—' : v %></td><% }) %></tr><% }) %>
                </tbody>
              </table>
            </div>
            <% if (view.pages > 1) { %>
              <div class="card-footer d-flex align-items-center">
                <span class="text-secondary small"><%= t('Page {page} of {pages}', { page: formatNumber(view.page), pages: formatNumber(view.pages) }) %></span>
                <div class="btn-list ms-auto">
                  <a class="btn btn-sm<%= view.page === 1 ? ' disabled' : '' %>" href="/admin/database?table=<%= view.name %>&page=<%= view.page - 1 %>"><i class="ti ti-chevron-left"></i></a>
                  <a class="btn btn-sm<%= view.page === view.pages ? ' disabled' : '' %>" href="/admin/database?table=<%= view.name %>&page=<%= view.page + 1 %>"><i class="ti ti-chevron-right"></i></a>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
