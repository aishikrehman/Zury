// Zury database schema. Models are added incrementally per the project roadmap.
// Role and permission definitions live in src/permissions/registry.js; the
// database stores only who holds which role, and where.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  // Central (global) Wikimedia user ID from the OAuth identify `sub` claim.
  // Demo users use negative IDs so they can never collide with real accounts.
  wikimediaId           Int       @unique
  username              String    @unique
  avatarUrl             String?   @db.Text
  homeWiki              String?
  wikimediaRegisteredAt DateTime?
  // Global edit count from CentralAuth, refreshed with rights; used for eligibility.
  globalEditCount       Int?
  preferredLanguage     String?
  timezone              String?
  status                String    @default("active")
  rightsCheckedAt       DateTime?
  // Display preferences.
  uiLayout              String?
  uiWide                Boolean   @default(false)
  uiTextLarge           Boolean   @default(false)
  uiSidebarCollapsed    Boolean   @default(false)
  // JSON: the other display options (see src/config/displayOptions.js).
  uiPrefs               String    @default("{}") @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?

  globalRoles         UserGlobalRole[]    @relation("GlobalRoleHolder")
  globalRolesAssigned UserGlobalRole[]    @relation("GlobalRoleAssigner")
  wikiRoles           UserWikiRole[]
  memberships         ContestMembership[] @relation("MembershipHolder")
  membershipsAssigned ContestMembership[] @relation("MembershipAssigner")
  scopeRoles          ScopeRole[]         @relation("ScopeRoleHolder")
  scopeRolesAssigned  ScopeRole[]         @relation("ScopeRoleAssigner")
  levelSettings       LevelSetting[]
  notifications       Notification[]
  permissionOverrides ContestPermission[]
  contestsCreated     Contest[]           @relation("ContestCreator")
  contestsDeleted     Contest[]           @relation("ContestDeleter")
  auditLogs           AuditLog[]
  submissions         Submission[]        @relation("SubmissionParticipant")
  submissionsMade     Submission[]        @relation("SubmissionSubmitter")
  submissionHistory   SubmissionHistory[]
  eventBlocks         EventBlock[]        @relation("BlockedUser")
  eventBlocksMade     EventBlock[]        @relation("BlockedBy")
  attendances         SessionAttendance[]
  reviews             Review[]            @relation("Reviewer")
  assignments         ReviewAssignment[]  @relation("AssignedJuror")
  appeals             Appeal[]            @relation("Appellant")
  appealsResolved     Appeal[]            @relation("AppealResolver")
}

// Zury-assigned platform roles (e.g. platform-admin). Never derived from Wikimedia.
model UserGlobalRole {
  id           Int      @id @default(autoincrement())
  userId       Int
  role         String
  assignedAt   DateTime @default(now())
  assignedById Int?

  user       User  @relation("GlobalRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("GlobalRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
}

// Wikimedia user groups verified through the MediaWiki API.
// `wiki` is a database name such as "bnwiki", or "*" for global groups.
model UserWikiRole {
  id                 Int      @id @default(autoincrement())
  userId             Int
  wiki               String
  rightName          String
  verifiedAt         DateTime @default(now())
  verificationSource String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wiki, rightName])
  @@index([wiki, rightName])
}

model Contest {
  id                  Int     @id @default(autoincrement())
  // Unique within its parent (standalone, a series, or an edition), not across Zury.
  slug                String
  // Its address, kept from its actual parent: /events/<slug>, /<series>/<slug> or
  // /<series>/<edition>/<slug>. Unique; empty for deleted events.
  path                String? @unique @db.VarChar(255)
  title               String  @db.VarChar(1000)
  description         String  @default("") @db.Text
  type                String
  status              String  @default("draft")
  // "auto": status follows the dates once published. "manual": pinned by an organizer.
  statusMode          String  @default("auto")
  visibility          String  @default("public")
  organizingCommunity String  @default("")
  primaryWiki         String
  // JSON array of wiki database names.
  additionalWikis     String  @default("[]") @db.Text
  language            String  @default("en")
  timezone            String  @default("UTC")
  contactInfo         String  @default("") @db.Text
  // Kind of project, e.g. "glam", "education" (see PROJECT_CATEGORIES).
  category            String  @default("")
  // Link to the previous edition's page, for recurring events run elsewhere before.
  previousEditionUrl  String  @default("") @db.Text
  // The event's main category on the wiki, without "Category:".
  mainCategory        String  @default("") @db.Text
  logoUrl             String? @db.Text
  bannerUrl           String? @db.Text

  // All stored in UTC; entered and shown in the event's timezone.
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startDate            DateTime?
  endDate              DateTime?
  submissionOpensAt    DateTime?
  submissionDeadline   DateTime?
  reviewOpensAt        DateTime?
  reviewDeadline       DateTime?
  appealDeadline       DateTime?
  resultsAnnouncedAt   DateTime?

  // At most one parent: a series directly, or an edition (whose series it then belongs to),
  // or neither. The database refuses both.
  seriesId           Int?
  editionId          Int?
  createdById        Int?
  deletedAt          DateTime?
  deletedById        Int?
  // Set when the event was moved into another one; its address then redirects there.
  mergedIntoId       Int?
  mergedWikiCode     String?
  // When the results were made public; until then only organizers and jury see them.
  resultsPublishedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy           User?               @relation("ContestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy           User?               @relation("ContestDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  settings            ContestSettings?
  wikis               ContestWiki[]
  // Restrict: MariaDB allows the "not both" check only on links that don't cascade.
  series              EventSeries?        @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  editionOf           Edition?            @relation("EditionEvents", fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  localEvents         LocalEvent[]
  seriesSlug          SeriesSlug?
  submissions         Submission[]
  memberships         ContestMembership[]
  permissionOverrides ContestPermission[]
  auditLogs           AuditLog[]
  blocks              EventBlock[]
  reviews             Review[]
  appeals             Appeal[]
  assignments         ReviewAssignment[]
  sessions            EventSession[]
  contributions       Contribution[]

  @@index([status, visibility])
  @@index([primaryWiki])
  @@index([deletedAt])
  @@index([editionId])
  @@index([seriesId])
  @@index([slug])
}

// A recurring event such as Wikipedia Asian Month; each year is an edition (a Contest).
model EventSeries {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  description String    @default("") @db.Text
  // active | archived
  status      String    @default("active")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  // Events linked through the old seriesId (until stage 2).
  editions       Contest[]
  editionRecords Edition[]
  slugs          SeriesSlug[]
  roles          ScopeRole[]
  settings       LevelSetting[]
}

// One occurrence of a series (WLM 2026). Belongs to exactly one series; holds zero or more events.
model Edition {
  id          Int       @id @default(autoincrement())
  seriesId    Int
  slug        String
  title       String    @db.VarChar(1000)
  year        Int?
  description String    @default("") @db.Text
  // draft | active | completed | archived
  status      String    @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  series     EventSeries    @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  events     Contest[]      @relation("EditionEvents")
  seriesSlug SeriesSlug?
  roles      ScopeRole[]
  settings   LevelSetting[]

  @@unique([seriesId, slug])
}

// The names directly under a series (/wlm/<name>): an edition or a direct event, never both.
model SeriesSlug {
  seriesId  Int
  slug      String
  editionId Int?   @unique
  contestId Int?   @unique

  series  EventSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  // Restrict, so the database can check "an edition or an event, never both" (MariaDB allows
  // no check on a column whose foreign key cascades); the entry is removed before its owner.
  edition Edition?    @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contest Contest?    @relation(fields: [contestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([seriesId, slug])
}

// An optional, separately managed local part of an event (its bnwiki edition, say).
// Created only when a community needs its own management; wikis an event simply accepts
// stay as ContestWiki rows.
model LocalEvent {
  id        Int       @id @default(autoincrement())
  contestId Int
  slug      String
  title     String?   @db.VarChar(1000)
  wiki      String?
  // active | paused | archived
  status    String    @default("active")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contest     Contest      @relation(fields: [contestId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@unique([contestId, slug])
}

// A wiki taking part in an event. Settings it doesn't override come from the event.
model ContestWiki {
  id               Int       @id @default(autoincrement())
  contestId        Int
  wiki             String
  // Short code used in URLs, e.g. "bn" in /wam/2026/bn.
  code             String
  // active | pending (requested, awaiting approval) | paused
  status           String    @default("active")
  // JSON: { contest: {...}, settings: {...}, typeConfig: {...} } — only overridden fields.
  overrides        String    @default("{}") @db.Text
  requestedById    Int?
  // The Fountain editathon this wiki follows (fountain.toolforge.org/editathons/<code>), if any.
  fountainCode     String    @default("")
  fountainSyncedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, wiki])
  @@unique([contestId, code])
}

// Per-event feature switches and participation rules. Type-specific options
// (validated against src/events/eventTypes.js) are the only JSON here.
model ContestSettings {
  contestId Int @id

  juryReviewEnabled               Boolean @default(true)
  // How words are counted: auto (the ztools rule on Bengali wikis), ztools or plain.
  wordCountMethod                 String  @default("auto")
  appealsEnabled                  Boolean @default(false)
  registrationEnabled             Boolean @default(true)
  massSubmissionEnabled           Boolean @default(false)
  autoValidationEnabled           Boolean @default(true)
  contributionDiscoveryEnabled    Boolean @default(false)
  badgesEnabled                   Boolean @default(false)
  // Count the words of each article and show them in tables, results and statistics.
  wordCountEnabled                Boolean @default(false)
  publicStatisticsEnabled         Boolean @default(true)
  participantNotificationsEnabled Boolean @default(true)

  registrationRequired        Boolean   @default(false)
  // individual | team | both
  participationMode           String    @default("individual")
  minAccountAgeDays           Int       @default(0)
  minEditCount                Int       @default(0)
  participantLimit            Int?
  allowJuryParticipation      Boolean   @default(false)
  allowOrganizerParticipation Boolean   @default(false)
  anonymousParticipants       Boolean   @default(false)
  // JSON array of namespace numbers; empty means the event type's default.
  eligibleNamespaces          String    @default("[]") @db.Text
  typeConfig                  String    @default("{}") @db.Text
  // Contribution tracking. Participant tracking uses contributionDiscoveryEnabled.
  // JSON arrays: hashtags without "#", categories without "Category:".
  trackHashtags               String    @default("[]") @db.Text
  trackCategories             String    @default("[]") @db.Text
  // Jury marks (Fountain-style), JSON: [{ name, values: [{ label, points }] }].
  marks                       String    @default("[]") @db.Text
  // Reviews an entry needs before it is decided; the majority decides.
  requiredReviews             Int       @default(1)
  // How the reviews decide an entry: majority | unanimous | any | veto | first | score.
  decisionRule                String    @default("majority")
  // With decisionRule score: the average points an entry needs to pass.
  passScore                   Float     @default(0)
  // A majority tie: reject | accept | wait (for one more review).
  tieBreak                    String    @default("reject")
  // Reviewers do not see each other's reviews until the entry is decided.
  secretBallot                Boolean   @default(false)
  // open: any jury member of the entry's wiki may review it.
  // assigned: jury members review only the entries assigned to them.
  // open: any reviewer may take any entry; assigned: by hand; equal: shared out automatically
  // in equal parts as entries arrive; fixed: automatically, at most assignPerJuror each.
  reviewAssignment            String    @default("open")
  assignPerJuror              Int       @default(0)
  // What the results count: words | articles | points (marks or scores).
  rankBy                      String    @default("articles")
  // How a reviewer judges: yesno (1/0) | stars (1–5) | number (scoreMin–scoreMax; no limit when
  // empty) | marks (the custom marks).
  reviewMethod                String    @default("yesno")
  scoreMin                    Float?    @default(0)
  scoreMax                    Float?    @default(10)
  // Who reviews, JSON list of: jury (the event's chosen reviewers), localAdmins (admins of the
  // entry's wiki), participants (any participant: peer review).
  reviewers                   String    @default("[\"jury\"]") @db.Text
  // May someone review their own entry?
  selfReview                  Boolean   @default(false)
  bulkReviewEnabled           Boolean   @default(true)
  // Reviewer statistics shown to everyone (else only to the organizers).
  juryStatsEnabled            Boolean   @default(true)
  // Settings taken from the series or edition, JSON { key: "series" | "edition" }. A key listed
  // here follows its parent; one the event changes itself drops out and stays its own.
  followed                    String    @default("{}") @db.Text
  trackedAt                   DateTime?

  updatedAt DateTime @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
}

// Event-level roles: organizer, jury, participant, viewer. A user may hold several.
model ContestMembership {
  id           Int      @id @default(autoincrement())
  contestId    Int
  userId       Int
  role         String
  // Wiki database name this role is limited to; "" means the whole event.
  wiki         String   @default("")
  status       String   @default("active")
  assignedAt   DateTime @default(now())
  assignedById Int?

  contest    Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user       User    @relation("MembershipHolder", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("MembershipAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([contestId, userId, role, wiki])
  @@index([userId])
}

// Per-event permission overrides. They adjust event-role permissions only and
// never reduce platform-level authority.
model ContestPermission {
  id         Int     @id @default(autoincrement())
  contestId  Int
  userId     Int
  permission String
  allowed    Boolean

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, permission])
}

// An entry (page, file or Wikidata entity) submitted to an event.
model Submission {
  id            Int       @id @default(autoincrement())
  contestId     Int
  participantId Int
  submittedById Int
  // Wiki database name, e.g. "commonswiki".
  wiki          String
  title         String    @db.VarChar(1000)
  url           String    @db.Text
  // Stable identity for duplicate checks: page ID, or entity ID on Wikidata.
  pageKey       String
  // article | file | item | property | lexeme | page
  entryType     String
  // pending | validated | invalid | under_review | approved | rejected | disqualified | withdrawn | appealed
  status        String
  // JSON: normalized metadata from the wiki at the last check.
  metadata      String    @default("{}") @db.Text
  // JSON: { errors: [], warnings: [] } from the last rule check.
  validation    String    @default("{}") @db.Text
  checkedAt     DateTime?
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contest      Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  // The local event it was made in, if its event has local events.
  localEventId Int?
  localEvent   LocalEvent?         @relation(fields: [localEventId], references: [id], onDelete: Restrict)
  participant  User                @relation("SubmissionParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  submittedBy  User                @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  history      SubmissionHistory[]
  reviews      Review[]
  appeals      Appeal[]
  assignments  ReviewAssignment[]

  // Average points of its reviews, set when the entry is decided.
  score Float?

  // Words in the article at the last check (from metadata), for sorting and totals.
  wordCount Int?

  @@index([contestId, pageKey])
  @@index([contestId, status])
  @@index([contestId, participantId])
  @@index([contestId, submittedAt])
  @@index([contestId, wordCount])
  @@index([participantId])
}

model SubmissionHistory {
  id            Int      @id @default(autoincrement())
  submissionId  Int
  actorId       Int?
  // submitted | status_changed | revalidated | withdrawn
  action        String
  previousValue String?  @db.VarChar(1000)
  newValue      String?  @db.VarChar(1000)
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

// Wikimedia wikis from Meta-Wiki's sitematrix, refreshed periodically.
model WikiSite {
  dbname    String   @id
  url       String
  // Project family code, e.g. "wiki", "wiktionary", "commons".
  family    String
  // The wiki's own name for itself, e.g. "উইকিপিডিয়া".
  sitename  String
  // English name, e.g. "Bangla Wikipedia".
  name      String   @default("")
  // Name in the wiki's language, e.g. "বাংলা উইকিপিডিয়া".
  localName String   @default("")
  lang      String?
  closed    Boolean  @default(false)
  private   Boolean  @default(false)
  fetchedAt DateTime @default(now())

  namespaces WikiNamespace[]

  @@index([lang])
}

model Language {
  code      String   @id
  // English name, e.g. "Bangla".
  name      String
  // The language's name for itself, e.g. "বাংলা".
  localName String?
  fetchedAt DateTime @default(now())
}

// Namespaces of a wiki, from its siteinfo API.
model WikiNamespace {
  wiki      String
  id        Int
  name      String
  canonical String?
  content   Boolean  @default(false)
  fetchedAt DateTime @default(now())

  site WikiSite @relation(fields: [wiki], references: [dbname], onDelete: Cascade)

  @@id([wiki, id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  contestId  Int?
  action     String
  entityType String
  entityId   String?
  // JSON-encoded; SQLite has no native JSON column in Prisma 5.
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([contestId])
}

// A person barred from one event: they can't join, submit or hold a role there.
model EventBlock {
  id          Int       @id @default(autoincrement())
  contestId   Int
  userId      Int
  reason      String    @default("") @db.Text
  blockedById Int?
  createdAt   DateTime  @default(now())
  liftedAt    DateTime?

  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User    @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User?   @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  @@index([contestId, userId])
}

// A scheduled meeting of an activity: a workshop, training session or photowalk.
model EventSession {
  id         Int       @id @default(autoincrement())
  contestId  Int
  // Wiki database name the session belongs to; "" means the whole event.
  wiki       String    @default("")
  title      String    @db.VarChar(1000)
  // planned | open | held | cancelled
  status     String    @default("planned")
  // online | offline | hybrid
  mode       String    @default("offline")
  startsAt   DateTime
  endsAt     DateTime?
  location   String    @default("") @db.Text
  meetingUrl String    @default("") @db.Text
  capacity   Int?
  agenda     String    @default("") @db.Text
  // Written after the session: what happened, outcomes.
  report     String    @default("") @db.Text
  createdAt  DateTime  @default(now())

  contest     Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  attendances SessionAttendance[]

  @@index([contestId, startsAt])
}

model SessionAttendance {
  id          Int       @id @default(autoincrement())
  sessionId   Int
  userId      Int
  // registered | waitlisted | attended | absent | cancelled
  status      String    @default("registered")
  createdAt   DateTime  @default(now())
  checkedInAt DateTime?

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// Edits and pages found by tracking: participants' contributions, hashtags in
// edit summaries, or pages in a category.
model Contribution {
  id        Int      @id @default(autoincrement())
  contestId Int
  wiki      String
  // "<wiki>:rev:<revid>" or "<wiki>:page:<pageid>"; unique per event.
  key       String
  // participant | hashtag | category
  source    String
  username  String   @default("")
  userId    Int?
  pageTitle String   @db.VarChar(1000)
  ns        Int      @default(0)
  revId     Int?
  isNew     Boolean  @default(false)
  sizeDiff  Int      @default(0)
  comment   String   @default("") @db.Text
  timestamp DateTime
  foundAt   DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, key])
  @@index([contestId, wiki])
  @@index([contestId, username])
}

// Login sessions, kept in the database so they survive restarts.
model Session {
  sid       String   @id
  data      String   @db.Text
  expiresAt DateTime

  @@index([expiresAt])
}

// One jury member's verdict on one entry.
model Review {
  id           Int      @id @default(autoincrement())
  contestId    Int
  submissionId Int
  jurorId      Int
  // accept | reject
  decision     String
  // JSON: { "<mark name>": "<value label>" }
  marks        String   @default("{}") @db.Text
  points       Float    @default(0)
  comment      String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contest    Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  juror      User       @relation("Reviewer", fields: [jurorId], references: [id], onDelete: Cascade)

  @@unique([submissionId, jurorId])
  @@index([contestId, jurorId])
}

// A participant asking organizers to look at a decision again.
model Appeal {
  id           Int       @id @default(autoincrement())
  contestId    Int
  submissionId Int
  userId       Int
  reason       String    @db.Text
  // open | upheld | dismissed
  status       String    @default("open")
  response     String    @default("") @db.Text
  resolvedById Int?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  contest    Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation("Appellant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?      @relation("AppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([contestId, status])
}

// An entry given to a jury member to review (when the event assigns entries).
model ReviewAssignment {
  id           Int      @id @default(autoincrement())
  contestId    Int
  submissionId Int
  jurorId      Int
  assignedById Int?
  createdAt    DateTime @default(now())

  contest    Contest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  juror      User       @relation("AssignedJuror", fields: [jurorId], references: [id], onDelete: Cascade)

  @@unique([submissionId, jurorId])
  @@index([contestId, jurorId])
}

// A change to what a role may do, made by a superuser on the Permissions page.
// Roles keep their built-in permissions; these rows add (allowed) or take away (not allowed) one.
model RolePermissionChange {
  id          Int      @id @default(autoincrement())
  // platform | event
  kind        String
  role        String
  permission  String
  allowed     Boolean
  changedById Int?
  changedAt   DateTime @default(now())

  @@unique([kind, role, permission])
}

// A role held on a series or an edition: exactly one of the two (checked by the database).
// It covers that level only; with appliesToChildren it also counts on every event below it.
// Event and local-event roles are ContestMembership (local event = wiki set); platform roles UserGlobalRole.
model ScopeRole {
  id                Int      @id @default(autoincrement())
  userId            Int
  // organizer | jury | viewer
  role              String
  seriesId          Int?
  editionId         Int?
  appliesToChildren Boolean  @default(false)
  assignedAt        DateTime @default(now())
  assignedById      Int?

  user       User         @relation("ScopeRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?        @relation("ScopeRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  series     EventSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edition    Edition?     @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([seriesId])
  @@index([editionId])
}

// A setting given on a series or an edition (exactly one; checked by the database) for the events below.
// locked: every event below uses it and cannot change it. default: events use it until they
// set their own. optional: only suggested, never applied. Kept apart from roles (ScopeRole).
model LevelSetting {
  id          Int      @id @default(autoincrement())
  seriesId    Int?
  editionId   Int?
  // A ContestSettings field, e.g. secretBallot.
  key         String   @db.VarChar(64)
  // JSON value.
  value       String   @db.Text
  // locked | default | optional
  mode        String   @default("default")
  updatedAt   DateTime @updatedAt
  updatedById Int?

  series    EventSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edition   Edition?     @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([seriesId])
  @@index([editionId])
}

// Zury's own notifications (the bell). The text is a message key with values, shown in the
// reader's language; link is where it leads.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  // entry.decided | appeal.resolved | review.assigned | role.given
  kind      String    @db.VarChar(40)
  message   String    @db.VarChar(255)
  params    String    @default("{}") @db.Text
  link      String    @default("") @db.VarChar(1000)
  contestId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
