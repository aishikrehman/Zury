{
  "name": "zury",
  "version": "1.0.0",
  "description": "A unified platform for Wikimedia contests and community events.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/prepare-db.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "seed": "node prisma/seed.js",
    "admin:grant": "node scripts/grant-platform-admin.js",
    "wikis:sync": "node scripts/sync-wikis.js",
    "start:server": "node src/server.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@prisma/client": "^5.20.0",
    "@tabler/core": "^1.7.1",
    "@tabler/icons-webfont": "^3.49.0",
    "apexcharts": "^7.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "oauth-1.0a": "^2.2.6",
    "prisma": "^5.20.0",
    "tom-select": "^2.6.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
